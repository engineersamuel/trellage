# syntax=docker/dockerfile:1

FROM python:slim-bookworm AS adapter

ARG WSHOBSON_AGENTS_REF=main
ARG WSHOBSON_AGENTS_PLUGIN=full-stack-orchestration
ARG PIP_INDEX_URL=https://pypi.org/simple/

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" uv

RUN git init -q /opt/agents \
    && printf '%s\n' "${WSHOBSON_AGENTS_REF}" | grep -Eq '^(main|master|[0-9a-f]{40})$' \
    && git -C /opt/agents remote add origin https://github.com/wshobson/agents.git \
    && git -C /opt/agents fetch --depth 1 origin "${WSHOBSON_AGENTS_REF}" \
    && git -C /opt/agents checkout --detach FETCH_HEAD \
    && resolved_commit="$(git -C /opt/agents rev-parse HEAD)" \
    && printf '%s\n' "${resolved_commit}" | grep -Eq '^[0-9a-f]{40}$' \
    && mkdir -p /opt/trellage \
    && jq -n \
      --arg source 'https://github.com/wshobson/agents.git' \
      --arg requestedRef "${WSHOBSON_AGENTS_REF}" \
      --arg resolvedCommit "${resolved_commit}" \
      '{schemaVersion: 1, source: $source, requestedRef: $requestedRef, resolvedCommit: $resolvedCommit}' \
      > /opt/trellage/source-provenance.json \
    && chmod 0444 /opt/trellage/source-provenance.json

COPY --chmod=0555 scripts/adapt-agent-kit.sh /usr/local/bin/adapt-agent-kit.sh

RUN mkdir -p /opt/agent-kit \
    && uv run --project /opt/agents/plugins/plugin-eval \
      python /opt/agents/tools/generate.py \
      --harness codex \
      --plugin "${WSHOBSON_AGENTS_PLUGIN}" \
      --output-root /opt/agent-kit \
    && /usr/local/bin/adapt-agent-kit.sh /opt/agent-kit \
    && find /opt/agent-kit -type f -print \
      | sed 's#^/opt/agent-kit/##' \
      | LC_ALL=C sort > /opt/agent-kit-inventory.txt \
    && test -s /opt/agent-kit-inventory.txt

FROM node:bookworm-slim AS runtime

ARG CODEX_VERSION=latest
ARG PLAYWRIGHT_VERSION=latest
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git jq \
    && npm_config_registry="${NPM_CONFIG_REGISTRY}" npx --yes "playwright@${PLAYWRIGHT_VERSION}" install-deps chromium \
    && npm_config_registry="${NPM_CONFIG_REGISTRY}" npm install --global "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/agent --shell /bin/bash agent \
    && mkdir -p /workspace \
    && touch /workspace/.volume-seed \
    && chown -R 10001:10001 /workspace /home/agent

COPY --from=adapter /opt/agent-kit /opt/agent-kit
COPY --from=adapter /opt/agent-kit-inventory.txt /opt/agent-kit-inventory.txt
COPY --from=adapter /opt/trellage/source-provenance.json /opt/trellage/source-provenance.json
COPY --from=floating_skills / /opt/floating-skills
COPY docker/codex-config.toml /opt/codex-config.toml
COPY --chmod=0555 scripts/adapt-agent-kit.sh /usr/local/bin/adapt-agent-kit.sh
COPY --chmod=0555 scripts/find-harness-session.sh /usr/local/bin/find-harness-session.sh
COPY --chmod=0555 scripts/floating-skills.mjs /usr/local/bin/floating-skills.mjs
COPY --chmod=0444 skills.json /opt/floating-skills-catalog.json
COPY scripts/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
COPY scripts/run-agent.sh /usr/local/bin/run-agent.sh

RUN chmod 0555 /usr/local/bin/agent-entrypoint.sh /usr/local/bin/run-agent.sh \
    && chmod -R a=rX /opt/agent-kit /opt/agent-kit-inventory.txt /opt/trellage/source-provenance.json /opt/codex-config.toml \
      /opt/floating-skills /opt/floating-skills-catalog.json

ENV HOME=/home/agent \
    CODEX_HOME=/workspace/.codex-home \
    XDG_CACHE_HOME=/workspace/.cache \
    XDG_CONFIG_HOME=/workspace/.config \
    NODE_COMPILE_CACHE=/workspace/.cache/trellage/node-compile-cache \
    npm_config_cache=/workspace/.npm \
    npm_config_update_notifier=false

WORKDIR /workspace
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
CMD ["bash"]
