# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim AS plugins

ARG AWESOME_COPILOT_REF=ecf0f5a9f4b014d2e0f5e3c1cec55b4e7792ed8a
ARG AWESOME_COPILOT_PLUGINS="frontend-web-dev testing-automation"

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates git jq \
    && rm -rf /var/lib/apt/lists/*

RUN git init -q /opt/awesome-copilot \
    && git -C /opt/awesome-copilot remote add origin https://github.com/github/awesome-copilot.git \
    && git -C /opt/awesome-copilot fetch --depth 1 origin "${AWESOME_COPILOT_REF}" \
    && git -C /opt/awesome-copilot checkout --detach FETCH_HEAD \
    && test "$(git -C /opt/awesome-copilot rev-parse HEAD)" = "${AWESOME_COPILOT_REF}"

COPY --chmod=0555 scripts/materialize-awesome-plugin.sh /usr/local/bin/materialize-awesome-plugin.sh

RUN set -- ${AWESOME_COPILOT_PLUGINS}; \
    /usr/local/bin/materialize-awesome-plugin.sh /opt/awesome-copilot /opt/awesome-plugins "$@"; \
    chmod -R a=rX /opt/awesome-plugins

FROM node:22-bookworm-slim AS runtime

ARG COPILOT_VERSION=1.0.71-0
ARG PLAYWRIGHT_VERSION=1.61.1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git jq python3 \
    && npx --yes "playwright@${PLAYWRIGHT_VERSION}" install-deps chromium \
    && npm install --global "@github/copilot@${COPILOT_VERSION}" \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/agent --shell /bin/bash agent \
    && mkdir -p /workspace \
    && touch /workspace/.volume-seed \
    && chown -R 10001:10001 /workspace /home/agent

COPY --from=plugins /opt/awesome-plugins /opt/awesome-plugins
COPY --from=floating_skills / /opt/floating-skills
COPY --chmod=0555 scripts/find-harness-session.sh /usr/local/bin/find-harness-session.sh
COPY --chmod=0555 scripts/floating-skills.mjs /usr/local/bin/floating-skills.mjs
COPY --chmod=0444 skills.json /opt/floating-skills-catalog.json
COPY scripts/copilot-agent-entrypoint.sh /usr/local/bin/copilot-agent-entrypoint.sh
COPY --chmod=0444 prototypes/trellage/assets/rundown/rundown.instructions.md \
    /usr/local/share/trellage/copilot-instructions/rundown.instructions.md
COPY scripts/run-copilot-agent.sh /usr/local/bin/run-copilot-agent.sh

RUN chmod 0555 /usr/local/bin/copilot-agent-entrypoint.sh /usr/local/bin/run-copilot-agent.sh \
    && chmod -R a=rX /opt/awesome-plugins /opt/floating-skills /opt/floating-skills-catalog.json

ENV HOME=/home/agent \
    COPILOT_HOME=/workspace/.copilot-home \
    XDG_CACHE_HOME=/workspace/.cache \
    XDG_CONFIG_HOME=/workspace/.config \
    NODE_COMPILE_CACHE=/workspace/.cache/trellage/node-compile-cache \
    npm_config_cache=/workspace/.npm \
    npm_config_update_notifier=false \
    COPILOT_AUTO_UPDATE=false \
    COPILOT_MODEL=gpt-5.5

WORKDIR /workspace
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/copilot-agent-entrypoint.sh"]
CMD ["bash"]
