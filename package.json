{
  "name": "trellage",
  "version": "0.1.0",
  "description": "Rich launchers for Trellage Native agent profiles",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "trx": "bin/trx"
  },
  "files": [
    "bin",
    "bun.lock",
    "bunfig.toml",
    "tsconfig.base.json",
    "tsconfig.json",
    "packages/*/package.json",
    "packages/*/bunfig.toml",
    "packages/*/tsconfig.json",
    "packages/*/src/**",
    "packages/*/assets/**",
    "packages/*/prompts/**",
    "profile-guides",
    "profiles",
    "prototypes",
    "scripts",
    "config.example.toml"
  ],
  "scripts": {
    "preinstall": "bash scripts/check-package-manager.sh",
    "postinstall": "bash scripts/install-source-runtime.sh --prepare",
    "package:source": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=./bunfig.toml ./packages/trellage-runtime/src/package-cli.ts",
    "check": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=./bunfig.toml run check:root && BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=./bunfig.toml run --sequential --workspaces check",
    "check:root": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=./bunfig.toml ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=./bunfig.toml run --sequential --workspaces test",
    "check:changed-quality": "uv run --offline --no-project python scripts/quality.py changed",
    "check:architecture": "uv run --offline --no-project python scripts/quality_checks.py --analysis",
    "check:unused": "uv run --offline --no-project python scripts/quality_checks.py --analysis",
    "lint": "uv run --offline --no-project python scripts/quality_checks.py --check oxlint --all",
    "format:check": "uv run --offline --no-project python scripts/quality_checks.py --check oxfmt --all"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@trellage/guide-core": "workspace:*",
    "@trellage/launcher": "workspace:*",
    "@trellage/runtime": "workspace:*",
    "effect": "4.1.2",
    "skills": "1.5.26",
    "smol-toml": "1.9.0",
    "traits": "0.5.14",
    "varlock": "1.19.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2",
    "@effect/sql-libsql": "4.1.2"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engineersamuel/trellage.git"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/bun": "1.4.4",
    "@types/node": "26.5.1",
    "@xterm/headless": "6.0.0",
    "dependency-cruiser": "18.7.2",
    "knip": "6.44.2",
    "lefthook": "^2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
