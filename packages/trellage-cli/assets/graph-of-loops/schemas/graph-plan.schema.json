{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trellage.dev/schemas/graph-plan.schema.json",
  "title": "Graph of Loops Plan",
  "type": "object",
  "required": ["objective", "base_revision", "nodes"],
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "graph_gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "validation_matrix": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation" }
    },
    "authorization": { "$ref": "#/$defs/authorization" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id", "type", "role", "prompt", "prompt_digest",
        "dependencies", "read_set", "write_set",
        "behavior_change", "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": ["implement", "tdd", "research", "debug", "validate"]
        },
        "role": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "prompt_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "read_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "write_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repair_write_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "test_write_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_write_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "research_ledger": {
          "type": "string",
          "minLength": 1
        },
        "parallel_safe": { "type": "boolean" },
        "behavior_change": { "type": "boolean" },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate" }
        },
        "review_required": { "type": "boolean" },
        "proof_required": { "type": "boolean" },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["name", "argv"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "phase": {
          "type": "string",
          "enum": ["red", "green", "final"]
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["kind", "status", "source_paths"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "format",
            "lint",
            "typecheck",
            "build",
            "targeted-test",
            "full-suite"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["covered", "not-applicable"]
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "gate_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_push": { "type": "boolean" },
        "allow_pull_request": { "type": "boolean" },
        "allow_deploy": { "type": "boolean" }
      }
    }
  }
}
