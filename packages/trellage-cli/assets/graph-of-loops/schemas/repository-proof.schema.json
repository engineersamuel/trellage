{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trellage.dev/schemas/repository-proof.schema.json",
  "title": "Repository Proof Policy",
  "description": "Trellage proof policy for Raindrop Workshop 0.1.21 replay.",
  "type": "object",
  "required": ["event_name", "source_run_id", "assertions"],
  "additionalProperties": false,
  "properties": {
    "event_name": {
      "type": "string",
      "minLength": 1,
      "description": "Raindrop event name; must match an entry in .raindrop/agents.yaml."
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Workshop source trace ID for replay_run. Never invented."
    },
    "user_message": {
      "type": "string",
      "description": "Optional user_message override for replay_run."
    },
    "model": {
      "type": "string",
      "description": "Optional model override for replay_run."
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" },
      "description": "Read-only trace assertions that must pass."
    },
    "allowed_file_effects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Glob patterns for files replay may modify."
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum replay duration."
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["name", "check"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "enum": ["replay_ok", "output_contains", "file_unchanged"]
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
