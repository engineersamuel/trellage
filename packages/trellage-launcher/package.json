{
  "name": "@trellage/launcher",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./cli": "./src/cli.tsx",
    "./run-catalog": "./src/run-catalog.ts"
  },
  "bin": {
    "trellage-launcher": "src/cli.tsx"
  },
  "scripts": {
    "check": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=../../bunfig.toml ./node_modules/typescript/bin/tsc --noEmit",
    "test": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun --no-install --no-env-file --config=../../bunfig.toml ./node_modules/vitest/vitest.mjs run --configLoader native"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.28",
    "@typesafe-ai/sdk": "0.7.0",
    "diff": "9.0.0",
    "@trellage/conversation-source": "workspace:*",
    "@trellage/guide-core": "workspace:*",
    "@trellage/runtime": "workspace:*",
    "ink": "7.1.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-devtools-core": "7.0.1",
    "string-width": "8.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "5.1.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@xterm/headless": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=22"
  }
}
