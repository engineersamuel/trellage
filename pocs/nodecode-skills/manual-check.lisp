(in-package #:nodecode.evolved)

(let ((nlk::*cells-directory* (nlk:home "cells/"))
      (checks 0)
      (captured nil)
      (config (nle:read-shared-config)))
  (labels ((check (condition label)
             (unless condition (error "FAIL: ~a" label))
             (incf checks))
           (refuses (thunk)
             (handler-case (progn (funcall thunk) nil) (error () t)))
           (private-discovery-p ()
             (some (lambda (entry)
                     (or (search "i-have-adhd" (nlk:knowledge-entry-name entry))
                         (search "PRIVATE_MANUAL_SENTINEL" (or (nlk:knowledge-entry-description entry) ""))))
                   (nlk::knowledge-entries))))
    (check (find-package "NODECODE-TRELLAGE-MANUAL-SPIKE") "bridge loaded by native cell loader")
    (check (not (private-discovery-p)) "manual content absent from native knowledge")
    (check (nlk:knowledge-entry-named "manual-metadata-control" nil :data t)
           "metadata-only manual control remains discoverable")
    (check (search "METADATA_IS_NOT_ENFORCED" (help "manual-metadata-control"))
           "preserved manual frontmatter does not prevent automatic help lookup")
    (check (not (search "PRIVATE_MANUAL_SENTINEL" (help))) "manual prose absent from help")
    (nodecode-trellage-manual-spike:start-cell config)
    (check (nle::find-registered-command "trx-skill") "native command registered")
    (check (not (find "trx-skill" nle::*tools* :key #'first :test #'equal)) "not a model tool")
    (nodecode-trellage-manual-spike:start-cell config)
    (check (= 1 (count "trx-skill" nle::*registered-commands*
                       :key #'nle::slash-command-name :test #'equal)) "repeat start does not duplicate")
    ;; Intercept the real native submit seam before any store admission,
    ;; worker, provider or model can run. No server or real session exists.
    (nle:hook 'nle:submit "trellage-manual-spike-test"
              (lambda (next session prompt &rest keys)
                (declare (ignore next))
                (push (list session prompt keys) captured)
                :captured))
    (unwind-protect
         (progn
           (check (search "Submitted" (nle:slash "/trx-skill i-have-adhd help me plan"
                                                  :session-id "offline-test-session"))
                  "explicit slash dispatch reaches prompt submission")
           (check (= 1 (length captured)) "one explicit invocation submits once")
           (check (equal "offline-test-session" (first (first captured))) "session retained")
           (check (search "PRIVATE_MANUAL_SENTINEL" (second (first captured))) "requested private skill in prompt")
           (check (search "help me plan" (second (first captured))) "operator request in prompt")
           (check (equal "trellage-manual-skill" (getf (third (first captured)) :source)) "invocation provenance")
           (check (equal "i-have-adhd" (getf (third (first captured)) :source-id)) "skill provenance")
           (check (search "not selected" (nle:slash "/trx-skill absent help" :session-id "offline-test-session"))
                  "unselected skill refused")
           (check (search "not selected" (nle:slash "/trx-skill ../escape help" :session-id "offline-test-session"))
                  "skill identifier traversal refused")
           (check (search "usage" (nle:slash "/trx-skill i-have-adhd" :session-id "offline-test-session"))
                  "missing prompt refused")
           (check (= 1 (length captured)) "refusals submit nothing")
           (check (not (private-discovery-p)) "explicit invocation does not register knowledge")
           (check (not (search "PRIVATE_MANUAL_SENTINEL" (help))) "explicit invocation does not add help")
           (check (equal "ASSET_SENTINEL"
                         (string-trim '(#\Newline #\Return)
                           (uiop:read-file-string
                            (nodecode-trellage-manual-spike::asset-path "i-have-adhd" "assets/template.txt"))))
                  "nested relative asset readable")
           (dolist (path '("../outside.txt" "/tmp/outside.txt" "assets/../../outside.txt" "assets/link.txt"))
             (check (refuses (lambda () (nodecode-trellage-manual-spike::asset-path "i-have-adhd" path)))
                    (format nil "asset escape refused: ~a" path)))
           ;; Generation-local references must not be used by the bridge.
           (uiop:delete-directory-tree (nlk:home "generations/") :validate t :if-does-not-exist :ignore)
           (check (probe-file (nodecode-trellage-manual-spike::asset-path "i-have-adhd" "assets/template.txt"))
                  "asset survives generation pruning")
           (check (not (probe-file (nlk:home "SHOULD_NOT_EXECUTE"))) "code-looking prose never executed")
           ;; Selected manifest replacement removes invocation immediately.
           (let ((nodecode-trellage-manual-spike::*selected-manual-skills* nil))
             (check (search "not selected" (nle:slash "/trx-skill i-have-adhd help" :session-id "offline-test-session"))
                    "deselection revokes managed dispatch"))
           (nodecode-trellage-manual-spike::stop-cell)
           (nodecode-trellage-manual-spike::stop-cell)
           (check (not (nle::find-registered-command "trx-skill")) "stop unregisters command idempotently")
           (check (search "unknown command" (nle:slash "/trx-skill i-have-adhd help" :session-id "offline-test-session"))
                  "stopped slash is unknown")
           (check (fboundp 'nodecode-trellage-manual-spike::run-skill)
                  "stop is not code unloading")
           (let ((disabled (make-hash-table :test #'equal))
                 (section (make-hash-table :test #'equal)))
             (setf (gethash "enabled" section) nil
                   (gethash "trellage-manual-spike" disabled) section)
             (nodecode-trellage-manual-spike:start-cell disabled)
             (check (not (nle::find-registered-command "trx-skill"))
                    "disabled section installs no command")
             (check (fboundp 'nodecode-trellage-manual-spike::run-skill)
                    "disabled section does not unload code"))
           ;; A command is not an authorization boundary: eval can call SLASH.
           (nodecode-trellage-manual-spike:start-cell config)
           (check (search "Submitted" (eval '(nle:slash "/trx-skill i-have-adhd eval can call this"
                                                       :session-id "offline-test-session")))
                  "model eval can call slash; document boundary")
           (check (= 2 (length captured)) "eval call also reaches submit")
           (nodecode-trellage-manual-spike::stop-cell)
           (with-open-file (out (nlk:home "manual-result.txt") :direction :output :if-exists :supersede)
             (format out "PASS: ~d offline manual-dispatch assertions.~%" checks)))
      (nle:unhook 'nle:submit "trellage-manual-spike-test"))))
