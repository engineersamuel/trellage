{
  "$schema": "https://unpkg.com/syncpack@15/schema.json",
  "source": ["package.json", "packages/*/package.json"],
  "versionGroups": [
    {
      "label": "Runtime remains on Effect 3 until an explicit API migration",
      "packages": ["@trellage/runtime"],
      "dependencies": ["effect"],
      "pinVersion": "3.22.2"
    },
    {
      "label": "Root application uses Effect 4",
      "packages": ["trellage"],
      "dependencies": ["effect"],
      "pinVersion": "4.1.2"
    },
    {
      "label": "Shared tools and dependencies use matching versions",
      "packages": ["**"],
      "dependencies": ["**"]
    }
  ]
}
