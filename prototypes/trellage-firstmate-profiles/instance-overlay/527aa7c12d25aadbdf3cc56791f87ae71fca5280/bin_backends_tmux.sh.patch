 # "firstmate" session exists. Mirrors fm-spawn.sh's container-ensure block;
 # prints the resolved session name.
 fm_backend_tmux_container_ensure() {
+  if [ -n "${FMX_INSTANCE_ID:-}" ]; then
+    local namespace controls
+    controls=$(python3 "${FMX_WORKER_LAUNCHER%/*}/fmx-controls.py" namespace) || return 1
+    namespace=$(printf '%s' "$controls" | jq -er .namespace) || return 1
+    if ! tmux has-session -t "=$namespace" 2>/dev/null; then
+      tmux new-session -d -s "$namespace" \
+        -e "FMX_INSTANCE_ID=$FMX_INSTANCE_ID" -e "FMX_PROFILE_ROOT=$FMX_PROFILE_ROOT" \
+        || return 1
+    fi
+    if [ "$(tmux show-environment -t "=$namespace" FMX_INSTANCE_ID 2>/dev/null)" != "FMX_INSTANCE_ID=$FMX_INSTANCE_ID" ] \
+      || [ "$(tmux show-environment -t "=$namespace" FMX_PROFILE_ROOT 2>/dev/null)" != "FMX_PROFILE_ROOT=$FMX_PROFILE_ROOT" ]; then
+      echo "error: tmux session is not owned by this instance" >&2
+      return 1
+    fi
+    printf '%s\n' "$namespace"
+    return 0
+  fi
   if [ -n "${TMUX:-}" ]; then
     tmux display-message -p '#S'
   else
