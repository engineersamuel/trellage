 # lost, so worktree discovery cannot fall back to the active client's window.
 fm_backend_tmux_create_task() {  # <session> <window-name> <proj-abs> -> prints window id
   local ses=$1 wname=$2 proj_abs=$3 wid
+  if [ -n "${FMX_INSTANCE_ID:-}" ]; then
+    ses="=$ses"
+  fi
   if tmux list-windows -t "$ses" -F '#{window_name}' | grep -qx "$wname"; then
     echo "error: window $ses:$wname already exists" >&2
     return 1
   fi
   wid=$(tmux new-window -dP -F '#{window_id}' -t "$ses:" -n "$wname" -c "$proj_abs") || return 1
+  if [ -n "${FMX_INSTANCE_ID:-}" ]; then
+    tmux set-window-option -t "$wid" @fmx_instance_id "$FMX_INSTANCE_ID" || return 1
+    tmux set-window-option -t "$wid" @fmx_profile_root "$FMX_PROFILE_ROOT" || return 1
+    tmux set-window-option -t "$wid" @fmx_task_id "${wname#fm-}" || return 1
+  fi
   tmux set-window-option -t "$wid" automatic-rename off 2>/dev/null || true
   tmux set-window-option -t "$wid" allow-rename off 2>/dev/null || true
   printf '%s\n' "$wid"
