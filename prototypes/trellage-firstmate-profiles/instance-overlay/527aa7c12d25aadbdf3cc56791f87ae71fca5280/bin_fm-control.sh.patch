--- a/bin/fm-control.sh
+++ b/bin/fm-control.sh
@@ -99,6 +99,10 @@
 if [ -n "${FMX_WORKER_LAUNCHER:-}" ]; then
   python3 "${FMX_WORKER_LAUNCHER%/*}/fmx-controls.py" control "$@" >/dev/null || exit 1
+  if [ -n "${FMX_INSTANCE_ID:-}" ]; then
+    python3 "${FMX_WORKER_LAUNCHER%/*}/fmx-controls.py" operation-enter "$$" control >/dev/null || exit 1
