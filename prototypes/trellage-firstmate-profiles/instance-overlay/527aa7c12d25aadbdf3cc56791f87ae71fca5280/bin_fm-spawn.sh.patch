  TRELLAGE_FIRSTMATE_TASK_ID_PREFIX=$(shell_quote "${TRELLAGE_FIRSTMATE_TASK_ID_PREFIX:-}")\
@@ -4113,6 +4129,10 @@
 fm_lock_release "$SPAWN_META_LOCK"
 SPAWN_META_LOCK_HELD=0
 
+if [ -n "${TRELLAGE_FIRSTMATE_INSTANCE_ID:-}" ]; then
+  python3 "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER%/*}/firstmate-controls.py" operation-wait "$$" "$ID" >/dev/null || exit 1
