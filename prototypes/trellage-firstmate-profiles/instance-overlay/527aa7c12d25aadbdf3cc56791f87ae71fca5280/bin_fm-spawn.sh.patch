--- a/bin/fm-spawn.sh
+++ b/bin/fm-spawn.sh
@@ -351,6 +351,12 @@
 if [ -n "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER:-}" ]; then
   TRELLAGE_FIRSTMATE_SPAWN_ARGUMENTS=("$@")
   TRELLAGE_FIRSTMATE_SPAWN_CONTROLS=$(python3 "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER%/*}/firstmate-controls.py" spawn "$@") || exit 1
+  if [ -n "${TRELLAGE_FIRSTMATE_INSTANCE_ID:-}" ]; then
+    python3 "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER%/*}/firstmate-controls.py" operation-enter "$$" spawn "$@" >/dev/null || exit 1
+    trap 'python3 "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER%/*}/firstmate-controls.py" operation-leave "$$" >/dev/null 2>&1 || true' EXIT
+    TRELLAGE_FIRSTMATE_SPAWN_OPERATION_PID=$$
+    TRELLAGE_FIRSTMATE_SPAWN_OPERATION_ID=$(jq -er .operationId "$TRELLAGE_FIRSTMATE_PROFILE_ROOT/locks/operations/$$.json") || exit 1
+  fi
 elif [ -e "$FM_HOME/.firstmate-managed" ] || [ -e "$FM_HOME/.fmx-managed" ]; then
   echo "error: managed Firstmate spawning requires the firstmate worker boundary" >&2
   exit 1
@@ -1034,6 +1040,9 @@
   if [ "$CONFIG_INHERIT_LOCK_HELD" = 1 ]; then
     CONFIG_INHERIT_LOCK_HELD=0
     fm_lock_release "$CONFIG_INHERIT_LOCK" || true
+  fi
+  if [ -n "${TRELLAGE_FIRSTMATE_INSTANCE_ID:-}" ]; then
+    python3 "${TRELLAGE_FIRSTMATE_WORKER_LAUNCHER%/*}/firstmate-controls.py" operation-leave "$$" >/dev/null 2>&1 || true
   fi
   return "$status"
 }
@@ -3675,6 +3684,10 @@
   fi
   [ -z "${BUSY_GEN:-}" ] || echo "busy_gen=$BUSY_GEN"
   echo "spawn_gen=$SPAWN_GEN"
+  if [ -n "${TRELLAGE_FIRSTMATE_INSTANCE_ID:-}" ]; then
+    echo "firstmate_instance_id=$TRELLAGE_FIRSTMATE_INSTANCE_ID"
+    echo "firstmate_profile_root=$TRELLAGE_FIRSTMATE_PROFILE_ROOT"
+  fi
   # Default-off writes no traceparent= line.
