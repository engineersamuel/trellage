+# --- Trellage firstmate worker policy --------------------------------------------
+# An firstmate profile may supply one small, bounded worker-policy file. It is read
+# once here and inserted into ship and scout briefs only; a secondmate charter
+# is a standing job description, not a task brief, so it never receives it.
+# Upstream behavior is unchanged when TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE is absent or empty.
+# The bound is fixed by this overlay. It is deliberately not configurable from
+# the environment: a worker brief must never be widened by ambient state.
+readonly TRELLAGE_FIRSTMATE_WORKER_POLICY_MAX_BYTES=16384
+TRELLAGE_FIRSTMATE_WORKER_POLICY_SECTION=""
+if [ -n "${TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE:-}" ]; then
+  case "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" in
+    /*) ;;
+    *) echo "error: TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE must be an absolute path: $TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" >&2; exit 1 ;;
+  esac
+  if [ -L "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" ] || [ ! -f "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" ] \
+     || [ ! -r "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" ]; then
+    echo "error: TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE is not a readable regular file: $TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" >&2
+    exit 1
+  fi
+  firstmate_policy_bytes=$(wc -c < "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" | tr -d ' ')
+  if [ "$firstmate_policy_bytes" -eq 0 ] || [ "$firstmate_policy_bytes" -gt "$TRELLAGE_FIRSTMATE_WORKER_POLICY_MAX_BYTES" ]; then
+    echo "error: TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE must be between 1 and $TRELLAGE_FIRSTMATE_WORKER_POLICY_MAX_BYTES bytes: $TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE" >&2
+    exit 1
+  fi
+  TRELLAGE_FIRSTMATE_WORKER_POLICY_SECTION="
+$(cat "$TRELLAGE_FIRSTMATE_WORKER_POLICY_FILE")
+"
+fi
