+# --- Trellage fmx task-id namespace ----------------------------------------
+# Each fmx profile owns a task-id prefix so two profiles cannot silently create
+# the same fm/<id> branch in one remote. Unset means no namespace is enforced.
+if [ -n "${FMX_TASK_ID_PREFIX:-}" ]; then
+  case "$ID" in
+    "$FMX_TASK_ID_PREFIX"-*) ;;
+    *)
+      echo "error: this fmx profile requires task ids to start with '$FMX_TASK_ID_PREFIX-' (got '$ID'); rename the task so its fm/<id> branch cannot collide with another profile's" >&2
+      exit 1 ;;
+  esac
+fi
