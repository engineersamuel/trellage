@@ -51 +51,12 @@
+# --- Trellage firstmate managed runtime ------------------------------------------
+# This checkout is published by the Trellage `firstmate` launcher at an exact pinned
+# commit with a verified overlay. A self-update would silently move the runtime
+# off that pin, so it is refused whenever the firstmate ownership marker is present.
+# Unmanaged firstmate clones carry no marker and are unaffected.
+for firstmate_marker in "$FM_HOME/.firstmate-managed" "$FM_HOME/.fmx-managed" \
+  "$FM_ROOT/.firstmate-managed" "$FM_ROOT/.fmx-managed"; do
+  [ -f "$firstmate_marker" ] || continue
+  echo "error: firstmate self-update is disabled here: this runtime is managed by Trellage firstmate and pinned to an exact commit (marker: $firstmate_marker). Run 'firstmate update <profile>' on the host to move the pin, then relaunch the profile." >&2
+  exit 1
+done
+
 # --- main firstmate repo ---------------------------------------------------
