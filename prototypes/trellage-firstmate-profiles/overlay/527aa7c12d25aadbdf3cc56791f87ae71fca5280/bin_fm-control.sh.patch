--- a/bin/fm-control.sh
+++ b/bin/fm-control.sh
@@ -96,6 +96,13 @@
 SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
 FM_ROOT="${FM_ROOT_OVERRIDE:-$(cd "$SCRIPT_DIR/.." && pwd)}"
 
+if [ -n "${FMX_WORKER_LAUNCHER:-}" ]; then
+  python3 "${FMX_WORKER_LAUNCHER%/*}/fmx-controls.py" control "$@" >/dev/null || exit 1
+elif [ -e "${FM_HOME:-$FM_ROOT}/.fmx-managed" ]; then
+  echo "error: managed Firstmate control requires the fmx worker boundary" >&2
+  exit 1
+fi
+
 usage() {
   # The whole leading comment block, ending at the first non-comment line.
   sed -n '2,${/^#/!q;p;}' "$0" | sed 's/^# \{0,1\}//'
@@ -833,8 +840,12 @@
   RELAUNCH_TX="${BASHPID:-$$}.$(date -u +%Y%m%dT%H%M%SZ).$RANDOM"
   journal_write launching "${CHECKPOINT_LINES[@]}" "$note_line" "relaunch_tx=$RELAUNCH_TX"
   spawn_args=("$ID" --relaunch --harness "$TARGET_HARNESS")
-  [ "$TARGET_MODEL" = default ] || spawn_args+=(--model "$TARGET_MODEL")
-  [ "$TARGET_EFFORT" = default ] || spawn_args+=(--effort "$TARGET_EFFORT")
+  if [ -n "${FMX_WORKER_LAUNCHER:-}" ]; then
+    spawn_args+=(--model "$TARGET_MODEL" --effort "$TARGET_EFFORT")
+  else
+    [ "$TARGET_MODEL" = default ] || spawn_args+=(--model "$TARGET_MODEL")
+    [ "$TARGET_EFFORT" = default ] || spawn_args+=(--effort "$TARGET_EFFORT")
+  fi
   if FM_CONTROL_RELAUNCH_TX="$RELAUNCH_TX" \
       "$SCRIPT_DIR/fm-spawn.sh" "${spawn_args[@]}" >/dev/null; then
     RELAUNCH_META_PUBLISHED=1
@@ -844,6 +855,10 @@
     die "the replacement agent for $ID could not be launched on $TARGET_HARNESS"
   fi
 
+  if [ -n "${FMX_WORKER_LAUNCHER:-}" ]; then
+    TARGET_MODEL=$(fm_meta_get "$META" model)
+    TARGET_EFFORT=$(fm_meta_get "$META" effort)
+  fi
   state=$(wait_agent_state "$LAUNCH_WAIT" alive) || {
     die "the replacement agent for $ID did not come up within ${LAUNCH_WAIT}s (endpoint reads '$state')"
   }
