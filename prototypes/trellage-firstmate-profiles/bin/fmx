#!/usr/bin/env bash

set -euo pipefail

readonly launcher_name='fmx'
readonly harness_name='firstmate'
readonly ownership_value='trellage-firstmate-profiles-v1'
readonly ownership_basename='.managed-by-trellage-firstmate-profiles'
readonly managed_runtime_marker='.fmx-managed'
# v1 supports exactly one worker harness. The fmx worker boundary only wraps
# Claude launches, so any other crew harness would escape it entirely.
readonly managed_crew_harness='claude'
readonly managed_gh_host='github.com'
readonly proxy_origin='http://127.0.0.1:8080'
readonly proxy_token='trellage-local-proxy'
readonly model_id='claude-opus-5'
readonly sonnet_model_id='claude-sonnet-5'
readonly haiku_model_id='claude-haiku-4.5'

die() {
  printf 'fmx: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  fmx PROFILE [--instance UUID|NAME|legacy] [--join] [FIRSTMATE_ARGS...]
  fmx list [--json]
  fmx instances list PROFILE --json [--limit 1..32] [--cursor CURSOR]
  fmx instances resolve PROFILE --worktree PATH --json
  fmx instances plan PROFILE --name NAME --worktree PATH --json --expected-source-revision SHA40
  fmx instances create PROFILE --json --approve-creation SHA256  (approved plan on stdin)
  fmx instances refresh-locator PROFILE --instance UUID --worktree PATH --json \
    --expected-binding-digest SHA256 --confirm
  fmx inventory PROFILE --json
  fmx prepare PROFILE --json --expected-source-revision SHA40 [--install-prerequisites SHA256]
  fmx submit PROFILE --json       (bounded JSON on stdin)
  fmx receipt PROFILE --json      (bounded JSON on stdin)
  fmx harness-version PROFILE
  fmx setup PROFILE|--all
  fmx doctor PROFILE
  fmx repair PROFILE
  fmx skills-update PROFILE
  fmx skills-check PROFILE
  fmx update [--check] PROFILE|--all

Profiles: default, pstack-workers.
Management commands accept --instance UUID|NAME|legacy. Unqualified commands
and --all retain their legacy profile scope. Named creation never starts work
or approves tool installation.

fmx runs a Firstmate captain from a pinned, overlaid runtime.

Network use:
  setup                always fetches the pinned Firstmate source.
  update PROFILE       fetches whenever the runtime must change or be
                       reinstalled; it reports "is current" without fetching
                       when the installed runtime already matches the pin.
  update --check       always offline: it compares the installed receipt to
                       the catalog pin and never fetches.
  repair               fetches only when it must restage the runtime.
  prepare              repairs existing owned, idle state without starting a
                       fleet. New tools require explicit lock-bound consent.
  skills-update        copies the refreshed shared skill cache into existing
                       captain and worker homes; requires an idle fleet.
  doctor               never fetch Firstmate source, but does run the GitHub
                       identity check, Firstmate prerequisite detection, and
                       the shared Claude health checks.
  PROFILE              prompts before a first managed prerequisite install.
                       Accepted installs use the configured npm registry and
                       locked GitHub release assets.
  list, list --json    a pure projection of the catalog; probe nothing.
EOF
}

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

canonical_directory() {
  CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P
}

recover_inaccessible_working_directory() {
  local recovered

  builtin pwd -P >/dev/null 2>&1 && return
  [[ "${HOME-}" == /* && "$HOME" != / && -d "$HOME" && ! -L "$HOME" ]] \
    || die 'current working directory no longer exists and HOME is not a safe recovery directory; change directory and retry'
  builtin cd -P -- "$HOME" >/dev/null 2>&1 \
    || die "current working directory no longer exists and fmx could not enter HOME: $HOME"
  recovered="$(builtin pwd -P)" \
    || die "current working directory no longer exists and fmx could not resolve HOME: $HOME"
  printf 'fmx: current working directory no longer exists; continuing from %s\n' \
    "$recovered" >&2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

recover_inaccessible_working_directory

script_dir="$(resolve_script_dir)" || die 'could not resolve launcher directory'
runtime_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" \
  || die 'could not resolve runtime root'
readonly catalog="$runtime_root/catalog.json"
readonly overlay_root="$runtime_root/overlay"
readonly policy_source_root="$runtime_root/policies"
readonly overlay_tool="$runtime_root/lib/fmx-overlay.py"
readonly worker_launcher="$runtime_root/lib/fmx-worker"
readonly controls_helper="$runtime_root/lib/fmx-controls.py"
readonly control_helper="$runtime_root/lib/fmx-control.py"
readonly registry_helper="$runtime_root/lib/fmx-registry.py"
readonly instances_helper="$runtime_root/lib/fmx-instances.py"
readonly instance_overlay_root="$runtime_root/instance-overlay"
# An installed runtime stages the shared helper at lib/native-claude. A
# checked-out source tree (no install.sh run yet) has no lib/native-claude,
# so fall back to the sibling trellage-claude-common source, matching cldx's
# resolution so fmx works uninstalled immediately after a merge/rebase.
native_claude="$runtime_root/lib/native-claude"
if [[ ! -f "$native_claude" ]]; then
  native_claude="$runtime_root/../trellage-claude-common/native-claude"
fi
readonly native_claude
readonly prerequisite_helper="$runtime_root/lib/fmx-prerequisites"
# install.sh pins prerequisite-lock/manifest.json from the live
# prerequisites/manifest.json at install time. A checked-out source tree has
# no prerequisite-lock yet, so fall back to the live source manifest (the
# same file install.sh would have staged verbatim) rather than failing
# doctor/setup/repair outright.
prerequisite_manifest="$runtime_root/prerequisite-lock/manifest.json"
if [[ ! -f "$prerequisite_manifest" ]]; then
  prerequisite_manifest="$runtime_root/prerequisites/manifest.json"
fi
readonly prerequisite_manifest
readonly managed_prerequisite_tools='no-mistakes gh-axi chrome-devtools-axi lavish-axi tasks-axi quota-axi treehouse'

profile_key=''
profile_root=''
profile_marker=''
fm_runtime=''
fm_home=''
captain_root=''
captain_home=''
captain_marker=''
worker_root=''
receipt_file=''
policy_file=''
session_lock=''
staging_root=''
previous_runtime=''
previous_receipt=''
mutation_lock=''
mutation_lock_held=''
automatic_preparation=false
automatic_staging_started=false
automatic_publication_started=false
task_id_prefix=''
prerequisite_path=''
prerequisite_diagnostics=''
prerequisite_managed_missing=''
prerequisite_host_missing=''
instance_selector='legacy'
instance_context=''
instance_join=false
instance_explicit=false
instance_operation=''
instance_descriptor=''
instance_id=''
unset FMX_SELECTED_INSTANCE FMX_INSTANCE_CONTEXT_JSON FMX_INSTANCE_ID
unset FMX_LAUNCH_PROVENANCE_JSON

# ---------------------------------------------------------------------------
# Catalog. `list --json` is a pure projection of this file: it never probes the
# host, the profile roots, or the network.
# ---------------------------------------------------------------------------

validate_catalog() {
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "invalid catalog: $catalog"
  jq -e '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and .prompt == false
      and .outputFormats == ["text"]
      and .eventContract == null
      and .trellageEventContract == null
      and .sessionId == "none"
      and .resume == false
      and .resumeWithPrompt == false
      and .questionToolControl == "none"
      and .changedFiles == "none"
      and .usage == false
      and .cost == false
      and .modelOverride == false
      and .effortOverride == false
      and .testedHarnessVersion == null;
    type == "object"
    and keys == ["profiles", "schemaVersion", "source"]
    and .schemaVersion == 1
    and (.source | type == "object" and keys == ["commit", "overlay", "repository"])
    and (.source.repository | type == "string" and test("^https://[A-Za-z0-9._~:/-]+\\.git$"))
    and (.source.commit | type == "string" and test("^[0-9a-f]{40}$"))
    and (.source.overlay | type == "string" and test("^[0-9a-f]{40}$"))
    and (.profiles | type == "object" and keys == ["default", "pstack-workers"])
    and all(.profiles | to_entries[];
      (.key | test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.value | type == "object")
      and (.value | keys == [
        "description",
        "headless",
        "orchestration",
        "plugin",
        "standaloneMcps",
        "taskIdPrefix",
        "workerPolicy"
      ])
      and (.value.description
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not))
      and (.value.headless | validHeadless)
      and (.value.orchestration | type == "object"
        and keys == ["dispatchRules","instances","kind","preparation","schemaVersion","sourceRevision",
          "submission","taskIdPrefix","workerEfforts","workerHarness","workerPolicy"]
        and .schemaVersion == 1 and .kind == "firstmate"
        and .workerHarness == "claude" and .dispatchRules == "claude-single"
        and .workerEfforts == ["low", "medium", "high", "xhigh", "max"]
        and .submission == {"schemaVersion":1,"maxRequestBytes":524288}
        and .preparation == {"schemaVersion":1}
        and .instances == {"schemaVersion":1}
        and (.sourceRevision | test("^[0-9a-f]{40}$")))
      and .value.orchestration.taskIdPrefix == .value.taskIdPrefix
      and .value.plugin == null
      and .value.standaloneMcps == []
      and (.value.taskIdPrefix | type == "string" and test("^[a-z][a-z0-9]{1,7}$"))
      and (.value.workerPolicy == null
        or (.value.workerPolicy | type == "string" and test("^[a-z0-9][a-z0-9.-]*\\.md$"))))
    and ([.profiles | to_entries[] | .value.taskIdPrefix] | length == (unique | length))
  ' "$catalog" >/dev/null 2>&1 || die "invalid catalog: $catalog"
}

catalog_commit() {
  jq -r '.source.commit' "$catalog"
}

catalog_repository() {
  jq -r '.source.repository' "$catalog"
}

catalog_overlay() {
  jq -r '.source.overlay' "$catalog"
}

profile_names() {
  jq -r '.profiles | keys_unsorted[]' "$catalog"
}

list_profiles() {
  jq -r '.profiles | to_entries[] | [.key, .value.description] | @tsv' "$catalog"
}

list_profiles_json() {
  jq -S '
    {
      schemaVersion: 1,
      launcher: "fmx",
      harness: "firstmate",
      # fmx runs Firstmate and its Claude workers directly on the host. No
      # native OS-level sandbox is enabled; the isolation is state isolation
      # plus disposable Git worktrees, not a security boundary.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries[]
        | {
            name: .key,
            description: .value.description,
            headless: .value.headless,
            plugin: .value.plugin,
            source: "kunchenguid/firstmate",
            marketplace: null,
            standaloneMcps: .value.standaloneMcps
            ,orchestration: .value.orchestration
          }
      ]
    }
  ' "$catalog"
}

# ---------------------------------------------------------------------------
# Profile paths and ownership.
# ---------------------------------------------------------------------------

require_safe_home() {
  local canonical_home

  [[ "${HOME-}" == /* && "$HOME" != / && -d "$HOME" && ! -L "$HOME" ]] \
    || die "unsafe HOME: ${HOME-}"
  canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
  [[ "$canonical_home" != / ]] || die "unsafe HOME: $HOME"
  export HOME="$canonical_home"
}

require_safe_profile_path() {
  local path="$HOME" component canonical_home canonical_path

  canonical_home="$(canonical_directory "$HOME")"
  while IFS= read -r component; do
    path="$path/$component"
    [[ ! -L "$path" ]] || die "unsafe profile path: $path"
    if [[ -e "$path" ]]; then
      [[ -d "$path" ]] || die "unsafe profile path: $path"
      canonical_path="$(canonical_directory "$path")" \
        || die "cannot resolve profile path: $path"
      case "$canonical_path" in
        "$canonical_home"/*) ;;
        *) die "redirected profile path: $path" ;;
      esac
    fi
  done < <(profile_path_components)
}

profile_path_components() {
  printf '%s\n' .local share trellage profiles firstmate
  if [[ "$instance_selector" == legacy ]]; then
    printf '%s\n' "$profile_key"
  else
    printf '%s\n' instances "$instance_selector"
  fi
}

select_profile() {
  local name="$1" resolved

  jq -e --arg name "$name" '.profiles | has($name)' "$catalog" >/dev/null 2>&1 \
    || die "unknown profile: $name"
  profile_key="$name"
  profile_root="$HOME/.local/share/trellage/profiles/firstmate/$name"
  task_id_prefix="$(jq -r --arg name "$name" '.profiles[$name].taskIdPrefix' "$catalog")"
  if [[ "$instance_selector" != legacy ]]; then
    resolved="$(python3 "$registry_helper" resolve "$name" "$instance_selector")" \
      || die 'instance selection refused; no legacy fallback was attempted'
    profile_root="$(jq -er '.root' <<<"$resolved")"
    task_id_prefix="$(jq -er '.taskIdPrefix' <<<"$resolved")"
    instance_descriptor="$(jq -c '.descriptor' <<<"$resolved")"
    instance_selector="$(jq -er '.descriptor.reference.instanceId' <<<"$resolved")"
    instance_id="$instance_selector"
  fi
  export FMX_SELECTED_INSTANCE="$instance_selector"
  export FMX_INSTANCE_CONTEXT_JSON="$instance_context"
  profile_marker="$profile_root/$ownership_basename"
  fm_runtime="$profile_root/runtime"
  fm_home="$profile_root/home"
  captain_root="$profile_root/captain"
  captain_home="$captain_root/claude"
  captain_marker="$captain_root/$ownership_basename"
  worker_root="$profile_root/workers"
  receipt_file="$profile_root/receipts/source.json"
  session_lock="$profile_root/locks/session"
  staging_root="$profile_root/staging"
  previous_runtime="$profile_root/runtime.previous"
  previous_receipt="$profile_root/receipts.previous.json"
  mutation_lock="$profile_root/locks/mutation"
  mutation_generation="$profile_root/locks/generation"
  policy_file=''
  if [[ "$(jq -r --arg name "$name" '.profiles[$name].workerPolicy // ""' "$catalog")" != '' ]]; then
    policy_file="$profile_root/policy/worker-policy.md"
  fi
}

verify_instance_context() {
  [[ "$instance_selector" != legacy || -n "$instance_context" ]] || return 0
  instance_context="$(python3 "$instances_helper" _context "$profile_key" \
    "$instance_selector" "$instance_join" "$instance_context")" \
    || die 'instance context or worktree binding failed validation'
  export FMX_INSTANCE_CONTEXT_JSON="$instance_context"
}

profile_is_owned_or_empty() {
  local existing

  if [[ -e "$profile_marker" || -L "$profile_marker" ]]; then
    [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
    [[ "$(<"$profile_marker")" == "$ownership_value" ]] || return 1
    return 0
  fi
  [[ ! -e "$profile_root" ]] && return 0
  existing="$(find "$profile_root" -mindepth 1 \( -type f -o -type l \) -print -quit)"
  [[ -z "$existing" ]]
}

make_owned_directory() {
  local path="$1"

  [[ ! -L "$path" ]] || die "unsafe managed directory: $path"
  [[ -e "$path" ]] || mkdir -p "$path"
  [[ -d "$path" && ! -L "$path" ]] || die "unsafe managed directory: $path"
  chmod 0700 "$path"
}

write_marker() {
  local path="$1" staged

  [[ ! -L "$path" ]] || die "unsafe ownership marker: $path"
  staged="$(mktemp "$(dirname "$path")/.ownership.XXXXXX")" \
    || die "could not stage ownership marker: $path"
  printf '%s\n' "$ownership_value" >"$staged"
  chmod 0600 "$staged"
  mv -f "$staged" "$path"
}

prepare_profile_tree() {
  local path="$HOME" component

  require_safe_profile_path
  profile_is_owned_or_empty \
    || die "refusing unrelated existing profile files: $profile_root"
  while IFS= read -r component; do
    path="$path/$component"
    [[ -e "$path" ]] || mkdir "$path"
    [[ -d "$path" && ! -L "$path" ]] || die "unsafe profile path: $path"
  done < <(profile_path_components)
  chmod 0700 "$profile_root"
  write_marker "$profile_marker"
  make_owned_directory "$fm_home"
  make_owned_directory "$captain_root"
  make_owned_directory "$worker_root"
  make_owned_directory "$profile_root/receipts"
  make_owned_directory "$profile_root/locks"
  write_marker "$captain_marker"
}

# Every fmx-owned subdirectory a read path traverses, so a redirected `home`,
# `receipts`, `locks`, `captain`, `policy`, or `workers` cannot make a check
# read somewhere else. Only directories that already exist are validated; a
# missing one is reported by the specific check that needs it.
managed_profile_subdirectories() {
  printf '%s\n' \
    "$fm_home" \
    "$fm_home/config" \
    "$fm_home/data" \
    "$fm_home/state" \
    "$fm_home/projects" \
    "$captain_root" \
    "$captain_home" \
    "$worker_root" \
    "$profile_root/receipts" \
    "$profile_root/locks" \
    "$profile_root/policy" \
    "$profile_root/task-work" \
    "$fm_runtime"
}

require_safe_managed_paths() {
  local canonical_profile path canonical_path
  local -a paths=()

  require_safe_profile_path
  # A profile that does not exist yet has nothing to validate.
  [[ -d "$profile_root" && ! -L "$profile_root" ]] || return 0
  canonical_profile="$(canonical_directory "$profile_root")" \
    || die "cannot resolve profile root: $profile_root"
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    paths+=("$path")
  done < <(managed_profile_subdirectories)
  for path in "${paths[@]}"; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ ! -L "$path" ]] || die "unsafe managed path (symlink): $path"
    [[ -d "$path" ]] || die "unsafe managed path (not a directory): $path"
    canonical_path="$(canonical_directory "$path")" \
      || die "cannot resolve managed path: $path"
    case "$canonical_path" in
      "$canonical_profile" | "$canonical_profile"/*) ;;
      *) die "redirected managed path: $path" ;;
    esac
  done
}

require_owned_profile() {
  require_safe_managed_paths
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] \
    || die "profile is not set up; run fmx setup $profile_key"
  [[ "$(<"$profile_marker")" == "$ownership_value" ]] \
    || die "profile ownership marker differs: $profile_marker"
}

profile_is_set_up() {
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
  [[ "$(<"$profile_marker")" == "$ownership_value" ]] || return 1
  [[ -d "$fm_runtime" && ! -L "$fm_runtime" ]] || return 1
  [[ -f "$receipt_file" && ! -L "$receipt_file" ]] || return 1
  return 0
}

# ---------------------------------------------------------------------------
# Owned-path removal. Only exact fmx-owned staged/runtime paths are removed,
# and only after the prefix and ownership marker have been validated.
# ---------------------------------------------------------------------------

remove_owned_path() {
  local path="$1" canonical_profile canonical_parent

  [[ -e "$path" || -L "$path" ]] || return 0
  case "$path" in
    "$profile_root"/*) ;;
    *) die "refusing to remove a path outside the profile root: $path" ;;
  esac
  case "$path" in
    "$staging_root" | "$previous_runtime" | "$previous_receipt" | "$fm_runtime") ;;
    *) die "refusing to remove an unmanaged path: $path" ;;
  esac
  [[ -f "$profile_marker" && ! -L "$profile_marker" \
    && "$(<"$profile_marker")" == "$ownership_value" ]] \
    || die "refusing to remove a path in an unowned profile: $path"
  [[ ! -L "$path" ]] || die "refusing to remove a symlink: $path"
  canonical_profile="$(canonical_directory "$profile_root")" \
    || die "cannot resolve profile root: $profile_root"
  canonical_parent="$(canonical_directory "$(dirname "$path")")" \
    || die "cannot resolve parent of $path"
  [[ "$canonical_parent" == "$canonical_profile" ]] \
    || die "refusing to remove a redirected path: $path"
  rm -rf -- "$path"
}

# ---------------------------------------------------------------------------
# Fleet activity. Nothing here deletes anything; it only reports.
# ---------------------------------------------------------------------------

pid_alive() {
  local pid="$1"

  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

read_pid_file() {
  local path="$1" value

  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(wc -c <"$path" | tr -d '[:space:]')" -le 32 ]] || return 1
  value="$(<"$path")"
  [[ "$value" =~ ^[1-9][0-9]{0,9}$ && "$value" -le 2147483647 ]] || return 1
  printf '%s\n' "$value"
}

# One classifier for both fmx lock directories.
#
#   none        no lock directory
#   incomplete  a lock directory whose owner or pid is missing or malformed;
#               this is what a competitor mid-acquisition looks like, so it is
#               NEVER auto-reclaimed
#   unowned     a complete-looking lock some other tool owns
#   stale       exactly ours, with a valid pid that is dead
#   active      exactly ours, with a valid live pid
lock_state() {
  local lock="$1" pid entry

  [[ -e "$lock" || -L "$lock" ]] || { printf 'none\n'; return; }
  [[ -d "$lock" && ! -L "$lock" ]] || { printf 'incomplete\n'; return; }
  [[ -f "$lock/owner" && ! -L "$lock/owner" ]] || { printf 'incomplete\n'; return; }
  [[ "$(<"$lock/owner")" == "$ownership_value" ]] || { printf 'unowned\n'; return; }
  for entry in "$lock"/* "$lock"/.[!.]*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    case "${entry##*/}" in
      owner | pid) ;;
      backend) [[ "$lock" == "$session_lock" ]] || { printf 'unowned\n'; return; } ;;
      action) [[ "$lock" == "$mutation_lock" ]] || { printf 'unowned\n'; return; } ;;
      *) printf 'unowned\n'; return ;;
    esac
    [[ -f "$entry" && ! -L "$entry" ]] || { printf 'incomplete\n'; return; }
  done
  if [[ "$lock" == "$session_lock" ]]; then
    [[ -f "$lock/backend" && ! -L "$lock/backend" ]] \
      || { printf 'incomplete\n'; return; }
    case "$(<"$lock/backend")" in
      tmux | herdr) ;;
      *) printf 'unowned\n'; return ;;
    esac
  else
    [[ -f "$lock/action" && ! -L "$lock/action" ]] \
      || { printf 'incomplete\n'; return; }
    case "$(<"$lock/action")" in
      setup | repair | prepare | update | launch | submit | receipt | doctor | skills-update | refresh-locator) ;;
      *) printf 'unowned\n'; return ;;
    esac
  fi
  pid="$(read_pid_file "$lock/pid")" || { printf 'incomplete\n'; return; }
  if pid_alive "$pid"; then
    printf 'active\n'
  else
    printf 'stale\n'
  fi
}

session_state() {
  local state pid upstream_pid
  state="$(lock_state "$session_lock")"
  if [[ -e "$fm_home/state/.lock" || -L "$fm_home/state/.lock" ]]; then
    upstream_pid="$(read_pid_file "$fm_home/state/.lock")" \
      || { printf 'incomplete\n'; return; }
    if pid_alive "$upstream_pid"; then
      pid="$(read_pid_file "$session_lock/pid" || printf '')"
      [[ "$state" == active && "$pid" == "$upstream_pid" ]] \
        || { printf 'unowned\n'; return; }
    fi
  fi
  printf '%s\n' "$state"
}

require_safe_worker_entry() {
  local entry="$1" mode="$2"

  [[ "$mode" == require-safe ]] || return 0
  [[ -d "$entry" && ! -L "$entry" ]] || die "unsafe worker home: $entry"
}

# Emits "<task-id> <active|stale|orphaned>" for every worker home fmx knows
# about. Orphaned means an fmx worker home with no live marker and no Firstmate
# task record; it is reported, never removed.
worker_states() {
  local entry task pid state mode="${1-report}"

  [[ -d "$worker_root" && ! -L "$worker_root" ]] || return 0
  for entry in "$worker_root"/*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    require_safe_worker_entry "$entry" "$mode"
    task="$(basename "$entry")"
    if [[ ! -d "$entry" || -L "$entry" || -L "$entry/.active" ]]; then
      state=unsafe
    elif [[ -e "$entry/.active" ]] && {
      [[ ! -f "$entry/$ownership_basename" || -L "$entry/$ownership_basename" ]] \
        || [[ "$(<"$entry/$ownership_basename")" != "$ownership_value" ]] \
        || ! pid="$(read_pid_file "$entry/.active")"
    }; then
      state=unsafe
    elif pid="$(read_pid_file "$entry/.active")" && pid_alive "$pid"; then
      state=active
    elif [[ -f "$entry/.active" && ! -L "$entry/.active" ]]; then
      state=stale
    elif [[ -f "$fm_home/state/$task.meta" ]]; then
      state=stale
    else
      state=orphaned
    fi
    printf '%s %s\n' "$task" "$state"
  done
}

fleet_is_active() {
  local line

  [[ "$(session_state)" != active ]] || return 0
  while read -r line; do
    [[ -n "$line" ]] || continue
    case "${line##* }" in active | unsafe) return 0 ;; esac
  done < <(worker_states)
  return 1
}

# Lock acquisition primitive.
#
# mkdir is the exclusive-creation arbiter: it fails if the path exists at all,
# and it never replaces anything. rename(2) is deliberately NOT used to claim a
# lock, because it silently replaces an empty destination directory - which is
# precisely what a competitor looks like between its own mkdir and publishing
# its pid.
#
# The unavoidable consequence is a brief window in which the winner's lock is
# incomplete. That window is handled by classification, not by racing: an
# incomplete lock is NEVER auto-reclaimed. Only a lock with an exact owner and
# a valid, dead pid is reclaimable, and that reclaim is arbitrated by rename(2).
#
# mv is deliberately not used either: for directories it means "move inside"
# when the destination exists, which is not the semantics required here.
atomic_rename() {
  python3 -c '
import os, sys

try:
    os.rename(sys.argv[1], sys.argv[2])
except OSError:
    sys.exit(1)
' "$1" "$2"
}

# Writes a lock directory's contents. The pid is written LAST, so a reader can
# never see a lock that claims a pid it has not committed to.
populate_lock_directory() {
  local lock="$1"
  shift
  local entry name value

  chmod 0700 "$lock"
  for entry in "$@"; do
    name="${entry%%=*}"
    value="${entry#*=}"
    printf '%s\n' "$value" >"$lock/$name" \
      || die "could not write the lock entry: $lock/$name"
    chmod 0600 "$lock/$name"
  done
}

remove_lock_stage() {
  local stage="$1"

  case "$stage" in
    "$profile_root/locks/."*) ;;
    *) die "refusing to remove an unmanaged lock stage: $stage" ;;
  esac
  [[ ! -L "$stage" ]] || die "refusing to remove a symlinked lock stage: $stage"
  rm -rf -- "$stage"
}

# Per-profile mutation lock. It guards the runtime and profile state only;
# fleet state is never touched here.
mutation_state() {
  lock_state "$mutation_lock"
}

mutation_reader_blocked() {
  case "$(mutation_state)" in
    active | incomplete | unowned) return 0 ;;
    none | stale) return 1 ;;
    *) die "the mutation lock at $mutation_lock is in an unexpected state" ;;
  esac
}

mutation_generation_value() {
  local value

  if [[ ! -e "$mutation_generation" && ! -L "$mutation_generation" ]]; then
    printf '0\n'
    return
  fi
  [[ -f "$mutation_generation" && ! -L "$mutation_generation" ]] \
    || die "unsafe mutation generation: $mutation_generation"
  value="$(<"$mutation_generation")"
  [[ "$value" =~ ^[0-9]{1,17}$ ]] \
    || die "invalid mutation generation: $mutation_generation"
  printf '%s\n' "$value"
}

advance_mutation_generation() {
  local current next staged

  [[ "$mutation_lock_held" == "$mutation_lock" ]] \
    || die 'cannot advance the mutation generation without holding the lock'
  current="$(mutation_generation_value)"
  next=$((10#$current + 1))
  staged="$(mktemp "$profile_root/locks/.generation.XXXXXX")" \
    || die 'could not stage the mutation generation'
  printf '%s\n' "$next" >"$staged"
  chmod 0600 "$staged"
  mv -f -- "$staged" "$mutation_generation" \
    || die 'could not publish the mutation generation'
}

release_mutation_lock() {
  local held="$mutation_lock_held"

  [[ -n "$held" ]] || return 0
  mutation_lock_held=''
  # Exact owned path only, and never a symlink.
  [[ "$held" == "$profile_root/locks/mutation" && ! -L "$held" ]] || return 0
  rm -rf -- "$held" 2>/dev/null || true
}

exit_after_mutation_signal() {
  local status="$1"

  trap - HUP INT TERM
  if [[ "$automatic_preparation" == true ]]; then
    cleanup_automatic_preparation
  else
    release_mutation_lock
  fi
  exit "$status"
}

# Only an unambiguously stale lock is reclaimed: exact owner, valid pid, and
# that pid dead. Anything else fails closed and is left in place.
reclaim_stale_mutation_lock() {
  local action="$1"
  python3 "$control_helper" reclaim "$profile_root" "$profile_key" \
    || die "$action refused: another fmx mutation is running for $profile_key"
}

acquire_mutation_lock() {
  local action="$1" state

  ! runtime_installation_busy \
    || die "$action refused: the fmx launcher installation is active or incomplete"
  make_owned_directory "$profile_root/locks"
  if ! mkdir "$mutation_lock" 2>/dev/null; then
    state="$(mutation_state)"
    case "$state" in
      active)
        die "$action refused: another fmx mutation is already running for $profile_key" ;;
      incomplete)
        die "$action refused: an incomplete mutation lock exists at $mutation_lock; another fmx process may be acquiring it right now. Confirm no fmx mutation is running, then remove it by hand" ;;
      unowned)
        die "$action refused: an unowned lock directory exists at $mutation_lock; remove it by hand after confirming no fmx mutation is running" ;;
      stale)
        reclaim_stale_mutation_lock "$action" ;;
      none) ;;
      *)
        die "$action refused: the mutation lock at $mutation_lock is in an unexpected state: $state" ;;
    esac
    mkdir "$mutation_lock" 2>/dev/null \
      || die "$action refused: another fmx mutation is already running for $profile_key"
  fi
  # Held from this point on, so a failure while publishing still releases it.
  mutation_lock_held="$mutation_lock"
  trap release_mutation_lock EXIT
  trap 'exit_after_mutation_signal 129' HUP
  trap 'exit_after_mutation_signal 130' INT
  trap 'exit_after_mutation_signal 143' TERM
  populate_lock_directory "$mutation_lock" \
    "owner=$ownership_value" "action=$action" "pid=$$"
  ! runtime_installation_busy \
    || die "$action refused: the fmx launcher installation is active"
  if [[ "$instance_operation" != _create-owned ]]; then
    case "$action" in
      prepare | repair | update | launch | skills-update) verify_instance_context ;;
    esac
  fi
  case "$action" in
    setup | repair | update) advance_mutation_generation ;;
  esac
}

runtime_installation_busy() {
  local lock
  for lock in "$runtime_root/../.fmx-install.lock" "$HOME/.local/share/trellage/.fmx-install.lock"; do
    if [[ -e "$lock" || -L "$lock" ]]; then return 0; fi
  done
  return 1
}

# A profile is busy when the fleet is running, when a mutation holds the lock,
# or when either lock is in an incomplete state that must not be reclaimed.
profile_is_busy() {
  local mutation session

  fleet_is_active && return 0
  mutation="$(mutation_state)"
  session="$(session_state)"
  [[ "$mutation" != active && "$mutation" != incomplete && "$mutation" != unowned ]] \
    || return 0
  [[ "$session" != active && "$session" != incomplete && "$session" != unowned ]] \
    || return 0
  return 1
}

require_idle_fleet() {
  local action="$1" state

  if [[ "$instance_selector" != legacy ]]; then
    python3 "$registry_helper" check-operations "$profile_key" "$instance_selector" \
      || die "$action refused: named task startup or control is active or unsafe"
  fi
  state="$(session_state)"
  case "$state" in
    active)
      die "$action refused: the $profile_key fleet is active; stop the captain session and its workers first (fmx inventory $profile_key --json reports what is running)" ;;
    incomplete | unowned)
      die "$action refused: the captain session lock at $session_lock is $state; confirm no captain is running, then remove it by hand" ;;
    none | stale) ;;
    *)
      die "$action refused: the captain session lock at $session_lock is in an unexpected state: $state" ;;
  esac

  if fleet_is_active; then
    die "$action refused: the $profile_key fleet is active; stop the captain session and its workers first (fmx inventory $profile_key --json reports what is running)"
  fi
}

# ---------------------------------------------------------------------------
# Pinned source staging, overlay, and atomic publication.
# ---------------------------------------------------------------------------

overlay_directory() {
  local commit="$1" directory="$overlay_root/$commit"

  [[ -d "$directory" && ! -L "$directory" ]] \
    || die "no checked-in overlay for commit $commit"
  [[ -f "$directory/manifest.json" && ! -L "$directory/manifest.json" ]] \
    || die "overlay manifest is missing for commit $commit"
  printf '%s\n' "$directory"
}

verify_runtime_overlay() {
  local commit="$1" directory

  directory="$(overlay_directory "$commit")"
  if [[ "$instance_selector" != legacy ]]; then
    python3 "$overlay_tool" --manifest "$directory/manifest.json" \
      --supplement "$instance_overlay_root/$commit/manifest.json" \
      --root "$fm_runtime" --commit "$commit" --verify-only >/dev/null \
      || die 'named runtime does not match its complete verified overlay variant'
    return
  fi
  python3 "$overlay_tool" \
    --manifest "$directory/manifest.json" \
    --root "$fm_runtime" \
    --commit "$commit" \
    --verify-only >/dev/null \
    || die "the installed runtime does not match the pinned overlay for $commit; run fmx repair $profile_key"
}

# Full-checkout integrity. Offline: rev-parse, status, and diff read only the
# local object store and worktree. The published runtime must sit exactly at
# the pinned commit and differ from it by exactly the manifest's managed paths,
# with unchanged file modes, nothing staged, and nothing untracked.
runtime_checkout_report() {
  local commit="$1" root="${2:-$fm_runtime}"
  local head status expected actual raw old_mode new_mode
  local GIT_OPTIONAL_LOCKS=0
  export GIT_OPTIONAL_LOCKS
  if [[ "$instance_selector" != legacy ]]; then
    python3 "$overlay_tool" --manifest "$overlay_root/$commit/manifest.json" \
      --supplement "$instance_overlay_root/$commit/manifest.json" \
      --root "$root" --commit "$commit" --verify-only
    return
  fi

  [[ -d "$root" && ! -L "$root" ]] \
    || { printf 'the installed runtime is missing\n'; return 1; }
  [[ -d "$root/.git" && ! -L "$root/.git" ]] \
    || { printf 'the installed runtime is not a Git checkout\n'; return 1; }
  head="$(git -C "$root" rev-parse HEAD 2>/dev/null)" \
    || { printf 'the installed runtime HEAD could not be read\n'; return 1; }
  if [[ "$head" != "$commit" ]]; then
    printf 'the installed runtime is at %s, not the pinned commit %s\n' "$head" "$commit"
    return 1
  fi
  # --ignored=matching is required: without it an ignored .env, config/, or
  # executable could sit in the runtime unseen.
  status="$(git -C "$root" status --porcelain --untracked-files=all \
    --ignored=matching 2>/dev/null)" \
    || { printf 'the installed runtime status could not be read\n'; return 1; }
  expected="$(jq -r '.files[].path' "$overlay_root/$commit/manifest.json" \
    | sed 's/^/ M /' | LC_ALL=C sort)"
  actual="$(printf '%s\n' "$status" | sed '/^$/d' | LC_ALL=C sort)"
  if [[ "$actual" != "$expected" ]]; then
    printf 'the installed runtime has unexpected Git changes (expected only the %s managed overlay paths); git status reported:\n%s\n' \
      "$(printf '%s\n' "$expected" | wc -l | tr -d '[:space:]')" "$actual"
    return 1
  fi
  raw="$(git -C "$root" -c diff.autoRefreshIndex=false diff --raw HEAD 2>/dev/null)" \
    || { printf 'the installed runtime diff could not be read\n'; return 1; }
  while read -r old_mode new_mode _rest; do
    [[ -n "$old_mode" ]] || continue
    old_mode="${old_mode#:}"
    if [[ "$old_mode" != "$new_mode" ]]; then
      printf 'the installed runtime changed a file mode (%s -> %s)\n' "$old_mode" "$new_mode"
      return 1
    fi
  done <<<"$raw"
  return 0
}

verify_runtime_checkout() {
  local commit="$1" report

  require_command git
  if ! report="$(runtime_checkout_report "$commit")"; then
    die "$report; run fmx repair $profile_key"
  fi
}

# ---------------------------------------------------------------------------
# Overlay evidence. Every helper below reads and hashes local files only: no
# network, no gh, and no proxy. Overall inventory READINESS is separate and is
# not offline, because reaching `healthy` runs the full doctor path.
# ---------------------------------------------------------------------------

sha256_file() {
  python3 -c '
import hashlib, sys
with open(sys.argv[1], "rb") as handle:
    print(hashlib.sha256(handle.read()).hexdigest())
' "$1" 2>/dev/null
}

# Identity of the overlaid runtime the manifest describes: a sha256 over the
# sorted "<path>:<result digest>" lines. It changes whenever any managed file's
# post-overlay content changes, and is independent of manifest formatting.
overlay_content_digest() {
  local manifest="$1"

  jq -r '.files | sort_by(.path)[] | "\(.path):\(.result)"' "$manifest" 2>/dev/null \
    | python3 -c '
import hashlib, sys
print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())
' 2>/dev/null
}

overlay_evidence_json() {
  local commit manifest manifest_digest content_digest file_count verified=false

  commit="$(catalog_overlay)"
  manifest="$overlay_root/$commit/manifest.json"
  if [[ "$instance_selector" != legacy ]]; then
    python3 "$overlay_tool" --manifest "$manifest" --root "$fm_runtime" --commit "$commit" \
      --supplement "$instance_overlay_root/$commit/manifest.json" --evidence "${1-verify}"
    return
  fi
  manifest_digest=''
  content_digest=''
  file_count=''
  if [[ -f "$manifest" && ! -L "$manifest" ]]; then
    manifest_digest="$(sha256_file "$manifest" || printf '')"
    content_digest="$(overlay_content_digest "$manifest" || printf '')"
    file_count="$(jq -r '.files | length' "$manifest" 2>/dev/null || printf '')"
    if [[ "${1-verify}" == verify && -d "$fm_runtime" && ! -L "$fm_runtime" ]] \
      && python3 "$overlay_tool" \
        --manifest "$manifest" \
        --root "$fm_runtime" \
        --commit "$commit" \
        --verify-only >/dev/null 2>&1; then
      verified=true
    fi
  fi
  jq -cn \
    --arg commit "$commit" \
    --arg manifestDigest "$manifest_digest" \
    --arg contentDigest "$content_digest" \
    --arg fileCount "$file_count" \
    --argjson verified "$verified" '
    {
      commit: $commit,
      digestAlgorithm: "sha256",
      manifestDigest: (if $manifestDigest == "" then null else $manifestDigest end),
      contentDigest: (if $contentDigest == "" then null else $contentDigest end),
      fileCount: (if $fileCount == "" then null else ($fileCount | tonumber) end),
      verified: $verified
    }
  '
}

stage_pinned_source() {
  local commit="$1" repository="$2" overlay_commit="$3" stage_prepared="${4-false}"
  local directory checkout head report

  directory="$(overlay_directory "$overlay_commit")"
  if [[ "$stage_prepared" == false ]]; then
    remove_owned_path "$staging_root"
    make_owned_directory "$staging_root"
  fi
  checkout="$staging_root/firstmate"
  mkdir "$checkout" || die "could not create the staging checkout: $checkout"

  git init --quiet "$checkout" >/dev/null \
    || die 'could not initialize the staging checkout'
  git -C "$checkout" remote add origin "$repository" >/dev/null \
    || die 'could not register the pinned Firstmate remote'
  git -C "$checkout" fetch --quiet --depth 1 origin "$commit" >/dev/null \
    || die "the pinned Firstmate commit is not available from $repository: $commit"
  git -C "$checkout" checkout --quiet --detach FETCH_HEAD >/dev/null \
    || die "could not check out the pinned commit: $commit"
  head="$(git -C "$checkout" rev-parse HEAD)" \
    || die 'could not read the staged HEAD'
  [[ "$head" == "$commit" ]] \
    || die "staged HEAD $head does not match the pinned commit $commit"

  python3 "$overlay_tool" \
    --manifest "$directory/manifest.json" \
    --root "$checkout" \
    --commit "$overlay_commit" >/dev/null \
    || die "the pinned Firstmate source does not match the checked-in overlay for $overlay_commit"
  if [[ "$instance_selector" != legacy ]]; then
    python3 "$overlay_tool" --manifest "$instance_overlay_root/$overlay_commit/manifest.json" \
      --root "$checkout" --commit "$overlay_commit" >/dev/null \
      || die 'named runtime supplement does not match the preceding overlay layer'
  fi

  # The staged checkout is verified BEFORE it can become the live runtime, so
  # a bad stage is never published and then reported.
  if ! report="$(runtime_checkout_report "$commit" "$checkout")"; then
    die "the staged Firstmate checkout is not clean at the pinned commit: $report"
  fi

  printf '%s\n' "$checkout"
}

# Runtime and receipt are published as ONE transaction. A staged receipt is
# written first, then both are moved into place; if either move fails, the
# previous runtime and the previous receipt are restored before the failure is
# reported. A previously retired runtime is never discarded while the live
# runtime is absent, so the only good copy cannot be lost.
recover_interrupted_publication() {
  local live_runtime=false live_receipt=false
  local saved_runtime=false saved_receipt=false

  require_safe_managed_paths
  if [[ -e "$fm_runtime" || -L "$fm_runtime" ]]; then
    [[ -d "$fm_runtime" && ! -L "$fm_runtime" ]] \
      || die "unsafe installed runtime: $fm_runtime"
    live_runtime=true
  fi
  if [[ -e "$receipt_file" || -L "$receipt_file" ]]; then
    [[ -f "$receipt_file" && ! -L "$receipt_file" ]] \
      || die "unsafe source receipt: $receipt_file"
    live_receipt=true
  fi
  if [[ -e "$previous_runtime" || -L "$previous_runtime" ]]; then
    [[ -d "$previous_runtime" && ! -L "$previous_runtime" ]] \
      || die "unsafe retired runtime: $previous_runtime"
    saved_runtime=true
  fi
  if [[ -e "$previous_receipt" || -L "$previous_receipt" ]]; then
    [[ -f "$previous_receipt" && ! -L "$previous_receipt" ]] \
      || die "unsafe retired source receipt: $previous_receipt"
    saved_receipt=true
  fi

  [[ "$saved_runtime" == true || "$saved_receipt" == true ]] || return 0
  # A complete live pair is usable. The preserved paths can be retired by the
  # next successful publication; deleting them before the live pair is fully
  # verified would discard the only fallback for unrelated corruption.
  if [[ "$live_runtime" == true && "$live_receipt" == true ]]; then
    return 0
  fi
  # The first publication step retires only the receipt. In that exact state,
  # restoring it is enough to recover the old live pair.
  if [[ "$live_runtime" == true && "$live_receipt" == false \
    && "$saved_runtime" == false && "$saved_receipt" == true ]]; then
    mv -- "$previous_receipt" "$receipt_file" \
      || die "interrupted publication recovery failed; the source receipt remains at $previous_receipt"
    remove_owned_path "$staging_root"
    return 0
  fi
  if [[ "$live_runtime" == false && "$live_receipt" == true \
    && "$saved_runtime" == true && "$saved_receipt" == false ]]; then
    mv -- "$previous_runtime" "$fm_runtime" \
      || die "interrupted publication recovery failed; the runtime remains at $previous_runtime"
    remove_owned_path "$staging_root"
    return 0
  fi
  if [[ "$live_runtime" == false && "$live_receipt" == false \
    && "$saved_runtime" == true && "$saved_receipt" == false ]]; then
    mv -- "$previous_runtime" "$fm_runtime" \
      || die "interrupted publication recovery failed; the runtime remains at $previous_runtime"
    remove_owned_path "$staging_root"
    return 0
  fi
  if [[ "$live_runtime" == false && "$live_receipt" == false \
    && "$saved_runtime" == false && "$saved_receipt" == true ]]; then
    mv -- "$previous_receipt" "$receipt_file" \
      || die "interrupted publication recovery failed; the source receipt remains at $previous_receipt"
    remove_owned_path "$staging_root"
    return 0
  fi
  # Once the old runtime is retired, both old items exist. A live runtime or
  # receipt at this point is an incompletely published new pair and is removed
  # before the preserved old pair is restored.
  if [[ "$saved_runtime" == true && "$saved_receipt" == true ]]; then
    if [[ "$live_runtime" == true ]]; then
      remove_owned_path "$fm_runtime"
    fi
    if [[ "$live_receipt" == true ]]; then
      rm -f -- "$receipt_file"
    fi
    mv -- "$previous_runtime" "$fm_runtime" \
      || die "interrupted publication recovery failed; the runtime remains at $previous_runtime"
    mv -- "$previous_receipt" "$receipt_file" \
      || die "interrupted publication recovery restored the runtime, but the source receipt remains at $previous_receipt"
    remove_owned_path "$staging_root"
    return 0
  fi

  die "interrupted publication cannot be recovered automatically; inspect $fm_runtime, $receipt_file, $previous_runtime, and $previous_receipt"
}

publish_runtime_and_receipt() {
  local checkout="$1" staged_receipt="$2"
  local retired=false receipt_retired=false

  if [[ -e "$fm_runtime" || -L "$fm_runtime" ]]; then
    [[ -d "$fm_runtime" && ! -L "$fm_runtime" ]] \
      || die "unsafe installed runtime: $fm_runtime"
  fi
  if [[ -e "$previous_runtime" || -L "$previous_runtime" ]]; then
    [[ -d "$previous_runtime" && ! -L "$previous_runtime" ]] \
      || die "unsafe retired runtime: $previous_runtime"
  fi
  if [[ -e "$receipt_file" || -L "$receipt_file" ]]; then
    [[ -f "$receipt_file" && ! -L "$receipt_file" ]] \
      || die "unsafe source receipt: $receipt_file"
  fi
  if [[ -e "$previous_receipt" || -L "$previous_receipt" ]]; then
    [[ -f "$previous_receipt" && ! -L "$previous_receipt" ]] \
      || die "unsafe retired source receipt: $previous_receipt"
  fi

  if [[ -e "$previous_runtime" || -L "$previous_runtime" ]]; then
    if [[ -e "$fm_runtime" || -L "$fm_runtime" ]]; then
      remove_owned_path "$previous_runtime"
    else
      # The live runtime is gone and a retired one survives: restore it rather
      # than delete the only good copy.
      mv -- "$previous_runtime" "$fm_runtime" \
        || die "a previously installed runtime is preserved at $previous_runtime but could not be restored; move it to $fm_runtime by hand before retrying"
    fi
  fi
  if [[ -e "$previous_receipt" || -L "$previous_receipt" ]]; then
    if [[ -e "$receipt_file" || -L "$receipt_file" ]]; then
      remove_owned_path "$previous_receipt"
    else
      mv -- "$previous_receipt" "$receipt_file" \
        || die "a previously installed source receipt is preserved at $previous_receipt but could not be restored; move it to $receipt_file by hand before retrying"
    fi
  fi
  if [[ "$automatic_preparation" == true ]]; then
    automatic_publication_started=true
  fi
  if [[ -f "$receipt_file" && ! -L "$receipt_file" ]]; then
    mv -- "$receipt_file" "$previous_receipt" \
      || die 'could not retire the previous receipt; the runtime and receipt were left unchanged'
    receipt_retired=true
  fi
  if [[ -e "$fm_runtime" || -L "$fm_runtime" ]]; then
    if ! mv -- "$fm_runtime" "$previous_runtime"; then
      if [[ "$receipt_retired" == true ]] \
        && mv -- "$previous_receipt" "$receipt_file"; then
        die 'could not retire the previous runtime; the runtime and receipt were left unchanged'
      fi
      die "could not retire the previous runtime, and the previous receipt could not be restored automatically; the runtime remains at $fm_runtime and the receipt is preserved at $previous_receipt"
    fi
    retired=true
  fi

  if ! mv -- "$checkout" "$fm_runtime"; then
    rollback_publication "$retired" "$receipt_retired" 'the staged runtime'
  fi
  if ! mv -- "$staged_receipt" "$receipt_file"; then
    rm -rf -- "$fm_runtime" 2>/dev/null || true
    rollback_publication "$retired" "$receipt_retired" 'the staged receipt'
  fi

  remove_owned_path "$previous_runtime"
  remove_owned_path "$previous_receipt"
  remove_owned_path "$staging_root"
  automatic_publication_started=false
  automatic_staging_started=false
}

rollback_publication() {
  local retired="$1" receipt_retired="$2" what="$3" restored=true

  if [[ "$retired" == true ]]; then
    mv -- "$previous_runtime" "$fm_runtime" || restored=false
  fi
  if [[ "$receipt_retired" == true ]]; then
    mv -- "$previous_receipt" "$receipt_file" || restored=false
  fi
  if [[ "$restored" == true ]]; then
    die "could not publish $what; the previously installed runtime and receipt were restored"
  fi
  die "could not publish $what, and the previous state could not be restored automatically; it is preserved at $previous_runtime and $previous_receipt"
}

# Stages the receipt and prints its path. Publication is the caller's job, so
# runtime and receipt land together.
stage_receipt() {
  local commit="$1" repository="$2" overlay_commit="$3" staged

  make_owned_directory "$profile_root/receipts"
  if [[ -e "$receipt_file" || -L "$receipt_file" ]]; then
    [[ -f "$receipt_file" && ! -L "$receipt_file" ]] \
      || die "unsafe receipt: $receipt_file"
  fi
  staged="$(mktemp "$profile_root/receipts/.source.json.XXXXXX")" \
    || die 'could not stage the source receipt'
  jq -n \
    --arg profile "$profile_key" \
    --arg repository "$repository" \
    --arg commit "$commit" \
    --arg overlay "$overlay_commit" '
    {
      schemaVersion: 1,
      profile: $profile,
      repository: $repository,
      commit: $commit,
      overlay: $overlay
    }
  ' >"$staged" || die 'could not create the source receipt'
  chmod 0600 "$staged"
  printf '%s\n' "$staged"
}

# The receipt is evidence, so its whole schema is checked, not just the commit.
verify_receipt() {
  local commit="$1" repository="$2" overlay_commit="$3"

  [[ -f "$receipt_file" && -r "$receipt_file" && ! -L "$receipt_file" ]] \
    || die "the source receipt is missing; run fmx repair $profile_key"
  jq -e \
    --arg profile "$profile_key" \
    --arg repository "$repository" \
    --arg commit "$commit" \
    --arg overlay "$overlay_commit" '
    type == "object"
    and keys == ["commit", "overlay", "profile", "repository", "schemaVersion"]
    and .schemaVersion == 1
    and .profile == $profile
    and .repository == $repository
    and .commit == $commit
    and .overlay == $overlay
  ' "$receipt_file" >/dev/null 2>&1 \
    || die "the source receipt does not match the catalog pin schema; run fmx repair $profile_key"
}

installed_commit() {
  [[ -f "$receipt_file" && ! -L "$receipt_file" ]] || return 1
  jq -er '.commit' "$receipt_file" 2>/dev/null
}

tasks_axi_config_content() {
  cat <<'EOF'
backend = "markdown"

[markdown]
path = "data/backlog.md"
archive = "data/done-archive.md"
done_keep = 10
EOF
}

ensure_tasks_axi_config() {
  local config="$fm_home/.tasks.toml"
  local legacy_backlog="$fm_home/backlog.md"
  local managed_backlog="$fm_home/data/backlog.md"
  local staged

  [[ ! -L "$legacy_backlog" && ! -L "$managed_backlog" ]] \
    || die "unsafe Firstmate backlog path under $fm_home"
  if [[ -e "$legacy_backlog" ]]; then
    [[ -f "$legacy_backlog" ]] \
      || die "the legacy Firstmate backlog is not a regular file: $legacy_backlog"
    [[ ! -e "$managed_backlog" ]] \
      || die "both $legacy_backlog and $managed_backlog exist; merge them before running fmx repair $profile_key"
    mv -- "$legacy_backlog" "$managed_backlog" \
      || die "could not migrate the legacy Firstmate backlog to $managed_backlog"
  fi

  [[ ! -L "$config" ]] || die "unsafe managed tasks-axi config: $config"
  [[ ! -e "$config" || -f "$config" ]] \
    || die "unsafe managed tasks-axi config: $config"
  staged="$(mktemp "$fm_home/.tasks.toml.XXXXXX")" \
    || die "could not stage the managed tasks-axi config: $config"
  tasks_axi_config_content >"$staged"
  chmod 0600 "$staged"
  mv -f "$staged" "$config"
}

verify_tasks_axi_config() {
  local config="$fm_home/.tasks.toml"
  local legacy_backlog="$fm_home/backlog.md"

  [[ ! -e "$legacy_backlog" && ! -L "$legacy_backlog" ]] \
    || die "a legacy Firstmate backlog remains at $legacy_backlog; run fmx repair $profile_key"
  [[ -f "$config" && -r "$config" && ! -L "$config" ]] \
    || die "the managed tasks-axi config is missing: $config; run fmx repair $profile_key"
  cmp -s -- "$config" <(tasks_axi_config_content) \
    || die "the managed tasks-axi config differs: $config; run fmx repair $profile_key"
}

# Doctor and launch verify the complete identity marker, not just its presence.
managed_runtime_marker_content() {
  printf 'managed-by=%s\nprofile=%s\n' "$ownership_value" "$profile_key"
  if [[ "$instance_selector" != legacy ]]; then
    printf 'instance-id=%s\ntask-prefix=%s\n' "$instance_selector" "$task_id_prefix"
  fi
}

verify_managed_runtime_marker() {
  local path="$fm_home/$managed_runtime_marker"

  [[ -f "$path" && -r "$path" && ! -L "$path" ]] \
    || die "the managed-runtime marker is missing; run fmx repair $profile_key"
  cmp -s -- "$path" <(managed_runtime_marker_content) \
    || die "the managed-runtime marker content differs; run fmx repair $profile_key"
}

ensure_managed_home() {
  local component staged

  make_owned_directory "$fm_home"
  for component in data state config projects; do
    make_owned_directory "$fm_home/$component"
  done
  ensure_tasks_axi_config
  [[ ! -L "$fm_home/$managed_runtime_marker" ]] \
    || die "unsafe managed-runtime marker: $fm_home/$managed_runtime_marker"
  staged="$(mktemp "$fm_home/.fmx-managed.XXXXXX")" \
    || die 'could not stage the managed-runtime marker'
  managed_runtime_marker_content >"$staged"
  chmod 0600 "$staged"
  mv -f "$staged" "$fm_home/$managed_runtime_marker"
}

# v1 manages the tasks-axi root and exactly two worker-harness files in FM_HOME.
# The harness files must read exactly "claude", because the fmx worker boundary
# only wraps Claude launches. config/crew-dispatch.json can select a different
# harness per task, which would bypass that boundary entirely, so its mere
# presence fails closed.
readonly managed_harness_files=(crew-harness secondmate-harness)

crew_dispatch_path() {
  printf '%s/config/crew-dispatch.json\n' "$fm_home"
}

ensure_crew_harness_config() {
  local config="$fm_home/config" name path staged

  make_owned_directory "$config"
  for name in "${managed_harness_files[@]}"; do
    path="$config/$name"
    [[ ! -L "$path" ]] || die "unsafe managed Firstmate config: $path"
    [[ ! -e "$path" || -f "$path" ]] || die "unsafe managed Firstmate config: $path"
    staged="$(mktemp "$config/.$name.XXXXXX")" \
      || die "could not stage the managed Firstmate config: $path"
    printf '%s\n' "$managed_crew_harness" >"$staged"
    chmod 0600 "$staged"
    mv -f "$staged" "$path"
  done
}

verify_crew_harness_config() {
  local config="$fm_home/config" name path dispatch expected_bytes actual_bytes

  dispatch="$(crew_dispatch_path)"
  if [[ -e "$dispatch" || -L "$dispatch" ]]; then
    worker_controls config --offline >/dev/null \
      || die "invalid Claude-only crew dispatch rules: $dispatch"
  fi
  expected_bytes=$((${#managed_crew_harness} + 1))
  for name in "${managed_harness_files[@]}"; do
    path="$config/$name"
    [[ -f "$path" && -r "$path" && ! -L "$path" ]] \
      || die "the managed Firstmate worker harness file is missing: $path; run fmx repair $profile_key"
    actual_bytes="$(wc -c <"$path" | tr -d '[:space:]')"
    [[ "$actual_bytes" == "$expected_bytes" && "$(<"$path")" == "$managed_crew_harness" ]] \
      || die "the managed Firstmate worker harness file must contain exactly '$managed_crew_harness': $path; run fmx repair $profile_key"
  done
}

readonly worker_policy_max_bytes=16384

# The name of this profile's Trellage-owned policy source, empty when the
# profile has none.
worker_policy_source() {
  local name

  name="$(jq -r --arg name "$profile_key" '.profiles[$name].workerPolicy // ""' "$catalog")"
  [[ -n "$name" ]] || return 1
  printf '%s/%s\n' "$policy_source_root" "$name"
}

# The installed policy must be byte-identical to the Trellage-owned source and
# within the same fixed bound the pinned fm-brief.sh overlay enforces.
verify_worker_policy() {
  local source bytes

  [[ -n "$policy_file" ]] || return 0
  source="$(worker_policy_source)" \
    || die "the catalog no longer declares a worker policy for $profile_key"
  [[ -f "$source" && -r "$source" && ! -L "$source" ]] \
    || die "missing managed worker policy source: $source"
  [[ -f "$policy_file" && -r "$policy_file" && ! -L "$policy_file" ]] \
    || die "the managed worker policy is missing; run fmx repair $profile_key"
  bytes="$(wc -c <"$policy_file" | tr -d '[:space:]')"
  [[ "$bytes" -ge 1 && "$bytes" -le "$worker_policy_max_bytes" ]] \
    || die "the managed worker policy must be between 1 and $worker_policy_max_bytes bytes; run fmx repair $profile_key"
  cmp -s -- "$source" "$policy_file" \
    || die "the managed worker policy differs from the Trellage-owned source; run fmx repair $profile_key"
}

ensure_worker_policy() {
  local source name staged

  name="$(jq -r --arg name "$profile_key" '.profiles[$name].workerPolicy // ""' "$catalog")"
  if [[ -z "$name" ]]; then
    return 0
  fi
  source="$policy_source_root/$name"
  [[ -f "$source" && -r "$source" && ! -L "$source" ]] \
    || die "missing managed worker policy source: $source"
  [[ "$(wc -c <"$source" | tr -d '[:space:]')" -le "$worker_policy_max_bytes" ]] \
    || die "the managed worker policy source exceeds $worker_policy_max_bytes bytes: $source"
  make_owned_directory "$profile_root/policy"
  [[ ! -L "$policy_file" ]] || die "unsafe managed worker policy: $policy_file"
  staged="$(mktemp "$profile_root/policy/.worker-policy.md.XXXXXX")" \
    || die 'could not stage the managed worker policy'
  cat -- "$source" >"$staged" || die 'could not stage the managed worker policy'
  chmod 0600 "$staged"
  mv -f "$staged" "$policy_file"
}

# ---------------------------------------------------------------------------
# Host prerequisites.
# ---------------------------------------------------------------------------

require_native_claude() {
  [[ -f "$native_claude" && -x "$native_claude" && ! -L "$native_claude" ]] \
    || die "missing shared native Claude helper: $native_claude"
}

require_prerequisite_helper() {
  [[ -f "$prerequisite_helper" && -x "$prerequisite_helper" \
    && ! -L "$prerequisite_helper" ]] \
    || die "missing fmx prerequisite helper: $prerequisite_helper"
  [[ -f "$prerequisite_manifest" && -r "$prerequisite_manifest" \
    && ! -L "$prerequisite_manifest" ]] \
    || die "missing fmx prerequisite manifest: $prerequisite_manifest"
}

# The shared helper resolves the session bridge and the floating-skills runtime
# from the caller's installed runtime root, and reports diagnostics under the
# caller's launcher identity.
native_claude() {
  TRELLAGE_CLAUDE_LAUNCHER_NAME="$launcher_name" \
    TRELLAGE_CLAUDE_RUNTIME_ROOT="$runtime_root" \
    "$native_claude" "$@"
}

require_worker_launcher() {
  [[ -f "$worker_launcher" && -x "$worker_launcher" && ! -L "$worker_launcher" ]] \
    || die "missing fmx worker helper: $worker_launcher"
  [[ -f "$controls_helper" && ! -L "$controls_helper" ]] \
    || die "missing fmx worker admission helper: $controls_helper"
  [[ -f "$control_helper" && ! -L "$control_helper" ]] \
    || die "missing fmx control helper: $control_helper"
}

worker_controls() {
  FMX_PROFILE="$profile_key" FMX_PROFILE_ROOT="$profile_root" \
    FMX_TASK_ID_PREFIX="$task_id_prefix" FMX_INSTANCE_ID="$instance_id" FM_HOME="$fm_home" \
    FM_STATE_OVERRIDE= FM_DATA_OVERRIDE= FM_CONFIG_OVERRIDE= FM_PROJECTS_OVERRIDE= \
    python3 "$controls_helper" "$@"
}

ensure_fleet_identity() {
  python3 "$control_helper" "${1-init}" "$profile_root" "$profile_key" \
    || die 'could not initialize the owned fleet identity'
}

require_complete_publication() {
  local path
  for path in "$previous_runtime" "$previous_receipt" "$staging_root"; do
    [[ ! -e "$path" && ! -L "$path" ]] \
      || die "an interrupted runtime publication needs idle repair: $path"
  done
}

verify_profile_runtime() {
  local commit repository overlay_commit
  require_owned_profile
  require_complete_publication
  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  overlay_commit="$(catalog_overlay)"
  verify_receipt "$commit" "$repository" "$overlay_commit"
  verify_runtime_overlay "$overlay_commit"
  verify_runtime_checkout "$commit"
  verify_managed_runtime_marker
  verify_tasks_axi_config
  verify_crew_harness_config
  verify_worker_policy
}

# The host gh configuration is the only accepted GitHub identity. Token
# environment variables are never forwarded into Firstmate or its workers, so
# they are removed from the probe too.
# Resolved the way gh itself resolves it: GH_CONFIG_DIR, then
# XDG_CONFIG_HOME/gh, then $HOME/.config/gh. The result is validated and
# absolute so it can be handed to a pane that inherits nothing.
gh_config_directory() {
  local directory

  if [[ -n "${GH_CONFIG_DIR-}" ]]; then
    directory="$GH_CONFIG_DIR"
  elif [[ -n "${XDG_CONFIG_HOME-}" ]]; then
    directory="$XDG_CONFIG_HOME/gh"
  else
    directory="$HOME/.config/gh"
  fi
  [[ "$directory" == /* ]] \
    || die "the GitHub CLI configuration directory must be absolute: $directory"
  [[ -d "$directory" && ! -L "$directory" ]] \
    || die "the GitHub CLI configuration directory is missing or unsafe: $directory (run gh auth login --hostname $managed_gh_host)"
  canonical_directory "$directory" \
    || die "cannot resolve the GitHub CLI configuration directory: $directory"
}

gh_config_path() {
  printf '%s/hosts.yml\n' "$(gh_config_directory)"
}

require_gh_config() {
  local path

  path="$(gh_config_path)"
  [[ -f "$path" && -r "$path" && ! -L "$path" ]] \
    || die "GitHub CLI host configuration is missing: $path (run gh auth login; GH_TOKEN and GITHUB_TOKEN are not forwarded)"
  grep -Eq "^${managed_gh_host//./\\.}:[[:space:]]*\$" "$path" \
    || die "GitHub CLI host configuration has no $managed_gh_host entry: $path (run gh auth login --hostname $managed_gh_host)"
}

# Explicit and daemon-independent: the configuration directory is resolved here
# and passed on, never inherited from a tmux or Herdr server environment.
require_gh_authenticated() {
  require_command gh
  require_gh_config
  env -u GH_TOKEN -u GITHUB_TOKEN -u COPILOT_GITHUB_TOKEN \
    -u COPILOT_PROXY_GITHUB_TOKEN \
    -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u COPILOT_TOKEN \
    GH_CONFIG_DIR="$(gh_config_directory)" \
    gh auth status --hostname "$managed_gh_host" >/dev/null 2>&1 \
    || die "gh is not authenticated for $managed_gh_host through $(gh_config_path) (run gh auth login --hostname $managed_gh_host; GH_TOKEN and GITHUB_TOKEN are not forwarded)"
}

# Herdr is selected only from a real Herdr pane identity. Everything else
# selects tmux; the source-of-truth bootstrap check below reports a missing
# backend before a session lock or captain process exists.
resolve_backend() {
  if [[ "${HERDR_ENV-}" == 1 && -n "${HERDR_PANE_ID-}" ]]; then
    printf 'herdr\n'
    return
  fi
  printf 'tmux\n'
}

is_managed_prerequisite() {
  case " $managed_prerequisite_tools " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

append_missing_tool() {
  local destination_name="$1" tool="$2" current

  case "$destination_name" in
    managed)
      current="$prerequisite_managed_missing"
      case " $current " in
        *" $tool "*) ;;
        *) prerequisite_managed_missing="${current:+$current }$tool" ;;
      esac
      ;;
    host)
      current="$prerequisite_host_missing"
      case " $current " in
        *" $tool "*) ;;
        *) prerequisite_host_missing="${current:+$current }$tool" ;;
      esac
      ;;
    *)
      die "unknown prerequisite destination: $destination_name" ;;
  esac
}

managed_prerequisite_path() {
  require_prerequisite_helper
  require_native_claude
  native_claude exec-clean -- "$prerequisite_helper" path
}

effective_prerequisite_path() {
  local managed_path='' status=0

  managed_path="$(managed_prerequisite_path 2>&1)" || status=$?
  case "$status" in
    0) printf '%s:%s\n' "$managed_path" "$PATH" ;;
    3) printf '%s\n' "$PATH" ;;
    *) printf '%s\n' "$managed_path" >&2; return "$status" ;;
  esac
}

detect_firstmate_prerequisites() {
  local backend="$1" effective_path="$2" line tool status=0

  prerequisite_managed_missing=''
  prerequisite_host_missing=''
  prerequisite_diagnostics=''
  [[ -f "$fm_runtime/bin/fm-bootstrap.sh" \
    && -x "$fm_runtime/bin/fm-bootstrap.sh" \
    && ! -L "$fm_runtime/bin/fm-bootstrap.sh" ]] \
    || die "installed runtime has no safe prerequisite detector; run fmx repair $profile_key"
  prerequisite_diagnostics="$(
    env -u GH_TOKEN -u GITHUB_TOKEN -u COPILOT_GITHUB_TOKEN \
      -u COPILOT_PROXY_GITHUB_TOKEN \
      -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN -u COPILOT_TOKEN \
      -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN -u OPENAI_API_KEY \
      HOME="$HOME" \
      PATH="$effective_path" \
      FM_HOME="$fm_home" \
      FM_ROOT_OVERRIDE="$fm_runtime" \
      FM_BACKEND="$backend" \
      FM_BOOTSTRAP_DETECT_ONLY=1 \
      FM_BOOTSTRAP_NETWORK=skip \
      "$fm_runtime/bin/fm-bootstrap.sh" 2>&1
  )" || status=$?
  [[ "$status" -eq 0 ]] || {
    prerequisite_diagnostics="Firstmate prerequisite detection failed with status $status"
    printf '%s\n' "$prerequisite_diagnostics" >&2
    return 1
  }
  for tool in python3 perl seq; do
    if ! PATH="$effective_path" command -v "$tool" >/dev/null 2>&1; then
      append_missing_tool host "$tool"
      prerequisite_diagnostics+="${prerequisite_diagnostics:+$'\n'}MISSING: $tool (host runtime dependency)"
    fi
  done

  while IFS= read -r line; do
    case "$line" in
      'MISSING: '*)
        tool="${line#MISSING: }"
        tool="${tool%% *}"
        if is_managed_prerequisite "$tool"; then
          append_missing_tool managed "$tool"
        else
          append_missing_tool host "$tool"
        fi
        ;;
      'MISSING_MANUAL: '*)
        tool="${line#MISSING_MANUAL: }"
        tool="${tool%% *}"
        append_missing_tool host "$tool"
        ;;
      'BACKEND_INVALID: '*)
        append_missing_tool host backend
        ;;
    esac
  done <<<"$prerequisite_diagnostics"
}

fleet_tools_report() {
  local backend="$1" effective_path description ready=false

  prerequisite_managed_missing=''
  prerequisite_host_missing=''
  if ! effective_path="$(effective_prerequisite_path 2>&1)"; then
    description="Managed prerequisite resolver failed: $effective_path"
  elif ! detect_firstmate_prerequisites "$backend" "$effective_path" >/dev/null 2>&1; then
    description="Firstmate tool check failed: $prerequisite_diagnostics"
  elif [[ -n "$prerequisite_managed_missing" || -n "$prerequisite_host_missing" ]]; then
    description="Missing Firstmate tools:"
    [[ -z "$prerequisite_managed_missing" ]] || description+=" $prerequisite_managed_missing (managed; installation needs consent)."
    [[ -z "$prerequisite_host_missing" ]] || description+=" $prerequisite_host_missing (host requirements)."
  else
    description='All required Firstmate tools are available; no installation was needed'
    ready=true
  fi
  python3 "$control_helper" tool-report "$ready" "$description" \
    "$prerequisite_managed_missing" "$prerequisite_host_missing"
}

require_prerequisite_install_host() {
  local minimum_node node_major=''

  for tool in npm curl; do
    command -v "$tool" >/dev/null 2>&1 \
      || append_missing_tool host "$tool"
  done
  if ! command -v sha256sum >/dev/null 2>&1 \
    && ! command -v shasum >/dev/null 2>&1; then
    append_missing_tool host sha256
  fi
  minimum_node="$(jq -r '.npm.minimumNodeMajor' "$prerequisite_manifest")"
  if command -v node >/dev/null 2>&1; then
    node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || printf '')"
    if [[ ! "$node_major" =~ ^[0-9]+$ || "$node_major" -lt "$minimum_node" ]]; then
      append_missing_tool host "node-$minimum_node+"
    fi
  fi
}

print_prerequisite_diagnostics() {
  local line

  while IFS= read -r line; do
    case "$line" in
      'MISSING: '* | 'MISSING_MANUAL: '* | 'BACKEND_INVALID: '*)
        printf '  %s\n' "$line" >&2 ;;
    esac
  done <<<"$prerequisite_diagnostics"
}

confirm_prerequisite_install() {
  local plan="$1" destination answer='' tool version
  destination="$(jq -er '.destination' <<<"$plan")"

  printf '\nFirstmate needs managed tools before it can dispatch workers:\n' >&2
  for tool in $prerequisite_managed_missing; do
    printf '  - %s\n' "$tool" >&2
  done
  printf '\nTrellage can install a complete version-locked toolchain.\n' >&2
  printf 'Install location:\n  %s\n' "$destination" >&2
  printf 'Installed tools:\n' >&2
  while IFS=$'\t' read -r tool version; do
    printf '  - %s %s\n' "$tool" "$version" >&2
  done < <(
    jq -r '.tools[] | [.name, .version] | @tsv' <<<"$plan"
  )
  cat >&2 <<EOF
Network sources:
  - the npm registry configured on this host
  - locked, checksum-verified GitHub release assets for no-mistakes and treehouse
Other state:
  - no-mistakes can create daemon state under $HOME/.no-mistakes
  - no global npm packages or global agent hooks will be installed
EOF
  jq -r '.sources[], .statePaths[] | "  - " + .' <<<"$plan" >&2
  printf '\nInstall these prerequisites now? [y/N] ' >&2
  IFS= read -r answer || answer=''
  case "$answer" in
    y | Y | yes | YES | Yes) return 0 ;;
    *) return 1 ;;
  esac
}

install_managed_prerequisites() {
  local worker_bash="$1"
  shift

  native_claude exec-clean \
    --interpreter "$worker_bash" \
    -- "$prerequisite_helper" install "$@"
}

ensure_launch_prerequisites() {
  local backend="$1" worker_bash="$2" plan artifact source_revision

  require_prerequisite_helper
  prerequisite_path="$(effective_prerequisite_path)"
  detect_firstmate_prerequisites "$backend" "$prerequisite_path" \
    || die "$prerequisite_diagnostics"
  if [[ -n "$prerequisite_managed_missing" ]]; then
    require_prerequisite_install_host
    if [[ -n "$prerequisite_host_missing" ]]; then
      printf 'fmx: managed prerequisites cannot be installed until these host requirements are ready:\n' >&2
      print_prerequisite_diagnostics
      for tool in $prerequisite_host_missing; do
        case "$tool" in
          npm | curl | sha256 | node-*)
            printf '  MISSING_MANUAL: %s (required by the managed installer)\n' \
              "$tool" >&2 ;;
        esac
      done
      die 'install the host requirements above, then launch again'
    fi
    source_revision="$(catalog_commit)"
    artifact="$(native_claude exec-clean -- "$prerequisite_helper" identity)"
    plan="$(native_claude exec-clean -- "$prerequisite_helper" plan)"
    if ! confirm_prerequisite_install "$plan"; then
      die 'prerequisite installation declined; no prerequisite files were changed'
    fi
    install_managed_prerequisites "$worker_bash" --expected-identity "$artifact" \
      --expected-plan "$(jq -er '.identity' <<<"$plan")" --expected-source-revision "$source_revision"
    prerequisite_path="$(effective_prerequisite_path)"
    detect_firstmate_prerequisites "$backend" "$prerequisite_path" \
      || die "$prerequisite_diagnostics"
  fi
  if [[ -n "$prerequisite_managed_missing" || -n "$prerequisite_host_missing" ]]; then
    printf 'fmx: Firstmate prerequisites are still incomplete:\n' >&2
    print_prerequisite_diagnostics
    die 'Firstmate cannot dispatch workers until every required prerequisite is ready'
  fi
}

require_existing_prerequisites() {
  local backend="$1"
  prerequisite_path="$(effective_prerequisite_path)"
  detect_firstmate_prerequisites "$backend" "$prerequisite_path" \
    || die "$prerequisite_diagnostics"
  [[ -z "$prerequisite_managed_missing" && -z "$prerequisite_host_missing" ]] \
    || die 'recovery requires existing prerequisites; installation and repair are forbidden while workers are live'
}

report_doctor_prerequisites() {
  local backend effective_path

  require_prerequisite_helper
  backend="$(resolve_backend)"
  effective_path="$(effective_prerequisite_path)"
  detect_firstmate_prerequisites "$backend" "$effective_path" \
    || die "$prerequisite_diagnostics"
  if [[ -n "$prerequisite_managed_missing" || -n "$prerequisite_host_missing" ]]; then
    printf 'fmx doctor %s: fleet prerequisites incomplete; managed installation requires explicit consent\n' \
      "$profile_key" >&2
    if [[ -n "$prerequisite_managed_missing" ]]; then
      printf '  managed by fmx after consent: %s\n' \
        "$prerequisite_managed_missing" >&2
    fi
    if [[ -n "$prerequisite_host_missing" ]]; then
      printf '  host requirements: %s\n' "$prerequisite_host_missing" >&2
    fi
    return 1
  fi
}

# ---------------------------------------------------------------------------
# Commands.
# ---------------------------------------------------------------------------

profile_skill_roots() {
  local states task state

  states="$(worker_states require-safe)" || die "cannot inspect worker homes: $profile_key"
  printf '%s\n' "$captain_root"
  while read -r task state; do
    [[ -n "$task" ]] || continue
    [[ "$task" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "unsafe worker task id: $task"
    printf '%s/%s\n' "$worker_root" "$task"
  done <<<"$states"
}

skills_check_profile() {
  local roots root skills_check_pid
  require_native_claude
  require_owned_profile
  profile_is_set_up || die "profile is not set up; run fmx setup $profile_key"
  native_claude --help | grep -q 'skills-check' || die 'refresh the Native Claude runtime for skills-check'
  roots="$(profile_skill_roots)" || die "cannot inspect profile skill homes: $profile_key"
  while IFS= read -r root; do
    TRELLAGE_CLAUDE_LAUNCHER_NAME="$launcher_name" TRELLAGE_CLAUDE_RUNTIME_ROOT="$runtime_root" \
      "$native_claude" skills-check \
      --home "$root/claude" --marker "$root/$ownership_basename" \
      --marker-value "$ownership_value" &
    skills_check_pid=$!
    trap 'kill -TERM "$skills_check_pid" 2>/dev/null || :; wait "$skills_check_pid" || :; exit 143' INT TERM
    wait "$skills_check_pid" || die "could not check skills: $root/claude"
    trap - INT TERM
  done <<<"$roots"
}

skills_update_profile() {
  local roots root mode

  require_native_claude
  require_owned_profile
  profile_is_set_up || die "profile is not set up; run fmx setup $profile_key"
  acquire_mutation_lock 'skills-update'
  require_idle_fleet 'skills-update'
  roots="$(profile_skill_roots)" || die "cannot inspect profile skill homes: $profile_key"
  for mode in --check --sync; do
    while IFS= read -r root; do
      native_claude skills-update \
        --home "$root/claude" --marker "$root/$ownership_basename" \
        --marker-value "$ownership_value" --mode "$mode" \
        || die "could not update cached skills: $root/claude"
    done <<<"$roots"
  done
  printf '%s: skills updated from cache\n' "$profile_key"
}

setup_profile() {
  local commit repository overlay_commit checkout staged_receipt

  require_command jq
  require_command git
  require_command python3
  require_native_claude
  require_prerequisite_helper
  require_worker_launcher
  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  overlay_commit="$(catalog_overlay)"

  require_safe_profile_path
  profile_is_owned_or_empty \
    || die "refusing unrelated existing profile files: $profile_root"
  make_owned_directory "$profile_root"
  # Claim ownership before creating any managed file, so the lock directory the
  # next step writes is never mistaken for unrelated pre-existing state.
  write_marker "$profile_marker"
  acquire_mutation_lock 'setup'
  # Unconditional: a missing or unreadable receipt must never be a licence to
  # replace a runtime out from under a live captain or worker.
  require_idle_fleet 'setup'
  recover_interrupted_publication
  require_gh_authenticated
  prepare_profile_tree
  checkout="$(stage_pinned_source "$commit" "$repository" "$overlay_commit")"
  staged_receipt="$(stage_receipt "$commit" "$repository" "$overlay_commit")"
  publish_runtime_and_receipt "$checkout" "$staged_receipt"
  ensure_managed_home
  ensure_crew_harness_config
  ensure_worker_policy
  native_claude prepare \
    --home "$captain_home" \
    --marker "$captain_marker" \
    --marker-value "$ownership_value" \
    --bridge enabled \
    --profile "$profile_key" \
    || die "could not prepare the captain Claude home: $captain_home"
  ensure_fleet_identity
  printf 'fmx setup %s: ready (firstmate %s, %s)\n' \
    "$profile_key" "${commit:0:12}" "$model_id"
}

repair_profile() {
  require_command jq
  require_command git
  require_command python3
  require_native_claude
  require_worker_launcher
  require_owned_profile
  acquire_mutation_lock 'repair'
  require_idle_fleet 'repair'
  repair_profile_contents explicit
  printf 'fmx repair %s: restored (firstmate %s, %s)\n' \
    "$profile_key" "$(catalog_commit | cut -c 1-12)" "$model_id"
}

repair_profile_contents() {
  local mode="$1" commit repository overlay_commit checkout installed staged_receipt
  local core_ready=false identity_missing=false claude_ready=false

  [[ "$mutation_lock_held" == "$mutation_lock" ]] || die 'repair requires the owning mutation lock'
  if [[ "$mode" == automatic ]]; then
    if (verify_profile_runtime >/dev/null 2>&1) && profile_setup_directories_ready; then core_ready=true; fi
    [[ -e "$profile_root/receipts/instance.json" ]] || identity_missing=true
  fi
  if [[ "$core_ready" == false ]]; then
    recover_interrupted_publication
    commit="$(catalog_commit)"
    repository="$(catalog_repository)"
    overlay_commit="$(catalog_overlay)"
    prepare_profile_tree
    installed="$(installed_commit || printf '')"
    # Restaging needs the network. Everything else in repair is local.
    if [[ "$installed" != "$commit" ]] \
      || ! (verify_runtime_overlay "$overlay_commit") >/dev/null 2>&1 \
      || ! runtime_checkout_report "$commit" >/dev/null 2>&1; then
      require_gh_authenticated
      if [[ "$mode" == automatic ]]; then
        remove_owned_path "$staging_root"
        automatic_staging_started=true
        make_owned_directory "$staging_root"
        checkout="$(stage_pinned_source "$commit" "$repository" "$overlay_commit" true)"
      else
        checkout="$(stage_pinned_source "$commit" "$repository" "$overlay_commit")"
      fi
      staged_receipt="$(stage_receipt "$commit" "$repository" "$overlay_commit")"
      publish_runtime_and_receipt "$checkout" "$staged_receipt"
    elif [[ "$mode" == explicit ]] || ! (verify_receipt "$commit" "$repository" "$overlay_commit" >/dev/null 2>&1); then
      staged_receipt="$(stage_receipt "$commit" "$repository" "$overlay_commit")"
      mv -f "$staged_receipt" "$receipt_file" \
        || die 'could not refresh the source receipt'
    fi
    ensure_managed_home
    ensure_crew_harness_config
    ensure_worker_policy
    verify_receipt "$commit" "$repository" "$overlay_commit"
    verify_runtime_overlay "$overlay_commit"
    verify_runtime_checkout "$commit"
    remove_owned_path "$previous_runtime"
    remove_owned_path "$previous_receipt"
    remove_owned_path "$staging_root"
    if [[ "$mode" == automatic ]]; then
      advance_mutation_generation
      printf 'Restored the pinned Firstmate runtime and owned setup files.\n'
    fi
  fi
  if [[ "$mode" == automatic ]]; then
    if native_claude doctor --home "$captain_home" --marker "$captain_marker" \
      --marker-value "$ownership_value" --bridge enabled --profile "$profile_key" >/dev/null 2>&1 \
      && native_claude skills-update --mode --check --home "$captain_home" \
      --marker "$captain_marker" --marker-value "$ownership_value" >/dev/null 2>&1; then
      claude_ready=true
    fi
  fi
  if [[ "$claude_ready" == false ]]; then
    if [[ "$mode" == automatic ]]; then
      python3 "$control_helper" cached-skills "$profile_root" "$profile_key" \
        || die 'automatic Claude repair requires a safe existing skill cache; no skill tools were downloaded'
    fi
    native_claude prepare \
      --home "$captain_home" \
      --marker "$captain_marker" \
      --marker-value "$ownership_value" \
      --bridge enabled \
      --profile "$profile_key" \
      >&2 || die "could not repair the captain Claude home: $captain_home"
    if [[ "$mode" == automatic ]]; then
      advance_mutation_generation
      printf 'Restored the managed Claude configuration and skills.\n'
    fi
  fi
  if [[ "$mode" == automatic ]]; then
    ensure_fleet_identity init-automatic
    if [[ "$identity_missing" == true ]]; then
      advance_mutation_generation
      printf 'Initialized the owned fleet identity without granting setup or installation consent.\n'
    fi
  else
    ensure_fleet_identity
  fi
}

profile_setup_directories_ready() {
  local path
  for path in "$fm_home" "$fm_home/config" "$fm_home/state" "$fm_home/data" "$fm_home/projects" \
    "$captain_root" "$captain_home" "$worker_root" "$profile_root/receipts" "$profile_root/locks"; do
    [[ -d "$path" && ! -L "$path" ]] || return 1
  done
  [[ -f "$captain_marker" && ! -L "$captain_marker" \
    && "$(<"$captain_marker")" == "$ownership_value" ]]
}

cleanup_automatic_preparation() {
  [[ "$mutation_lock_held" == "$mutation_lock" ]] || return 0
  if [[ "$automatic_publication_started" == true ]] \
    && ! (recover_interrupted_publication) >/dev/null 2>&1; then
    printf 'fmx prepare: owned runtime publication needs inspection before another repair\n' >&2
  fi
  if [[ "$automatic_staging_started" == true ]] \
    && ! (remove_owned_path "$staging_root") >/dev/null 2>&1; then
    printf 'fmx prepare: owned runtime staging needs inspection before another repair\n' >&2
  fi
  release_mutation_lock
}

verify_preparation_expectations() {
  local expected_source="$1" expected_lock="$2" approved="${3-}" actual_lock plan

  validate_catalog
  [[ "$(catalog_commit)" == "$expected_source" ]] \
    || die 'Firstmate source revision changed; refresh the profile catalog before preparation'
  actual_lock="$(native_claude exec-clean -- "$prerequisite_helper" identity)"
  [[ "$actual_lock" == "$expected_lock" ]] \
    || die 'prerequisite plan changed: the artifact lock differs; refresh preparation'
  if [[ -n "$approved" ]]; then
    plan="$(native_claude exec-clean -- "$prerequisite_helper" plan)"
    [[ "$(jq -er '.identity' <<<"$plan")" == "$approved" ]] \
      || die 'prerequisite installation plan changed; review the current destination and sources'
  fi
}

prepare_owned_profile() {
  local expected_source="$1" expected_lock="$2" approved="$3" repair_cache="$4" worker_bash

  [[ "$expected_source" =~ ^[0-9a-f]{40}$ && "$expected_lock" =~ ^[0-9a-f]{64}$ ]] \
    || die 'invalid preparation expectations'
  [[ -z "$approved" || "$approved" =~ ^[0-9a-f]{64}$ ]] \
    || die 'invalid approved installation plan identity'
  [[ "$repair_cache" == true || "$repair_cache" == false ]] || die 'invalid cache repair request'
  require_native_claude
  require_worker_launcher
  require_prerequisite_helper
  require_owned_profile
  verify_preparation_expectations "$expected_source" "$expected_lock" "$approved"
  python3 "$control_helper" prepare-safe "$profile_root" "$profile_key" \
    || die 'automatic preparation refused unsafe profile state'
  require_idle_fleet 'prepare'
  acquire_mutation_lock 'prepare'
  verify_preparation_expectations "$expected_source" "$expected_lock" "$approved"
  require_idle_fleet 'prepare'
  python3 "$control_helper" prepare-safe "$profile_root" "$profile_key" \
    || die 'automatic preparation refused unsafe profile state'
  worker_controls fleet --offline >/dev/null \
    || die 'automatic preparation refused unsafe worker controls'
  automatic_preparation=true
  trap cleanup_automatic_preparation EXIT
  repair_profile_contents automatic
  if [[ "$repair_cache" == true ]]; then
    verify_preparation_expectations "$expected_source" "$expected_lock" "$approved"
    native_claude exec-clean -- "$prerequisite_helper" repair-cache \
      --expected-identity "$expected_lock" --expected-source-revision "$expected_source" >&2
    printf 'Restored the existing verified prerequisite cache without downloads.\n'
  fi
  if [[ -n "$approved" ]]; then
    verify_preparation_expectations "$expected_source" "$expected_lock" "$approved"
    worker_bash="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$BASH")"
    install_managed_prerequisites "$worker_bash" \
      --expected-identity "$expected_lock" --expected-plan "$approved" \
      --expected-source-revision "$expected_source" >&2
    printf 'Verified the approved managed prerequisite toolchain.\n'
  fi
}

doctor_profile() {
  local commit repository overlay_commit installed

  require_command jq
  require_command git
  require_command python3
  require_native_claude
  require_worker_launcher
  require_owned_profile
  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  overlay_commit="$(catalog_overlay)"
  installed="$(installed_commit)" \
    || die "profile is not set up; run fmx setup $profile_key"
  [[ "$installed" == "$commit" ]] \
    || die "installed Firstmate commit $installed does not match the catalog pin $commit; run fmx update $profile_key"
  verify_receipt "$commit" "$repository" "$overlay_commit"
  [[ -d "$fm_runtime" && ! -L "$fm_runtime" ]] \
    || die "installed runtime is missing; run fmx repair $profile_key"
  [[ -f "$fm_runtime/bin/fm-spawn.sh" ]] \
    || die "installed runtime is incomplete; run fmx repair $profile_key"
  verify_runtime_overlay "$overlay_commit"
  verify_runtime_checkout "$commit"
  verify_managed_runtime_marker
  verify_tasks_axi_config
  verify_crew_harness_config
  verify_worker_policy
  require_gh_authenticated
  resolve_backend >/dev/null
  native_claude doctor \
    --home "$captain_home" \
    --marker "$captain_marker" \
    --marker-value "$ownership_value" \
    --bridge enabled \
    --profile "$profile_key" \
    || die "the captain Claude home is unhealthy; run fmx repair $profile_key"
  report_doctor_prerequisites
  printf 'fmx doctor %s: OK (firstmate %s, %s)\n' \
    "$profile_key" "${commit:0:12}" "$model_id"
}

doctor_profile_with_lifecycle_gate() {
  require_owned_profile
  acquire_mutation_lock 'doctor'
  if ! fleet_is_active; then
    recover_interrupted_publication
  fi
  doctor_profile
}

check_update() {
  local commit installed before after

  commit="$(catalog_commit)"
  before="$(mutation_generation_value)"
  mutation_reader_blocked \
    && die "update --check refused: a mutation is in progress for $profile_key"
  installed="$(installed_commit || printf '')"
  after="$(mutation_generation_value)"
  if [[ "$before" != "$after" ]] || mutation_reader_blocked; then
    die "update --check could not get a stable snapshot for $profile_key; retry after the current mutation"
  fi
  if [[ -z "$installed" ]]; then
    printf 'fmx update: %s is not set up (catalog pin %s)\n' "$profile_key" "${commit:0:12}"
    return
  fi
  if [[ "$installed" == "$commit" ]]; then
    printf 'fmx update: %s is current (%s)\n' "$profile_key" "${commit:0:12}"
  else
    printf 'fmx update: %s is stale (installed %s, catalog pin %s)\n' \
      "$profile_key" "${installed:0:12}" "${commit:0:12}"
  fi
}

print_harness_version_json() {
  local commit installed before after

  commit="$(catalog_commit)"
  before="$(mutation_generation_value)"
  mutation_reader_blocked \
    && die "harness-version refused: a mutation is in progress for $profile_key"
  installed="$(installed_commit || printf '')"
  after="$(mutation_generation_value)"
  if [[ "$before" != "$after" ]] || mutation_reader_blocked; then
    die "harness-version could not get a stable snapshot for $profile_key; retry after the current mutation"
  fi
  jq -cn \
    --arg installed "$installed" \
    --arg latest "$commit" '{
      schemaVersion: 1,
      launcher: "fmx",
      harness: "firstmate",
      installed: ($installed | if length > 0 then . else null end),
      latest: $latest,
      latestKnown: true
    }'
}

update_profile() {
  local commit repository overlay_commit installed checkout staged_receipt

  require_command jq
  require_command git
  require_command python3
  require_native_claude
  require_worker_launcher
  require_owned_profile
  acquire_mutation_lock 'update'
  require_idle_fleet 'update'
  recover_interrupted_publication
  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  overlay_commit="$(catalog_overlay)"
  installed="$(installed_commit)" \
    || die "profile is not set up; run fmx setup $profile_key"
  if [[ "$installed" == "$commit" ]] \
    && python3 "$overlay_tool" \
      --manifest "$(overlay_directory "$overlay_commit")/manifest.json" \
      --root "$fm_runtime" \
      --commit "$overlay_commit" \
      --verify-only >/dev/null 2>&1 \
    && runtime_checkout_report "$commit" >/dev/null 2>&1; then
    printf 'fmx update: %s is current (%s)\n' "$profile_key" "${commit:0:12}"
    return
  fi
  require_gh_authenticated
  checkout="$(stage_pinned_source "$commit" "$repository" "$overlay_commit")"
  staged_receipt="$(stage_receipt "$commit" "$repository" "$overlay_commit")"
  publish_runtime_and_receipt "$checkout" "$staged_receipt"
  ensure_managed_home
  ensure_crew_harness_config
  ensure_worker_policy
  printf 'fmx update: %s %s -> %s installed\n' \
    "$profile_key" "${installed:0:12}" "${commit:0:12}"
}

fleet_readiness_json() {
  local permitted_parent="${1-}" runtime=missing identity=null backend=null supervisor=stopped
  local pid=null session=none workers='[]' active_workers=0 consent=true tools=false
  local claude=false github=false rules=false skills=false backend_ready=false prerequisites
  local commit reason start=false recover=false submit=false current_mutation tools_report
  local tools_description='Not checked: the owned fleet runtime is not ready'

  commit="$(catalog_commit)"
  if ! (require_safe_managed_paths >/dev/null 2>&1); then
    runtime=unsafe
    supervisor=unsafe
  elif [[ -d "$profile_root" ]]; then
    session="$(session_state)"
    case "$session" in
      active) supervisor=running; pid="$(read_pid_file "$session_lock/pid")" ;;
      stale) supervisor=stale; pid="$(read_pid_file "$session_lock/pid")" ;;
      incomplete | unowned) supervisor=unsafe ;;
    esac
    workers="$(worker_states | jq -Rn '[inputs | split(" ") | {task:.[0],state:.[1]}]')"
    active_workers="$(jq '[.[] | select(.state == "active")] | length' <<<"$workers")"
    current_mutation="$(mutation_state)"
    if [[ -n "$permitted_parent" && "$current_mutation" == active \
      && "$(read_pid_file "$mutation_lock/pid")" == "$permitted_parent" ]]; then
      case "$(<"$mutation_lock/action")" in submit | receipt) current_mutation=none ;; esac
    fi
    if [[ "$current_mutation" == active || "$current_mutation" == incomplete \
      || "$current_mutation" == unowned ]]; then
      runtime=busy
    elif runtime_installation_busy; then
      runtime=busy
    elif ! (require_owned_profile >/dev/null 2>&1); then
      runtime=unsafe
    elif profile_is_set_up; then
      runtime=drift
      if (verify_profile_runtime >/dev/null 2>&1); then runtime=ready; fi
    fi
    if [[ "$supervisor" == unsafe ]] || jq -e 'any(.[]; .state == "unsafe")' <<<"$workers" >/dev/null; then
      runtime=unsafe
    fi
    identity="$(python3 "$control_helper" identity "$profile_root" "$profile_key" "$commit" 2>/dev/null || printf 'null')"
    if [[ "$runtime" == ready && "$identity" == null ]]; then runtime=unsafe; fi
    if [[ "$runtime" == ready ]] && ! worker_controls fleet --offline >/dev/null 2>&1; then
      runtime=unsafe
    fi
    if python3 "$control_helper" consent "$profile_root" "$profile_key" >/dev/null 2>&1; then consent=false; fi
  fi

  if [[ "$session" == active || "$session" == stale ]]; then
    backend="$(<"$session_lock/backend")"
  elif [[ "$supervisor" != unsafe ]]; then
    backend="$(resolve_backend)"
  fi
  if [[ "$runtime" == ready ]]; then
    (require_gh_authenticated >/dev/null 2>&1) && github=true
    if native_claude doctor --home "$captain_home" --marker "$captain_marker" \
      --marker-value "$ownership_value" --bridge enabled --profile "$profile_key" >/dev/null 2>&1; then
      claude=true
    fi
    if worker_controls fleet >/dev/null 2>&1; then rules=true; fi
    if native_claude skills-update --mode --check --home "$captain_home" \
      --marker "$captain_marker" --marker-value "$ownership_value" >/dev/null 2>&1; then
      skills=true
    fi
    tools_report="$(fleet_tools_report "$backend")"
    tools="$(jq -r '.ready' <<<"$tools_report")"
    tools_description="$(jq -r '.description' <<<"$tools_report")"
    if [[ "$backend" == tmux ]] && command -v tmux >/dev/null 2>&1; then backend_ready=true; fi
    if [[ "$backend" == herdr ]] && command -v herdr >/dev/null 2>&1; then
      if [[ "$supervisor" == running || "$(resolve_backend)" == herdr ]]; then backend_ready=true; fi
    fi
  fi
  prerequisites="$(jq -cn --argjson tools "$tools" --argjson claude "$claude" \
    --argjson github "$github" --argjson rules "$rules" --argjson skills "$skills" \
    --argjson backend "$backend_ready" --arg toolsDescription "$tools_description" \
    --arg runtime "$runtime" '
    def description($ready; $ok; $failed):
      if $ready then $ok
      elif $runtime != "ready" then "Not checked: the owned fleet runtime is " + $runtime
      else $failed end;
    [
      {id:"fleet-tools",ready:$tools,description:$toolsDescription},
      {id:"claude",ready:$claude,description:description($claude;"Owned Claude configuration and shared proxy";"Claude configuration or shared proxy check failed")},
      {id:"github",ready:$github,description:description($github;"File-backed GitHub authentication";"File-backed GitHub authentication check failed; authentication was not changed")},
      {id:"worker-controls",ready:$rules,description:description($rules;"Claude-only dispatch controls and available models";"Claude worker controls or available model check failed")},
      {id:"skills",ready:$skills,description:description($skills;"Existing shared skill cache; no fetch or refresh";"Managed skills or the shared skill cache are missing or unsafe")},
      {id:"backend",ready:$backend,description:description($backend;"The selected tmux or real Herdr backend";"The selected tmux or Herdr backend is unavailable")}
    ]')"
  reason="runtime is $runtime"
  if [[ "$runtime" == ready && "$identity" != null && "$supervisor" != unsafe ]]; then
    submit=true
    reason='ready'
    if [[ "$consent" == true ]]; then
      reason='explicit idle setup or repair consent is required'
    elif [[ "$tools" != true || "$claude" != true || "$github" != true \
      || "$rules" != true || "$skills" != true || "$backend_ready" != true ]]; then
      reason='existing tools, authentication, worker controls, or backend are not ready'
    elif [[ "$supervisor" == running ]]; then
      reason='the supervisor is already running'
    elif [[ "$supervisor" == stale ]]; then
      recover=true
      reason='a stale owned supervisor requires recovery'
    elif [[ "$active_workers" -gt 0 ]]; then
      reason='live workers have no stale owned supervisor lock; inspect ownership'
    else
      start=true
    fi
  fi
  jq -cn --argjson identity "$identity" --arg runtime "$runtime" --arg backend "$backend" \
    --arg supervisor "$supervisor" --argjson pid "$pid" --argjson count "$active_workers" \
    --argjson prerequisites "$prerequisites" --argjson consent "$consent" \
    --argjson start "$start" --argjson recover "$recover" --argjson submit "$submit" --arg reason "$reason" '
    def permission($allowed): {allowed:$allowed,reason:(if $allowed then null else $reason end)};
    {schemaVersion:1,identity:$identity,runtime:$runtime,
     backend:(if $backend == "null" then null else $backend end),
     supervisor:{state:$supervisor,pid:$pid},activeWorkers:$count,
     prerequisites:$prerequisites,consentRequired:$consent,
     actions:{start:permission($start),recover:permission($recover),submit:permission($submit)}}
  '
}

inventory_json() {
  local readiness="$1" fleet="$2" commit repository installed workers session overlay mutation

  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  if ! (require_safe_managed_paths >/dev/null 2>&1); then
    installed=''
    session=unowned
    mutation=unowned
    overlay="$(overlay_evidence_json static)"
    workers='[]'
  else
    installed="$(installed_commit || printf '')"
    session="$(session_state)"
    mutation="$(mutation_state)"
    overlay="$(overlay_evidence_json)"
    workers="$(worker_states | jq -Rn '
      [inputs | select(length > 0) | split(" ") | {task: .[0], state: .[1]}]
    ')"
  fi
  jq -cn \
    --arg profile "$profile_key" \
    --arg readiness "$readiness" \
    --arg session "$session" \
    --arg mutation "$mutation" \
    --arg repository "$repository" \
    --arg pinned "$commit" \
    --arg installed "$installed" \
    --argjson overlay "$overlay" \
    --argjson workers "$workers" \
    --argjson fleet "$fleet" '
    {
      schemaVersion: 1,
      launcher: "fmx",
      harness: "firstmate",
      profile: $profile,
      readiness: $readiness,
      fleet: $fleet,
      source: {
        repository: $repository,
        pinnedCommit: $pinned,
        installedCommit: (if $installed == "" then null else $installed end),
        commitMatchesPin: ($installed != "" and $installed == $pinned)
      },
      overlay: $overlay,
      session: $session,
      mutation: $mutation,
      workers: $workers,
      plugins: [],
      skills: {packageCount: null, visibleCount: null},
      mcps: []
    }
  '
}

inventory_profile() {
  local attempt before after readiness output fleet

  if ! (require_safe_managed_paths >/dev/null 2>&1); then
    fleet="$(fleet_readiness_json)"
    inventory_json unhealthy "$fleet"
    return
  fi
  for attempt in 1 2 3; do
    before="$(mutation_generation_value 2>/dev/null || printf unsafe)"
    fleet="$(fleet_readiness_json)"
    if [[ "$(jq -r '.runtime' <<<"$fleet")" == busy ]] || profile_is_busy; then
      readiness='busy'
    elif [[ "$(jq -r '.runtime' <<<"$fleet")" == missing ]]; then
      readiness='not-setup'
    elif jq -e '.runtime == "ready" and (.prerequisites | all(.ready)) and (.consentRequired | not)' <<<"$fleet" >/dev/null; then
      readiness='healthy'
    else
      readiness='unhealthy'
    fi
    if ! output="$(inventory_json "$readiness" "$fleet")"; then
      output=''
    fi
    after="$(mutation_generation_value 2>/dev/null || printf unsafe)"
    if [[ -n "$output" && "$before" == "$after" ]]; then
      printf '%s\n' "$output"
      return
    fi
  done
  fleet="$(fleet_readiness_json)"
  inventory_json 'busy' "$fleet"
}

# Captain-session acquisition uses the same mkdir claim, so two concurrent
# launches can never both start a captain. A stale owned lock is reclaimed
# atomically; an unowned lock directory is refused, never removed.
acquire_session_lock() {
  local backend="$1" state stale="$profile_root/locks/.session-stale.$$"

  make_owned_directory "$profile_root/locks"
  if ! mkdir "$session_lock" 2>/dev/null; then
    state="$(session_state)"
    case "$state" in
      active)
        die "the $profile_key captain session is already running; attach to it instead of starting a second one" ;;
      incomplete)
        # A contender must never take a session directory that has been created
        # but whose pid is not published yet.
        die "an incomplete captain session lock exists at $session_lock; another fmx launch may be acquiring it right now. Confirm no captain is running, then remove it by hand" ;;
      unowned)
        die "an unowned captain session lock exists at $session_lock; remove it by hand after confirming no captain is running" ;;
      stale)
        [[ ! -e "$stale" && ! -L "$stale" ]] \
          || die "unsafe session lock staging path: $stale"
        atomic_rename "$session_lock" "$stale" \
          || die "the $profile_key captain session is already running; attach to it instead of starting a second one"
        remove_lock_stage "$stale" ;;
      none) ;;
      *)
        die "the captain session lock at $session_lock is in an unexpected state: $state" ;;
    esac
    mkdir "$session_lock" 2>/dev/null \
      || die "the $profile_key captain session is already running; attach to it instead of starting a second one"
  fi
  populate_lock_directory "$session_lock" \
    "owner=$ownership_value" "backend=$backend" "pid=$$"
}

launch_profile() {
  local commit overlay_commit repository backend gh_config worker_bash state workers_live=false
  local expected_fleet_json='' expected_fleet_set=false startup_message
  local -a captain_arguments=()

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --fmx-expected-fleet-json | --fmx-expected-fleet-json=*)
        [[ "$expected_fleet_set" == false ]] || die 'expected fleet identity was supplied more than once'
        expected_fleet_set=true
        if [[ "$1" == --fmx-expected-fleet-json ]]; then
          [[ "$#" -ge 2 ]] || die '--fmx-expected-fleet-json requires a JSON identity'
          expected_fleet_json="$2"
          shift 2
        else
          expected_fleet_json="${1#*=}"
          shift
        fi
        ;;
      *)
        captain_arguments+=("$1")
        shift
        ;;
    esac
  done
  if [[ "${#captain_arguments[@]}" -gt 0 ]]; then
    set -- "${captain_arguments[@]}"
  else
    set --
  fi

  require_command jq
  require_command git
  require_command python3
  worker_bash="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \
    "${BASH-}")" \
    || die "could not resolve the current Bash interpreter: ${BASH-}"
  [[ "$worker_bash" == /* && -f "$worker_bash" && -x "$worker_bash" \
    && ! -L "$worker_bash" ]] \
    || die "the current Bash interpreter is not an absolute executable file: $worker_bash"
  require_native_claude
  require_worker_launcher
  require_owned_profile
  verify_instance_context
  require_safe_managed_paths
  acquire_mutation_lock 'launch'
  if [[ "$expected_fleet_set" == true ]]; then
    commit="$(catalog_commit)"
    python3 "$control_helper" verify-expected "$profile_root" "$profile_key" "$commit" "$expected_fleet_json" \
      || die 'launch refused: expected fleet identity could not be verified under the mutation gate'
    require_complete_publication
  fi
  state="$(session_state)"
  case "$state" in
    active) die "launch refused: the $profile_key fleet is active; the captain session is already running" ;;
    incomplete | unowned) die "launch refused: the captain session lock is $state; inspect it without changing worker state" ;;
    none | stale) ;;
    *) die "launch refused: unsafe captain session state: $state" ;;
  esac
  if fleet_is_active; then
    workers_live=true
    [[ "$state" == stale ]] \
      || die 'live workers require a stale owned supervisor lock for recovery'
    require_complete_publication
    [[ "$(worker_states | awk '$2 == "unsafe" { print }')" == '' ]] \
      || die 'worker state is unsafe; automatic recovery is refused'
  elif [[ "$expected_fleet_set" == false ]]; then
    recover_interrupted_publication
  fi
  profile_is_set_up || die "profile is not set up; run fmx setup $profile_key"
  commit="$(catalog_commit)"
  repository="$(catalog_repository)"
  overlay_commit="$(catalog_overlay)"
  [[ "$(installed_commit)" == "$commit" ]] \
    || die "installed Firstmate commit differs from the catalog pin; run fmx update $profile_key"
  verify_receipt "$commit" "$repository" "$overlay_commit"
  [[ -f "$fm_runtime/bin/fm-spawn.sh" ]] \
    || die "installed runtime is incomplete; run fmx repair $profile_key"
  verify_runtime_overlay "$overlay_commit"
  verify_runtime_checkout "$commit"
  verify_managed_runtime_marker
  verify_tasks_axi_config
  verify_crew_harness_config
  verify_worker_policy
  python3 "$control_helper" identity "$profile_root" "$profile_key" "$commit" >/dev/null \
    || die "fleet identity is missing or unsafe; run fmx repair $profile_key while the fleet is idle"
  python3 "$control_helper" consent "$profile_root" "$profile_key" >/dev/null \
    || die "prior setup consent is required; run fmx repair $profile_key while the fleet is idle"
  worker_controls fleet >/dev/null \
    || die 'restored fleet worker controls failed admission'
  require_gh_authenticated
  gh_config="$(gh_config_directory)"

  if [[ "$state" == stale ]]; then
    backend="$(<"$session_lock/backend")"
    if [[ "$backend" == herdr && "$(resolve_backend)" != herdr ]]; then
      die 'Herdr recovery must start in a real Herdr pane'
    fi
  else
    backend="$(resolve_backend)"
  fi
  if [[ "$workers_live" == true || "$expected_fleet_set" == true || "$instance_selector" != legacy ]]; then
    require_existing_prerequisites "$backend"
    native_claude skills-update --mode --check \
      --home "$captain_home" --marker "$captain_marker" --marker-value "$ownership_value" \
      || die 'launch requires the existing shared skills; stop the fleet before repair'
  else
    ensure_launch_prerequisites "$backend" "$worker_bash"
  fi
  native_claude doctor \
    --home "$captain_home" --marker "$captain_marker" --marker-value "$ownership_value" \
    --bridge enabled --profile "$profile_key" \
    || die 'the existing captain configuration is not ready'
  if [[ ( "$expected_fleet_set" == true || "$instance_selector" != legacy ) && "$#" -eq 0 ]]; then
    # SessionStart supplies context, but Claude needs a first message to act on it.
    startup_message="$(
      printf '%s' \
        'Continue Firstmate from the existing session-start digest.' \
        ' Follow AGENTS.md if the digest is missing or incomplete; do not repeat completed startup.' \
        ' Read pending captain notes with `bin/fm-inbox.sh drain`, then handle the saved requests' \
        ' under their original intent, workflow, project target and authority.' \
        ' This operational message is not a new captain request.' \
        ' Do not create a note for this message or resubmit the saved requests.' |
        "$worker_bash" "$fm_runtime/bin/fm-operational-input.sh" encode session-start
    )" || die 'could not encode the Firstmate startup instruction'
    [[ -n "$startup_message" ]] || die 'the Firstmate startup instruction is empty'
    set -- "$startup_message"
  fi
  acquire_session_lock "$backend"
  release_mutation_lock
  [[ ! -e "$mutation_lock" && ! -L "$mutation_lock" ]] \
    || die "launch refused: the mutation lock at $mutation_lock could not be released"

  cd "$fm_runtime" || die "could not enter the installed runtime: $fm_runtime"

  local -a environment=(
    "FM_HOME=$fm_home"
    "FM_ROOT_OVERRIDE=$fm_runtime"
    "FM_BACKEND=$backend"
    "FMX_PROFILE=$profile_key"
    "FMX_PROFILE_ROOT=$profile_root"
    "FMX_WORKER_LAUNCHER=$worker_launcher"
    "FMX_CAPTAIN_PANE_ID=${HERDR_PANE_ID-}"
    "FMX_TASK_ID_PREFIX=$task_id_prefix"
    "FMX_INSTANCE_ID=$(if [[ "$instance_selector" != legacy ]]; then printf '%s' "$instance_selector"; fi)"
    "FMX_LAUNCH_PROVENANCE_JSON=$instance_context"
    # HOME and PATH are captured from the validated captain process here and
    # carried explicitly into every worker pane, because a session daemon's
    # environment is not the captain's.
    "FMX_WORKER_HOME=$HOME"
    "FMX_WORKER_PATH=$prerequisite_path"
    "FMX_WORKER_BASH=$worker_bash"
    "TASKS_AXI_BACKEND=markdown"
    "TASKS_AXI_FILE=$fm_home/data/backlog.md"
    "GH_CONFIG_DIR=$gh_config"
    "FMX_GH_CONFIG_DIR=$gh_config"
    "ANTHROPIC_AUTH_TOKEN=$proxy_token"
    "ANTHROPIC_BASE_URL=$proxy_origin"
    "ANTHROPIC_DEFAULT_OPUS_MODEL=$model_id"
    "ANTHROPIC_DEFAULT_SONNET_MODEL=$sonnet_model_id"
    "ANTHROPIC_DEFAULT_HAIKU_MODEL=$haiku_model_id"
  )
  if [[ -n "$policy_file" ]]; then
    environment+=("FMX_WORKER_POLICY_FILE=$policy_file")
  else
    environment+=("FMX_WORKER_POLICY_FILE=")
  fi

  exec env \
    -u GH_TOKEN -u GITHUB_TOKEN -u COPILOT_GITHUB_TOKEN \
    -u FM_STATE_OVERRIDE -u FM_DATA_OVERRIDE -u FM_CONFIG_OVERRIDE -u FM_PROJECTS_OVERRIDE \
    -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN -u OPENAI_API_KEY \
    -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX \
    "TRELLAGE_CLAUDE_LAUNCHER_NAME=$launcher_name" \
    "TRELLAGE_CLAUDE_RUNTIME_ROOT=$runtime_root" \
    "PATH=$prerequisite_path" \
    "${environment[@]}" \
    "$native_claude" launch \
    --home "$captain_home" \
    --marker "$captain_marker" \
    --marker-value "$ownership_value" \
    --bridge enabled \
    --profile "$profile_key" \
    -- "$@"
}

# ---------------------------------------------------------------------------
# Argument handling.
# ---------------------------------------------------------------------------

resolve_selection() {
  local selection="$1"

  if [[ "$selection" == --all ]]; then
    profile_names
    return
  fi
  printf '%s\n' "$selection"
}

# The selection is materialized BEFORE the loop runs. A per-profile command
# invokes helpers that may read standard input, and a loop fed by a process
# substitution would lose the remaining profiles to the first such reader.
run_over_selection() {
  local command_name="$1" selection="$2" name
  local -a selected=()

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    selected+=("$name")
  done < <(resolve_selection "$selection")
  [[ "${#selected[@]}" -gt 0 ]] || die "no profile matched the selection: $selection"
  # Each command is invoked directly, never as the left side of ||, so errexit
  # stays active for the whole profile operation and a bare failing command can
  # never continue on to report success. The EXIT trap still releases the lock
  # on failure.
  for name in "${selected[@]}"; do
    select_profile "$name"
    "$command_name"
    # Release between profiles so one selection never holds several locks.
    release_mutation_lock
  done
}

require_command jq
validate_catalog
instance_operation="${1-}"
if [[ "$instance_operation" != instances && "$instance_operation" != list ]]; then
  filtered_arguments=()
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --instance=* | --fmx-instance-context-json=* | --join=*)
        die 'reserved instance options require their documented separate-value form' ;;
      --instance | --fmx-instance-context-json)
        [[ "$#" -ge 2 && -n "$2" && "$2" != --* ]] || die "$1 requires a nonempty value"
        if [[ "$1" == --instance ]]; then
          [[ "$instance_explicit" == false ]] || die 'instance selector was supplied more than once'
          instance_explicit=true
          instance_selector="$2"
        else
          [[ -z "$instance_context" ]] || die 'instance context was supplied more than once'
          instance_context="$2"
        fi
        shift 2 ;;
      --join)
        [[ "$instance_join" == false ]] || die '--join was supplied more than once'
        instance_join=true
        shift ;;
      *) filtered_arguments+=("$1"); shift ;;
    esac
  done
  if [[ "${#filtered_arguments[@]}" -gt 0 ]]; then set -- "${filtered_arguments[@]}"; else set --; fi
  if [[ "$instance_explicit" == false && ( -n "$instance_context" || "$instance_join" == true ) ]]; then
    die 'instance context and --join require an explicit --instance selector'
  fi
  if [[ "$instance_explicit" == true ]]; then
    for argument in "$@"; do [[ "$argument" != --all ]] || die '--instance cannot expand legacy --all semantics'; done
  fi
fi

case "${1-}" in
  help | -h | --help | '')
    usage
    ;;
  list)
    shift
    if [[ "$#" -eq 0 ]]; then
      list_profiles
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  instances)
    shift
    require_safe_home
    exec python3 "$instances_helper" "$@"
    ;;
  inventory)
    shift
    [[ "$#" -eq 2 ]] || die 'inventory requires PROFILE --json'
    if [[ "$1" == --json ]]; then set -- "$2" "$1"; fi
    [[ "$2" == --json ]] || die 'inventory requires PROFILE --json'
    require_safe_home
    select_profile "$1"
    inventory_profile
    ;;
  prepare)
    shift
    [[ "$#" -ge 4 ]] || die 'prepare requires PROFILE --json --expected-source-revision SHA40 [--install-prerequisites SHA256]'
    preparation_profile="$1"
    shift
    preparation_json=false
    preparation_revision=''
    preparation_install=''
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --json)
          [[ "$preparation_json" == false ]] || die '--json was supplied more than once'
          preparation_json=true
          shift ;;
        --expected-source-revision)
          [[ "$#" -ge 2 && -z "$preparation_revision" && "$2" =~ ^[0-9a-f]{40}$ ]] \
            || die '--expected-source-revision requires one lowercase 40-character SHA'
          preparation_revision="$2"
          shift 2 ;;
        --install-prerequisites)
          [[ "$#" -ge 2 && -z "$preparation_install" && "$2" =~ ^[0-9a-f]{64}$ ]] \
            || die '--install-prerequisites requires one lowercase SHA-256 reviewed plan identity'
          preparation_install="$2"
          shift 2 ;;
        *) die "unknown prepare option: $1" ;;
      esac
    done
    [[ "$preparation_json" == true && -n "$preparation_revision" ]] \
      || die 'prepare requires --json and --expected-source-revision'
    require_safe_home
    select_profile "$preparation_profile"
    verify_instance_context
    exec python3 "$control_helper" prepare "$profile_key" "$preparation_revision" "$preparation_install"
    ;;
  _prepare-owned)
    shift
    [[ "$#" -eq 5 ]] || die 'invalid internal preparation request'
    require_safe_home
    select_profile "$1"
    prepare_owned_profile "$2" "$3" "$4" "$5"
    ;;
  _preparation-tools)
    shift
    [[ "$#" -eq 1 ]] || die 'invalid internal prerequisite report request'
    require_safe_home
    select_profile "$1"
    verify_profile_runtime
    preparation_backend="$(resolve_backend)"
    if [[ "$(session_state)" == stale || "$(session_state)" == active ]]; then
      preparation_backend="$(<"$session_lock/backend")"
    fi
    fleet_tools_report "$preparation_backend"
    ;;
  submit | receipt)
    control_operation="$1"
    shift
    [[ "$#" -eq 2 ]] || die "$control_operation requires PROFILE --json"
    if [[ "$1" == --json ]]; then set -- "$2" "$1"; fi
    [[ "$2" == --json ]] || die "$control_operation requires PROFILE --json"
    require_safe_home
    select_profile "$1"
    if [[ "$control_operation" == submit ]]; then verify_instance_context; fi
    FMX_CONTROL_BASH="$BASH" python3 "$control_helper" "$control_operation" "$1"
    ;;
  _control-readiness)
    shift
    [[ "$#" -eq 1 ]] || die 'invalid internal readiness request'
    require_safe_home
    select_profile "$1"
    [[ "$(read_pid_file "$mutation_lock/pid")" == "$PPID" ]] \
      || die 'internal readiness requires the parent control operation lock'
    fleet_readiness_json "$PPID"
    ;;
  harness-version)
    shift
    [[ "$#" -eq 1 ]] || die 'usage: fmx harness-version PROFILE'
    [[ "$1" != --all ]] || die 'usage: fmx harness-version PROFILE'
    require_safe_home
    select_profile "$1"
    print_harness_version_json
    ;;
  setup)
    shift
    [[ "$#" -eq 1 ]] || die 'usage: fmx setup PROFILE|--all'
    require_safe_home
    [[ "$instance_selector" == legacy ]] || die 'named instances require an approved instances create plan'
    run_over_selection setup_profile "$1"
    ;;
  _create-owned)
    shift
    [[ "$#" -eq 2 && "$instance_selector" != legacy ]] || die 'invalid owned instance creation request'
    require_safe_home
    select_profile "$1"
    python3 "$instances_helper" _check-creation "$profile_key" "$instance_selector" "$2" \
      || die 'creation requires the owning approved allocation operation'
    require_owned_profile
    acquire_mutation_lock prepare
    python3 "$instances_helper" _check-creation "$profile_key" "$instance_selector" "$2" \
      || die 'approved creation changed under its instance mutation gate'
    require_idle_fleet create
    automatic_preparation=true
    trap cleanup_automatic_preparation EXIT
    repair_profile_contents automatic
    verify_profile_runtime
    ;;
  doctor)
    shift
    [[ "$#" -eq 1 ]] || die 'usage: fmx doctor PROFILE'
    [[ "$1" != --all ]] || die 'usage: fmx doctor PROFILE'
    require_safe_home
    select_profile "$1"
    doctor_profile_with_lifecycle_gate
    ;;
  repair)
    shift
    [[ "$#" -eq 1 ]] || die 'usage: fmx repair PROFILE'
    [[ "$1" != --all ]] || die 'usage: fmx repair PROFILE'
    require_safe_home
    select_profile "$1"
    repair_profile
    ;;
  skills-check)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-check requires PROFILE'
    require_safe_home
    select_profile "$1"
    skills_check_profile
    ;;
  skills-update)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-update requires PROFILE'
    require_safe_home
    select_profile "$1"
    skills_update_profile
    ;;
  update)
    shift
    check_only=false
    if [[ "${1-}" == --check ]]; then
      check_only=true
      shift
    fi
    [[ "$#" -eq 1 ]] || die 'usage: fmx update [--check] PROFILE|--all'
    require_safe_home
    if [[ "$check_only" == true ]]; then
      run_over_selection check_update "$1"
    else
      run_over_selection update_profile "$1"
    fi
    ;;
  *)
    profile_argument="$1"
    shift
    require_safe_home
    select_profile "$profile_argument"
    launch_profile "$@"
    ;;
esac
