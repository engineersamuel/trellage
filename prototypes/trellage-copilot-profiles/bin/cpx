#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  local source_dir
  local link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done

  cd -P "$(dirname "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)"
runtime_root="$(cd -P "$script_dir/.." && pwd)"
catalog="${CPX_CATALOG:-$script_dir/../catalog.json}"
instruction_asset="$script_dir/../assets/rundown/rundown.instructions.md"
profiles_root="$HOME/.local/share/trellage/profiles/copilot"
floating_skills_manager="$runtime_root/../common/floating-skills-runtime/floating-skills.mjs"
floating_skills_catalog="$runtime_root/../common/floating-skills-runtime/skills.json"
if [[ ! -f "$floating_skills_manager" ]]; then
  floating_skills_manager="$runtime_root/../../scripts/floating-skills.mjs"
  floating_skills_catalog="$runtime_root/../../skills.json"
fi

die() {
  printf 'cpx: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  cpx setup PROFILE|--all
  cpx PROFILE [COPILOT_ARGS...]
  cpx list
  cpx list --json
  cpx inventory PROFILE --json
  cpx doctor PROFILE
  cpx update --check PROFILE|--all
  cpx update PROFILE|--all
  cpx repair PROFILE
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

ensure_floating_skills() {
  local profile="$1"
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "invalid floating-skills manager: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "invalid floating-skills catalog: $floating_skills_catalog"
  command -v node >/dev/null 2>&1 || die 'required command not found: node'
  node "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle native-common \
    --target "$(profile_home "$profile")/skills" \
    || die "failed to install floating skills: $profile"
}

verify_floating_skills() {
  local profile="$1"
  node "$floating_skills_manager" verify \
    --catalog "$floating_skills_catalog" \
    --bundle native-common \
    --target "$(profile_home "$profile")/skills" \
    || die "floating skills are unhealthy: $profile"
}

extract_semver() {
  sed -nE 's/.*(^|[^0-9])([0-9]+\.[0-9]+\.[0-9]+)([^0-9]|$).*/\2/p' | head -n 1
}

copilot_version_if_available() {
  local executable output version

  executable="$(command -v copilot 2>/dev/null || :)"
  [[ "$executable" == */* && -x "$executable" ]] || return 0
  output="$("$executable" --version 2>/dev/null || :)"
  version="$(printf '%s\n' "$output" | extract_semver)"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  printf '%s\n' "$version"
}

conservative_headless() {
  local question_tool_control="${1-none}"

  jq -cn \
    --arg questionToolControl "$question_tool_control" '
    {
      schemaVersion: 1,
      prompt: false,
      outputFormats: ["text"],
      eventContract: null,
      trellageEventContract: null,
      sessionId: "none",
      resume: false,
      resumeWithPrompt: false,
      questionToolControl: $questionToolControl,
      changedFiles: "none",
      usage: false,
      cost: false,
      modelOverride: false,
      effortOverride: false,
      testedHarnessVersion: null
    }
  '
}

projected_headless() {
  local profile="$1"
  local current_version expected_version

  current_version="$(copilot_version_if_available)"
  expected_version="$(jq -r --arg profile "$profile" \
    '.profiles[$profile].headless.testedHarnessVersion // empty' "$catalog")"
  if [[ -z "$current_version" || "$current_version" != "$expected_version" ]]; then
    conservative_headless
    return
  fi
  jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
}

projected_headless_map_json() {
  jq -cn \
    --argjson awesome "$(projected_headless awesome)" \
    --argjson hve "$(projected_headless hve)" \
    --argjson plannotator "$(projected_headless plannotator)" \
    --argjson superpowers "$(projected_headless superpowers)" '
    {
      awesome: $awesome,
      hve: $hve,
      plannotator: $plannotator,
      superpowers: $superpowers
    }
  '
}

