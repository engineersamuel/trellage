profile_exists() {
  jq -e --arg profile "$1" '.profiles | has($profile)' "$catalog" >/dev/null
}

profile_name_is_safe() {
  [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]
}

require_profile() {
  profile_name_is_safe "$1" || die "unsafe profile name: $1"
  profile_exists "$1" || die "unknown profile: $1"
}

profile_value() {
  jq -r --arg profile "$1" --arg field "$2" '.profiles[$profile][$field]' "$catalog"
}

profile_optional_value() {
  jq -r --arg profile "$1" --arg field "$2" \
    '.profiles[$profile][$field] // empty' "$catalog"
}

profile_home() {
  printf '%s/%s/home\n' "$profiles_root" "$1"
}

profile_home_is_safe() {
  local profile="$1"

  case "$HOME" in
    /|'') return 1 ;;
    /*) ;;
    *) return 1 ;;
  esac
  case "$HOME/" in
    */../*) return 1 ;;
  esac
  [[ -d "$HOME" && ! -L "$HOME" ]] || return 1

  # Canonicalize every component inside one subshell: `cd -P` only mutates the
  # child, so the whole walk costs a single fork instead of one per component.
  # This runs on every safety re-check, so the fork count dominates latency.
  (
    canonical_home=''
    canonical_profiles_root=''
    canonical_path=''
    path="$HOME"
    component=''

    cd -P "$HOME" >/dev/null 2>&1 || exit 1
    canonical_home="$PWD"
    [[ "$canonical_home" != '/' ]] || exit 1
    profile_name_is_safe "$profile" || exit 1

    for component in .local share trellage profiles copilot; do
      path="$path/$component"
      [[ ! -L "$path" ]] || exit 1
      if [[ -e "$path" ]]; then
        [[ -d "$path" ]] || exit 1
        cd -P "$path" >/dev/null 2>&1 || exit 1
        canonical_path="$PWD"
        case "$canonical_path" in
          "$canonical_home"|"$canonical_home"/*) ;;
          *) exit 1 ;;
        esac
      fi
    done

    if [[ -e "$profiles_root" ]]; then
      cd -P "$profiles_root" >/dev/null 2>&1 || exit 1
      canonical_profiles_root="$PWD"
      [[ "$canonical_profiles_root" == "$canonical_home/.local/share/trellage/profiles/copilot" ]] \
        || exit 1
    else
      canonical_profiles_root="$canonical_home/.local/share/trellage/profiles/copilot"
    fi

    for component in "$profile" home; do
      path="$path/$component"
      [[ ! -L "$path" ]] || exit 1
      if [[ -e "$path" ]]; then
        [[ -d "$path" ]] || exit 1
        cd -P "$path" >/dev/null 2>&1 || exit 1
        canonical_path="$PWD"
        case "$canonical_path" in
          "$canonical_profiles_root"/*) ;;
          *) exit 1 ;;
        esac
      fi
    done
    exit 0
  )
}

require_safe_profile_home() {
  local profile="$1"

  profile_home_is_safe "$profile" \
    || die "unsafe profile home path: $(profile_home "$profile")"
}

prepare_profile_home() {
  local profile="$1"
  local path="$HOME"
  local component

  require_safe_profile_home "$profile"
  for component in .local share trellage profiles copilot "$profile" home; do
    path="$path/$component"
    if [[ ! -e "$path" ]]; then
      mkdir "$path" || die "failed to create profile home path: $path"
    fi
    [[ -d "$path" && ! -L "$path" ]] \
      || die "unsafe profile home path: $(profile_home "$profile")"
  done
  require_safe_profile_home "$profile"
  chmod 0700 "$(profile_home "$profile")" \
    || die "failed to secure profile home: $(profile_home "$profile")"
  ensure_instructions "$profile"
}

ensure_instructions() {
  local profile="$1"
  local root
  local destination
  local staged

  root="$(profile_home "$profile")/instructions"
  destination="$root/rundown.instructions.md"
  [[ -f "$instruction_asset" && -r "$instruction_asset" && ! -L "$instruction_asset" ]] \
    || die "missing managed instructions: $instruction_asset"
  [[ ! -L "$root" ]] || die "unsafe instructions path: $root"
  if [[ ! -e "$root" ]]; then
    mkdir "$root" || die "failed to create instructions path: $root"
  fi
  [[ -d "$root" && ! -L "$root" ]] || die "unsafe instructions path: $root"
  chmod 0700 "$root" || die "failed to secure instructions path: $root"
  [[ ! -L "$destination" && ( ! -e "$destination" || -f "$destination" ) ]] \
    || die "unsafe managed instructions: $destination"
  staged="$(mktemp "$root/.rundown.instructions.md.XXXXXX")" \
    || die "failed to stage managed instructions: $destination"
  cat -- "$instruction_asset" >"$staged" \
    || die "failed to stage managed instructions: $destination"
  chmod 0600 "$staged" || die "failed to secure managed instructions: $destination"
  mv -f "$staged" "$destination" \
    || die "failed to publish managed instructions: $destination"
}

run_copilot() {
  local profile="$1"
  shift
  require_safe_profile_home "$profile"
  COPILOT_HOME="$(profile_home "$profile")" copilot "$@"
}

launch_profile() {
  local profile="$1"
  shift
  ensure_floating_skills "$profile"

  ensure_profile_for_launch "$profile"
  exec env COPILOT_HOME="$(profile_home "$profile")" \
    copilot --autopilot --allow-all --no-ask-user "$@"
}

plugin_inventory_snapshot() {
  local profile="$1" inventory

  inventory="$(run_copilot "$profile" plugin list)" || return 2
  printf '%s\n' "$inventory" | jq -Rsce '
    def selector:
      "[A-Za-z0-9][A-Za-z0-9._+-]*(@[A-Za-z0-9][A-Za-z0-9._+-]*)?";
    split("\n")
    | map(select(length > 0))
    | if .[0] == "No plugins installed." or .[0] == "No plugins installed" then
        if length == 1
          or (length == 2 and .[1] == "Use '\''copilot plugin install <source>'\'' to install a plugin.")
        then []
        else error("invalid empty plugin inventory")
        end
      elif .[0] == "Installed plugins:" then
        .[1:]
        | map(
            if test("^[[:space:]]*• " + selector + " \\(v[^()[:cntrl:]]+\\)( \\((enabled|disabled)\\))?$") then
              capture("^[[:space:]]*• (?<name>" + selector + ") \\(v(?<version>[^()[:cntrl:]]+)\\)( \\((enabled|disabled)\\))?$")
              | {name, version}
            elif test("^[[:space:]]*• " + selector + "( \\((enabled|disabled)\\))?$") then
              capture("^[[:space:]]*• (?<name>" + selector + ")( \\((enabled|disabled)\\))?$")
              | {name, version: null}
            else
              error("invalid plugin row")
            end
          )
        | if ([.[].name] | length) == ([.[].name] | unique | length) then .
          else error("duplicate plugin row")
          end
      else
        error("invalid plugin inventory")
      end
  ' 2>/dev/null || return 2
}

normalize_github_source() {
  printf '%s\n' "$1" | sed -E \
    -e 's#^git\+##I' \
    -e 's#^https://github\.com/##I' \
    -e 's#^ssh://git@github\.com/##I' \
    -e 's#^git@github\.com:##I' \
    -e 's#^github:##I' \
    -e 's#^github\.com/##I' \
    -e 's#/*$##' \
    -e 's#\.git$##I' \
    | tr '[:upper:]' '[:lower:]'
}

active_plugin_root() {
  local profile="$1" selector="$2" home installed_root root name marketplace canonical_home canonical_root

  home="$(profile_home "$profile")"
  installed_root="$home/installed-plugins"
  [[ -d "$installed_root" && ! -L "$installed_root" ]] || return 2
  name="${selector%%@*}"
  if [[ "$selector" == *@* ]]; then
    marketplace="${selector#*@}"
    [[ -d "$installed_root/$marketplace" && ! -L "$installed_root/$marketplace" ]] \
      || return 2
    root="$installed_root/$marketplace/$name"
  else
    root="$installed_root/$name"
  fi
  [[ -e "$root" || -L "$root" ]] || return 1
  [[ -d "$root" && ! -L "$root" ]] || return 2
  canonical_home="$(cd "$installed_root" 2>/dev/null && pwd -P)" || return 2
  canonical_root="$(cd "$root" 2>/dev/null && pwd -P)" || return 2
  [[ "$canonical_root" == "$canonical_home"/* ]] || return 2
  printf '%s\n' "$root"
}

installed_manifest_version() {
  local profile="$1" plugin="$2"
  local manifest_path root current remaining segment canonical_root canonical_manifest

  manifest_path="$(profile_optional_value "$profile" installedVersionManifest)" || return 2
  [[ -n "$manifest_path" ]] || return 1
  case "$manifest_path" in
    /*|''|*/|*//*|../*|*/../*|*/..|..|./*|*/./*|*/.) return 2 ;;
  esac

  root="$(active_plugin_root "$profile" "$plugin")" || return 2
  current="$root"
  remaining="$manifest_path"
  while [[ "$remaining" == */* ]]; do
    segment="${remaining%%/*}"
    [[ -n "$segment" && "$segment" != '.' && "$segment" != '..' ]] || return 2
    current="$current/$segment"
    [[ -d "$current" && ! -L "$current" ]] || return 2
    remaining="${remaining#*/}"
  done
  [[ -n "$remaining" && "$remaining" != '.' && "$remaining" != '..' ]] || return 2
  current="$current/$remaining"
  [[ -f "$current" && ! -L "$current" ]] || return 2

  canonical_root="$(cd -P "$root" >/dev/null 2>&1 && pwd)" || return 2
  canonical_manifest="$(cd -P "$(dirname "$current")" >/dev/null 2>&1 && pwd)/$(basename "$current")" \
    || return 2
  case "$canonical_manifest" in
    "$canonical_root"/*) ;;
    *) return 2 ;;
  esac

  jq -er --arg plugin "${plugin%%@*}" '
    if .name == $plugin
      and (.version | type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"))
    then .version
    else empty
    end
  ' "$current" 2>/dev/null || return 2
}

plugin_present_in_snapshot() {
  local plugin="$1" inventory="$2"
  jq -e --arg plugin "$plugin" 'any(.[]; .name == $plugin)' \
    <<<"$inventory" >/dev/null 2>&1
}

resolved_version_from_snapshot() {
  local profile="$1" plugin="$2" inventory="$3"
  local version status=0

  plugin_present_in_snapshot "$plugin" "$inventory" || return 1
  version="$(jq -r --arg plugin "$plugin" \
    '.[] | select(.name == $plugin) | .version // empty' <<<"$inventory")" || return 2
  if [[ -n "$version" ]]; then
    printf '%s\n' "$version"
    return
  fi
  version="$(installed_manifest_version "$profile" "$plugin")" || status=$?
  [[ "$status" == 0 && -n "$version" ]] || return 2
  printf '%s\n' "$version"
}

installed_version() {
  local profile="$1" plugin="$2" inventory version status=0

  inventory="$(plugin_inventory_snapshot "$profile")" || return 2
  version="$(resolved_version_from_snapshot "$profile" "$plugin" "$inventory")" || status=$?
  case "$status" in
    0) printf '%s\n' "$version" ;;
    1) ;;
    *) return 2 ;;
  esac
}

plugin_is_installed() {
  local profile="$1" plugin="$2" inventory

  inventory="$(plugin_inventory_snapshot "$profile")" || return 2
  plugin_present_in_snapshot "$plugin" "$inventory"
}

plugin_manifest_is_superpowers() {
  local root="$1" manifest='' candidate source name

  for candidate in \
    "$root/.claude-plugin/plugin.json" \
    "$root/.github/plugin/plugin.json" \
    "$root/plugin.json"; do
    if [[ -e "$candidate" || -L "$candidate" ]]; then
      [[ -f "$candidate" && ! -L "$candidate" ]] || return 2
      case "$candidate" in
        */.claude-plugin/plugin.json)
          [[ -d "$root/.claude-plugin" && ! -L "$root/.claude-plugin" ]] || return 2
          ;;
        */.github/plugin/plugin.json)
          [[ -d "$root/.github" && ! -L "$root/.github" \
            && -d "$root/.github/plugin" && ! -L "$root/.github/plugin" ]] || return 2
          ;;
      esac
      [[ -z "$manifest" ]] || return 2
      manifest="$candidate"
    fi
  done
  [[ -n "$manifest" ]] || return 3
  jq -e '
    type == "object"
    and (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+-]*$"))
    and ((has("repository") | not) or .repository == null or (.repository | type == "string") or (.repository | type == "object" and (.url | type == "string")))
    and ((has("source") | not) or .source == null or (.source | type == "string") or (.source | type == "object" and (.url | type == "string")))
  ' "$manifest" >/dev/null 2>&1 || return 2
  name="$(jq -r '.name' "$manifest")" || return 2
  source="$(jq -r '
    if (.repository | type) == "object" then .repository.url
    elif (.repository | type) == "string" then .repository
    elif (.source | type) == "object" then .source.url
    elif (.source | type) == "string" then .source
    else empty end
  ' "$manifest")" || return 2
  [[ "$name" == superpowers ]] && return 0
  [[ -n "$source" ]] || return 1
  [[ "$(normalize_github_source "$source")" == obra/superpowers ]]
}

forbidden_superpowers_plugins_from_snapshot() {
  local profile="$1" inventory="$2" selector root status=0 matches='' selected

  [[ "$profile" != superpowers ]] || return 1
  selected="$(profile_value "$profile" plugin)"
  while IFS= read -r selector; do
    [[ -n "$selector" ]] || continue
    if [[ "${selector%%@*}" == superpowers ]]; then
      matches+="$selector"$'\n'
      continue
    fi
    [[ "$selector" != "$selected" ]] || continue
    if jq -e --arg profile "$profile" --arg selector "$selector" \
      '(.profiles[$profile].retiredPlugins // []) | index($selector) != null' \
      "$catalog" >/dev/null; then
      continue
    fi
    root="$(active_plugin_root "$profile" "$selector")" || status=$?
    case "$status" in
      0)
        plugin_manifest_is_superpowers "$root" || status=$?
        case "$status" in
          0) matches+="$selector"$'\n' ;;
          1) ;;
          *) return 2 ;;
        esac
        ;;
      1) return 2 ;;
      *) return 2 ;;
    esac
    status=0
  done < <(jq -r '.[].name' <<<"$inventory")
  [[ -n "$matches" ]] || return 1
  printf '%s' "$matches" | LC_ALL=C sort -u
}

forbidden_superpowers_plugins() {
  local profile="$1" inventory

  inventory="$(plugin_inventory_snapshot "$profile")" || return $?
  forbidden_superpowers_plugins_from_snapshot "$profile" "$inventory"
}

require_no_forbidden_superpowers() {
  local profile="$1" status=0

  [[ "$profile" != superpowers ]] || return 0
  forbidden_superpowers_plugins "$profile" >/dev/null || status=$?
  case "$status" in
    0) die "forbidden Superpowers plugin is installed: $profile; run: cpx repair $profile" ;;
    1) ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
}

remove_forbidden_superpowers() {
  local profile="$1"
  local plugins
  local status=0
  local plugin

  plugins="$(forbidden_superpowers_plugins "$profile")" || status=$?
  case "$status" in
    0) ;;
    1) return ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
  while IFS= read -r plugin; do
    [[ "$plugin" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*(@[A-Za-z0-9][A-Za-z0-9._+-]*)?$ ]] \
      || die "invalid forbidden Superpowers plugin selector: $profile"
    run_copilot "$profile" plugin uninstall "$plugin" \
      || die "failed to remove forbidden Superpowers plugin: $profile"
  done <<<"$plugins"
  require_no_forbidden_superpowers "$profile"
}

retired_plugins_from_snapshot() {
  local profile="$1" inventory="$2" selector matches=''

  while IFS= read -r selector; do
    [[ -n "$selector" ]] || continue
    if jq -e --arg selector "$selector" \
      'any(.[]; .name == $selector)' <<<"$inventory" >/dev/null; then
      matches+="$selector"$'\n'
    fi
  done < <(jq -r --arg profile "$profile" \
    '.profiles[$profile].retiredPlugins[]? // empty' "$catalog")
  [[ -n "$matches" ]] || return 1
  printf '%s' "$matches" | LC_ALL=C sort -u
}

retired_plugins() {
  local profile="$1" inventory

  inventory="$(plugin_inventory_snapshot "$profile")" || return $?
  retired_plugins_from_snapshot "$profile" "$inventory"
}

require_no_retired_plugins() {
  local profile="$1" status=0

  retired_plugins "$profile" >/dev/null || status=$?
  case "$status" in
    0) die "retired plugin is installed: $profile; run: cpx repair $profile" ;;
    1) ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
}

remove_retired_plugins() {
  local profile="$1" plugins status=0 plugin

  plugins="$(retired_plugins "$profile")" || status=$?
  case "$status" in
    0) ;;
    1) return ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
  while IFS= read -r plugin; do
    [[ "$plugin" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*(@[A-Za-z0-9][A-Za-z0-9._+-]*)?$ ]] \
      || die "invalid retired plugin selector: $profile"
    run_copilot "$profile" plugin uninstall "$plugin" \
      || die "failed to remove retired plugin: $profile"
  done <<<"$plugins"
  require_no_retired_plugins "$profile"
}

ensure_profile_for_launch() {
  local profile="$1"
  local inventory
  local forbidden
  local status=0
  local plugin
  local version

  prepare_profile_home "$profile"
  ensure_floating_skills "$profile"
  inventory="$(plugin_inventory_snapshot "$profile")" \
    || die "failed to read installed plugins: $profile"
  forbidden="$(forbidden_superpowers_plugins_from_snapshot "$profile" "$inventory")" \
    || status=$?
  case "$status" in
    0)
      while IFS= read -r plugin; do
        [[ "$plugin" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*(@[A-Za-z0-9][A-Za-z0-9._+-]*)?$ ]] \
          || die "invalid forbidden Superpowers plugin selector: $profile"
        run_copilot "$profile" plugin uninstall "$plugin" \
          || die "failed to remove forbidden Superpowers plugin: $profile"
      done <<<"$forbidden"
      require_no_forbidden_superpowers "$profile"
      ;;
    1) ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac

  plugin="$(profile_value "$profile" plugin)"
  if ! plugin_present_in_snapshot "$plugin" "$inventory"; then
    ensure_marketplace "$profile"
    run_copilot "$profile" plugin install "$plugin"
  fi
  remove_retired_plugins "$profile"
  verify_required_package_skills "$profile"
}

marketplace_available() {
  local profile="$1"
  local marketplace_name="$2"
  run_copilot "$profile" plugin marketplace list \
    | sed -n \
      -e 's/^[[:space:]]*•[[:space:]]\([^[:space:]]*\).*/\1/p' \
      -e 's/^[[:space:]]*◆[[:space:]]\([^[:space:]]*\).*/\1/p' \
    | grep -Fxq -- "$marketplace_name"
}

ensure_marketplace() {
  local profile="$1"
  local marketplace
  local marketplace_name
  marketplace="$(profile_value "$profile" marketplace)"
  marketplace_name="$(profile_value "$profile" marketplaceName)"

  if marketplace_available "$profile" "$marketplace_name"; then
    return
  fi
  if [[ "$marketplace_name" == 'awesome-copilot' ]]; then
    die 'required built-in marketplace is unavailable: awesome-copilot'
  fi
  run_copilot "$profile" plugin marketplace add "$marketplace"
}

setup_profile() {
  local profile="$1"
  local plugin
  local installed_status=0
  require_profile "$profile"
  prepare_profile_home "$profile"
  ensure_floating_skills "$profile"
  remove_forbidden_superpowers "$profile"
  ensure_marketplace "$profile"
  plugin="$(profile_value "$profile" plugin)"
  plugin_is_installed "$profile" "$plugin" || installed_status=$?
  case "$installed_status" in
    0) ;;
    1) run_copilot "$profile" plugin install "$plugin" ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
  remove_retired_plugins "$profile"
  printf '%s: ready\n' "$profile"
}

for_selected_profiles() {
  local selection="$1"
  local callback="$2"
  local profile

  if [[ "$selection" == '--all' ]]; then
    while IFS= read -r profile; do
      "$callback" "$profile"
    done < <(jq -r '.profiles | keys[]' "$catalog")
    return
  fi

  "$callback" "$selection"
}

list_profiles() {
  jq -r '.profiles | to_entries[] | [.key, .value.plugin] | @tsv' "$catalog"
}

list_profiles_json() {
  local headless_map

  headless_map="$(projected_headless_map_json)"
  jq -S --argjson headless "$headless_map" '
    {
      schemaVersion: 1,
      launcher: "cpx",
      harness: "copilot",
      # Copilot CLI has no native OS-level sandbox (only trust-directory +
      # tool-approval prompts); real isolation requires Trellage Sandbox
      # (Docker). See docs/native-sandbox-research.md.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries
        | sort_by(.key)[]
        | {
            name: .key,
            description: .value.description,
            headless: $headless[.key],
            plugin: .value.plugin,
            source: null,
            marketplace: {
              kind: (if .value.marketplaceName == "awesome-copilot" then "built-in" else "git" end),
              source: .value.marketplace,
              name: .value.marketplaceName,
              manifestUrl: .value.manifestUrl
            },
            standaloneMcps: .value.standaloneMcps
          }
      ]
    }
  ' "$catalog"
}

not_ready_inventory() {
  local profile="$1"
  local readiness="$2"

  jq -cn \
    --arg profile "$profile" \
    --arg readiness "$readiness" \
    '{
      schemaVersion: 1,
      launcher: "cpx",
      harness: "copilot",
      profile: $profile,
      readiness: $readiness,
      plugins: [],
      skills: {packageCount: null, visibleCount: null},
      mcps: []
    }'
}

count_package_skills() {
  local profile="$1"
  local plugin_root="$2"
  local home
  local installed_root
  local canonical_installed_root
  local canonical_plugin_root
  local relative
  local remaining
  local segment
  local current

  require_safe_profile_home "$profile"
  home="$(profile_home "$profile")"
  installed_root="$home/installed-plugins"
  [[ -d "$installed_root" && ! -L "$installed_root" ]] || return 1
  case "$plugin_root" in
    "$installed_root"/*) ;;
    *) return 1 ;;
  esac

  relative="${plugin_root#"$installed_root"/}"
  case "$relative" in
    ''|/*|*/|*//*) return 1 ;;
  esac
  current="$installed_root"
  remaining="$relative"
  while :; do
    segment="${remaining%%/*}"
    case "$segment" in ''|.|..) return 1 ;; esac
    current="$current/$segment"
    [[ -d "$current" && ! -L "$current" ]] || return 1
    [[ "$remaining" == */* ]] || break
    remaining="${remaining#*/}"
  done

  canonical_installed_root="$(cd -P "$installed_root" >/dev/null 2>&1 && pwd)" || return 1
  canonical_plugin_root="$(cd -P "$plugin_root" >/dev/null 2>&1 && pwd)" || return 1
  case "$canonical_plugin_root" in
    "$canonical_installed_root"/*) ;;
    *) return 1 ;;
  esac

  find "$plugin_root" -type f -name SKILL.md -exec printf '.\n' \; 2>/dev/null \
    | awk 'END { print NR }'
}

inventory_profile() {
  local profile="$1"
  local home
  local plugin
  local plugin_name
  local marketplace_name
  local plugin_root
  local plugin_output
  local plugins
  local skills
  local package_count
  local mcps

  require_profile "$profile"
  require_safe_profile_home "$profile"
  home="$(profile_home "$profile")"
  if [[ ! -d "$home" ]]; then
    not_ready_inventory "$profile" not-setup
    return
  fi
  require_command copilot
  if ! (doctor_profile "$profile" >/dev/null 2>&1); then
    not_ready_inventory "$profile" unhealthy
    return
  fi

  plugin="$(profile_value "$profile" plugin)"
  plugin_name="${plugin%%@*}"
  marketplace_name="$(profile_value "$profile" marketplaceName)"
  plugin_root="$home/installed-plugins/$marketplace_name/$plugin_name"

  plugin_output="$(plugin_inventory_snapshot "$profile")" \
    || die "failed to read plugin inventory: $profile"
  version="$(resolved_version_from_snapshot "$profile" "$plugin" "$plugin_output")" \
    || die "failed to resolve installed plugin version: $profile"
  plugins="$(jq -ce --arg plugin "$plugin" --arg version "$version" '
    if length == 0 then error("empty plugin inventory")
    else map(if .name == $plugin then .version = $version else . end)
    end
  ' <<<"$plugin_output" 2>/dev/null)" || die "invalid plugin inventory for $profile"

  skills="$(skill_inventory_snapshot "$profile")" \
    || die "failed to read skill inventory: $profile"
  skills="$(jq -ce '{
    visibleCount: ([.[] | select(.enabled)] | length)
  }' <<<"$skills" 2>/dev/null)" || die "invalid skill inventory for $profile"
  package_count="$(count_package_skills "$profile" "$plugin_root")" \
    || die "invalid installed plugin root for $profile"
  [[ "$package_count" =~ ^[0-9]+$ ]] \
    || die "invalid installed plugin skill count for $profile"
  skills="$(printf '%s\n' "$skills" | jq -c \
    --argjson packageCount "$package_count" \
    '. + {packageCount: $packageCount}')" \
    || die "invalid skill inventory for $profile"

  mcps="$(run_copilot "$profile" mcp list --json)" \
    || die "failed to read MCP inventory: $profile"
  mcps="$(printf '%s\n' "$mcps" | jq -ce '
    if type == "object"
      and keys == ["mcpServers"]
      and (.mcpServers | type == "object")
      and all(.mcpServers | keys[]; test("^[^[:cntrl:]]+$"))
    then [.mcpServers | to_entries[] | select(.value.disabled != true) | .key] | sort
    else error("invalid MCP inventory")
    end
  ' 2>/dev/null)" || die "invalid MCP inventory for $profile"

  jq -cn \
    --arg profile "$profile" \
    --argjson plugins "$plugins" \
    --argjson skills "$skills" \
    --argjson mcps "$mcps" \
    '{
      schemaVersion: 1,
      launcher: "cpx",
      harness: "copilot",
      profile: $profile,
      readiness: "healthy",
      plugins: $plugins,
      skills: $skills,
      mcps: $mcps
    }'
}

check_empty_mcp_file() {
  local config_file="$1"
  [[ -f "$config_file" ]] || return 0
  jq -e '((.mcpServers // {}) | type == "object" and length == 0)' "$config_file" >/dev/null \
    || die "standalone MCP configuration is not empty: $config_file"
}

skill_inventory_snapshot() {
  local profile="$1" inventory

  inventory="$(run_copilot "$profile" skill list --json)" || return 2
  jq -ce '
    if type == "array"
      and all(.[];
        type == "object"
        and (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:-]*$"))
        and (.source | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._:-]*$"))
        and (.path | type == "string" and length > 0 and startswith("/"))
        and (.enabled | type == "boolean"))
    then .
    else error("invalid skill inventory")
    end
  ' <<<"$inventory" 2>/dev/null || return 2
}

verify_required_package_skills() {
  local profile="$1"
  local plugin plugin_root skills_root skill skill_root skill_file inventory

  if ! jq -e --arg profile "$profile" \
    '(.profiles[$profile].requiredPackageSkills // []) | length > 0' \
    "$catalog" >/dev/null; then
    return
  fi

  plugin="$(profile_value "$profile" plugin)"
  plugin_root="$(active_plugin_root "$profile" "$plugin")" \
    || die "invalid installed plugin root for $profile"
  skills_root="$plugin_root/skills"
  [[ -d "$skills_root" && ! -L "$skills_root" ]] \
    || die "required package skill root is unsafe: $profile"
  inventory="$(skill_inventory_snapshot "$profile")" \
    || die "failed to read skill inventory: $profile"

  while IFS= read -r skill; do
    [[ "$skill" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
      || die "invalid required package skill name: $profile"
    skill_root="$skills_root/$skill"
    skill_file="$skill_root/SKILL.md"
    [[ -d "$skill_root" && ! -L "$skill_root" \
      && -f "$skill_file" && ! -L "$skill_file" ]] \
      || die "required package skill is missing or unsafe: $profile/$skill"
    jq -e --arg skill "$skill" --arg path "$skill_root" '
      [.[] | select(
        .name == $skill
        and .source == "plugin"
        and .path == $path
        and .enabled == true
      )] | length == 1
    ' <<<"$inventory" >/dev/null \
      || die "required package skill is not enabled by Copilot: $profile/$skill"
  done < <(jq -r --arg profile "$profile" \
    '.profiles[$profile].requiredPackageSkills[]? // empty' "$catalog")
}

doctor_profile() {
  local profile="$1"
  local home
  local plugin
  local version
  require_profile "$profile"
  require_command copilot
  require_safe_profile_home "$profile"
  home="$(profile_home "$profile")"
  [[ -d "$home" ]] || die "profile is not set up: $profile"
  require_no_retired_plugins "$profile"
  require_no_forbidden_superpowers "$profile"
  plugin="$(profile_value "$profile" plugin)"
  version="$(installed_version "$profile" "$plugin")" \
    || die "failed to resolve installed plugin version: $plugin"
  [[ -n "$version" ]] || die "expected plugin is not installed: $plugin"
  [[ "$(profile_value "$profile" standaloneMcps)" == '[]' ]] \
    || die "catalog requests unsupported standalone MCPs: $profile"

  verify_floating_skills "$profile"
  verify_required_package_skills "$profile"
  check_empty_mcp_file "$home/mcp-config.json"
  check_empty_mcp_file "$home/config/mcp-config.json"

  printf '%s: healthy (plugin %s, version %s)\n' "$profile" "$plugin" "$version"
}

manifest_version() {
  local profile="$1"
  local manifest_url
  local plugin
  local plugin_name
  manifest_url="$(profile_optional_value "$profile" versionManifestUrl)"
  if [[ -z "$manifest_url" ]]; then
    manifest_url="$(profile_value "$profile" manifestUrl)"
  fi
  plugin="$(profile_value "$profile" plugin)"
  plugin_name="${plugin%%@*}"
  curl -fsSL "$manifest_url" \
    | jq -er --arg plugin "$plugin_name" '
        (
          if (.plugins | type) == "array" then
            .plugins[] | select(.name == $plugin) | .version
          elif .name == $plugin then
            .version
          else
            empty
          end
        )
        | select(
            type == "string"
            and test("^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$")
          )
      ' \
    | head -n 1
}

check_update_profile() {
  local profile="$1"
  local plugin
  local current_version
  local available_version
  require_profile "$profile"
  plugin="$(profile_value "$profile" plugin)"
  if ! current_version="$(installed_version "$profile" "$plugin")"; then
    printf 'cpx: failed to read installed plugin version for %s\n' "$profile" >&2
    return 2
  fi
  if [[ -z "$current_version" ]]; then
    printf '%s: not installed\n' "$profile"
    return 1
  fi
  if ! available_version="$(manifest_version "$profile")"; then
    printf 'cpx: failed to fetch or parse official manifest for %s\n' "$profile" >&2
    return 2
  fi
  if [[ "$current_version" == "$available_version" ]]; then
    printf '%s: current (%s)\n' "$profile" "$current_version"
    return
  fi
  printf '%s: update available (%s -> %s)\n' "$profile" "$current_version" "$available_version"
  return 1
}

check_updates() {
  local selection="$1"
  local profile
  local profile_status
  local status=0

  if [[ "$selection" != '--all' ]]; then
    check_update_profile "$selection" || status=$?
    return "$status"
  fi

  while IFS= read -r profile; do
    profile_status=0
    check_update_profile "$profile" || profile_status=$?
    if [[ "$profile_status" == 2 ]]; then
      status=2
    elif [[ "$profile_status" == 1 && "$status" == 0 ]]; then
      status=1
    elif [[ "$profile_status" != 0 && "$profile_status" != 1 ]]; then
      status=2
    fi
  done < <(jq -r '.profiles | keys[]' "$catalog")
  return "$status"
}

update_profile() {
  local profile="$1"
  local marketplace_name
  local plugin
  local installed_status=0
  require_profile "$profile"
  ensure_floating_skills "$profile"
  [[ -d "$(profile_home "$profile")" ]] || die "profile is not set up: $profile"
  ensure_marketplace "$profile"
  marketplace_name="$(profile_value "$profile" marketplaceName)"
  plugin="$(profile_value "$profile" plugin)"
  run_copilot "$profile" plugin marketplace update "$marketplace_name"
  plugin_is_installed "$profile" "$plugin" || installed_status=$?
  case "$installed_status" in
    0) run_copilot "$profile" plugin update "$plugin" ;;
    1) run_copilot "$profile" plugin install "$plugin" ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
  remove_retired_plugins "$profile"
  printf '%s: updated\n' "$profile"
}

repair_profile() {
  local profile="$1"
  local plugin
  local installed_status=0
  require_profile "$profile"
  prepare_profile_home "$profile"
  ensure_floating_skills "$profile"
  remove_forbidden_superpowers "$profile"
  ensure_marketplace "$profile"
  plugin="$(profile_value "$profile" plugin)"
  plugin_is_installed "$profile" "$plugin" || installed_status=$?
  case "$installed_status" in
    0) ;;
    1) run_copilot "$profile" plugin install "$plugin" ;;
    *) die "failed to read installed plugins: $profile" ;;
  esac
  remove_retired_plugins "$profile"
  doctor_profile "$profile"
  printf '%s: repaired\n' "$profile"
}

require_command jq
validate_catalog

command_name="${1-}"
[[ -n "$command_name" ]] || {
  usage >&2
  exit 2
}
shift

case "$command_name" in
  list)
    if [[ "$#" == 0 ]]; then
      list_profiles
    elif [[ "$#" == 1 && "$1" == '--json' ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  inventory)
    [[ "$#" == 2 && "$2" == '--json' ]] || die 'inventory requires PROFILE --json'
    inventory_profile "$1"
    ;;
  setup)
    [[ "$#" == 1 ]] || die 'setup requires PROFILE or --all'
    require_command copilot
    for_selected_profiles "$1" setup_profile
    ;;
  doctor)
    [[ "$#" == 1 ]] || die 'doctor requires PROFILE'
    doctor_profile "$1"
    ;;
  update)
    require_command copilot
    if [[ "${1-}" == '--check' ]]; then
      [[ "$#" == 2 ]] || die 'update --check requires PROFILE or --all'
      require_command curl
      check_updates "$2"
    else
      [[ "$#" == 1 ]] || die 'update requires PROFILE or --all'
      for_selected_profiles "$1" update_profile
    fi
    ;;
  repair)
    [[ "$#" == 1 ]] || die 'repair requires PROFILE'
    require_command copilot
    repair_profile "$1"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    require_profile "$command_name"
    require_command copilot
    require_safe_profile_home "$command_name"
    launch_profile "$command_name" "$@"
    ;;
esac
