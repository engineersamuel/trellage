        "questionToolControl": "prompt-only",
        "changedFiles": "none",
        "usage": false,
        "cost": false,
        "modelOverride": false,
        "effortOverride": false,
        "testedHarnessVersion": "0.84.2"
      },
      "kind": "local",
      "piProfile": "picx-default",
      "plugin": null,
      "standaloneMcps": [],
      "extensions": [
        {
          "name": "Ponytail",
          "package": "@dietrichgebert/ponytail",
          "installSpec": "git:github.com/DietrichGebert/ponytail"
        },
        {
          "name": "pi-web-access",
          "package": "pi-web-access",
          "installSpec": "npm:pi-web-access"
        },
        {
          "name": "pi-subagents",
          "package": "pi-subagents",
          "installSpec": "npm:pi-subagents@0.34.0"
