#!/usr/bin/env bash

set -euo pipefail

readonly profile_marker_value='trellage-claude-profile-v1'

die() {
  printf 'claude: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  claude [CLAUDE_ARGS...]
  claude {default|office|office-charts} [CLAUDE_ARGS...]
  claude list [--json]
  claude inventory PROFILE --json
  claude setup [PROFILE]
  claude doctor [PROFILE]
  claude repair [PROFILE]
  claude skills-update PROFILE
  claude skills-check PROFILE
  claude harness-version
  claude harness-update

Bare claude invocations use the default profile.
EOF
}

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

script_dir="$(resolve_script_dir)" || die 'could not resolve launcher directory'
runtime_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" \
  || die 'could not resolve runtime root'
readonly catalog="$runtime_root/catalog.json"
readonly output_style_asset="$runtime_root/assets/rundown/rundown.md"
profile_name=default
profile_root="$HOME/.local/share/trellage/profiles/claude/default"
profile_home="$profile_root/home"
profile_marker="$profile_root/.managed-by-trellage-claude-profiles"
output_style_root="$profile_home/output-styles"
output_style="$output_style_root/rundown.md"

# The shared native Claude runtime owns executable/version resolution, safe
# profile path checks, onboarding, settings, floating skills, proxy/model
# checks, credential scrubbing, model defaulting, signal/exec behavior, and
# optional session bridge installation. claude only owns its own CLI surface,
# catalog schema, and the vendored output style asset.
native_claude="$runtime_root/lib/native-claude"
if [[ ! -f "$native_claude" ]]; then
  native_claude="$runtime_root/../trellage-claude-common/native-claude"
fi
[[ -f "$native_claude" && ! -L "$native_claude" && -x "$native_claude" ]] \
  || die "shared native Claude launcher is missing or unsafe: $native_claude"
export TRELLAGE_CLAUDE_LAUNCHER_NAME=claude
export TRELLAGE_CLAUDE_RUNTIME_ROOT="$runtime_root"

validate_catalog() {
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "invalid catalog: $catalog"
  jq -e '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    type == "object"
    and keys == ["profiles", "schemaVersion"]
    and .schemaVersion == 1
    and (.profiles | type == "object" and keys == ["default", "office", "office-charts"])
    and (.profiles | all(.[]; type == "object"
      and keys == ["description", "headless", "plugin", "standaloneMcps"]
      and (.description | type == "string" and length > 0)
      and (.headless | validHeadless)
      and .standaloneMcps == []))
    and .profiles.default.plugin == null
    and .profiles.office.plugin == "document-skills@anthropic-agent-skills"
    and .profiles["office-charts"].plugin == "document-skills@anthropic-agent-skills"
  ' "$catalog" >/dev/null 2>&1 || die "invalid catalog: $catalog"
}

list_profiles() {
  jq -r '.profiles | to_entries[] | [.key, .value.description] | @tsv' "$catalog"
}

list_profiles_json() {
  local headless_map

  headless_map="$(projected_headless_map_json)"
  jq -S --argjson headless "$headless_map" '
    {
      schemaVersion: 1,
      launcher: "claude",
      harness: "claude",
      # claude runs Claude Code directly on the host with
      # --dangerously-skip-permissions; no native OS-level sandbox is
      # enabled today. See docs/native-sandbox-research.md.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries[]
        | {
            name: .key,
            description: .value.description,
            headless: $headless[.key],
            plugin: .value.plugin,
            source: "anthropics/claude-code",
            marketplace: (if .value.plugin == null then null else {
              kind: "git",
              source: "anthropics/skills",
              name: "anthropic-agent-skills",
              manifestUrl: "https://raw.githubusercontent.com/anthropics/skills/main/.claude-plugin/marketplace.json"
            } end),
            skillBundles: (if .key == "default" then ["native-common"]
              else ["native-common", ("claude-" + .key)] end),
            standaloneMcps: .value.standaloneMcps
          }
      ]
    }
  ' "$catalog"
}

select_profile() {
  profile_name="${1-default}"
  case "$profile_name" in
    default|office|office-charts) ;;
    *) die "unknown profile: $profile_name" ;;
  esac
  profile_root="$HOME/.local/share/trellage/profiles/claude/$profile_name"
  profile_home="$profile_root/home"
  profile_marker="$profile_root/.managed-by-trellage-claude-profiles"
  output_style_root="$profile_home/output-styles"
  output_style="$output_style_root/rundown.md"
  export TRELLAGE_CLAUDE_PROFILE_SKILLS=native-common
  [[ "$profile_name" == default ]] || export TRELLAGE_CLAUDE_PROFILE_SKILLS="$profile_name"
}

conservative_headless() {
  local question_tool_control="${1-none}"

  jq -cn \
    --arg questionToolControl "$question_tool_control" '
    {
      schemaVersion: 1,
      prompt: false,
      outputFormats: ["text"],
      eventContract: null,
      trellageEventContract: null,
      sessionId: "none",
      resume: false,
      resumeWithPrompt: false,
      questionToolControl: $questionToolControl,
      changedFiles: "none",
      usage: false,
      cost: false,
      modelOverride: false,
      effortOverride: false,
      testedHarnessVersion: null
    }
  '
}

projected_headless() {
  local profile="$1"
  local current_version expected_version

  current_version="${2-}"
  [[ "$#" -ge 2 ]] || current_version="$("$native_claude" version)"
  expected_version="$(jq -r --arg profile "$profile" \
    '.profiles[$profile].headless.testedHarnessVersion // empty' "$catalog")"
  if [[ -z "$current_version" || "$current_version" != "$expected_version" ]]; then
    conservative_headless
    return
  fi
  jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
}

projected_headless_map_json() {
  local current_version
  current_version="$("$native_claude" version)"
  jq -cn --argjson defaultProfile "$(projected_headless default "$current_version")" \
    --argjson office "$(projected_headless office "$current_version")" \
    --argjson charts "$(projected_headless office-charts "$current_version")" '
    {default: $defaultProfile, office: $office, "office-charts": $charts}
  '
}

office_plugin() {
  "$native_claude" plugin --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" -- "$@"
}

office_plugin_inventory() {
  local registry="$profile_home/plugins/installed_plugins.json"
  [[ ! -L "$profile_home/plugins" && ! -L "$registry" ]] || die 'unsafe Office plugin registry'
  if [[ ! -e "$registry" ]]; then
    printf '[]\n'
    return
  fi
  [[ -f "$registry" && -f "$profile_home/settings.json" && ! -L "$profile_home/settings.json" ]] \
    || die 'invalid Office plugin registry or settings'
  # Claude's plugin list command rewrites settings; inspect its v2 registry instead.
  jq -ce --slurpfile settings "$profile_home/settings.json" '
    if .version != 2 or (.plugins | type) != "object"
      or ($settings | length) != 1 or ($settings[0] | type) != "object"
    then error("invalid plugin registry or settings")
    else
      (.plugins["document-skills@anthropic-agent-skills"] // [])
      | if type != "array" then error("invalid document plugin entries") else . end
      | map(. + {id: "document-skills@anthropic-agent-skills",
          enabled: ($settings[0].enabledPlugins["document-skills@anthropic-agent-skills"] == true)})
    end
  ' "$registry" || die 'invalid Office plugin inventory'
}

require_office_plugin() {
  [[ "$profile_name" != default ]] || return 0
  local inventory
  inventory="$(office_plugin_inventory)"
  jq -e 'any(.[]; .id == "document-skills@anthropic-agent-skills"
    and .scope == "user" and .enabled == true)' <<<"$inventory" >/dev/null \
    || die "Office document plugin is missing or disabled; run claude repair $profile_name"
  local install_path ancestor skill
  local required_skills=(academic-pptx)
  [[ "$profile_name" != office-charts ]] || required_skills+=(slide-maker)
  install_path="$(jq -r '[.[] | select(.scope == "user")][0].installPath // empty' <<<"$inventory")"
  [[ "$install_path" == "$profile_home/plugins/cache/anthropic-agent-skills/document-skills/"* \
    && "$install_path" != *'/../'* && "$install_path" != *'/./'* ]] \
    || die 'unsafe Office plugin install path'
  ancestor="$install_path"
  while [[ "$ancestor" != "$profile_home" ]]; do
    [[ -d "$ancestor" && ! -L "$ancestor" ]] || die "missing or unsafe Office plugin directory: $ancestor"
    ancestor="${ancestor%/*}"
  done
  local manifest="$install_path/.claude-plugin/marketplace.json"
  [[ -f "$manifest" && ! -L "$install_path/.claude-plugin" && ! -L "$manifest" ]] \
    || die 'missing or unsafe Office marketplace manifest'
  jq -e 'any(.plugins[]; .name == "document-skills" and .source == "./"
    and (.skills | contains(["./skills/docx", "./skills/xlsx", "./skills/pptx", "./skills/pdf"])))' \
    "$manifest" >/dev/null || die 'Office document plugin manifest is incomplete'
  for skill in docx xlsx pptx pdf; do
    [[ -d "$install_path/skills/$skill" && ! -L "$install_path/skills" \
      && ! -L "$install_path/skills/$skill" && -f "$install_path/skills/$skill/SKILL.md" \
      && ! -L "$install_path/skills/$skill/SKILL.md" ]] || die "missing or unsafe document plugin skill: $skill"
  done
  for skill in "${required_skills[@]}"; do
    [[ -d "$profile_home/skills/$skill" && ! -L "$profile_home/skills" \
      && ! -L "$profile_home/skills/$skill" && -f "$profile_home/skills/$skill/SKILL.md" \
      && ! -L "$profile_home/skills/$skill/SKILL.md" ]] || die "missing or unsafe Office skill: $skill"
  done
}

ensure_office_plugin() {
  [[ "$profile_name" != default ]] || return 0
  local inventory marketplaces changed=false
  inventory="$(office_plugin_inventory)"
  if ! jq -e 'any(.[]; .id == "document-skills@anthropic-agent-skills"
    and .scope == "user")' <<<"$inventory" >/dev/null; then
    marketplaces="$(office_plugin marketplace list --json)" || die 'could not read Office marketplaces'
    jq -e 'type == "array"' <<<"$marketplaces" >/dev/null || die 'invalid Office marketplace inventory'
    if ! jq -e 'any(.[]; .name == "anthropic-agent-skills")' <<<"$marketplaces" >/dev/null; then
      office_plugin marketplace add anthropics/skills || die 'could not add Anthropic skills marketplace'
    elif ! jq -e 'any(.[]; .name == "anthropic-agent-skills" and .repo == "anthropics/skills")' \
      <<<"$marketplaces" >/dev/null; then
      die 'Anthropic skills marketplace points to an unexpected repository'
    fi
    office_plugin install document-skills@anthropic-agent-skills --scope user \
      || die 'could not install Office document plugin'
    changed=true
    inventory="$(office_plugin_inventory)"
  fi
  if ! jq -e 'any(.[]; .id == "document-skills@anthropic-agent-skills"
    and .scope == "user" and .enabled == true)' <<<"$inventory" >/dev/null; then
    office_plugin enable document-skills@anthropic-agent-skills --scope user \
      || die 'could not enable Office document plugin'
    changed=true
  fi
  if [[ "$changed" == true ]]; then
    "$native_claude" prepare --home "$profile_home" --marker "$profile_marker" \
      --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name" --require-existing
  fi
  require_office_plugin
}

ensure_output_style() {
  local staged

  [[ -f "$output_style_asset" && -r "$output_style_asset" && ! -L "$output_style_asset" ]] \
    || die "missing managed output style: $output_style_asset"
  [[ ! -L "$output_style_root" ]] || die "unsafe output style directory: $output_style_root"
  [[ -e "$output_style_root" ]] || mkdir "$output_style_root"
  [[ -d "$output_style_root" && ! -L "$output_style_root" ]] \
    || die "unsafe output style directory: $output_style_root"
  chmod 0700 "$output_style_root"
  [[ ! -L "$output_style" && ( ! -e "$output_style" || -f "$output_style" ) ]] \
    || die "unsafe managed output style: $output_style"
  staged="$(mktemp "$output_style_root/.rundown.md.XXXXXX")" \
    || die 'could not stage the managed output style'
  cat -- "$output_style_asset" >"$staged" \
    || die 'could not stage the managed output style'
  chmod 0600 "$staged"
  mv -f "$staged" "$output_style"
}

setup_profile() {
  local version model

  "$native_claude" prepare \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name"
  ensure_output_style
  ensure_office_plugin
  version="$("$native_claude" version)"
  model="$("$native_claude" model-id)"
  printf 'claude setup: ready (%s, %s)\n' "$version" "$model"
}

repair_profile() {
  local version model

  "$native_claude" prepare \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name" \
    --require-existing
  ensure_output_style
  ensure_office_plugin
  version="$("$native_claude" version)"
  model="$("$native_claude" model-id)"
  printf 'claude repair: restored (%s, %s)\n' "$version" "$model"
}

doctor_profile() {
  local version model

  "$native_claude" doctor \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name"
  require_office_plugin
  version="$("$native_claude" version)"
  model="$("$native_claude" model-id)"
  printf 'claude doctor: OK (%s, %s)\n' "$version" "$model"
}

not_ready_inventory() {
  local profile="$1"
  local readiness="$2"

  jq -cn --arg profile "$profile" --arg readiness "$readiness" '{
    schemaVersion: 1,
    launcher: "claude",
    harness: "claude",
    profile: $profile,
    readiness: $readiness,
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

inventory_profile() {
  local profile="$1"

  select_profile "$profile"
  if [[ ! -f "$profile_marker" || -L "$profile_marker" ]]; then
    not_ready_inventory "$profile" not-setup
    return
  fi
  if ! "$native_claude" doctor \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name" \
    >/dev/null 2>&1; then
    not_ready_inventory "$profile" unhealthy
    return
  fi
  if ! (require_office_plugin) >/dev/null 2>&1; then
    not_ready_inventory "$profile" unhealthy
    return
  fi
  jq -cn --arg profile "$profile" --argjson plugins \
    "$(jq -c --arg profile "$profile" '[.profiles[$profile].plugin | select(. != null)]' "$catalog")" '{
    schemaVersion: 1,
    launcher: "claude",
    harness: "claude",
    profile: $profile,
    readiness: "healthy",
    plugins: $plugins,
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

launch_profile() {
  "$native_claude" prepare \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name"
  ensure_output_style
  ensure_office_plugin
  exec "$native_claude" launch \
    --home "$profile_home" --marker "$profile_marker" \
    --marker-value "$profile_marker_value" --bridge enabled --profile "$profile_name" -- "$@"
}

require_command jq
validate_catalog
select_profile default

case "${1-}" in
  help|-h|--help)
    usage
    ;;
  list)
    shift
    if [[ "$#" -eq 0 ]]; then
      list_profiles
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  inventory)
    shift
    [[ "$#" -eq 2 && "$2" == '--json' ]] || die 'inventory requires PROFILE --json'
    inventory_profile "$1"
    ;;
  setup|doctor|repair)
    command_name="$1"
    shift
    [[ "$#" -le 1 ]] || die "usage: claude $command_name [PROFILE]"
    select_profile "${1-default}"
    "${command_name}_profile"
    ;;
  skills-check)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-check requires PROFILE'
    select_profile "$1"
    "$native_claude" --help | grep -q 'skills-check' || die 'refresh the Native Claude runtime for skills-check'
    exec "$native_claude" skills-check \
      --home "$profile_home" --marker "$profile_marker" \
      --marker-value "$profile_marker_value"
    ;;
  skills-update)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-update requires PROFILE'
    select_profile "$1"
    "$native_claude" skills-update \
      --home "$profile_home" --marker "$profile_marker" \
      --marker-value "$profile_marker_value"
    printf '%s: skills updated from cache\n' "$profile_name"
    ;;
  harness-version)
    shift
    [[ "$#" -eq 0 ]] || die 'harness-version accepts no arguments'
    goal_runtime="$("$native_claude" goal-runtime)"
    jq -cn --argjson runtime "$goal_runtime" --arg profileHome "$profile_home" '{
      schemaVersion: 1,
      launcher: "claude",
      harness: "claude",
      installed: $runtime.version,
      latest: null,
      latestKnown: false,
      goalRuntime: {
        profileHome: $profileHome,
        evaluatorModel: $runtime.evaluatorModel,
        modelsUrl: $runtime.modelsUrl
      }
    }'
    ;;
  harness-update)
    shift
    [[ "$#" -eq 0 ]] || die 'harness-update accepts no arguments'
    exec "$native_claude" harness-update
    ;;
  default|office|office-charts)
    select_profile "$1"
    shift
    launch_profile "$@"
    ;;
  *)
    launch_profile "$@"
    ;;
esac
