#!/usr/bin/env bash

set -euo pipefail

readonly provider='copilot-proxy-rs'
readonly model_id='claude-opus-5'
readonly proxy_origin='http://127.0.0.1:8080'
readonly proxy_models_url="${proxy_origin}/v1/models"
readonly api_key='trellage-local-proxy'
readonly mise_tool='github:PrimeIntellect-ai/prime-agent'
readonly mise_install_name='github-prime-intellect-ai-prime-agent'
readonly profile_marker_value='trellage-prime-profile-v1'
readonly managed_extension_name='ask-user'

die() {
  printf 'prx: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  prx [PRIME_ARGS...]
  prx default [PRIME_ARGS...]
  prx list [--json]
  prx inventory PROFILE --json
  prx setup [default]
  prx doctor [default]
  prx repair [default]
  prx shutdown [default]
  prx update [--check] [default]

Bare prx invocations use the default profile.
EOF
}

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

canonical_directory() {
  CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

extract_semver() {
  sed -nE 's/.*(^|[^0-9])([0-9]+\.[0-9]+\.[0-9]+)([^0-9]|$).*/\2/p' | head -n 1
}

script_dir="$(resolve_script_dir)" || die 'could not resolve launcher directory'
runtime_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" \
  || die 'could not resolve runtime root'
readonly catalog="$runtime_root/catalog.json"
readonly receipt_file="$runtime_root/installed-version"
readonly legacy_version_file="$runtime_root/version"
readonly npm_prefix="$runtime_root/npm-prefix"
readonly managed_extension_source="$runtime_root/assets/extensions/${managed_extension_name}.ts"
readonly profile_root="$HOME/.local/share/trellage/profiles/prime/default"
readonly profile_home="$profile_root/home"
readonly profile_marker="$profile_root/.managed-by-trellage-prime-profiles"
readonly profile_models="$profile_home/models.json"
readonly profile_extensions="$profile_home/extensions"
readonly profile_extension="$profile_extensions/${managed_extension_name}.ts"
readonly profile_extension_manifest="$profile_home/.trellage-managed-extensions"
readonly kernel_venv="$profile_home/kernel-venv"
readonly kernel_python="$kernel_venv/bin/python"
floating_skills_manager="$runtime_root/../common/floating-skills-runtime/floating-skills.mjs"
floating_skills_catalog="$runtime_root/../common/floating-skills-runtime/skills.json"
if [[ ! -f "$floating_skills_manager" ]]; then
  floating_skills_manager="$runtime_root/../../scripts/floating-skills.mjs"
  floating_skills_catalog="$runtime_root/../../skills.json"
fi

ensure_floating_skills() {
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "invalid floating-skills manager: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "invalid floating-skills catalog: $floating_skills_catalog"
  command -v node >/dev/null 2>&1 || die 'required command not found: node'
  node "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle native-common \
    --target "$profile_home/skills" \
    || die 'failed to install floating skills'
}
# UID-global default socket is /tmp/prime-agent-$UID/daemon.sock. Resident workers
# inherit the supervisor's env at spawn, and PRIME_AGENT_KERNEL_* is not on the
# client→daemon allowlist — so a daemon started without our kernel paths keeps
# bootstrapping ~/.prime/agent/kernel-venv forever. Pin a profile-local socket.
readonly daemon_dir="$profile_root/daemon"
readonly daemon_socket="$daemon_dir/daemon.sock"
readonly daemon_env_stamp="$daemon_dir/kernel-env.stamp"
# Default RLM extras required when PRIME_AGENT_KERNEL_PYTHON is set (prime bootstrap.js).
# prime-agent-runtime is installed from the bundled source tree, not PyPI.
readonly kernel_pypi_packages=(
  ipykernel
  dill
  requests
  httpx
  pyyaml
  tomli
  python-dotenv
  pandas
  numpy
  scipy
  beautifulsoup4
  lxml
  pydantic
  tyro
)
# Prefer the public index; fall back when files.pythonhosted.org is unreachable.
readonly pypi_fallback_index='https://mirrors.aliyun.com/pypi/simple'

validate_catalog() {
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "invalid catalog: $catalog"
  jq -e '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    type == "object"
    and keys == ["profiles", "schemaVersion"]
    and .schemaVersion == 1
    and (.profiles | type == "object" and keys == ["default"])
    and (.profiles.default | type == "object")
    and (.profiles.default | keys == ["description", "headless", "plugin", "standaloneMcps"])
    and (.profiles.default.description | type == "string" and length > 0)
    and (.profiles.default.headless | validHeadless)
    and .profiles.default.plugin == null
    and .profiles.default.standaloneMcps == []
  ' "$catalog" >/dev/null 2>&1 || die "invalid catalog: $catalog"
}

list_profiles() {
  jq -r '.profiles | to_entries[] | [.key, .value.description] | @tsv' "$catalog"
}

list_profiles_json() {
  local headless_map

  headless_map="$(projected_headless_map_json)"
  jq -S --argjson headless "$headless_map" '
    {
      schemaVersion: 1,
      launcher: "prx",
      harness: "prime",
      # Prime Agent has no known native OS-level sandbox; runs directly on
      # the host. See docs/native-sandbox-research.md.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries[]
        | {
            name: .key,
            description: .value.description,
            headless: $headless[.key],
            plugin: .value.plugin,
            source: "PrimeIntellect-ai/prime-agent",
            marketplace: null,
            standaloneMcps: .value.standaloneMcps
          }
      ]
    }
  ' "$catalog"
}

require_default_profile() {
  [[ "${1-default}" == default ]] || die "unknown profile: $1"
}

require_safe_home() {
  local canonical_home

  [[ "$HOME" == /* && "$HOME" != / && -d "$HOME" && ! -L "$HOME" ]] \
    || die "unsafe HOME: $HOME"
  canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
  [[ "$canonical_home" != / ]] || die "unsafe HOME: $HOME"
}

require_safe_profile_path() {
  local path="$HOME" component canonical_home canonical_path

  require_safe_home
  canonical_home="$(canonical_directory "$HOME")"
  for component in .local share trellage profiles prime default home; do
    path="$path/$component"
    [[ ! -L "$path" ]] || die "unsafe profile path: $path"
    if [[ -e "$path" ]]; then
      [[ -d "$path" ]] || die "unsafe profile path: $path"
      canonical_path="$(canonical_directory "$path")" || die "cannot resolve profile path: $path"
      case "$canonical_path" in
        "$canonical_home"/*) ;;
        *) die "redirected profile path: $path" ;;
      esac
    fi
  done
}

profile_is_owned_or_empty() {
  local existing

  if [[ -e "$profile_marker" || -L "$profile_marker" ]]; then
    [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
    [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] || return 1
    return 0
  fi
  [[ ! -e "$profile_root" ]] && return 0
  existing="$(find "$profile_root" -mindepth 1 \( -type f -o -type l \) -print -quit)"
  [[ -z "$existing" ]]
}

prepare_profile() {
  local path="$HOME" component marker_stage

  require_safe_profile_path
  profile_is_owned_or_empty || die "refusing unrelated existing profile files: $profile_root"
  for component in .local share trellage profiles prime default home; do
    path="$path/$component"
    [[ -e "$path" ]] || mkdir "$path"
    [[ -d "$path" && ! -L "$path" ]] || die "unsafe profile path: $path"
  done
  chmod 0700 "$profile_root" "$profile_home"
  marker_stage="$(mktemp "$profile_root/.ownership.XXXXXX")" \
    || die 'could not stage profile ownership'
  printf '%s\n' "$profile_marker_value" >"$marker_stage"
  chmod 0600 "$marker_stage"
  mv -f "$marker_stage" "$profile_marker"
}

managed_models() {
  local selected_model="${1:-$model_id}"
  jq -n \
    --arg provider "$provider" \
    --arg base_url "$proxy_origin" \
    --arg api_key "$api_key" \
    --arg model "$selected_model" \
    '{
      providers: {
        ($provider): {
          baseUrl: $base_url,
          api: "anthropic-messages",
          apiKey: $api_key,
          compat: { supportsEagerToolInputStreaming: false },
          models: [{ id: $model }]
        }
      }
    }'
}

require_managed_extension_source() {
  [[ -f "$managed_extension_source" && -r "$managed_extension_source" \
    && ! -L "$managed_extension_source" ]] \
    || die "managed ask-user extension asset is missing; reinstall prx ($managed_extension_source)"
}

publish_managed_extensions() {
  local extension_stage manifest_stage path component

  require_managed_extension_source
  path="$profile_home"
  for component in extensions; do
    path="$path/$component"
    [[ ! -L "$path" ]] || die "unsafe managed extension path: $path"
    if [[ ! -e "$path" ]]; then
      mkdir -p "$path"
    fi
    [[ -d "$path" && ! -L "$path" ]] || die "unsafe managed extension path: $path"
  done
  chmod 0700 "$profile_extensions"
  [[ ! -L "$profile_extension" && ( ! -e "$profile_extension" || -f "$profile_extension" ) ]] \
    || die "unsafe managed extension: $profile_extension"
  if [[ -e "$profile_extension" ]]; then
    if ! cmp -s "$managed_extension_source" "$profile_extension"; then
      if [[ -f "$profile_extension_manifest" && ! -L "$profile_extension_manifest" ]] \
        && grep -Fqx -- "$managed_extension_name" "$profile_extension_manifest"; then
        :
      else
        die "managed ask-user extension collides with unmanaged state: $profile_extension"
      fi
    fi
  fi
  [[ ! -e "$profile_extension_manifest" || ( -f "$profile_extension_manifest" && ! -L "$profile_extension_manifest" ) ]] \
    || die "unsafe managed extension manifest: $profile_extension_manifest"
  extension_stage="$(mktemp "$profile_extensions/.ask-user.XXXXXX")" \
    || die 'could not stage managed ask-user extension'
  manifest_stage="$(mktemp "$profile_home/.managed-extensions.XXXXXX")" \
    || {
      rm -f -- "$extension_stage"
      die 'could not stage managed extension manifest'
    }
  cp -- "$managed_extension_source" "$extension_stage" \
    || {
      rm -f -- "$extension_stage" "$manifest_stage"
      die 'could not copy managed ask-user extension'
    }
  chmod 0600 "$extension_stage"
  printf '%s\n' "$managed_extension_name" >"$manifest_stage"
  chmod 0600 "$manifest_stage"
  mv -f "$extension_stage" "$profile_extension"
  mv -f "$manifest_stage" "$profile_extension_manifest"
}

publish_managed_profile() {
  local models_stage selected_model="${1:-$model_id}"

  prepare_profile
  [[ ! -L "$profile_models" && ( ! -e "$profile_models" || -f "$profile_models" ) ]] \
    || die "unsafe managed models config: $profile_models"
  models_stage="$(mktemp "$profile_home/.models.XXXXXX")" \
    || die 'could not stage Prime models config'
  managed_models "$selected_model" >"$models_stage"
  chmod 0600 "$models_stage"
  mv -f "$models_stage" "$profile_models"
  publish_managed_extensions
}

require_owned_profile() {
  require_safe_profile_path
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] \
    || die 'profile is not managed; run prx setup'
  [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] \
    || die "profile ownership marker differs: $profile_marker"
}

verify_managed_profile() {
  require_owned_profile
  [[ -f "$profile_models" && ! -L "$profile_models" ]] \
    || die "managed models config is missing: $profile_models"
  jq -e \
    --arg provider "$provider" \
    --arg base_url "$proxy_origin" \
    --arg api_key "$api_key" '
      (.providers | keys) == [$provider]
      and .providers[$provider].baseUrl == $base_url
      and .providers[$provider].api == "anthropic-messages"
      and .providers[$provider].apiKey == $api_key
      and .providers[$provider].compat == { supportsEagerToolInputStreaming: false }
      and (.providers[$provider].models | type == "array" and length > 0)
      and all(.providers[$provider].models[]; keys == ["id"] and (.id | type == "string" and length > 0))
      and ([.providers[$provider].models[].id] | length == (unique | length))
    ' "$profile_models" >/dev/null \
    || die 'managed models config differs; run prx repair'
  require_managed_extension_source
  [[ -f "$profile_extension" && ! -L "$profile_extension" ]] \
    || die "managed ask-user extension is missing; run prx repair"
  cmp -s "$managed_extension_source" "$profile_extension" \
    || die 'managed ask-user extension differs; run prx repair'
  [[ -f "$profile_extension_manifest" && ! -L "$profile_extension_manifest" ]] \
    || die "managed extension manifest is missing; run prx repair"
  grep -Fqx -- "$managed_extension_name" "$profile_extension_manifest" \
    || die 'managed extension manifest differs; run prx repair'
}

require_exact_version() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid prime-agent version: $1"
}

mise_env() {
  # Run from the owned runtime so a parent-tree mise.toml cannot block installs.
  (
    CDPATH= cd -P -- "$runtime_root" || exit 1
    MISE_DATA_DIR="$runtime_root/mise" \
      MISE_CACHE_DIR="$runtime_root/cache" \
      MISE_CONFIG_DIR="$runtime_root/mise-config" \
      MISE_GLOBAL_CONFIG_FILE=/dev/null \
      MISE_IGNORED_CONFIG_PATHS="$HOME" \
      mise "$@"
  )
}

resolve_latest_version() {
  local version

  version="$(mise_env latest "$mise_tool")" \
    || die 'could not resolve latest eligible prime-agent release'
  require_exact_version "$version"
  printf '%s\n' "$version"
}

read_installed_version() {
  local version

  if [[ ! -e "$receipt_file" && ! -L "$receipt_file" \
    && ( -e "$legacy_version_file" || -L "$legacy_version_file" ) ]]; then
    [[ -f "$legacy_version_file" && ! -L "$legacy_version_file" ]] \
      || die "unsafe legacy installed version receipt: $legacy_version_file"
    version="$(<"$legacy_version_file")"
    require_exact_version "$version"
    publish_installed_version "$version"
  fi
  [[ -f "$receipt_file" && ! -L "$receipt_file" ]] \
    || die 'prime-agent installed version receipt is missing; run prx setup'
  version="$(<"$receipt_file")"
  require_exact_version "$version"
  printf '%s\n' "$version"
}

resolve_package_source() {
  local version="$1" install_dir expected

  install_dir="$(mise_env where "$mise_tool@$version")" \
    || die "prime-agent $version is not installed; run prx repair"
  expected="$runtime_root/mise/installs/$mise_install_name/$version"
  [[ "$install_dir" == "$expected" ]] \
    || die "mise returned unexpected prime-agent path: $install_dir"
  # mise extracts the GitHub release tarball in place (package.json at root).
  [[ -f "$install_dir/package.json" && ! -L "$install_dir/package.json" ]] \
    || die "prime-agent package is missing: $install_dir"
  jq -e --arg version "$version" '
    .name == "prime-agent" and .version == $version
  ' "$install_dir/package.json" >/dev/null 2>&1 \
    || die "prime-agent package metadata is invalid: $install_dir/package.json"
  printf '%s\n' "$install_dir"
}

require_node() {
  local major

  require_command node
  major="$(node -p 'process.versions.node.split(".")[0]')" \
    || die 'could not determine Node.js version'
  [[ "$major" =~ ^[0-9]+$ && "$major" -ge 22 ]] \
    || die "Node.js 22+ is required (found $(node --version 2>/dev/null || printf unknown))"
}

installed_cli() {
  local version="$1" prefix="${2:-$npm_prefix}" cli package_root package_json

  package_root="$prefix/lib/node_modules/prime-agent"
  cli="$package_root/dist/bundle/cli.js"
  package_json="$package_root/package.json"
  # npm install of a bare directory path creates a symlink into the mise
  # extract without dependencies. Require a real package tree.
  [[ -d "$package_root" && ! -L "$package_root" ]] \
    || die "prime-agent $version is not installed; run prx repair"
  [[ -f "$cli" && ! -L "$cli" ]] \
    || die "prime-agent $version is not installed; run prx repair"
  [[ -f "$package_json" && ! -L "$package_json" ]] \
    || die "prime-agent package metadata is missing: $package_json"
  [[ -d "$package_root/node_modules" && ! -L "$package_root/node_modules" ]] \
    || die "prime-agent dependencies are missing; run prx repair"
  jq -e --arg version "$version" '
    .name == "prime-agent" and .version == $version
  ' "$package_json" >/dev/null 2>&1 \
    || die "prime-agent package version differs: $package_json"
  printf '%s\n' "$cli"
}

verify_cli_version() {
  local cli="$1" version="$2" prefix="${3:-$npm_prefix}" actual status=0

  require_node
  # Prime Agent prints --version on stderr; merge it into the capture.
  if [[ -x "$prefix/bin/prime-agent" ]]; then
    actual="$("$prefix/bin/prime-agent" --version 2>&1)" || status=$?
  else
    actual="$(node "$cli" --version 2>&1)" || status=$?
  fi
  ((status == 0)) || die "could not run prime-agent $version"
  # Strip CR and surrounding whitespace; keep the first non-empty line.
  actual="$(printf '%s\n' "$actual" | tr -d '\r' | sed -e '/^[[:space:]]*$/d' | head -n 1 \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [[ "$actual" == "$version" ]] \
    || die "prime-agent version differs: expected $version, got ${actual:-<empty>}"
}

pack_package_tarball() {
  local package_dir="$1" version="$2" pack_dir packed tarball

  pack_dir="$(mktemp -d "$runtime_root/.pack.XXXXXX")" \
    || die 'could not stage prime-agent package pack directory'
  # npm install of a directory path symlinks without deps; pack to a tarball
  # first so the global install materializes dependencies.
  if ! (
    CDPATH= cd -P -- "$package_dir" || exit 1
    npm pack --pack-destination "$pack_dir" --loglevel=error --ignore-scripts
  ) >/dev/null 2>"$pack_dir/pack.err"; then
    cat "$pack_dir/pack.err" >&2 || true
    rm -rf -- "$pack_dir"
    die "npm could not pack prime-agent $version"
  fi
  packed="$(find "$pack_dir" -maxdepth 1 -type f -name 'prime-agent-*.tgz' -print)"
  if [[ "$(printf '%s\n' "$packed" | awk 'NF { count++ } END { print count + 0 }')" -ne 1 ]]; then
    rm -rf -- "$pack_dir"
    die "npm pack produced an unexpected prime-agent tarball set"
  fi
  tarball="$packed"
  [[ -f "$tarball" && ! -L "$tarball" ]] || {
    rm -rf -- "$pack_dir"
    die "unsafe packed prime-agent tarball: $tarball"
  }
  printf '%s\n' "$tarball"
}

staged_npm_prefix=''

stage_exact_version() {
  local version="$1" package_source tarball cli npm_log pack_dir

  require_command mise
  require_command npm
  require_node
  mise_env install "$mise_tool@$version" \
    || die "mise could not install prime-agent $version"
  package_source="$(resolve_package_source "$version")"
  [[ ! -L "$npm_prefix" ]] || die "unsafe npm prefix: $npm_prefix"
  if [[ -e "$npm_prefix" ]]; then
    [[ -d "$npm_prefix" ]] || die "unsafe npm prefix: $npm_prefix"
  fi
  tarball="$(pack_package_tarball "$package_source" "$version")"
  pack_dir="$(dirname "$tarball")"
  staged_npm_prefix="$(mktemp -d "$runtime_root/.npm-prefix-stage.XXXXXX")" \
    || {
      rm -rf -- "$pack_dir"
      die 'could not stage prime-agent npm prefix'
    }
  npm_log="$(mktemp "$runtime_root/.npm-install.XXXXXX")" \
    || {
      rm -rf -- "$pack_dir" "$staged_npm_prefix"
      die 'could not stage npm install log'
    }
  if ! PRIME_AGENT_BOOTSTRAP_TOOLS_ON_INSTALL=0 \
    PRIME_AGENT_BOOTSTRAP_KERNEL_ON_INSTALL=0 \
    PRIME_AGENT_INSTALL_UV=0 \
    npm install --global --prefix "$staged_npm_prefix" --no-fund --no-audit \
      --loglevel=error --progress=false "$tarball" \
    >"$npm_log" 2>&1; then
    cat "$npm_log" >&2 || true
    rm -f -- "$npm_log"
    rm -rf -- "$pack_dir" "$staged_npm_prefix"
    die "npm could not install prime-agent $version"
  fi
  rm -f -- "$npm_log"
  rm -rf -- "$pack_dir"
  cli="$(installed_cli "$version" "$staged_npm_prefix")"
  verify_cli_version "$cli" "$version" "$staged_npm_prefix"
}

publish_staged_runtime() {
  local prefix_stage="$1" prefix_backup=''

  if [[ -d "$npm_prefix" ]]; then
    prefix_backup="$(mktemp -d "$runtime_root/.npm-prefix-backup.XXXXXX")" \
      || {
        rm -rf -- "$prefix_stage"
        die 'could not stage prime-agent npm prefix backup'
      }
    rmdir "$prefix_backup"
    mv "$npm_prefix" "$prefix_backup" \
      || {
        rm -rf -- "$prefix_stage"
        die 'could not preserve installed prime-agent runtime'
      }
  fi
  if ! mv "$prefix_stage" "$npm_prefix"; then
    [[ -z "$prefix_backup" ]] || mv "$prefix_backup" "$npm_prefix"
    rm -rf -- "$prefix_stage"
    die 'could not publish installed prime-agent runtime'
  fi
  if [[ -n "$prefix_backup" ]] && ! rm -rf -- "$prefix_backup"; then
    printf 'prx: warning: could not remove old prime-agent runtime backup: %s\n' \
      "$prefix_backup" >&2
  fi
}

stage_installed_version_receipt() {
  local version="$1" staged

  staged="$(mktemp "$runtime_root/.installed-version.XXXXXX")" \
    || die 'could not stage prime-agent installed version receipt'
  printf '%s\n' "$version" >"$staged"
  chmod 0600 "$staged"
  printf '%s\n' "$staged"
}

install_exact_version() {
  local version="$1"

  stage_exact_version "$version"
  publish_staged_runtime "$staged_npm_prefix"
  staged_npm_prefix=''
}

publish_installed_version() {
  local version="$1" staged

  staged="$(stage_installed_version_receipt "$version")"
  mv -f "$staged" "$receipt_file"
  rm -f -- "$legacy_version_file"
}

adopt_exact_version() {
  local version="$1" receipt_stage prefix_backup='' adoption_error=''

  stage_exact_version "$version"
  receipt_stage="$(stage_installed_version_receipt "$version")"

  if [[ -d "$npm_prefix" ]]; then
    prefix_backup="$(mktemp -d "$runtime_root/.npm-prefix-backup.XXXXXX")" \
      || {
        rm -rf -- "$staged_npm_prefix" "$receipt_stage"
        die 'could not stage prime-agent npm prefix backup'
      }
    rmdir "$prefix_backup"
    mv "$npm_prefix" "$prefix_backup" \
      || {
        rm -rf -- "$staged_npm_prefix" "$receipt_stage"
        die 'could not preserve installed prime-agent runtime'
      }
  fi
  if ! mv "$staged_npm_prefix" "$npm_prefix"; then
    [[ -z "$prefix_backup" ]] || mv "$prefix_backup" "$npm_prefix"
    rm -rf -- "$staged_npm_prefix" "$receipt_stage"
    die 'could not publish installed prime-agent runtime'
  fi
  staged_npm_prefix=''

  if [[ "${PRX_TEST_FAIL_AT-}" == before-receipt-publication ]]; then
    adoption_error='injected failure before installed version receipt publication'
  elif ! mv -f "$receipt_stage" "$receipt_file"; then
    adoption_error='could not publish prime-agent installed version receipt'
  fi

  if [[ -n "$adoption_error" ]]; then
    rm -rf -- "$npm_prefix"
    if [[ -n "$prefix_backup" ]]; then
      mv "$prefix_backup" "$npm_prefix" \
        || die "could not restore prior prime-agent runtime after adoption failure"
    fi
    rm -f -- "$receipt_stage"
    die "$adoption_error"
  fi

  if ! rm -f -- "$legacy_version_file"; then
    printf 'prx: warning: could not remove legacy installed version receipt: %s\n' \
      "$legacy_version_file" >&2
  fi
  if [[ -n "$prefix_backup" ]] && ! rm -rf -- "$prefix_backup"; then
    printf 'prx: warning: could not remove old prime-agent runtime backup: %s\n' \
      "$prefix_backup" >&2
  fi
}

prime_version_if_available() {
  local version cli actual actual_version status=0

  if [[ -f "$receipt_file" && ! -L "$receipt_file" ]]; then
    version="$(<"$receipt_file")"
  elif [[ -f "$legacy_version_file" && ! -L "$legacy_version_file" ]]; then
    version="$(<"$legacy_version_file")"
  else
    return 0
  fi
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  cli="$npm_prefix/lib/node_modules/prime-agent/dist/bundle/cli.js"
  if [[ -x "$npm_prefix/bin/prime-agent" ]]; then
    actual="$("$npm_prefix/bin/prime-agent" --version 2>&1)" || status=$?
  elif [[ -f "$cli" && ! -L "$cli" ]] && command -v node >/dev/null 2>&1; then
    actual="$(node "$cli" --version 2>&1)" || status=$?
  else
    return 0
  fi
  ((status == 0)) || return 0
  actual_version="$(printf '%s\n' "$actual" | tr -d '\r' | sed -e '/^[[:space:]]*$/d' | head -n 1 | extract_semver)"
  [[ "$actual_version" == "$version" ]] || return 0
  printf '%s\n' "$version"
}

conservative_headless() {
  local question_tool_control="${1-none}"

  jq -cn \
    --arg questionToolControl "$question_tool_control" '
    {
      schemaVersion: 1,
      prompt: false,
      outputFormats: ["text"],
      eventContract: null,
      trellageEventContract: null,
      sessionId: "none",
      resume: false,
      resumeWithPrompt: false,
      questionToolControl: $questionToolControl,
      changedFiles: "none",
      usage: false,
      cost: false,
      modelOverride: false,
      effortOverride: false,
      testedHarnessVersion: null
    }
  '
}

projected_headless() {
  local profile="$1"
  local current_version expected_version

  current_version="$(prime_version_if_available)"
  expected_version="$(jq -r --arg profile "$profile" \
    '.profiles[$profile].headless.testedHarnessVersion // empty' "$catalog")"
  if [[ -z "$current_version" || "$current_version" != "$expected_version" ]]; then
    conservative_headless
    return
  fi
  jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
}

projected_headless_map_json() {
  jq -cn --argjson defaultProfile "$(projected_headless default)" '
    {default: $defaultProfile}
  '
}

check_proxy() {
  local selected_model="${1:-$model_id}" health models

  require_command curl
  health="$(curl -fsS --max-time 5 "${proxy_origin}/health")" \
    || die 'copilot-proxy-rs health check failed'
  jq -e '.status == "ok" or .status == "healthy"' <<<"$health" >/dev/null \
    || die 'copilot-proxy-rs health response is invalid'
  models="$(curl -fsS --max-time 5 "$proxy_models_url")" \
    || die 'copilot-proxy-rs model discovery failed'
  jq -e --arg model "$selected_model" '.data | any(.id == $model)' <<<"$models" >/dev/null \
    || die "copilot-proxy-rs model is missing: $selected_model"
}

pypi_host_reachable() {
  # Prime's uv bootstrap hits files.pythonhosted.org for wheels. Probe quickly.
  curl -fsS --max-time 5 -o /dev/null https://files.pythonhosted.org/ 2>/dev/null
}

uv_with_index() {
  # When the public files CDN is blocked, route uv to a reachable simple index.
  if pypi_host_reachable; then
    uv "$@"
  else
    UV_DEFAULT_INDEX="$pypi_fallback_index" UV_INDEX_URL="$pypi_fallback_index" uv "$@"
  fi
}

kernel_runtime_ready() {
  local python="$1"

  # venv bin/python is typically a symlink to the real interpreter; that is OK.
  [[ -x "$python" ]] || return 1
  "$python" -c 'import ipykernel' >/dev/null 2>&1 || return 1
  # Match prime-agent's runtime readiness gate (callable rlm + harness CRUD surface).
  "$python" -c '
import inspect
import rlm
from rlm import McpIntegration  # noqa: F401
from rlm.harness import HarnessEntry
methods = [
  "create_memory","update_memory","delete_memory",
  "create_skill","update_skill","delete_skill",
  "create_subagent","update_subagent","delete_subagent",
  "create_prompt_note","update_prompt_note","delete_prompt_note",
  "record_refinement",
]
assert hasattr(rlm, "run") and callable(rlm)
assert hasattr(rlm, "rlm") and callable(rlm.rlm)
assert callable(rlm.host_request)
assert callable(rlm.find_models) and callable(rlm.rlm.find_models)
assert hasattr(rlm, "harness") and hasattr(rlm, "get_harness_state")
assert hasattr(rlm.rlm, "harness") and hasattr(rlm.rlm, "get_harness_state")
assert all(
  callable(getattr(h, m, None))
  for h in (rlm.harness, rlm.rlm.harness)
  for m in methods
)
assert "reference" in HarnessEntry.__dataclass_fields__
assert "scope" in HarnessEntry.__dataclass_fields__
' >/dev/null 2>&1 || return 1
  "$python" -c '
import bs4, dill, dotenv, httpx, lxml, numpy, pandas, pydantic, requests, scipy, tomli, tyro, yaml
' >/dev/null 2>&1 || return 1
  return 0
}

resolve_runtime_source() {
  local candidate

  # Bundled with the managed npm install of prime-agent (not a PyPI package).
  candidate="$npm_prefix/lib/node_modules/prime-agent/dist/prime-agent-runtime"
  [[ -d "$candidate" && ! -L "$candidate" ]] \
    || die "bundled prime-agent-runtime is missing; run prx repair ($candidate)"
  [[ -f "$candidate/pyproject.toml" && ! -L "$candidate/pyproject.toml" ]] \
    || die "bundled prime-agent-runtime is incomplete: $candidate"
  printf '%s\n' "$candidate"
}

ensure_kernel_runtime() {
  local log runtime_source

  require_command uv
  require_command curl
  prepare_profile
  [[ ! -L "$kernel_venv" ]] || die "unsafe kernel venv path: $kernel_venv"

  if kernel_runtime_ready "$kernel_python"; then
    return 0
  fi

  runtime_source="$(resolve_runtime_source)"

  printf 'prx: bootstrapping Prime IPython kernel (one-time; needs network)…\n' >&2
  if ! pypi_host_reachable; then
    printf 'prx: files.pythonhosted.org unreachable; using %s\n' \
      "$pypi_fallback_index" >&2
  fi

  # Drop a partial/broken venv so install is deterministic.
  if [[ -e "$kernel_venv" ]]; then
    rm -rf -- "$kernel_venv"
  fi

  log="$(mktemp "$runtime_root/.kernel-bootstrap.XXXXXX")" \
    || die 'could not stage kernel bootstrap log'

  if ! uv_with_index python install 3.11 >"$log" 2>&1; then
    cat "$log" >&2 || true
    rm -f -- "$log"
    die 'uv could not install Python 3.11 for the Prime kernel'
  fi

  # Avoid --seed: seed packages pull from files.pythonhosted.org and fail when
  # that CDN is blocked even if a simple-index mirror works.
  if ! uv_with_index venv "$kernel_venv" --python 3.11 >"$log" 2>&1; then
    cat "$log" >&2 || true
    rm -f -- "$log"
    die 'uv could not create the Prime kernel venv'
  fi

  if ! uv_with_index pip install --python "$kernel_python" \
    "${kernel_pypi_packages[@]}" "$runtime_source" >"$log" 2>&1; then
    cat "$log" >&2 || true
    rm -f -- "$log"
    die 'uv could not install Prime kernel packages (ipykernel, prime-agent-runtime, …)'
  fi
  rm -f -- "$log"

  kernel_runtime_ready "$kernel_python" \
    || die "Prime kernel runtime is incomplete after install: $kernel_python"
  printf 'prx: kernel ready (%s)\n' "$kernel_python" >&2
}

verify_kernel_runtime() {
  [[ -x "$kernel_python" ]] \
    || die "Prime kernel python is missing; run prx setup or prx repair"
  [[ -d "$kernel_venv" && ! -L "$kernel_venv" ]] \
    || die "Prime kernel venv is missing or unsafe; run prx repair"
  kernel_runtime_ready "$kernel_python" \
    || die "Prime kernel runtime is incomplete; run prx repair"
}

write_daemon_env_stamp() {
  local staged

  staged="$(mktemp "$daemon_dir/.kernel-env.XXXXXX")" \
    || die 'could not stage daemon kernel env stamp'
  printf 'PRIME_AGENT_KERNEL_PYTHON=%s\nPRIME_AGENT_KERNEL_VENV=%s\n' \
    "$kernel_python" "$kernel_venv" >"$staged"
  chmod 0600 "$staged"
  mv -f "$staged" "$daemon_env_stamp"
}

daemon_env_stamp_matches() {
  local expected

  [[ -f "$daemon_env_stamp" && ! -L "$daemon_env_stamp" ]] || return 1
  expected="$(printf 'PRIME_AGENT_KERNEL_PYTHON=%s\nPRIME_AGENT_KERNEL_VENV=%s\n' \
    "$kernel_python" "$kernel_venv")"
  [[ "$(<"$daemon_env_stamp")" == "$expected" ]]
}

prepare_daemon_dir() {
  [[ ! -L "$daemon_dir" ]] || die "unsafe daemon directory: $daemon_dir"
  if [[ ! -e "$daemon_dir" ]]; then
    mkdir -p "$daemon_dir"
  fi
  [[ -d "$daemon_dir" && ! -L "$daemon_dir" ]] \
    || die "unsafe daemon directory: $daemon_dir"
  chmod 0700 "$daemon_dir"
}

# Targeted stop of the profile-local supervisor only (never global UID daemon).
# Uses Prime's shutdownDaemonAndWait — CLI "shutdown" discovers every socket and
# requires TTY confirmation, and "… --daemon-socket X shutdown" is treated as a
# chat prompt rather than the lifecycle command.
stop_profile_daemon_socket() {
  local launch_js="$npm_prefix/lib/node_modules/prime-agent/dist/cli/daemon-launch.js"
  local stopped=false

  [[ -f "$launch_js" && ! -L "$launch_js" ]] \
    || die "prime-agent daemon-launch module missing; run prx repair ($launch_js)"

  if [[ -S "$daemon_socket" ]]; then
    if PRX_DAEMON_SOCKET="$daemon_socket" PRX_DAEMON_LAUNCH_JS="$launch_js" \
      node --input-type=module -e '
import { pathToFileURL } from "node:url";
const launchJs = process.env.PRX_DAEMON_LAUNCH_JS;
const socket = process.env.PRX_DAEMON_SOCKET;
const { shutdownDaemonAndWait } = await import(pathToFileURL(launchJs).href);
const ok = await shutdownDaemonAndWait(socket, 10000);
process.exit(ok ? 0 : 2);
'; then
      stopped=true
    fi
  fi

  # If the socket file remains with no listener, drop the stale path.
  if [[ -e "$daemon_socket" || -L "$daemon_socket" ]]; then
    if ! PRX_DAEMON_SOCKET="$daemon_socket" node --input-type=module -e '
import { createConnection } from "node:net";
const socket = process.env.PRX_DAEMON_SOCKET;
await new Promise((resolve) => {
  const c = createConnection(socket);
  const done = (code) => { try { c.destroy(); } catch {} resolve(code); };
  c.setTimeout(250);
  c.once("connect", () => done(0));
  c.once("error", () => done(1));
  c.once("timeout", () => done(1));
}).then((code) => process.exit(code));
' 2>/dev/null; then
      rm -f -- "$daemon_socket"
    fi
  fi

  [[ "$stopped" == true ]]
}

# Shut down the profile-local daemon when the kernel paths change (or the stamp
# is missing). Safe no-op when nothing is listening.
restart_stale_profile_daemon() {
  prepare_daemon_dir
  if daemon_env_stamp_matches; then
    return 0
  fi

  if [[ -S "$daemon_socket" ]]; then
    printf 'prx: restarting profile daemon so kernel env reaches workers…\n' >&2
    stop_profile_daemon_socket >/dev/null 2>&1 || true
  fi

  write_daemon_env_stamp
}

shutdown_profile_daemon() {
  prepare_daemon_dir
  if [[ ! -S "$daemon_socket" ]]; then
    printf 'prx shutdown: no profile daemon socket\n'
    rm -f -- "$daemon_env_stamp"
    return 0
  fi
  if stop_profile_daemon_socket; then
    printf 'prx shutdown: stopped profile daemon\n'
  else
    printf 'prx shutdown: profile daemon was not running (cleared stale socket)\n'
  fi
  rm -f -- "$daemon_env_stamp"
}

setup_profile() {
  local version

  require_command mise
  if [[ -e "$receipt_file" || -L "$receipt_file" \
    || -e "$legacy_version_file" || -L "$legacy_version_file" ]]; then
    version="$(read_installed_version)"
  else
    version="$(resolve_latest_version)"
  fi
  install_exact_version "$version"
  publish_managed_profile
  ensure_floating_skills
  publish_installed_version "$version"
  ensure_kernel_runtime
  printf 'prx setup: ready (%s, %s)\n' "$version" "$model_id"
}

repair_profile() {
  local version

  require_command mise
  version="$(read_installed_version)"
  install_exact_version "$version"
  publish_managed_profile
  ensure_floating_skills
  ensure_kernel_runtime
  printf 'prx repair: restored (%s, %s)\n' "$version" "$model_id"
}

check_for_update() {
  local current latest

  require_command mise
  current="$(read_installed_version)"
  latest="$(resolve_latest_version)"
  if [[ "$current" == "$latest" ]]; then
    printf 'prx update: %s is current\n' "$current"
  else
    printf 'prx update: %s -> %s available\n' "$current" "$latest"
  fi
}

update_profile() {
  local current latest

  require_command mise
  ensure_floating_skills
  current="$(read_installed_version)"
  latest="$(resolve_latest_version)"
  if [[ "$current" == "$latest" ]]; then
    printf 'prx update: %s is current\n' "$current"
    return
  fi
  adopt_exact_version "$latest"
  printf 'prx update: %s -> %s installed\n' "$current" "$latest"
}

doctor_profile() {
  local version cli

  require_command mise
  verify_managed_profile
  version="$(read_installed_version)"
  cli="$(installed_cli "$version")"
  verify_cli_version "$cli" "$version"
  verify_kernel_runtime
  check_proxy
  printf 'prx doctor: OK (%s, %s)\n' "$version" "$model_id"
}

not_ready_inventory() {
  local profile="$1"
  local readiness="$2"

  jq -cn --arg profile "$profile" --arg readiness "$readiness" '{
    schemaVersion: 1,
    launcher: "prx",
    harness: "prime",
    profile: $profile,
    readiness: $readiness,
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

inventory_profile() {
  local profile="$1"

  [[ "$profile" == default ]] || die "unknown profile: $profile"
  if [[ ! -f "$profile_marker" || -L "$profile_marker" ]]; then
    not_ready_inventory "$profile" not-setup
    return
  fi
  if ! (doctor_profile >/dev/null 2>&1); then
    not_ready_inventory "$profile" unhealthy
    return
  fi
  jq -cn --arg profile "$profile" '{
    schemaVersion: 1,
    launcher: "prx",
    harness: "prime",
    profile: $profile,
    readiness: "healthy",
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

launch_prime() {
  local version cli selected_model="$model_id"
  local -a prime_args=() command_args

  while (( $# > 0 )); do
    case "$1" in
      --model)
        [[ $# -ge 2 && -n "$2" ]] || die '--model requires a value'
        selected_model="$2"
        shift 2
        ;;
      --model=*)
        selected_model="${1#--model=}"
        [[ -n "$selected_model" ]] || die '--model requires a value'
        shift
        ;;
      *)
        prime_args+=("$1")
        shift
        ;;
    esac
  done

  require_command mise
  require_node
  if [[ ! -e "$receipt_file" && ! -L "$receipt_file" \
    && ! -e "$legacy_version_file" && ! -L "$legacy_version_file" ]]; then
    setup_profile >/dev/null
  fi
  publish_managed_profile "$selected_model"
  ensure_floating_skills
  version="$(read_installed_version)"
  cli="$(installed_cli "$version")"
  verify_cli_version "$cli" "$version"
  ensure_kernel_runtime
  restart_stale_profile_daemon
  check_proxy "$selected_model"
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY
  unset COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN
  command_args=(
    "$cli"
    --provider "$provider"
    --model "$selected_model"
    --offline
    --autonomous
    --daemon-socket "$daemon_socket"
  )
  # Bash 3.2 treats an empty array expansion as unbound under `set -u`.
  if (( ${#prime_args[@]} > 0 )); then
    command_args+=("${prime_args[@]}")
  fi
  exec env \
    PRIME_AGENT_CODING_AGENT_DIR="$profile_home" \
    PRIME_AGENT_KERNEL_PYTHON="$kernel_python" \
    PRIME_AGENT_KERNEL_VENV="$kernel_venv" \
    node "${command_args[@]}"
}

require_command jq
validate_catalog

case "${1-}" in
  help|-h|--help)
    usage
    ;;
  list)
    shift
    if [[ "$#" -eq 0 ]]; then
      list_profiles
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  inventory)
    shift
    [[ "$#" -eq 2 && "$2" == '--json' ]] || die 'inventory requires PROFILE --json'
    inventory_profile "$1"
    ;;
  setup|doctor|repair)
    command_name="$1"
    shift
    [[ "$#" -le 1 ]] || die "$command_name accepts only default"
    require_default_profile "${1-default}"
    "${command_name}_profile"
    ;;
  shutdown)
    shift
    [[ "$#" -le 1 ]] || die 'shutdown accepts only default'
    require_default_profile "${1-default}"
    require_command mise
    require_node
    shutdown_profile_daemon
    ;;
  update)
    shift
    check_only=false
    if [[ "${1-}" == --check ]]; then
      check_only=true
      shift
    fi
    [[ "$#" -le 1 ]] || die 'usage: prx update [--check] [default]'
    require_default_profile "${1-default}"
    if [[ "$check_only" == true ]]; then
      check_for_update
    else
      update_profile
    fi
    ;;
  default)
    shift
    launch_prime "$@"
    ;;
  *)
    launch_prime "$@"
    ;;
esac
