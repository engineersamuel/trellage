#!/usr/bin/env bash

set -euo pipefail

readonly provider='copilot-proxy-rs'
readonly model_id='qwen3.6-35b-a3b-local'
readonly model_selector="$provider/$model_id"
readonly copilot_model_selector='github-copilot/gpt-5.6-sol:medium'
readonly profile_marker_value='trellage-omp-profile-v1'
readonly verified_headless_policy_version='18.8.5'
readonly minimum_community_skills_version='17.3.5'

die() {
  printf 'omp: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  omp list [--json]
  omp inventory PROFILE --json
  omp setup [local|copilot|--all]
  omp doctor [local|copilot]
  omp repair [local|copilot]
  omp reap [local|copilot]
  omp skills-update PROFILE
  omp skills-check PROFILE
  omp update [--check] [local|copilot|--all]
  omp harness-version

Launch with `trx run omp default` or `trx run omp local`.
EOF
}

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)" || die 'could not resolve launcher directory'
launcher_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" \
  || die 'could not resolve launcher root'
runtime_root="$launcher_root"
readonly catalog="$launcher_root/catalog.json"
floating_skills_manager="$runtime_root/../common/floating-skills-runtime/scripts/floating-skills.ts"
floating_skills_catalog="$runtime_root/../common/floating-skills-runtime/config.toml"
if [[ ! -f "$floating_skills_manager" ]]; then
  floating_skills_manager="$runtime_root/../../scripts/floating-skills.ts"
  floating_skills_catalog="$runtime_root/../../config.toml"
  runtime_root="$HOME/.local/share/trellage/omp"
fi
bun_runner="${floating_skills_manager%/*}/run-source.sh"
readonly community_skills_cache="${XDG_DATA_HOME:-$HOME/.local/share}/trellage/common/omp-community-skills"

profile_key=''
profile_kind=''
profile_name=''
profile_root=''
agent_root=''
profile_marker=''
managed_overlay_path=''
launch_child_pid=''
launch_overlay_path=''
launch_headless_policy=''
launch_pending_signal=''
launch_cancel_status=0
launch_forwarded_args=()
community_skills_enabled=false
host_omp=''
host_omp_version=''
initialization_lock_path=''
initialization_lock_candidate=''
initialization_lock_claim=''
initialization_lock_reap=''
initialization_lock_owner=''

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

ensure_floating_skills() {
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "invalid floating-skills manager: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "invalid floating-skills catalog: $floating_skills_catalog"
  "$bun_runner" "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle native-common \
    --target "$agent_root/skills" \
    || die "failed to install floating skills: $profile_key"
}

ensure_community_skills() {
  [[ "$community_skills_enabled" == true ]] || return 0
  "$bun_runner" "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle omp-community \
    --cache "$community_skills_cache" \
    --target "$agent_root/community-skills" \
    || die "failed to install OMP community skills: $profile_key"
}

check_community_skills() {
  [[ "$community_skills_enabled" == true ]] || return 0
  "$bun_runner" "$floating_skills_manager" verify \
    --catalog "$floating_skills_catalog" \
    --bundle omp-community \
    --cache "$community_skills_cache" \
    --target "$agent_root/community-skills" \
    || die "failed to validate OMP community skills: $profile_key"
}

skills_update_profile() {
  local helper="$launcher_root/native-skills.ts"
  local cache="${XDG_DATA_HOME:-$HOME/.local/share}/trellage/common/skills"
  local skill_args=("${1:---sync}")
  [[ "${skill_args[0]}" != --fresh ]] || skill_args+=("$floating_skills_catalog")

  require_owned_profile
  [[ -e "$helper" || -L "$helper" ]] || helper="$launcher_root/../trellage-claude-common/native-skills.ts"
  [[ -f "$helper" && ! -L "$helper" ]] || die "missing or unsafe Native skills helper: $helper"
  if [[ "${skill_args[0]}" == --fresh ]]; then
    exec "$bun_runner" "$helper" "$floating_skills_manager" "${skill_args[@]}" \
      "$cache" "$agent_root/skills" "$community_skills_cache" "$agent_root/community-skills"
  fi
  "$bun_runner" "$helper" "$floating_skills_manager" "${skill_args[@]}" \
    "$cache" "$agent_root/skills" \
    "$community_skills_cache" "$agent_root/community-skills" \
    || die "failed to update cached skills: $profile_key"
  [[ "${skill_args[0]}" == --fresh ]] || printf '%s: skills updated from cache\n' "$profile_key"
}

version_at_least() {
  local actual="$1" minimum="$2"
  local actual_major actual_minor actual_patch minimum_major minimum_minor minimum_patch

  [[ "$actual" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  actual_major="${BASH_REMATCH[1]}"
  actual_minor="${BASH_REMATCH[2]}"
  actual_patch="${BASH_REMATCH[3]}"
  [[ "$minimum" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  minimum_major="${BASH_REMATCH[1]}"
  minimum_minor="${BASH_REMATCH[2]}"
  minimum_patch="${BASH_REMATCH[3]}"

  (( 10#$actual_major > 10#$minimum_major )) && return 0
  (( 10#$actual_major < 10#$minimum_major )) && return 1
  (( 10#$actual_minor > 10#$minimum_minor )) && return 0
  (( 10#$actual_minor < 10#$minimum_minor )) && return 1
  (( 10#$actual_patch >= 10#$minimum_patch ))
}

configure_version_capabilities() {
  if version_at_least "$1" "$minimum_community_skills_version"; then
    community_skills_enabled=true
  else
    community_skills_enabled=false
  fi
}

canonical_directory() {
  CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P
}

validate_catalog() {
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "invalid catalog: $catalog"
  jq -e '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    type == "object"
    and keys == ["profiles", "schemaVersion"]
    and .schemaVersion == 1
    and (.profiles | type == "object" and keys == ["copilot", "local"])
    and all(.profiles | to_entries[];
      (.key | test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.value | type == "object")
      and (.value | keys
        == ["description", "headless", "kind", "ompProfile", "plugin", "standaloneMcps"])
      and (.value.description
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not))
      and (.value.headless | validHeadless)
      and (.value.kind == .key)
      and (.value.ompProfile
        | type == "string"
        and test("^trellage-[a-z0-9]+(-[a-z0-9]+)*$"))
      and .value.plugin == null
      and (.value.standaloneMcps | type == "array" and length == 0))
  ' "$catalog" >/dev/null 2>&1 || die "invalid catalog: $catalog"
}

select_profile() {
  local requested="$1"

  jq -e --arg profile "$requested" '.profiles[$profile] != null' "$catalog" \
    >/dev/null || die "unknown profile: $requested"
  profile_key="$requested"
  profile_kind="$(jq -r --arg profile "$requested" '.profiles[$profile].kind' "$catalog")"
  profile_name="$(jq -r --arg profile "$requested" '.profiles[$profile].ompProfile' "$catalog")"
  profile_root="$HOME/.omp/profiles/$profile_name"
  agent_root="$profile_root/agent"
  profile_marker="$profile_root/.managed-by-trellage-omp-profiles"
  managed_overlay_path="$runtime_root/overlays/$profile_key.yml"
}

list_profiles() {
  jq -r '.profiles | to_entries | sort_by(.key)[] | [.key, .value.description] | @tsv' "$catalog"
}

list_profiles_json() {
  local headless_map

  headless_map="$(projected_headless_map_json)"
  jq -S --argjson headless "$headless_map" '
    {
      schemaVersion: 1,
      launcher: "omp",
      harness: "oh-my-pi",
      # oh-my-pi has no known native OS-level sandbox; runs directly on the
      # host. See docs/native-sandbox-research.md.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries
        | sort_by(.key)[]
        | {
            name: .key,
            description: .value.description,
            headless: $headless[.key],
            plugin: .value.plugin,
            source: null,
            marketplace: null,
            standaloneMcps: .value.standaloneMcps
          }
      ]
    }
  ' "$catalog"
}

require_safe_home() {
  local canonical_home

  [[ "$HOME" == /* && "$HOME" != / && -d "$HOME" && ! -L "$HOME" ]] \
    || die "unsafe HOME: $HOME"
  canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
  [[ "$canonical_home" != / ]] || die "unsafe HOME: $HOME"
}

require_safe_profile_path() {
  local path="$HOME" component canonical_home canonical_path

  require_safe_home
  canonical_home="$(canonical_directory "$HOME")"
  for component in .omp profiles "$profile_name" agent; do
    path="$path/$component"
    [[ ! -L "$path" ]] || die "unsafe profile path: $path"
    if [[ -e "$path" ]]; then
      [[ -d "$path" ]] || die "unsafe profile path: $path"
      canonical_path="$(canonical_directory "$path")" || die "cannot resolve profile path: $path"
      case "$canonical_path" in
        "$canonical_home"/*) ;;
        *) die "redirected profile path: $path" ;;
      esac
    fi
  done
}

profile_is_owned_or_adoptable() {
  if [[ -e "$profile_marker" || -L "$profile_marker" ]]; then
    [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
    [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] || return 1
    return 0
  fi
  [[ "$profile_kind" != local ]] && return 0
  [[ ! -L "$agent_root/models.yml" && ! -e "$agent_root/models.yml" ]]
}

require_owned_profile() {
  require_safe_profile_path
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] \
    || die "profile is not managed; run omp setup $profile_key"
  [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] \
    || die "profile ownership marker differs: $profile_marker"
}

prepare_profile_directories() {
  local path="$HOME" component

  require_safe_profile_path
  profile_is_owned_or_adoptable || die "refusing unrelated existing profile files: $profile_root"
  for component in .omp profiles "$profile_name" agent; do
    path="$path/$component"
    [[ -e "$path" ]] || mkdir "$path"
    [[ -d "$path" && ! -L "$path" ]] || die "unsafe profile path: $path"
  done
  chmod 0700 "$profile_root" "$agent_root"
  require_safe_profile_path
}

managed_overlay() {
  cat <<EOF
setupVersion: 1
startup:
  checkUpdate: false
  setupWizard: false
marketplace:
  autoUpdate: off
EOF
  if [[ "$community_skills_enabled" == true ]]; then
    cat <<EOF
skills:
  customDirectories:
    - "$(printf '%s' "$agent_root/community-skills" | sed 's/\\/\\\\/g; s/"/\\"/g')"
EOF
  fi
  if [[ "$profile_kind" == local ]]; then
    cat <<EOF
modelRoles:
  default: $model_selector
  smol: $model_selector
  slow: $model_selector
  vision: $model_selector
  plan: $model_selector
  commit: $model_selector
  tiny: $model_selector
  task: $model_selector
  advisor: $model_selector
enabledModels:
  - $model_selector
EOF
  else
    cat <<EOF
modelRoles:
  default: $copilot_model_selector
  smol: github-copilot/gpt-5.6-sol:low
  slow: github-copilot/gpt-5.6-sol:high
  vision: github-copilot/gpt-5.6-sol:medium
  plan: github-copilot/gpt-5.6-sol:high
  commit: github-copilot/gpt-5.6-sol:low
  tiny: github-copilot/gpt-5.6-sol:low
  task: github-copilot/gpt-5.6-sol:medium
  advisor: github-copilot/gpt-5.6-sol:high
EOF
  fi
  cat <<'EOF'
tools:
  approvalMode: yolo
bash:
  gitGuard: true
secrets:
  enabled: true
providers:
  cacheWarming: streaming
EOF
}

managed_local_models() {
  cat <<EOF
providers:
  $provider:
    baseUrl: http://127.0.0.1:8080/v1
    api: openai-responses
    auth: none
    discovery:
      type: openai-models-list
EOF
}

publish_local_models() (
  local stage=''

  require_safe_profile_path
  [[ ! -L "$agent_root/models.yml" \
    && ( ! -e "$agent_root/models.yml" || -f "$agent_root/models.yml" ) ]] \
    || die "unsafe managed profile file: $agent_root/models.yml"
  trap '[[ -z "$stage" ]] || rm -f -- "$stage"' EXIT
  stage="$(mktemp "$agent_root/.models.yml.XXXXXX")"
  managed_local_models >"$stage"
  chmod 0600 "$stage"
  mv -f "$stage" "$agent_root/models.yml"
  stage=''
)

verify_local_models() {
  [[ ! -L "$agent_root/models.yml" && -f "$agent_root/models.yml" ]] \
    || die "managed models config is missing: $agent_root/models.yml"
  cmp -s "$agent_root/models.yml" <(managed_local_models) \
    || die "managed models config differs; run omp repair $profile_key"
}

require_safe_overlay_path() {
  local marker="$runtime_root/.managed-by-trellage-omp-profiles"
  local directory="$runtime_root/overlays"
  local path="$HOME" component

  if [[ "$runtime_root" != "$launcher_root" ]]; then
    require_safe_home
    for component in .local share trellage omp; do
      path="$path/$component"
      [[ -d "$path" && ! -L "$path" ]] || die "unsafe runtime path: $path"
    done
  fi

  [[ -d "$runtime_root" && ! -L "$runtime_root" ]] || die "unsafe runtime root: $runtime_root"
  [[ -f "$marker" && ! -L "$marker" ]] || die "unowned runtime root: $runtime_root"
  [[ "$(<"$marker")" == trellage-omp-profiles-v2 \
    || "$(<"$marker")" == trellage-omp-profiles-v1 ]] || die "unowned runtime root: $runtime_root"
  [[ ! -L "$directory" && ( ! -e "$directory" || -d "$directory" ) ]] \
    || die "unsafe overlay directory: $directory"
  [[ ! -L "$managed_overlay_path" \
    && ( ! -e "$managed_overlay_path" || -f "$managed_overlay_path" ) ]] \
    || die "unsafe managed overlay: $managed_overlay_path"
}

initialization_lock_file_is_safe() {
  local path="$1" mode

  [[ -f "$path" && ! -L "$path" ]] || return 1
  if ! mode="$(stat -f '%Lp' "$path" 2>/dev/null)"; then
    mode="$(stat -c '%a' "$path" 2>/dev/null)" || return 1
  fi
  [[ "$mode" == 600 ]]
}

valid_process_birth_identity() {
  local birth="$1" weekday month day hour minute second year month_num max_day day_num year_num
  local weekday_year weekday_index month_offset
  local -a month_offsets=(0 3 2 5 0 3 5 1 4 6 2 4)
  local -a weekday_names=(Sun Mon Tue Wed Thu Fri Sat)
  local identity_regex='^(Sun|Mon|Tue|Wed|Thu|Fri|Sat)(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)([1-9]|[12][0-9]|3[01])([01][0-9]|2[0-3])([0-5][0-9])([0-5][0-9])([0-9]{4})$'

  [[ "$birth" =~ $identity_regex ]] || return 1
  weekday="${BASH_REMATCH[1]}"
  month="${BASH_REMATCH[2]}"
  day="${BASH_REMATCH[3]}"
  hour="${BASH_REMATCH[4]}"
  minute="${BASH_REMATCH[5]}"
  second="${BASH_REMATCH[6]}"
  year="${BASH_REMATCH[7]}"
  case "$month" in
    Jan) month_num=1; max_day=31 ;;
    Feb) month_num=2; max_day=28 ;;
    Mar) month_num=3; max_day=31 ;;
    Apr) month_num=4; max_day=30 ;;
    May) month_num=5; max_day=31 ;;
    Jun) month_num=6; max_day=30 ;;
    Jul) month_num=7; max_day=31 ;;
    Aug) month_num=8; max_day=31 ;;
    Sep) month_num=9; max_day=30 ;;
    Oct) month_num=10; max_day=31 ;;
    Nov) month_num=11; max_day=30 ;;
    Dec) month_num=12; max_day=31 ;;
  esac
  day_num=$((10#$day))
  year_num=$((10#$year))
  (( year_num > 0 )) || return 1
  if (( month_num == 2 && (year_num % 400 == 0 || (year_num % 4 == 0 && year_num % 100 != 0)) )); then
    max_day=29
  fi
  (( day_num <= max_day )) || return 1
  weekday_year="$year_num"
  if (( month_num < 3 )); then
    weekday_year=$((weekday_year - 1))
  fi
  month_offset="${month_offsets[$((month_num - 1))]}"
  weekday_index=$(( (weekday_year + weekday_year / 4 - weekday_year / 100 + weekday_year / 400 + month_offset + day_num) % 7 ))
  [[ "$weekday" == "${weekday_names[$weekday_index]}" ]]
}

process_birth_identity() (
  local pid="$1" output_file diagnostic_file value compact status
  local row_regex='^ *(Sun|Mon|Tue|Wed|Thu|Fri|Sat) (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) +([1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]) ([0-9]{4}) *$'

  output_file="$(mktemp "${TMPDIR:-/tmp}/trellage-omp-ps-output.XXXXXX")" \
    || return 2
  diagnostic_file="$(mktemp "${TMPDIR:-/tmp}/trellage-omp-ps-diagnostic.XXXXXX")" \
    || { rm -f -- "$output_file"; return 2; }
  trap 'rm -f -- "$output_file" "$diagnostic_file"' EXIT
  if TZ=UTC LC_ALL=C ps -p "$pid" -o lstart= >"$output_file" 2>"$diagnostic_file"; then
    status=0
  else
    status=$?
  fi
  [[ ! -s "$diagnostic_file" ]] || return 2
  if [[ "$status" != 0 ]]; then
    [[ ! -s "$output_file" ]] && return 1
    return 2
  fi
  IFS= read -r value <"$output_file" || return 2
  cmp -s "$output_file" <(printf '%s\n' "$value") || return 2
  [[ "$value" =~ $row_regex ]] || return 2
  compact="$(printf '%s' "$value" | LC_ALL=C tr -cd '[:alnum:]')" || return 2
  valid_process_birth_identity "$compact" || return 2
  printf '%s\n' "$compact"
)

process_is_absent() {
  local pid="$1" diagnostic

  if diagnostic="$(LC_ALL=C kill -0 "$pid" 2>&1)"; then
    return 1
  fi
  case "$diagnostic" in
    *[Nn]o\ such\ process*|*ESRCH*) return 0 ;;
    *) return 1 ;;
  esac
}

pending_launch_signal_status() {
  case "$launch_pending_signal" in
    HUP) printf '129\n' ;;
    INT) printf '130\n' ;;
    TERM) printf '143\n' ;;
    *) return 1 ;;
  esac
}

read_initialization_lock_owner() {
  local path="$1" pid birth token extra

  initialization_lock_file_is_safe "$path" || return 1
  IFS=' ' read -r pid birth token extra <"$path" || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ "$birth" =~ ^[A-Za-z0-9]+$ ]] || return 1
  [[ "$token" =~ ^[1-9][0-9]*-[0-9]+$ ]] || return 1
  [[ "${token%%-*}" == "$pid" ]] || return 1
  [[ -z "$extra" ]] || return 1
  cmp -s "$path" <(printf '%s %s %s\n' "$pid" "$birth" "$token") || return 1
  printf '%s %s %s\n' "$pid" "$birth" "$token"
}

initialization_file_identity() {
  local path="$1" identity

  identity="$(stat -f '%d:%i' "$path" 2>/dev/null)" \
    || identity="$(stat -c '%d:%i' "$path" 2>/dev/null)" \
    || return 1
  [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] || return 1
  printf '%s\n' "$identity"
}

reap_profile_initialization_claim() (
  local reap="$runtime_root/.profile-initialization-$profile_key.reap"
  local owner claim_pid claim_birth current_birth expected_identity actual_identity
  local staging_dir staging nested_claim restored=false identity_status=0

  require_safe_overlay_path
  [[ "$reap" == "$runtime_root/.profile-initialization-$profile_key.reap" ]] \
    || die "unsafe profile initialization recovery claim: $profile_key"
  [[ -f "$reap" && ! -L "$reap" ]] \
    || die "unsafe profile initialization recovery claim: $profile_key"
  initialization_lock_file_is_safe "$reap" \
    || die "unsafe profile initialization recovery claim: $profile_key"
  expected_identity="$(initialization_file_identity "$reap")" \
    || die "could not identify profile initialization recovery claim: $profile_key"
  owner="$(read_initialization_lock_owner "$reap" 2>/dev/null || :)"
  [[ -n "$owner" ]] || die "malformed profile initialization recovery claim: $profile_key"
  claim_pid="${owner%% *}"
  claim_birth="${owner#* }"
  claim_birth="${claim_birth%% *}"
  [[ "$claim_pid" =~ ^[1-9][0-9]*$ ]] \
    && valid_process_birth_identity "$claim_birth" \
    || die "malformed profile initialization recovery claim: $profile_key"
  [[ "$(initialization_file_identity "$reap" 2>/dev/null || :)" == "$expected_identity" ]] \
    || die "profile initialization recovery claim changed during reap: $profile_key"
  if current_birth="$(process_birth_identity "$claim_pid" 2>/dev/null)"; then
    [[ "$current_birth" != "$claim_birth" ]] \
      || die "profile initialization claim is live: $profile_key"
  else
    identity_status=$?
    if [[ "$identity_status" != 1 ]] || ! process_is_absent "$claim_pid"; then
      die "could not verify profile initialization claim identity: $profile_key"
    fi
  fi

  staging_dir="$(mktemp -d "$runtime_root/.profile-initialization-$profile_key.reap.XXXXXX")" \
    || die "could not stage profile initialization recovery claim: $profile_key"
  trap 'rmdir "$staging_dir" 2>/dev/null || :' EXIT
  chmod 0700 "$staging_dir" || die "could not secure profile initialization recovery claim: $profile_key"
  staging="$staging_dir/claim"
  if ! mv -n -- "$reap" "$staging"; then
    die "could not claim profile initialization recovery file: $profile_key"
  fi
  if [[ -d "$staging" && ! -L "$staging" ]]; then
    nested_claim="$staging/${reap##*/}"
    [[ ! -e "$reap" && ! -L "$reap" ]] \
      && [[ "$(initialization_file_identity "$nested_claim" 2>/dev/null || :)" == "$expected_identity" ]] \
      && [[ "$(read_initialization_lock_owner "$nested_claim" 2>/dev/null || :)" == "$owner" ]] \
      && ln "$nested_claim" "$reap" 2>/dev/null || :
    die "profile initialization recovery claim changed during reap: $profile_key"
  fi
  [[ ! -e "$reap" && ! -L "$reap" ]] \
    || die "profile initialization recovery claim changed during reap: $profile_key"
  actual_identity="$(initialization_file_identity "$staging" 2>/dev/null || :)"
  if [[ "$actual_identity" != "$expected_identity" ]] \
    || [[ "$(read_initialization_lock_owner "$staging" 2>/dev/null || :)" != "$owner" ]]; then
    if [[ ! -e "$reap" && ! -L "$reap" ]] && ln "$staging" "$reap" 2>/dev/null; then
      rm -f -- "$staging"
      restored=true
    fi
    if [[ "$restored" != true && ! -e "$reap" && ! -L "$reap" ]]; then
      if mv -n -- "$staging" "$reap" 2>/dev/null \
        && [[ ! -e "$staging" && -e "$reap" ]]; then
        restored=true
      fi
    fi
    [[ "$restored" == true ]] || die "profile initialization recovery claim changed during reap: $profile_key"
    die "profile initialization recovery claim changed during reap: $profile_key"
  fi
  rm -f -- "$staging" \
    || die "could not remove stale profile initialization recovery claim: $profile_key"
  rmdir "$staging_dir" \
    || die "could not clean stale profile initialization recovery staging: $profile_key"
  printf 'omp reap %s: removed stale initialization claim\n' "$profile_key"
)

acquire_profile_initialization_lock() {
  local lock="$runtime_root/.profile-initialization-$profile_key.lock"
  local reap="$runtime_root/.profile-initialization-$profile_key.reap"
  local candidate owner claimed_owner claim_pid claim_birth pid owner_birth current_birth token candidate_birth
  local current_owner

  [[ -z "$initialization_lock_path" ]] || die 'internal error: profile initialization lock already held'
  require_safe_overlay_path
  [[ ! -L "$lock" ]] || die "unsafe profile initialization lock: $profile_key"
  [[ ! -e "$lock" || -f "$lock" ]] || die "unsafe profile initialization lock: $profile_key"
  [[ ! -L "$reap" ]] || die "unsafe profile initialization recovery: $profile_key"
  [[ ! -e "$reap" || -f "$reap" ]] || die "unsafe profile initialization recovery: $profile_key"

  candidate="$(mktemp "$runtime_root/.profile-initialization-$profile_key.XXXXXX")" \
    || die "could not stage profile initialization lock: $profile_key"
  initialization_lock_candidate="$candidate"
  candidate_birth="$(process_birth_identity "$$" 2>/dev/null || printf '%s\n' unavailable)"
  token="$$-${RANDOM:-0}"
  printf '%s %s %s\n' "$$" "$candidate_birth" "$token" >"$candidate" \
    || die "could not write profile initialization lock: $profile_key"
  chmod 0600 "$candidate" || die "could not secure profile initialization lock: $profile_key"

  while :; do
    if [[ -n "$launch_pending_signal" ]]; then
      launch_cancel_status="$(pending_launch_signal_status)"
      return "$launch_cancel_status"
    fi
    require_safe_overlay_path
    [[ ! -L "$lock" ]] || die "unsafe profile initialization lock: $profile_key"
    [[ ! -e "$lock" || -f "$lock" ]] || die "unsafe profile initialization lock: $profile_key"
    if [[ -e "$reap" || -L "$reap" ]]; then
      initialization_lock_file_is_safe "$reap" \
        || die "unsafe profile initialization recovery: $profile_key"
      claimed_owner="$(read_initialization_lock_owner "$reap" 2>/dev/null || :)"
      [[ -n "$claimed_owner" ]] || die "unsafe profile initialization recovery: $profile_key"
      claim_pid="${claimed_owner%% *}"
      claim_birth="${claimed_owner#* }"
      claim_birth="${claim_birth%% *}"
      if kill -0 "$claim_pid" 2>/dev/null; then
        current_birth="$(process_birth_identity "$claim_pid" 2>/dev/null || printf '%s\n' unavailable)"
        if [[ "$claim_birth" == unavailable || "$current_birth" == unavailable || "$claim_birth" == "$current_birth" ]]; then
          sleep 0.05
          continue
        fi
      fi
      die "stale profile initialization recovery: $profile_key"
    fi
    if ln "$candidate" "$lock" 2>/dev/null; then
      initialization_lock_path="$lock"
      initialization_lock_reap="$reap"
      initialization_lock_owner="$$ $candidate_birth $token"
      rm -f -- "$candidate" || die "could not clean profile initialization lock staging: $profile_key"
      initialization_lock_candidate=''
      return 0
    fi
    [[ -e "$lock" ]] || continue

    owner="$(read_initialization_lock_owner "$lock" 2>/dev/null || :)"
    [[ -n "$owner" ]] || {
      [[ ! -e "$lock" && ! -L "$lock" ]] && continue
      die "unsafe profile initialization lock: $profile_key"
    }
    pid="${owner%% *}"
    owner_birth="${owner#* }"
    owner_birth="${owner_birth%% *}"
    if kill -0 "$pid" 2>/dev/null; then
      current_birth="$(process_birth_identity "$pid" 2>/dev/null || printf '%s\n' unavailable)"
      if [[ "$owner_birth" == unavailable || "$current_birth" == unavailable || "$owner_birth" == "$current_birth" ]]; then
        sleep 0.05
        continue
      fi
    fi

    if ln "$candidate" "$reap" 2>/dev/null; then
      claimed_owner="$(read_initialization_lock_owner "$reap" 2>/dev/null || :)"
      if [[ "$claimed_owner" != "$$ $candidate_birth $token" ]]; then
        rm -f -- "$reap" || die "could not discard changed profile initialization recovery: $profile_key"
        continue
      fi
      current_owner="$(read_initialization_lock_owner "$lock" 2>/dev/null || :)"
      if [[ "$current_owner" != "$owner" ]]; then
        rm -f -- "$reap" || die "could not discard changed profile initialization recovery: $profile_key"
        continue
      fi
      initialization_lock_claim="$reap"
      initialization_lock_owner="$$ $candidate_birth $token"
      rm -f -- "$lock" || die "could not recover profile initialization lock: $profile_key"
      rm -f -- "$reap" || die "could not clean profile initialization recovery: $profile_key"
      initialization_lock_claim=''
      initialization_lock_owner=''
    fi
  done
}

profile_committed_ready() {
  require_safe_profile_path
  require_safe_overlay_path
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
  [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] || return 1
  [[ -f "$managed_overlay_path" && ! -L "$managed_overlay_path" ]] || return 1
  cmp -s "$managed_overlay_path" <(managed_overlay) || return 1
  if [[ "$profile_kind" == local ]]; then
    [[ -f "$agent_root/models.yml" && ! -L "$agent_root/models.yml" ]] || return 1
    cmp -s "$agent_root/models.yml" <(managed_local_models) || return 1
  fi
}

release_profile_initialization_lock() {
  local lock="$initialization_lock_path" owner claim_owner

  if [[ -n "$initialization_lock_candidate" ]]; then
    rm -f -- "$initialization_lock_candidate"
    initialization_lock_candidate=''
  fi
  if [[ -n "$initialization_lock_claim" ]]; then
    if [[ -e "$initialization_lock_claim" || -L "$initialization_lock_claim" ]]; then
      claim_owner="$(read_initialization_lock_owner "$initialization_lock_claim")" || return 1
      [[ "$claim_owner" == "$initialization_lock_owner" ]] || return 1
      rm -f -- "$initialization_lock_claim" || return 1
    fi
    initialization_lock_claim=''
  fi
  [[ -n "$lock" ]] || return 0
  if [[ ! -e "$lock" && ! -L "$lock" ]]; then
    initialization_lock_path=''
    initialization_lock_reap=''
    initialization_lock_owner=''
    return 0
  fi
  owner="$(read_initialization_lock_owner "$lock")" || return 1
  [[ "$owner" == "$initialization_lock_owner" ]] || return 1
  rm -f -- "$lock" || return 1
  initialization_lock_path=''
  initialization_lock_reap=''
  initialization_lock_owner=''
}

publish_managed_overlay() (
  local stage=''

  require_safe_profile_path
  require_safe_overlay_path
  trap '[[ -z "$stage" ]] || rm -f -- "$stage"' EXIT
  [[ -e "$runtime_root/overlays" ]] || mkdir "$runtime_root/overlays"
  chmod 0700 "$runtime_root/overlays"
  stage="$(mktemp "$runtime_root/overlays/.$profile_key.XXXXXX")"
  managed_overlay >"$stage"
  chmod 0600 "$stage"
  mv -f "$stage" "$managed_overlay_path"
  stage=''
)

publish_profile() (
  local transaction='' marker_stage='' path index mode committed_count=0
  local publication_paths=("$managed_overlay_path" "$profile_marker")
  local publication_existing=()
  local publication_directories=(
    "$HOME/.omp" "$HOME/.omp/profiles" "$profile_root" "$agent_root" "$runtime_root/overlays"
  )
  local publication_directory_modes=()

  require_safe_profile_path
  profile_is_owned_or_adoptable || die "refusing unrelated existing profile files: $profile_root"
  require_safe_overlay_path
  if [[ "$profile_kind" == local ]]; then
    [[ ! -L "$agent_root/models.yml" \
      && ( ! -e "$agent_root/models.yml" || -f "$agent_root/models.yml" ) ]] \
      || die "unsafe managed profile file: $agent_root/models.yml"
    publication_paths=("$agent_root/models.yml" "${publication_paths[@]}")
  fi
  for ((index=0; index < ${#publication_directories[@]}; index += 1)); do
    path="${publication_directories[index]}"
    mode=''
    if [[ -d "$path" ]]; then
      if ! mode="$(stat -f '%Lp' "$path" 2>/dev/null)"; then
        mode="$(stat -c '%a' "$path")"
      fi
    fi
    publication_directory_modes[index]="$mode"
  done

  finish_profile_publication() {
    local status="$1" rollback_failed=false rollback_index directory

    set +e
    [[ -z "$marker_stage" ]] || rm -f -- "$marker_stage" || rollback_failed=true
    if [[ "$status" -ne 0 ]]; then
      for ((rollback_index=committed_count - 1; rollback_index >= 0; rollback_index -= 1)); do
        if [[ "${publication_existing[rollback_index]}" == true ]]; then
          mv -f -- "$transaction/file-$rollback_index" "${publication_paths[rollback_index]}" \
            || rollback_failed=true
        else
          rm -f -- "${publication_paths[rollback_index]}" || rollback_failed=true
        fi
      done
      for ((rollback_index=${#publication_directories[@]} - 1; rollback_index >= 0; rollback_index -= 1)); do
        directory="${publication_directories[rollback_index]}"
        if [[ -n "${publication_directory_modes[rollback_index]}" ]]; then
          chmod "${publication_directory_modes[rollback_index]}" "$directory" || rollback_failed=true
        elif [[ -d "$directory" ]]; then
          rmdir -- "$directory" || rollback_failed=true
        fi
      done
    fi
    if [[ "$rollback_failed" == true ]]; then
      printf 'omp: profile publication rollback failed; recovery files retained at %s\n' "$transaction" >&2
      return 1
    fi
    [[ -z "$transaction" ]] || rm -rf -- "$transaction"
    return "$status"
  }

  trap 'finish_profile_publication "$?"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  transaction="$(mktemp -d "$runtime_root/.profile-transaction.XXXXXX")"
  for ((index=0; index < ${#publication_paths[@]}; index += 1)); do
    path="${publication_paths[index]}"
    publication_existing[index]=false
    if [[ -f "$path" ]]; then
      cp -p -- "$path" "$transaction/file-$index"
      publication_existing[index]=true
    fi
  done

  prepare_profile_directories
  if [[ "$profile_kind" == local ]]; then
    publish_local_models
    committed_count=$((committed_count + 1))
  fi
  publish_managed_overlay
  committed_count=$((committed_count + 1))
  marker_stage="$(mktemp "$profile_root/.profile-marker.XXXXXX")"
  printf '%s\n' "$profile_marker_value" >"$marker_stage"
  chmod 0600 "$marker_stage"
  mv -f "$marker_stage" "$profile_marker"
  committed_count=$((committed_count + 1))
  marker_stage=''
)

compose_pi_config_files() {
  local overlay="$1" remaining="${PI_CONFIG_FILES-}" entry composed=''

  # Put our layer last even when an inherited list already contains it.
  while [[ -n "$remaining" ]]; do
    entry="${remaining%%:*}"
    if [[ "$entry" != "$overlay" ]]; then
      if [[ -n "$composed" ]]; then
        composed="$composed:$entry"
      else
        composed="$entry"
      fi
    fi
    [[ "$remaining" == *:* ]] || break
    remaining="${remaining#*:}"
  done
  printf '%s\n' "${composed:+$composed:}$overlay"
}

canonical_executable() {
  local path="$1" directory target links=0

  [[ "$path" == /* ]] || path="$PWD/$path"
  while :; do
    directory="$(CDPATH= cd -P -- "${path%/*}/" 2>/dev/null && pwd -P)" || return 1
    path="${directory%/}/${path##*/}"
    if [[ ! -L "$path" ]]; then
      [[ -f "$path" && -x "$path" ]] || return 1
      printf '%s\n' "$path"
      return 0
    fi
    (( links < 40 )) || return 1
    links=$((links + 1))
    target="$(readlink "$path")" || return 1
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$directory/$target"
    fi
  done
}

resolve_host_omp() {
  local remaining="${PATH-}:" entry candidate canonical launcher_path internal_path=''

  launcher_path="$(canonical_executable "${BASH_SOURCE[0]}")" \
    || die 'could not resolve the running OMP launcher'
  internal_path="$(canonical_executable "$runtime_root/../.native-commands/omp" 2>/dev/null)" \
    || internal_path=''
  while [[ "$remaining" == *:* ]]; do
    entry="${remaining%%:*}"
    remaining="${remaining#*:}"
    [[ "$entry" == /* ]] || continue
    candidate="$entry/omp"
    [[ -f "$candidate" && -x "$candidate" ]] || continue
    canonical="$(canonical_executable "$candidate")" || continue
    [[ "$canonical" != "$launcher_path" && "$canonical" != "$internal_path" ]] || continue
    printf '%s\n' "$canonical"
    return 0
  done
  die 'no host OMP executable found on PATH; install with Bun (bun install -g @oh-my-pi/pi-coding-agent), Homebrew (brew install can1357/tap/omp), or mise (mise use -g github:can1357/oh-my-pi)'
}

read_omp_version() {
  local binary="$1" actual

  actual="$("$binary" --version)" \
    || die "could not read host OMP version: $binary; repair this installation or correct PATH"
  [[ "$actual" =~ ^omp/([0-9]+\.[0-9]+\.[0-9]+)$ ]] \
    || die "invalid host OMP version from $binary: $actual; expected omp/X.Y.Z; repair this installation or correct PATH"
  printf '%s\n' "${BASH_REMATCH[1]}"
}

refresh_host_omp() {
  host_omp="$(resolve_host_omp)" || return $?
  host_omp_version="$(read_omp_version "$host_omp")" || return $?
  configure_version_capabilities "$host_omp_version"
}

omp_version_if_available() {
  local binary

  binary="$(resolve_host_omp 2>/dev/null)" || return 0
  read_omp_version "$binary" 2>/dev/null || :
}

conservative_headless() {
  local question_tool_control="${1-none}"

  jq -cn \
    --arg questionToolControl "$question_tool_control" '
    {
      schemaVersion: 1,
      prompt: false,
      outputFormats: ["text"],
      eventContract: null,
      trellageEventContract: null,
      sessionId: "none",
      resume: false,
      resumeWithPrompt: false,
      questionToolControl: $questionToolControl,
      changedFiles: "none",
      usage: false,
      cost: false,
      modelOverride: false,
      effortOverride: false,
      testedHarnessVersion: null
    }
  '
}

projected_headless() {
  local profile="$1"
  local current_version expected_version

  current_version="$(omp_version_if_available)"
  expected_version="$(jq -r --arg profile "$profile" \
    '.profiles[$profile].headless.testedHarnessVersion // empty' "$catalog")"
  if [[ -z "$expected_version" ]]; then
    jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
    return
  fi
  if [[ -z "$current_version" || "$current_version" != "$expected_version" ]]; then
    conservative_headless
    return
  fi
  jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
}

projected_headless_map_json() {
  jq -cn \
    --argjson copilotProfile "$(projected_headless copilot)" \
    --argjson localProfile "$(projected_headless local)" '
    {
      copilot: $copilotProfile,
      local: $localProfile
    }
  '
}

verify_managed_overlay() {
  require_owned_profile
  require_safe_overlay_path
  [[ -f "$managed_overlay_path" && ! -L "$managed_overlay_path" ]] \
    || die "managed overlay is missing: $managed_overlay_path"
  cmp -s "$managed_overlay_path" <(managed_overlay) \
    || die "managed overlay differs; run omp repair $profile_key"
}

verify_managed_profile() {
  verify_managed_overlay
  if [[ "$profile_kind" == local ]]; then
    verify_local_models
  fi
}

profile_ready_label() {
  if [[ "$profile_kind" == local ]]; then
    printf '%s\n' "$model_id"
  else
    printf '%s\n' 'github-copilot'
  fi
}

setup_profile() {
  local version

  refresh_host_omp
  version="$host_omp_version"
  publish_profile
  ensure_floating_skills
  ensure_community_skills
  if [[ "$profile_kind" == local ]]; then
    printf 'omp setup: ready (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp setup %s: ready (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

repair_profile() {
  local version

  refresh_host_omp
  version="$host_omp_version"
  require_owned_profile
  publish_profile
  ensure_floating_skills
  ensure_community_skills
  if [[ "$profile_kind" == local ]]; then
    printf 'omp repair: restored (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp repair %s: restored (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

bun_owns_omp() {
  local binary="$1" global_bin owned_binary packages

  command -v bun >/dev/null 2>&1 || return 1
  global_bin="$(bun pm bin -g 2>/dev/null)" || return 1
  [[ "$global_bin" == /* ]] || return 1
  owned_binary="$(canonical_executable "$global_bin/omp" 2>/dev/null)" || return 1
  [[ "$owned_binary" == "$binary" ]] || return 1
  packages="$(bun pm ls -g 2>/dev/null)" || return 1
  awk -v package="@oh-my-pi/pi-coding-agent@$host_omp_version" '
    { for (i = 1; i <= NF; i++) if ($i == package) found = 1 }
    END { exit !found }
  ' <<<"$packages"
}

brew_owns_omp() {
  local binary="$1" packages root canonical_root

  command -v brew >/dev/null 2>&1 || return 1
  packages="$(brew list --formula --versions can1357/tap/omp 2>/dev/null)" || return 1
  awk -v version="$host_omp_version" '
    $1 == "omp" || $1 == "can1357/tap/omp" {
      for (i = 2; i <= NF; i++) if ($i == version) found = 1
    }
    END { exit !found }
  ' <<<"$packages" || return 1
  for root in \
    "$(brew --cellar can1357/tap/omp 2>/dev/null)" \
    "$(brew --prefix can1357/tap/omp 2>/dev/null)"; do
    [[ "$root" == /* ]] || continue
    canonical_root="$(canonical_directory "$root" 2>/dev/null)" || continue
    [[ "$binary" == "$canonical_root/"* ]] && return 0
  done
  return 1
}

mise_owns_omp() {
  local binary="$1" owned_binary packages

  command -v mise >/dev/null 2>&1 || return 1
  owned_binary="$(mise which omp 2>/dev/null)" || return 1
  owned_binary="$(canonical_executable "$owned_binary" 2>/dev/null)" || return 1
  [[ "$owned_binary" == "$binary" ]] || return 1
  packages="$(mise ls --json github:can1357/oh-my-pi 2>/dev/null)" || return 1
  jq -e --arg version "$host_omp_version" '
    type == "array" and any(.[]; .installed == true and .version == $version)
  ' <<<"$packages" >/dev/null 2>&1
}

detect_omp_owner() {
  local binary="$1"

  if bun_owns_omp "$binary"; then
    printf '%s\n' bun
  elif brew_owns_omp "$binary"; then
    printf '%s\n' brew
  elif mise_owns_omp "$binary"; then
    printf '%s\n' mise
  else
    return 1
  fi
}

owner_latest_version() {
  local owner="$1" output latest outdated_status=0

  case "$owner" in
    bun)
      output="$(bun outdated -g @oh-my-pi/pi-coding-agent --no-progress)" || return 1
      latest="$(awk '
        { gsub(/[|│]/, " ") }
        $1 == "@oh-my-pi/pi-coding-agent" { print $NF }
      ' <<<"$output")"
      if [[ -z "$latest" ]]; then
        awk 'NF && $0 !~ /^bun outdated v/ { found = 1 } END { exit found }' \
          <<<"$output" || return 1
        latest="$host_omp_version"
      fi
      ;;
    brew)
      # Homebrew exits 1 when a named formula is outdated, even with valid JSON.
      output="$(brew outdated --formula --json=v2 can1357/tap/omp)" || outdated_status=$?
      [[ "$outdated_status" == 0 || "$outdated_status" == 1 ]] || return 1
      latest="$(jq -er '
        .formulae[] | select(.full_name == "can1357/tap/omp" or .name == "can1357/tap/omp" or .name == "omp") | .current_version
      ' <<<"$output")" || {
        [[ "$outdated_status" == 0 ]] || return 1
        jq -e '.formulae | type == "array" and length == 0' <<<"$output" >/dev/null || return 1
        output="$(brew info --formula --json=v2 can1357/tap/omp)" || return 1
        latest="$(jq -er '
          .formulae[] | select(.full_name == "can1357/tap/omp" or .name == "can1357/tap/omp" or .name == "omp") | .versions.stable
        ' <<<"$output")" || return 1
      }
      ;;
    mise)
      latest="$(mise latest github:can1357/oh-my-pi)" || return 1
      ;;
    *) return 1 ;;
  esac
  [[ "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$latest"
}

upgrade_owned_omp() {
  case "$1" in
    bun) bun update -g --latest @oh-my-pi/pi-coding-agent '@oh-my-pi/pi-natives*' ;;
    brew) brew upgrade can1357/tap/omp ;;
    mise) mise upgrade github:can1357/oh-my-pi ;;
    *) return 1 ;;
  esac
}

require_omp_owner() {
  detect_omp_owner "$host_omp" \
    || die "unknown package manager ownership for host OMP $host_omp_version at $host_omp; update it manually with the mechanism used to install it"
}

check_for_update() {
  local owner latest

  refresh_host_omp
  owner="$(require_omp_owner)" || return $?
  latest="$(owner_latest_version "$owner" 2>/dev/null)" \
    || die "could not determine the latest OMP version through $owner; current version is $host_omp_version at $host_omp"
  printf 'omp update check: owner=%s current=%s latest=%s\n' "$owner" "$host_omp_version" "$latest"
}

print_harness_version_json() {
  local owner='' latest='' diagnostic=''

  refresh_host_omp
  if owner="$(detect_omp_owner "$host_omp")"; then
    latest="$(owner_latest_version "$owner" 2>/dev/null)" \
      || diagnostic="Could not determine the latest host OMP version through $owner."
  else
    diagnostic="Unknown package manager ownership for host OMP at $host_omp; update it manually with the mechanism used to install it."
  fi
  jq -cn --arg installed "$host_omp_version" --arg latest "$latest" --arg diagnostic "$diagnostic" '{
    schemaVersion: 1,
    launcher: "omp",
    harness: "oh-my-pi",
    installed: $installed,
    latest: (if $latest == "" then null else $latest end),
    latestKnown: ($latest != "")
  } + (if $diagnostic == "" then {} else {latestDiagnostic: $diagnostic} end)'
}

preflight_update_profile() {
  require_safe_profile_path
  profile_is_owned_or_adoptable || die "refusing unrelated existing profile files: $profile_root"
  require_safe_overlay_path
  if [[ "$profile_kind" == local ]]; then
    [[ ! -L "$agent_root/models.yml" \
      && ( ! -e "$agent_root/models.yml" || -f "$agent_root/models.yml" ) ]] \
      || die "unsafe managed profile file: $agent_root/models.yml"
  fi
}

refresh_updated_profile() {
  publish_profile
  ensure_floating_skills
  ensure_community_skills
}

update_profile() {
  local owner before

  refresh_host_omp
  before="$host_omp_version"
  owner="$(require_omp_owner)" || return $?
  run_for_selection --all preflight_update_profile
  if ! upgrade_owned_omp "$owner"; then
    if refresh_host_omp; then
      die "$owner OMP update failed; still observed host OMP $host_omp_version at $host_omp (before: $before)"
    fi
    die "$owner OMP update failed; no valid host OMP remains (before: $before)"
  fi
  refresh_host_omp || die "$owner OMP update left no valid host executable (before: $before)"
  run_for_selection --all refresh_updated_profile
  printf 'omp update: owner=%s before=%s after=%s (%s)\n' "$owner" "$before" "$host_omp_version" "$host_omp"
}

doctor_local() {
  local health models

  require_command curl
  health="$(curl -fsS --max-time 5 http://127.0.0.1:8080/health)" \
    || die 'copilot-proxy-rs health check failed'
  jq -e '.status == "ok" or .status == "healthy"' <<<"$health" >/dev/null \
    || die 'copilot-proxy-rs health response is invalid'
  models="$(curl -fsS --max-time 5 http://127.0.0.1:8080/v1/models)" \
    || die 'copilot-proxy-rs model discovery failed'
  jq -e --arg model "$model_id" '.data | any(.id == $model)' <<<"$models" >/dev/null \
    || die "copilot-proxy-rs model is missing: $model_id"
}

doctor_copilot() {
  local binary="$1" output token config_files

  config_files="$(compose_pi_config_files "$managed_overlay_path")"

  if token="$(resolve_copilot_token)"; then
    output="$(
      unset GH_TOKEN GITHUB_TOKEN
      export COPILOT_GITHUB_TOKEN="$token" OMP_PROFILE="$profile_name" PI_CONFIG_FILES="$config_files"
      "$binary" models github-copilot 2>&1
    )" || {
      printf '%s\n' "$output" >&2
      die 'GitHub Copilot authentication is unavailable; run omp copilot auth-broker login github-copilot'
    }
  elif ! output="$(OMP_PROFILE="$profile_name" PI_CONFIG_FILES="$config_files" \
    "$binary" models github-copilot 2>&1)"; then
    printf '%s\n' "$output" >&2
    die 'GitHub Copilot authentication is unavailable; run omp copilot auth-broker login github-copilot'
  fi
  [[ "$output" == *gpt-5.6-sol* ]] \
    || die 'GitHub Copilot exposed no models; run omp copilot auth-broker login github-copilot'
}

resolve_copilot_token() {
  local host token

  if [[ -n "${COPILOT_GITHUB_TOKEN-}" ]]; then
    printf '%s\n' "$COPILOT_GITHUB_TOKEN"
    return
  fi
  if [[ -n "${GH_TOKEN-}" ]]; then
    printf '%s\n' "$GH_TOKEN"
    return
  fi
  if [[ -n "${GITHUB_TOKEN-}" ]]; then
    printf '%s\n' "$GITHUB_TOKEN"
    return
  fi
  if command -v gh >/dev/null 2>&1; then
    host="${COPILOT_GH_HOST:-${GH_HOST:-github.com}}"
    token="$(gh auth token --hostname "$host" 2>/dev/null)" || token=
    if [[ -n "$token" ]]; then
      printf '%s\n' "$token"
      return
    fi
  fi
  command -v security >/dev/null 2>&1 || return 1
  token="$(security find-generic-password -s copilot-cli -w 2>/dev/null)" \
    || return 1
  [[ -n "$token" ]] || return 1
  printf '%s\n' "$token"
}

doctor_profile() {
  local version="${2-}" binary="${1-}"

  if [[ "$#" -eq 0 ]]; then
    refresh_host_omp
    version="$host_omp_version"
    binary="$host_omp"
  else
    [[ "$#" -eq 2 && -n "$binary" && -n "$version" ]] \
      || die 'internal error: doctor host executable/version pair is incomplete'
  fi
  verify_managed_profile
  check_community_skills
  if [[ "$profile_kind" == local ]]; then
    doctor_local
  else
    doctor_copilot "$binary"
  fi
  if [[ "$profile_kind" == local ]]; then
    printf 'omp doctor: OK (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp doctor %s: OK (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

not_ready_inventory() {
  local profile="$1"
  local readiness="$2"

  jq -cn --arg profile "$profile" --arg readiness "$readiness" '{
    schemaVersion: 1,
    launcher: "omp",
    harness: "oh-my-pi",
    profile: $profile,
    readiness: $readiness,
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

inventory_profile() {
  local requested="$1" binary version

  jq -e --arg profile "$requested" '.profiles[$profile] != null' "$catalog" \
    >/dev/null || die "unknown profile: $requested"
  select_profile "$requested"
  if [[ ! -f "$profile_marker" || -L "$profile_marker" ]]; then
    not_ready_inventory "$requested" not-setup
    return
  fi
  if ! refresh_host_omp 2>/dev/null; then
    not_ready_inventory "$requested" unhealthy
    return
  fi
  binary="$host_omp"
  version="$host_omp_version"
  if ! (doctor_profile "$binary" "$version") >/dev/null 2>/dev/null; then
    not_ready_inventory "$requested" unhealthy
    return
  fi
  jq -cn --arg profile "$requested" --arg harnessVersion "$version" '{
    schemaVersion: 1,
    launcher: "omp",
    harness: "oh-my-pi",
    profile: $profile,
    readiness: "healthy",
    harnessVersion: $harnessVersion,
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

parse_launch_arguments() {
  local value

  launch_headless_policy=''
  launch_forwarded_args=()
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --headless-policy)
        [[ -z "$launch_headless_policy" ]] || die '--headless-policy may be specified only once'
        [[ "$#" -ge 2 ]] || die '--headless-policy requires a value'
        value="$2"
        [[ -n "$value" && "$value" != -* ]] || die '--headless-policy requires a value'
        [[ "$value" == no-user-input ]] || die "unknown --headless-policy: $value"
        launch_headless_policy="$value"
        shift 2
        ;;
      --headless-policy=*)
        [[ -z "$launch_headless_policy" ]] || die '--headless-policy may be specified only once'
        value="${1#--headless-policy=}"
        [[ -n "$value" ]] || die '--headless-policy requires a value'
        [[ "$value" == no-user-input ]] || die "unknown --headless-policy: $value"
        launch_headless_policy="$value"
        shift
        ;;
      *)
        launch_forwarded_args+=("$1")
        shift
        ;;
    esac
  done
}

cleanup_launch_overlay() {
  if [[ -n "$launch_overlay_path" ]]; then
    rm -f -- "$launch_overlay_path"
    launch_overlay_path=''
  fi
}

create_headless_policy_overlay() {
  launch_overlay_path="$(mktemp "$runtime_root/.headless-policy.XXXXXX.yml")" \
    || die 'could not stage OMP headless policy overlay'
  cat >"$launch_overlay_path" <<'EOF'
ask:
  enabled: false
EOF
  chmod 0600 "$launch_overlay_path"
}

forward_launch_signal() {
  local signal="$1"

  if [[ -z "$launch_child_pid" ]]; then
    launch_pending_signal="$signal"
    return 0
  fi
  kill "-$signal" "$launch_child_pid" 2>/dev/null || true
}

cancel_pending_launch() {
  [[ -n "$launch_pending_signal" ]] || return 1
  case "$launch_pending_signal" in
    HUP) launch_cancel_status=129 ;;
    INT) launch_cancel_status=130 ;;
    TERM) launch_cancel_status=143 ;;
    *) launch_cancel_status=1 ;;
  esac
  launch_pending_signal=''
  launch_child_pid=''
  if [[ -n "$initialization_lock_path" ]]; then
    release_profile_initialization_lock \
      || die "failed to release profile initialization lock: $profile_key"
  fi
  trap - EXIT HUP INT TERM
  cleanup_launch_overlay
  return 0
}

wait_for_launch_child() {
  local status

  while :; do
    if wait "$launch_child_pid"; then
      status=0
    else
      status=$?
    fi
    if [[ "$status" -ge 128 ]] && kill -0 "$launch_child_pid" 2>/dev/null; then
      continue
    fi
    return "$status"
  done
}

admit_omp() (
  local version binary config_files token credential_file=''

  cleanup_admission() {
    [[ -z "$credential_file" ]] || rm -f -- "$credential_file"
    release_profile_initialization_lock || :
  }
  trap 'cleanup_admission' EXIT HUP INT TERM

  refresh_host_omp
  version="$host_omp_version"
  binary="$host_omp"
  if ! profile_committed_ready; then
    acquire_profile_initialization_lock || return $?
    require_safe_profile_path
    if ! profile_committed_ready; then
      if [[ "$profile_kind" == local ]]; then
        profile_is_owned_or_adoptable || require_owned_profile
      fi
      setup_profile >/dev/null
    fi
  fi
  verify_managed_profile
  ensure_floating_skills >/dev/null
  ensure_community_skills >/dev/null
  release_profile_initialization_lock || die "failed to release profile initialization lock: $profile_key"
  config_files="$(compose_pi_config_files "$managed_overlay_path")"

  if [[ "$profile_kind" == copilot ]] && token="$(resolve_copilot_token)"; then
    require_safe_overlay_path
    credential_file="$(mktemp "$runtime_root/.copilot-credential.XXXXXX")" \
      || die 'could not stage Copilot credential handoff'
    chmod 0600 "$credential_file"
    printf '%s\n' "$token" >"$credential_file"
  fi

  if [[ -n "$credential_file" ]]; then
    jq -cn \
      --arg executable "$binary" \
      --arg ompProfile "$profile_name" \
      --arg piConfigFiles "$config_files" \
      --arg version "$version" \
      --arg copilotCredentialFile "$credential_file" \
      '{
        schemaVersion: 1,
        executable: $executable,
        ompProfile: $ompProfile,
        piConfigFiles: $piConfigFiles,
        version: $version,
        copilotCredentialFile: $copilotCredentialFile
      }'
  else
    jq -cn \
      --arg executable "$binary" \
      --arg ompProfile "$profile_name" \
      --arg piConfigFiles "$config_files" \
      --arg version "$version" \
      '{
        schemaVersion: 1,
        executable: $executable,
        ompProfile: $ompProfile,
        piConfigFiles: $piConfigFiles,
        version: $version,
        copilotCredentialFile: null
      }'
  fi
  trap - EXIT HUP INT TERM
)

run_for_selection() {
  local selection="$1" callback="$2"

  if [[ "$selection" == '--all' ]]; then
    select_profile local
    "$callback"
    select_profile copilot
    "$callback"
    return
  fi
  select_profile "$selection"
  "$callback"
}

require_command jq
validate_catalog

command_name="${1-}"
case "$command_name" in
  help|--help)
    usage
    ;;
  list)
    shift
    if [[ "$#" -eq 0 ]]; then
      list_profiles
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  inventory)
    shift
    [[ "$#" -eq 2 && "$2" == '--json' ]] || die 'inventory requires PROFILE --json'
    inventory_profile "$1"
    ;;
  setup)
    shift
    [[ "$#" -le 1 ]] || die 'setup accepts only local, copilot, or --all'
    run_for_selection "${1-local}" setup_profile
    ;;
  doctor)
    shift
    [[ "$#" -le 1 && "${1-local}" != --all ]] \
      || die 'doctor accepts only local or copilot'
    select_profile "${1-local}"
    doctor_profile
    ;;
  repair)
    shift
    [[ "$#" -le 1 && "${1-local}" != --all ]] \
      || die 'repair accepts only local or copilot'
    select_profile "${1-local}"
    repair_profile
    ;;
  reap)
    shift
    [[ "$#" -le 1 && "${1-local}" != --all ]] \
      || die 'reap accepts only local or copilot'
    select_profile "${1-local}"
    reap_profile_initialization_claim
    ;;
  skills-check)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-check requires PROFILE'
    select_profile "$1"
    skills_update_profile --fresh
    ;;
  skills-update)
    shift
    [[ "$#" -eq 1 ]] || die 'skills-update requires PROFILE'
    select_profile "$1"
    skills_update_profile
    ;;
  update)
    shift
    check_only=false
    selection=local
    if [[ "${1-}" == --check ]]; then
      check_only=true
      shift
    fi
    [[ "$#" -le 1 ]] || die 'usage: omp update [--check] [local|copilot|--all]'
    selection="${1-local}"
    [[ "$selection" == local || "$selection" == copilot || "$selection" == --all ]] \
      || die 'usage: omp update [--check] [local|copilot|--all]'
    select_profile local
    if [[ "$check_only" == true ]]; then
      check_for_update
    else
      update_profile
    fi
    ;;
  harness-version)
    shift
    [[ "$#" -eq 0 ]] || die 'harness-version accepts no arguments'
    print_harness_version_json
    ;;
  _trx-admit)
    [[ "${TRELLAGE_TRX_OMP_ADAPTER:-}" == 1 ]] \
      || die '_trx-admit is reserved for the trx OMP adapter'
    shift
    [[ "$#" -eq 1 ]] || die '_trx-admit requires a profile'
    case "$1" in
      default) select_profile copilot ;;
      local) select_profile local ;;
      *) die "unknown profile: $1" ;;
    esac
    admit_omp
    ;;
  local|copilot)
    public_profile="$command_name"
    [[ "$public_profile" != copilot ]] || public_profile=default
    die "this private profile manager cannot launch agents; use trx run omp $public_profile"
    ;;
  *)
    die 'this private profile manager cannot launch agents; use trx run omp PROFILE'
    ;;
esac
