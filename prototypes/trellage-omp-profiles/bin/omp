#!/usr/bin/env bash

set -euo pipefail

readonly provider='copilot-proxy-rs'
readonly model_id='qwen3.6-35b-a3b-local'
readonly model_selector="$provider/$model_id"
readonly copilot_model_selector='github-copilot/gpt-5.6-sol:medium'
readonly mise_tool='github:can1357/oh-my-pi'
readonly profile_marker_value='trellage-omp-profile-v1'
readonly verified_headless_policy_version='18.0.10'
readonly minimum_community_skills_version='17.3.5'

die() {
  printf 'omp: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  omp [OMP_ARGS...]
  omp local [OMP_ARGS...]
  omp copilot [OMP_ARGS...]
  omp [local|copilot] --headless-policy no-user-input [OMP_ARGS...]
  omp list [--json]
  omp inventory PROFILE --json
  omp setup [local|copilot|--all]
  omp doctor [local|copilot]
  omp repair [local|copilot]
  omp update [--check] [local|copilot|--all]

Bare omp invocations use the local profile for backward compatibility.
EOF
}

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)" || die 'could not resolve launcher directory'
runtime_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" \
  || die 'could not resolve runtime root'
readonly catalog="$runtime_root/catalog.json"
readonly receipt_file="$runtime_root/installed-version"
readonly legacy_version_file="$runtime_root/version"
floating_skills_manager="$runtime_root/../common/floating-skills-runtime/floating-skills.mjs"
floating_skills_catalog="$runtime_root/../common/floating-skills-runtime/skills.json"
if [[ ! -f "$floating_skills_manager" ]]; then
  floating_skills_manager="$runtime_root/../../scripts/floating-skills.mjs"
  floating_skills_catalog="$runtime_root/../../skills.json"
fi
readonly community_skills_cache="$runtime_root/../common/omp-community-skills"

profile_key=''
profile_kind=''
profile_name=''
profile_root=''
agent_root=''
profile_marker=''
launch_child_pid=''
launch_overlay_path=''
launch_headless_policy=''
launch_pending_signal=''
launch_cancel_status=0
launch_forwarded_args=()
community_skills_enabled=false

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

ensure_floating_skills() {
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "invalid floating-skills manager: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "invalid floating-skills catalog: $floating_skills_catalog"
  command -v node >/dev/null 2>&1 || die 'required command not found: node'
  node "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle native-common \
    --target "$agent_root/skills" \
    || die "failed to install floating skills: $profile_key"
}

ensure_community_skills() {
  [[ "$community_skills_enabled" == true ]] || return 0
  node "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle omp-community \
    --cache "$community_skills_cache" \
    --target "$agent_root/community-skills" \
    || die "failed to install OMP community skills: $profile_key"
}

check_community_skills() {
  [[ "$community_skills_enabled" == true ]] || return 0
  node "$floating_skills_manager" verify \
    --catalog "$floating_skills_catalog" \
    --bundle omp-community \
    --cache "$community_skills_cache" \
    --target "$agent_root/community-skills" \
    || die "failed to validate OMP community skills: $profile_key"
}

version_at_least() {
  local actual="$1" minimum="$2"
  local actual_major actual_minor actual_patch minimum_major minimum_minor minimum_patch

  [[ "$actual" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  actual_major="${BASH_REMATCH[1]}"
  actual_minor="${BASH_REMATCH[2]}"
  actual_patch="${BASH_REMATCH[3]}"
  [[ "$minimum" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  minimum_major="${BASH_REMATCH[1]}"
  minimum_minor="${BASH_REMATCH[2]}"
  minimum_patch="${BASH_REMATCH[3]}"

  (( 10#$actual_major > 10#$minimum_major )) && return 0
  (( 10#$actual_major < 10#$minimum_major )) && return 1
  (( 10#$actual_minor > 10#$minimum_minor )) && return 0
  (( 10#$actual_minor < 10#$minimum_minor )) && return 1
  (( 10#$actual_patch >= 10#$minimum_patch ))
}

configure_version_capabilities() {
  if version_at_least "$1" "$minimum_community_skills_version"; then
    community_skills_enabled=true
  else
    community_skills_enabled=false
  fi
}

canonical_directory() {
  CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P
}

validate_catalog() {
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "invalid catalog: $catalog"
  jq -e '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    type == "object"
    and keys == ["profiles", "schemaVersion"]
    and .schemaVersion == 1
    and (.profiles | type == "object" and keys == ["copilot", "local"])
    and all(.profiles | to_entries[];
      (.key | test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.value | type == "object")
      and (.value | keys
        == ["description", "headless", "kind", "ompProfile", "plugin", "standaloneMcps"])
      and (.value.description
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not))
      and (.value.headless | validHeadless)
      and (.value.kind == .key)
      and (.value.ompProfile
        | type == "string"
        and test("^trellage-[a-z0-9]+(-[a-z0-9]+)*$"))
      and .value.plugin == null
      and (.value.standaloneMcps | type == "array" and length == 0))
  ' "$catalog" >/dev/null 2>&1 || die "invalid catalog: $catalog"
}

select_profile() {
  local requested="$1"

  jq -e --arg profile "$requested" '.profiles[$profile] != null' "$catalog" \
    >/dev/null || die "unknown profile: $requested"
  profile_key="$requested"
  profile_kind="$(jq -r --arg profile "$requested" '.profiles[$profile].kind' "$catalog")"
  profile_name="$(jq -r --arg profile "$requested" '.profiles[$profile].ompProfile' "$catalog")"
  profile_root="$HOME/.omp/profiles/$profile_name"
  agent_root="$profile_root/agent"
  profile_marker="$profile_root/.managed-by-trellage-omp-profiles"
}

list_profiles() {
  jq -r '.profiles | to_entries | sort_by(.key)[] | [.key, .value.description] | @tsv' "$catalog"
}

list_profiles_json() {
  local headless_map

  headless_map="$(projected_headless_map_json)"
  jq -S --argjson headless "$headless_map" '
    {
      schemaVersion: 1,
      launcher: "omp",
      harness: "oh-my-pi",
      # oh-my-pi has no known native OS-level sandbox; runs directly on the
      # host. See docs/native-sandbox-research.md.
      sandbox: false,
      profiles: [
        .profiles
        | to_entries
        | sort_by(.key)[]
        | {
            name: .key,
            description: .value.description,
            headless: $headless[.key],
            plugin: .value.plugin,
            source: null,
            marketplace: null,
            standaloneMcps: .value.standaloneMcps
          }
      ]
    }
  ' "$catalog"
}

require_safe_home() {
  local canonical_home

  [[ "$HOME" == /* && "$HOME" != / && -d "$HOME" && ! -L "$HOME" ]] \
    || die "unsafe HOME: $HOME"
  canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
  [[ "$canonical_home" != / ]] || die "unsafe HOME: $HOME"
}

require_safe_profile_path() {
  local path="$HOME" component canonical_home canonical_path

  require_safe_home
  canonical_home="$(canonical_directory "$HOME")"
  for component in .omp profiles "$profile_name" agent; do
    path="$path/$component"
    [[ ! -L "$path" ]] || die "unsafe profile path: $path"
    if [[ -e "$path" ]]; then
      [[ -d "$path" ]] || die "unsafe profile path: $path"
      canonical_path="$(canonical_directory "$path")" || die "cannot resolve profile path: $path"
      case "$canonical_path" in
        "$canonical_home"/*) ;;
        *) die "redirected profile path: $path" ;;
      esac
    fi
  done
}

profile_is_owned_or_empty() {
  local existing

  if [[ -e "$profile_marker" || -L "$profile_marker" ]]; then
    [[ -f "$profile_marker" && ! -L "$profile_marker" ]] || return 1
    [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] || return 1
    return 0
  fi
  [[ ! -e "$profile_root" ]] && return 0
  existing="$(find "$profile_root" -mindepth 1 \( -type f -o -type l \) -print -quit)"
  [[ -z "$existing" ]]
}

require_owned_profile() {
  require_safe_profile_path
  [[ -f "$profile_marker" && ! -L "$profile_marker" ]] \
    || die "profile is not managed; run omp setup $profile_key"
  [[ "$(<"$profile_marker")" == "$profile_marker_value" ]] \
    || die "profile ownership marker differs: $profile_marker"
}

prepare_profile_directories() {
  local path="$HOME" component

  require_safe_profile_path
  profile_is_owned_or_empty || die "refusing unrelated existing profile files: $profile_root"
  for component in .omp profiles "$profile_name" agent; do
    path="$path/$component"
    [[ -e "$path" ]] || mkdir "$path"
    [[ -d "$path" && ! -L "$path" ]] || die "unsafe profile path: $path"
  done
  chmod 0700 "$profile_root" "$agent_root"
  require_safe_profile_path
}

managed_config() {
  cat <<EOF
setupVersion: 1
startup:
  checkUpdate: false
  setupWizard: false
marketplace:
  autoUpdate: off
EOF
  if [[ "$community_skills_enabled" == true ]]; then
    cat <<EOF
skills:
  customDirectories:
    - "$(printf '%s' "$agent_root/community-skills" | sed 's/\\/\\\\/g; s/"/\\"/g')"
EOF
  fi
  if [[ "$profile_kind" == local ]]; then
    cat <<EOF
modelRoles:
  default: $model_selector
  smol: $model_selector
  slow: $model_selector
  vision: $model_selector
  plan: $model_selector
  designer: $model_selector
  commit: $model_selector
  tiny: $model_selector
  task: $model_selector
  advisor: $model_selector
enabledModels:
  - $model_selector
EOF
  else
    cat <<EOF
modelRoles:
  default: $copilot_model_selector
EOF
  fi
  cat <<'EOF'
tools:
  approvalMode: yolo
EOF
}

managed_models() {
  if [[ "$profile_kind" == local ]]; then
    cat <<EOF
providers:
  $provider:
    baseUrl: http://127.0.0.1:8080/v1
    api: openai-responses
    auth: none
    discovery:
      type: openai-models-list
EOF
  else
    printf 'providers: {}\n'
  fi
}

transaction_active=false
config_backup=''
models_backup=''
marker_backup=''
config_existed=false
models_existed=false
marker_existed=false

restore_target() {
  local target="$1" backup="$2" existed="$3" staged

  if [[ "$existed" == true && -f "$backup" ]]; then
    staged="$(mktemp "$(dirname "$target")/.omp-rollback.XXXXXX")" || return
    cp -p "$backup" "$staged" && mv -f "$staged" "$target"
    return
  fi
  rm -f -- "$target"
}

rollback_profile_transaction() {
  [[ "$transaction_active" == true ]] || return 0
  restore_target "$agent_root/config.yml" "$config_backup" "$config_existed"
  restore_target "$agent_root/models.yml" "$models_backup" "$models_existed"
  restore_target "$profile_marker" "$marker_backup" "$marker_existed"
}

cleanup_profile_transaction() {
  rm -f -- "$config_backup" "$models_backup" "$marker_backup"
  config_backup=''
  models_backup=''
  marker_backup=''
}

publish_managed_profile() {
  local config_stage models_stage marker_stage target

  prepare_profile_directories
  for target in "$agent_root/config.yml" "$agent_root/models.yml"; do
    [[ ! -L "$target" && ( ! -e "$target" || -f "$target" ) ]] \
      || die "unsafe managed profile file: $target"
  done

  config_stage="$(mktemp "$agent_root/.config.yml.XXXXXX")"
  models_stage="$(mktemp "$agent_root/.models.yml.XXXXXX")"
  marker_stage="$(mktemp "$profile_root/.profile-marker.XXXXXX")"
  managed_config >"$config_stage"
  managed_models >"$models_stage"
  printf '%s\n' "$profile_marker_value" >"$marker_stage"
  chmod 0600 "$config_stage" "$models_stage" "$marker_stage"

  config_backup="$(mktemp "$agent_root/.config-backup.XXXXXX")"
  models_backup="$(mktemp "$agent_root/.models-backup.XXXXXX")"
  marker_backup="$(mktemp "$profile_root/.marker-backup.XXXXXX")"
  config_existed=false
  models_existed=false
  marker_existed=false
  if [[ -e "$agent_root/config.yml" ]]; then
    config_existed=true
    cp -p "$agent_root/config.yml" "$config_backup"
  fi
  if [[ -e "$agent_root/models.yml" ]]; then
    models_existed=true
    cp -p "$agent_root/models.yml" "$models_backup"
  fi
  if [[ -e "$profile_marker" ]]; then
    marker_existed=true
    cp -p "$profile_marker" "$marker_backup"
  fi

  transaction_active=true
  trap 'rollback_profile_transaction; cleanup_profile_transaction' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mv -f "$config_stage" "$agent_root/config.yml"
  [[ "${OMP_TEST_FAIL_AT-}" != after-config ]] || die 'injected failure after config publication'
  mv -f "$models_stage" "$agent_root/models.yml"
  [[ "${OMP_TEST_FAIL_AT-}" != after-models ]] || die 'injected failure after models publication'
  mv -f "$marker_stage" "$profile_marker"
  transaction_active=false
  cleanup_profile_transaction
  trap - EXIT HUP INT TERM
}

require_exact_version() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "invalid OMP version: $1"
}

omp_version_if_available() {
  local version binary actual

  if [[ -f "$receipt_file" && ! -L "$receipt_file" ]]; then
    version="$(<"$receipt_file")"
  elif [[ -f "$legacy_version_file" && ! -L "$legacy_version_file" ]]; then
    version="$(<"$legacy_version_file")"
  else
    return 0
  fi
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 0
  binary="$runtime_root/mise/installs/github-can1357-oh-my-pi/$version/omp"
  [[ -x "$binary" && ! -L "$binary" ]] || return 0
  actual="$("$binary" --version 2>/dev/null || :)"
  [[ "$actual" == "omp/$version" ]] || return 0
  printf '%s\n' "$version"
}

conservative_headless() {
  local question_tool_control="${1-none}"

  jq -cn \
    --arg questionToolControl "$question_tool_control" '
    {
      schemaVersion: 1,
      prompt: false,
      outputFormats: ["text"],
      eventContract: null,
      trellageEventContract: null,
      sessionId: "none",
      resume: false,
      resumeWithPrompt: false,
      questionToolControl: $questionToolControl,
      changedFiles: "none",
      usage: false,
      cost: false,
      modelOverride: false,
      effortOverride: false,
      testedHarnessVersion: null
    }
  '
}

projected_headless() {
  local profile="$1"
  local current_version expected_version

  current_version="$(omp_version_if_available)"
  expected_version="$(jq -r --arg profile "$profile" \
    '.profiles[$profile].headless.testedHarnessVersion // empty' "$catalog")"
  if [[ -z "$expected_version" ]]; then
    jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
    return
  fi
  if [[ -z "$current_version" || "$current_version" != "$expected_version" ]]; then
    conservative_headless
    return
  fi
  jq -c --arg profile "$profile" '.profiles[$profile].headless' "$catalog"
}

projected_headless_map_json() {
  jq -cn \
    --argjson copilotProfile "$(projected_headless copilot)" \
    --argjson localProfile "$(projected_headless local)" '
    {
      copilot: $copilotProfile,
      local: $localProfile
    }
  '
}

mise_env() {
  MISE_DATA_DIR="$runtime_root/mise" \
    MISE_CACHE_DIR="$runtime_root/cache" \
    MISE_CONFIG_DIR="$runtime_root/mise-config" \
    MISE_GLOBAL_CONFIG_FILE=/dev/null \
    MISE_IGNORED_CONFIG_PATHS="$HOME" \
    mise "$@"
}

resolve_latest_version() {
  local version

  version="$(mise_env latest "$mise_tool")" || die 'could not resolve latest eligible OMP release'
  require_exact_version "$version"
  printf '%s\n' "$version"
}

read_installed_version() {
  local version

  if [[ ! -e "$receipt_file" && ! -L "$receipt_file" \
    && ( -e "$legacy_version_file" || -L "$legacy_version_file" ) ]]; then
    [[ -f "$legacy_version_file" && ! -L "$legacy_version_file" ]] \
      || die "unsafe legacy installed version receipt: $legacy_version_file"
    version="$(<"$legacy_version_file")"
    require_exact_version "$version"
    publish_installed_version "$version"
  fi
  [[ -f "$receipt_file" && ! -L "$receipt_file" ]] \
    || die "OMP installed version receipt is missing; run omp setup $profile_key"
  version="$(<"$receipt_file")"
  require_exact_version "$version"
  printf '%s\n' "$version"
}

installed_binary() {
  local version="$1" install_dir expected

  install_dir="$(mise_env where "$mise_tool@$version")" \
    || die "OMP $version is not installed; run omp repair $profile_key"
  expected="$runtime_root/mise/installs/github-can1357-oh-my-pi/$version"
  [[ "$install_dir" == "$expected" ]] || die "mise returned unexpected OMP path: $install_dir"
  [[ -x "$install_dir/omp" && ! -L "$install_dir/omp" ]] \
    || die "OMP executable is missing: $install_dir/omp"
  printf '%s/omp\n' "$install_dir"
}

verify_binary_version() {
  local binary="$1" version="$2" actual

  actual="$("$binary" --version)" || die "could not run OMP $version"
  [[ "$actual" == "omp/$version" ]] || die "OMP version differs: expected omp/$version, got $actual"
}

install_exact_version() {
  local version="$1" binary

  mise_env install "$mise_tool@$version" || die "mise could not install OMP $version"
  binary="$(installed_binary "$version")"
  verify_binary_version "$binary" "$version"
}

stage_installed_version_receipt() {
  local version="$1" staged

  staged="$(mktemp "$runtime_root/.installed-version.XXXXXX")" \
    || die 'could not stage OMP installed version receipt'
  printf '%s\n' "$version" >"$staged"
  chmod 0600 "$staged"
  printf '%s\n' "$staged"
}

publish_installed_version() {
  local version="$1" staged

  staged="$(stage_installed_version_receipt "$version")"
  mv -f "$staged" "$receipt_file"
  rm -f -- "$legacy_version_file"
}

backup_update_state() {
  local backup target name

  backup="$(mktemp -d "$runtime_root/.update-backup.XXXXXX")" \
    || die 'could not stage OMP update backup'
  for target in "$agent_root/config.yml" "$agent_root/models.yml" "$profile_marker"; do
    if [[ -e "$target" || -L "$target" ]]; then
      [[ -f "$target" && ! -L "$target" ]] \
        || {
          rm -rf -- "$backup"
          die "unsafe managed update target: $target"
        }
      name="$(basename "$target")"
      cp -p "$target" "$backup/$name"
    fi
  done
  for name in skills community-skills; do
    target="$agent_root/$name"
    if [[ -e "$target" || -L "$target" ]]; then
      [[ -d "$target" && ! -L "$target" ]] \
        || {
          rm -rf -- "$backup"
          die "unsafe managed update target: $target"
        }
      cp -R -p "$target" "$backup/$name"
    fi
  done
  if [[ -f "$receipt_file" && ! -L "$receipt_file" ]]; then
    cp -p "$receipt_file" "$backup/installed-version"
  fi
  if [[ -f "$legacy_version_file" && ! -L "$legacy_version_file" ]]; then
    cp -p "$legacy_version_file" "$backup/legacy-version"
  fi
  printf '%s\n' "$backup"
}

restore_update_state() {
  local backup="$1" name target

  rm -f -- "$agent_root/config.yml" "$agent_root/models.yml" "$profile_marker"
  for name in config.yml models.yml; do
    [[ ! -f "$backup/$name" ]] || mv "$backup/$name" "$agent_root/$name"
  done
  [[ ! -f "$backup/.managed-by-trellage-omp-profiles" ]] \
    || mv "$backup/.managed-by-trellage-omp-profiles" "$profile_marker"
  for name in skills community-skills; do
    target="$agent_root/$name"
    rm -rf -- "$target"
    [[ ! -d "$backup/$name" ]] || mv "$backup/$name" "$target"
  done
  rm -f -- "$receipt_file" "$legacy_version_file"
  [[ ! -f "$backup/installed-version" ]] \
    || mv "$backup/installed-version" "$receipt_file"
  [[ ! -f "$backup/legacy-version" ]] \
    || mv "$backup/legacy-version" "$legacy_version_file"
  rm -rf -- "$backup"
}

adopt_updated_version() {
  local version="$1" backup receipt_stage status

  receipt_stage="$(stage_installed_version_receipt "$version")"
  backup="$(backup_update_state)"
  if (
    ensure_floating_skills
    configure_version_capabilities "$version"
    ensure_community_skills
    publish_managed_profile
    [[ "${OMP_TEST_FAIL_AT-}" != before-receipt-publication ]] \
      || die 'injected failure before installed version receipt publication'
    mv -f "$receipt_stage" "$receipt_file"
  ); then
    if ! rm -f -- "$legacy_version_file"; then
      printf 'omp: warning: could not remove legacy installed version receipt: %s\n' \
        "$legacy_version_file" >&2
    fi
    if ! rm -rf -- "$backup"; then
      printf 'omp: warning: could not remove update backup: %s\n' "$backup" >&2
    fi
    return
  else
    status=$?
    restore_update_state "$backup"
    rm -f -- "$receipt_stage"
    return "$status"
  fi
}

verify_managed_profile() {
  require_owned_profile
  [[ -f "$agent_root/config.yml" && ! -L "$agent_root/config.yml" ]] \
    || die "managed config is missing: $agent_root/config.yml"
  [[ -f "$agent_root/models.yml" && ! -L "$agent_root/models.yml" ]] \
    || die "managed models config is missing: $agent_root/models.yml"
  cmp -s "$agent_root/config.yml" <(managed_config) \
    || die "managed config differs; run omp repair $profile_key"
  cmp -s "$agent_root/models.yml" <(managed_models) \
    || die "managed models config differs; run omp repair $profile_key"
}

managed_profile_is_current() {
  [[ -f "$agent_root/config.yml" && ! -L "$agent_root/config.yml" ]] || return 1
  [[ -f "$agent_root/models.yml" && ! -L "$agent_root/models.yml" ]] || return 1
  cmp -s "$agent_root/config.yml" <(managed_config) || return 1
  cmp -s "$agent_root/models.yml" <(managed_models)
}

# OMP rewrites its own config during normal use, so drift on launch is expected
# rather than exceptional. Republish instead of stopping for a manual repair.
# Ownership and path safety still fail hard: only a profile this launcher created is
# ever overwritten, and `omp doctor` keeps the strict check for diagnosis.
ensure_managed_profile() {
  require_owned_profile
  managed_profile_is_current && return 0
  publish_managed_profile
  ensure_floating_skills
  printf 'omp: managed config restored\n' >&2
}

# The installed version receipt is the contract. A missing installation is
# repairable state, not a reason to refuse to start.
ensure_installed_binary() {
  local version="$1" binary

  if binary="$(installed_binary "$version" 2>/dev/null)"; then
    printf '%s\n' "$binary"
    return 0
  fi
  printf 'omp: OMP %s is not installed; installing\n' "$version" >&2
  install_exact_version "$version" >&2
  installed_binary "$version"
}

profile_ready_label() {
  if [[ "$profile_kind" == local ]]; then
    printf '%s\n' "$model_id"
  else
    printf '%s\n' 'github-copilot'
  fi
}

setup_profile() {
  local version

  require_command mise
  if [[ -e "$receipt_file" || -L "$receipt_file" \
    || -e "$legacy_version_file" || -L "$legacy_version_file" ]]; then
    version="$(read_installed_version)"
  else
    version="$(resolve_latest_version)"
  fi
  configure_version_capabilities "$version"
  install_exact_version "$version"
  publish_managed_profile
  ensure_floating_skills
  ensure_community_skills
  publish_installed_version "$version"
  if [[ "$profile_kind" == local ]]; then
    printf 'omp setup: ready (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp setup %s: ready (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

repair_profile() {
  local version

  require_command mise
  version="$(read_installed_version)"
  configure_version_capabilities "$version"
  install_exact_version "$version"
  publish_managed_profile
  ensure_floating_skills
  ensure_community_skills
  if [[ "$profile_kind" == local ]]; then
    printf 'omp repair: restored (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp repair %s: restored (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

check_for_update() {
  local current latest

  require_command mise
  current="$(read_installed_version)"
  latest="$(resolve_latest_version)"
  if [[ "$current" == "$latest" ]]; then
    printf 'omp update: %s is current\n' "$current"
    return
  fi
  printf 'omp update: %s -> %s available\n' "$current" "$latest"
}

update_profile() {
  local current latest

  require_command mise
  current="$(read_installed_version)"
  latest="$(resolve_latest_version)"
  if [[ "$current" == "$latest" ]]; then
    ensure_floating_skills
    configure_version_capabilities "$current"
    ensure_community_skills
    ensure_managed_profile
    printf 'omp update: %s is current\n' "$current"
    return
  fi
  install_exact_version "$latest"
  adopt_updated_version "$latest"
  printf 'omp update: %s -> %s installed\n' "$current" "$latest"
}

doctor_local() {
  local health models

  require_command curl
  health="$(curl -fsS --max-time 5 http://127.0.0.1:8080/health)" \
    || die 'copilot-proxy-rs health check failed'
  jq -e '.status == "ok" or .status == "healthy"' <<<"$health" >/dev/null \
    || die 'copilot-proxy-rs health response is invalid'
  models="$(curl -fsS --max-time 5 http://127.0.0.1:8080/v1/models)" \
    || die 'copilot-proxy-rs model discovery failed'
  jq -e --arg model "$model_id" '.data | any(.id == $model)' <<<"$models" >/dev/null \
    || die "copilot-proxy-rs model is missing: $model_id"
}

doctor_copilot() {
  local binary="$1" output token

  if token="$(resolve_copilot_token)"; then
    output="$(
      unset GH_TOKEN GITHUB_TOKEN
      export COPILOT_GITHUB_TOKEN="$token" OMP_PROFILE="$profile_name"
      "$binary" models github-copilot 2>&1
    )" || {
      printf '%s\n' "$output" >&2
      die 'GitHub Copilot authentication is unavailable; run omp copilot auth-broker login github-copilot'
    }
  elif ! output="$(OMP_PROFILE="$profile_name" \
    "$binary" models github-copilot 2>&1)"; then
    printf '%s\n' "$output" >&2
    die 'GitHub Copilot authentication is unavailable; run omp copilot auth-broker login github-copilot'
  fi
  [[ "$output" == *gpt-5.6-sol* ]] \
    || die 'GitHub Copilot exposed no models; run omp copilot auth-broker login github-copilot'
}

resolve_copilot_token() {
  local host token

  if [[ -n "${COPILOT_GITHUB_TOKEN-}" ]]; then
    printf '%s\n' "$COPILOT_GITHUB_TOKEN"
    return
  fi
  if [[ -n "${GH_TOKEN-}" ]]; then
    printf '%s\n' "$GH_TOKEN"
    return
  fi
  if [[ -n "${GITHUB_TOKEN-}" ]]; then
    printf '%s\n' "$GITHUB_TOKEN"
    return
  fi
  if command -v gh >/dev/null 2>&1; then
    host="${COPILOT_GH_HOST:-${GH_HOST:-github.com}}"
    token="$(gh auth token --hostname "$host" 2>/dev/null)" || token=
    if [[ -n "$token" ]]; then
      printf '%s\n' "$token"
      return
    fi
  fi
  command -v security >/dev/null 2>&1 || return 1
  token="$(security find-generic-password -s copilot-cli -w 2>/dev/null)" \
    || return 1
  [[ -n "$token" ]] || return 1
  printf '%s\n' "$token"
}

doctor_profile() {
  local version binary

  require_command mise
  version="$(read_installed_version)"
  configure_version_capabilities "$version"
  verify_managed_profile
  check_community_skills
  binary="$(installed_binary "$version")"
  verify_binary_version "$binary" "$version"
  if [[ "$profile_kind" == local ]]; then
    doctor_local
  else
    doctor_copilot "$binary"
  fi
  if [[ "$profile_kind" == local ]]; then
    printf 'omp doctor: OK (%s, %s)\n' "$version" "$(profile_ready_label)"
  else
    printf 'omp doctor %s: OK (%s, %s)\n' \
      "$profile_key" "$version" "$(profile_ready_label)"
  fi
}

not_ready_inventory() {
  local profile="$1"
  local readiness="$2"

  jq -cn --arg profile "$profile" --arg readiness "$readiness" '{
    schemaVersion: 1,
    launcher: "omp",
    harness: "oh-my-pi",
    profile: $profile,
    readiness: $readiness,
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

inventory_profile() {
  local requested="$1"

  jq -e --arg profile "$requested" '.profiles[$profile] != null' "$catalog" \
    >/dev/null || die "unknown profile: $requested"
  select_profile "$requested"
  if [[ ! -f "$profile_marker" || -L "$profile_marker" ]]; then
    not_ready_inventory "$requested" not-setup
    return
  fi
  if ! (doctor_profile >/dev/null 2>&1); then
    not_ready_inventory "$requested" unhealthy
    return
  fi
  jq -cn --arg profile "$requested" '{
    schemaVersion: 1,
    launcher: "omp",
    harness: "oh-my-pi",
    profile: $profile,
    readiness: "healthy",
    plugins: [],
    skills: {packageCount: null, visibleCount: null},
    mcps: []
  }'
}

parse_launch_arguments() {
  local value

  launch_headless_policy=''
  launch_forwarded_args=()
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --headless-policy)
        [[ -z "$launch_headless_policy" ]] || die '--headless-policy may be specified only once'
        [[ "$#" -ge 2 ]] || die '--headless-policy requires a value'
        value="$2"
        [[ -n "$value" && "$value" != -* ]] || die '--headless-policy requires a value'
        [[ "$value" == no-user-input ]] || die "unknown --headless-policy: $value"
        launch_headless_policy="$value"
        shift 2
        ;;
      --headless-policy=*)
        [[ -z "$launch_headless_policy" ]] || die '--headless-policy may be specified only once'
        value="${1#--headless-policy=}"
        [[ -n "$value" ]] || die '--headless-policy requires a value'
        [[ "$value" == no-user-input ]] || die "unknown --headless-policy: $value"
        launch_headless_policy="$value"
        shift
        ;;
      *)
        launch_forwarded_args+=("$1")
        shift
        ;;
    esac
  done
}

cleanup_launch_overlay() {
  if [[ -n "$launch_overlay_path" ]]; then
    rm -f -- "$launch_overlay_path"
    launch_overlay_path=''
  fi
}

create_headless_policy_overlay() {
  launch_overlay_path="$(mktemp "$runtime_root/.headless-policy.XXXXXX.yml")" \
    || die 'could not stage OMP headless policy overlay'
  cat >"$launch_overlay_path" <<'EOF'
ask:
  enabled: false
EOF
  chmod 0600 "$launch_overlay_path"
}

forward_launch_signal() {
  local signal="$1"

  if [[ -z "$launch_child_pid" ]]; then
    launch_pending_signal="$signal"
    return 0
  fi
  kill "-$signal" "$launch_child_pid" 2>/dev/null || true
}

cancel_pending_launch() {
  [[ -n "$launch_pending_signal" ]] || return 1
  case "$launch_pending_signal" in
    HUP) launch_cancel_status=129 ;;
    INT) launch_cancel_status=130 ;;
    TERM) launch_cancel_status=143 ;;
    *) launch_cancel_status=1 ;;
  esac
  launch_pending_signal=''
  launch_child_pid=''
  trap - EXIT HUP INT TERM
  cleanup_launch_overlay
  return 0
}

wait_for_launch_child() {
  local status

  while :; do
    if wait "$launch_child_pid"; then
      status=0
    else
      status=$?
    fi
    if [[ "$status" -ge 128 ]] && kill -0 "$launch_child_pid" 2>/dev/null; then
      continue
    fi
    return "$status"
  done
}

launch_omp() {
  local version binary token status
  local launch_args=()

  launch_child_pid=''
  launch_pending_signal=''
  launch_cancel_status=0
  trap cleanup_launch_overlay EXIT
  trap 'forward_launch_signal HUP' HUP
  trap 'forward_launch_signal INT' INT
  trap 'forward_launch_signal TERM' TERM

  require_command mise
  if [[ ! -e "$receipt_file" && ! -L "$receipt_file" \
    && ! -e "$legacy_version_file" && ! -L "$legacy_version_file" ]]; then
    setup_profile >/dev/null
    if cancel_pending_launch; then
      return "$launch_cancel_status"
    fi
  fi
  version="$(read_installed_version)"
  configure_version_capabilities "$version"
  ensure_managed_profile
  ensure_floating_skills
  ensure_community_skills
  if cancel_pending_launch; then
    return "$launch_cancel_status"
  fi
  binary="$(ensure_installed_binary "$version")"
  if cancel_pending_launch; then
    return "$launch_cancel_status"
  fi
  verify_binary_version "$binary" "$version"
  if cancel_pending_launch; then
    return "$launch_cancel_status"
  fi
  parse_launch_arguments "$@"
  launch_args=(--approval-mode yolo)
  if [[ "$launch_headless_policy" == no-user-input ]]; then
    [[ "$version" == "$verified_headless_policy_version" ]] \
      || die "--headless-policy no-user-input is verified only for OMP $verified_headless_policy_version; installed version is $version"
    create_headless_policy_overlay
    launch_args+=(--config "$launch_overlay_path")
  fi
  if cancel_pending_launch; then
    return "$launch_cancel_status"
  fi
  if [[ "${#launch_forwarded_args[@]}" -gt 0 ]]; then
    launch_args+=("${launch_forwarded_args[@]}")
  fi

  if cancel_pending_launch; then
    return "$launch_cancel_status"
  fi
  if [[ "$profile_kind" == copilot ]]; then
    if token="$(resolve_copilot_token)"; then
      if cancel_pending_launch; then
        return "$launch_cancel_status"
      fi
      env -u GH_TOKEN -u GITHUB_TOKEN \
        COPILOT_GITHUB_TOKEN="$token" OMP_PROFILE="$profile_name" \
        "$binary" "${launch_args[@]}" <&0 &
      launch_child_pid=$!
    else
      if cancel_pending_launch; then
        return "$launch_cancel_status"
      fi
      env OMP_PROFILE="$profile_name" "$binary" "${launch_args[@]}" <&0 &
      launch_child_pid=$!
    fi
  else
    env OMP_PROFILE="$profile_name" "$binary" "${launch_args[@]}" <&0 &
    launch_child_pid=$!
  fi
  if [[ -n "$launch_pending_signal" ]]; then
    case "$launch_pending_signal" in
      HUP) launch_cancel_status=129 ;;
      INT) launch_cancel_status=130 ;;
      TERM) launch_cancel_status=143 ;;
      *) launch_cancel_status=1 ;;
    esac
    forward_launch_signal "$launch_pending_signal"
    launch_pending_signal=''
  fi
  if wait_for_launch_child; then
    status=0
  else
    status=$?
  fi
  if [[ "$launch_cancel_status" -ne 0 ]]; then
    status="$launch_cancel_status"
  fi
  launch_child_pid=''
  launch_pending_signal=''
  launch_cancel_status=0
  trap - EXIT HUP INT TERM
  cleanup_launch_overlay
  return "$status"
}

run_for_selection() {
  local selection="$1" callback="$2"

  if [[ "$selection" == '--all' ]]; then
    select_profile local
    "$callback"
    select_profile copilot
    "$callback"
    return
  fi
  select_profile "$selection"
  "$callback"
}

require_command jq
validate_catalog

command_name="${1-}"
case "$command_name" in
  help)
    usage
    ;;
  list)
    shift
    if [[ "$#" -eq 0 ]]; then
      list_profiles
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_profiles_json
    else
      die 'list accepts only --json'
    fi
    ;;
  inventory)
    shift
    [[ "$#" -eq 2 && "$2" == '--json' ]] || die 'inventory requires PROFILE --json'
    inventory_profile "$1"
    ;;
  setup)
    shift
    [[ "$#" -le 1 ]] || die 'setup accepts only local, copilot, or --all'
    run_for_selection "${1-local}" setup_profile
    ;;
  doctor)
    shift
    [[ "$#" -le 1 && "${1-local}" != --all ]] \
      || die 'doctor accepts only local or copilot'
    select_profile "${1-local}"
    doctor_profile
    ;;
  repair)
    shift
    [[ "$#" -le 1 && "${1-local}" != --all ]] \
      || die 'repair accepts only local or copilot'
    select_profile "${1-local}"
    repair_profile
    ;;
  update)
    shift
    check_only=false
    selection=local
    if [[ "${1-}" == --check ]]; then
      check_only=true
      shift
    fi
    [[ "$#" -le 1 ]] || die 'usage: omp update [--check] [local|copilot|--all]'
    selection="${1-local}"
    [[ "$selection" == local || "$selection" == copilot || "$selection" == --all ]] \
      || die 'usage: omp update [--check] [local|copilot|--all]'
    select_profile local
    if [[ "$check_only" == true ]]; then
      check_for_update
    else
      update_profile
    fi
    ;;
  local|copilot)
    select_profile "$command_name"
    shift
    launch_omp "$@"
    ;;
  *)
    select_profile local
    launch_omp "$@"
    ;;
esac
