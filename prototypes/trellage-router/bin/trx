#!/usr/bin/env bash
set +x
set +a
set -euo pipefail

if ! pwd -P >/dev/null 2>&1; then
  if [[ -z "${HOME-}" || ! -d "$HOME" ]]; then
    printf 'trx: current working directory no longer exists and HOME is unavailable\n' >&2
    exit 1
  fi
  cd -- "$HOME"
  printf 'trx: current working directory no longer exists; continuing from %s\n' "$HOME" >&2
fi

unset trx_transcript_api_key trx_transcript_api_key_is_set
trx_transcript_api_key_is_set=false
trx_transcript_api_key=""
if [[ "${TRANSCRIPT_API_KEY+x}" == x ]]; then
  trx_transcript_api_key_is_set=true
  trx_transcript_api_key="$TRANSCRIPT_API_KEY"
fi
unset TRANSCRIPT_API_KEY

readonly ownership_value='trellage-router-v3'


die() {
  printf 'trx: %s\n' "$1" >&2
  exit 1
}

restore_transcript_api_key() {
  if [[ "$1" == codex && "$2" == youtube && "$trx_transcript_api_key_is_set" == true ]]; then
    export TRANSCRIPT_API_KEY="$trx_transcript_api_key"
  fi
}

usage() {
  cat <<'EOF'
Usage:
  trx
  trx run HARNESS [PROFILE...] [OPTIONS] [-- ARGS...]
  trx list [--json]
  trx guide [INTENT]
  trx guide --intent INTENT [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --next-steps [--model MODEL] [--effort LEVEL]
  trx guide --engagement [--intent QUESTION] [--model MODEL] [--effort LEVEL]
  trx guide --review
  trx guide --optimize
  trx guide --json [--intent INTENT] [--profile PROFILE_REF] [--model MODEL] [--effort LEVEL]
  trx guide --preview
  trx guide --forks [tabs|inline]
  trx guide --ritual [id] [--print | --copy]
  trx inventory HARNESS [PROFILE...] [--no-always] --json
  trx doctor|setup|repair HARNESS PROFILE
  trx skill jcode SKILL PROMPT
  trx admin
  trx upgrade all [--yes | --dry-run]
  trx upgrade HARNESS [--all | PROFILE]
  trx skills status
  trx skills check --json
  trx skills update [--check | --upgrade-pins]

Bare trx opens the run composer. Run `trx run --help` for profile composition,
model, effort, isolation, and dry-run options. `trx list` prints the harnesses,
built-in presets, and composed profiles that `trx run` accepts.

`trx guide` recommends profiles and builds prompt candidates. JSON mode is
non-interactive and does not launch a harness or open a Herdr pane.

`trx inventory` reports a composition's live readiness. `doctor`, `setup`, and
`repair` run that harness's lifecycle checks and fixes. `trx admin` opens a
read-mostly command center. It never repairs or launches a profile automatically.

`trx upgrade all` updates supported harness versions and skills after a preview.
Use --yes for a non-interactive update or --dry-run for a preview without updates.
`trx upgrade HARNESS` uses the harness lifecycle command.

`trx skills status` reports the shared skill cache. `trx skills check --json`
checks configured sources. `trx skills update` refreshes floating sources;
--check reports changes, and --upgrade-pins rewrites config.toml pins.
EOF
}

upgrade_usage() {
  cat <<'EOF'
Usage:
  trx upgrade all [--yes | --dry-run]
  trx upgrade HARNESS [--all | PROFILE]

Update harness versions AND skills for every Native catalog profile.
The preview includes profiles hidden by Admin filters. One queue runs:
1. Native harness updates: shared runtimes once.
2. Shared Native skill-cache refresh: one trx skills update.
3. Native profile skill copies and verification, including Agency.
Native skill copies are final; harness updates cannot overwrite them afterward.
Admin U remains the selected harness-only action.

Without a flag, preview the scope and require you to type yes at a terminal.
--yes authorizes updates without an interactive terminal.
--dry-run previews the scope without running updates or version checks.

The HARNESS form delegates to the managed harness lifecycle. Depending on the
harness, it updates the shared runtime, every profile with --all, or one PROFILE.
Existing profile version and source pins are preserved. Unsupported profiles,
fallbacks, failures, and unreadable installed versions are reported.
Independent updates continue after failures. Cancellation stops later updates.
Exit status is nonzero for incomplete discovery, unsupported profiles, failed
harness or skill updates, failed installed-version reads, and profiles not run.
A failed skill cache refresh skips Native copies, not independent harness updates.
Cancellation exits 130.

This does not install or upgrade Trellage itself.
EOF
}

guide_usage() {
  cat <<'EOF'
Usage:
  trx guide [INTENT]
  trx guide --intent INTENT [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --next-steps [--model MODEL] [--effort LEVEL]
  trx guide --engagement [--intent QUESTION] [--model MODEL] [--effort LEVEL]
  trx guide --review
  trx guide --optimize
  trx guide --json [--intent INTENT] [--profile PROFILE_REF] [--model MODEL] [--effort LEVEL]
  trx guide --preview
  trx guide --forks [tabs|inline]
  trx guide --ritual [id] [--print | --copy]

PROFILE_REF is native:<harness>/<profile>[+<profile>...]. JSON mode
uses schemaVersion 2, has no launch or Herdr side effects, and accepts a JSON
request on stdin when --intent is omitted.
INTENT can contain line breaks and accepts up to 60,000 characters.
--engagement reads selected repository documents to recommend the next
customer-engagement action. Its question is limited to 8,000 characters.
It opens a local source view first; model use, saving, and interactive
current-terminal launch require separate confirmation. No folder migration.
--review opens Review changes with no checks selected.
Approve findings before one fresh Native agent can edit this worktree.
Press o in Guide, or use --optimize, to Optimize: run selected skills on the
whole repository.
The current worktree and branch are used automatically. Use --base REF to
override the detected comparison base. Uncommitted-only review is an explicit
alternative. No conversation capture or model calls during setup.
Press p during matching or recommendations to view the prompt as Markdown.
Press e in the prompt viewer to edit; Enter rematches a changed prompt.
Interactive prompt viewers: pager, split, focus, bookends, dashboard.
--preview renders the staged prompt basket composer overlay from fixture data.
--forks renders two ways to fork the guide into parallel subflows.
It loads no composition catalog, calls no model, and launches nothing.
--ritual opens saved prompts. It calls no model. Opening the list copies nothing.
--print writes one prompt to stdout. --copy copies one prompt and exits.
Use --print or --copy with --ritual and an id.
--review accepts --base, --intent, --intent-stdin, --model and --effort.
It needs Copilot and selected review skills, not every Native harness.
EOF
}

canonical_directory() {
  (CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P)
}

resolve_file() {
  local path="$1"
  local directory
  local target
  local links=0

  [[ "$path" == /* ]] || {
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    path="$directory/$(basename "$path")"
  }

  while [[ -L "$path" ]]; do
    ((links += 1))
    ((links <= 40)) || return 1
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    target="$(readlink "$path")" || return 1
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$directory/$target"
    fi
  done

  directory="$(canonical_directory "$(dirname "$path")")" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}


mode=''
review_seen=false
ritual_seen=false
skills_action=''
guide_args=()
upgrade_args=()
case "${1-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  list)
    shift
    if [[ "$#" -eq 0 || ( "$#" -eq 1 && "$1" == --json ) ]]; then
      mode='list'
      list_args=("$@")
    elif [[ ( "$#" -eq 1 || ( "$#" -eq 2 && "$2" == --json ) ) && "$1" != -* ]]; then
      mode='lifecycle'
      lifecycle_args=(list "$@")
    else
      die 'list accepts only --json or HARNESS [--json]'
    fi
    ;;
  guide)
    mode='guide'
    shift
    if [[ "$#" -eq 1 && ("$1" == -h || "$1" == --help || "$1" == help) ]]; then
      guide_usage
      exit 0
    fi
    guide_args=("$@")
    next_steps_seen=false
    engagement_seen=false
        review_seen=false
    guide_value_expected=false
    for guide_arg in "$@"; do
      if [[ "$guide_value_expected" == true ]]; then
        guide_value_expected=false
        continue
      fi
      case "$guide_arg" in
        --intent|--base|--model|--effort|--ui-variant|--profile|--*-model|--*-effort)
          guide_value_expected=true
          ;;
        --next-steps)
          [[ "$next_steps_seen" == false ]] || die '--next-steps may be specified only once'
          next_steps_seen=true
          ;;
        --next-steps=*) die '--next-steps does not accept a value' ;;
        --engagement)
          [[ "$engagement_seen" == false ]] || die '--engagement may be specified only once'
          engagement_seen=true
          ;;
        --engagement=*) die '--engagement does not accept a value' ;;
        --review)
          [[ "$review_seen" == false ]] || die '--review may be specified only once'
          review_seen=true
          ;;
        --review=*) die '--review does not accept a value' ;;
        --ritual)
          [[ "$ritual_seen" == false ]] || die '--ritual may be specified only once'
          ritual_seen=true
          ;;
        --ritual=*) die '--ritual does not accept a value' ;;
      esac
    done
    if [[ "$ritual_seen" == true ]]; then
      [[ "$review_seen" == false ]] || die '--review and --ritual cannot be combined'
      [[ "$next_steps_seen" == false ]] || die '--next-steps and --ritual cannot be combined'
      [[ "$engagement_seen" == false ]] || die '--engagement and --ritual cannot be combined'
    fi
    if [[ "$review_seen" == true ]]; then
      [[ "$next_steps_seen" == false ]] || die '--review and --next-steps cannot be combined'
      [[ "$engagement_seen" == false ]] || die '--review and --engagement cannot be combined'
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --json|--json=*|--preview|--preview=*|--forks|--forks=*)
            die '--review cannot be combined with JSON or preview modes'
            ;;
          --intent|--base|--model|--effort|--ui-variant|--profile|--*-model|--*-effort)
            guide_value_expected=true
            ;;
        esac
      done
    fi
    if [[ "$next_steps_seen" == true ]]; then
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --engagement|--json|--json=*|--intent|--intent=*|--stdin|--preview|--preview=*|--forks|--forks=*)
            die '--next-steps cannot be combined with ordinary intent, JSON, stdin, or preview modes'
            ;;
          --model|--effort|--ui-variant|--profile|--*-model|--*-effort)
            guide_value_expected=true
            ;;
        esac
      done
    fi
    if [[ "$engagement_seen" == true ]]; then
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --json|--json=*|--profile|--profile=*|--ui-variant|--ui-variant=*|--preview|--preview=*|--forks|--forks=*)
            die '--engagement cannot be combined with JSON, profile selection, or preview modes'
            ;;
          --intent|--model|--effort) guide_value_expected=true ;;
        esac
      done
    fi
    ;;
  setup|doctor|repair|workflow-check|harness-version|shutdown|skills-update|skills-check|harness-update)
    mode='lifecycle'
    lifecycle_args=("$@")
    ;;
  skill)
    [[ "${2-}" == jcode ]] || die 'skill supports only jcode'
    mode='lifecycle'
    lifecycle_args=("$@")
    ;;
  inventory)
    shift
    [[ "$#" -ge 2 ]] || die 'inventory requires HARNESS [PROFILE...] [--no-always] --json'
    if [[ "${!#}" != --json ]]; then
      [[ "$1" == codex && "${!#}" == --goal-features ]] || die 'inventory requires HARNESS [PROFILE...] [--no-always] --json'
    fi
    mode='lifecycle'
    lifecycle_args=(inventory "$@")
    ;;
  run)
    shift
    case "${1-}" in
      '')
        mode='compose-select'
        compose_args=()
        ;;
      --dry-run|--no-always|--allow-unproven-isolation|--require-proven-isolation)
        mode='compose-select'
        compose_args=("$@")
        ;;
      pi|copilot|claude|codex|grok|agency|fx|headlong|jcode|omp|prime|uji|-h|--help|help)
        mode='compose'
        compose_args=("$@")
        [[ "${1-}" == pi || "${1-}" == copilot || "${1-}" == claude || "${1-}" == codex || "${1-}" == grok || "${1-}" == agency || "${1-}" == fx || "${1-}" == headlong || "${1-}" == jcode || "${1-}" == omp || "${1-}" == prime || "${1-}" == uji ]] \
          || compose_args=(--help)
        ;;
      *) die "unknown harness: $1; harnesses: agency, claude, codex, copilot, grok, jcode, omp, pi, prime, uji (also fx, headlong); usage: trx run HARNESS [PROFILE...]" ;;
    esac
    ;;
  --profile|--profile=*)
    die '--profile aliases are retired; use: trx run HARNESS [PROFILE...] [-- ARGS...]'
    ;;
  admin)
    mode='admin'
    shift
    [[ "$#" -eq 0 ]] || die 'admin accepts no arguments'
    ;;
  upgrade)
    mode='upgrade'
    shift
    if [[ "$#" -eq 1 && ( "$1" == -h || "$1" == --help || "$1" == help ) ]]; then
      upgrade_usage
      exit 0
    fi
    if [[ "${1-}" != all ]]; then
      if [[ "$#" -eq 2 && ( "$2" == -h || "$2" == --help || "$2" == help ) ]]; then
        upgrade_usage
        exit 0
      fi
      case "${1-}" in
        agency|codex|claude|copilot|fx|grok|headlong|jcode|omp|pi|prime|uji)
          mode='lifecycle'
          lifecycle_args=(upgrade "$@")
          ;;
        *) die 'upgrade requires all [--yes | --dry-run] or HARNESS [--all | PROFILE]' ;;
      esac
    else
      [[ "$#" -le 2 ]] \
        || die 'upgrade requires all [--yes | --dry-run]; use trx upgrade --help'
      if [[ "$#" -eq 2 ]]; then
        case "$2" in
          -h|--help|help) upgrade_usage; exit 0 ;;
          --yes|--dry-run) ;;
          *) die 'upgrade requires all [--yes | --dry-run]; use trx upgrade --help' ;;
        esac
      fi
      upgrade_args=("$@")
    fi
    ;;
  skills)
    mode='skills'
    shift
    skills_action="${1-}"
    skills_update_args=()
    if [[ "$skills_action" == update ]]; then
      shift
      [[ "$#" -le 1 && ( "$#" -eq 0 || "$1" == --check || "$1" == --upgrade-pins ) ]] || die 'skills update accepts --check or --upgrade-pins'
      skills_update_args=("$@")
    else
      [[ ( "$#" -eq 1 && "$1" == status ) || ( "$#" -eq 2 && "$1" == check && "$2" == --json ) ]] || die 'skills requires status, update, or check --json'
    fi
    ;;
  -i|--interactive|--interactive=*)
    die '-i and --interactive have been removed; run trx with no arguments'
    ;;
  '')
    mode='compose-select'
    compose_args=()
    ;;
  *)
    die "unknown command: $1; run trx --help"
    ;;
esac

command -v jq >/dev/null 2>&1 || die 'required command not found: jq'

case "$HOME" in
  /*) ;;
  *) die "HOME must be an absolute path: $HOME" ;;
esac
[[ -d "$HOME" && ! -L "$HOME" ]] || die "unsafe HOME: $HOME"
canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
[[ "$canonical_home" != / ]] || die 'HOME must not be /'
native_common_root="${XDG_DATA_HOME:-$canonical_home/.local/share}/trellage/common"

script_path="$(resolve_file "${BASH_SOURCE[0]}")" || die 'cannot resolve trx runtime'
script_dir="$(canonical_directory "$(dirname "$script_path")")" || die 'cannot resolve trx runtime'
runtime="$(canonical_directory "$script_dir/..")" || die 'cannot resolve trx runtime'
source_workspace="$runtime/source"
if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
  [[ "$TRELLAGE_TRX_SOURCE_ROOT" == /* ]] \
    || die "TRELLAGE_TRX_SOURCE_ROOT must be absolute: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ -d "$TRELLAGE_TRX_SOURCE_ROOT" && ! -L "$TRELLAGE_TRX_SOURCE_ROOT" ]] \
    || die "unsafe TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  source_root="$(canonical_directory "$TRELLAGE_TRX_SOURCE_ROOT")" \
    || die "cannot resolve TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ "$runtime" == "$source_root" ]] \
    || die "trx source runtime differs from TRELLAGE_TRX_SOURCE_ROOT: $runtime"
  source_workspace="$(canonical_directory "$runtime/../..")" || die 'cannot resolve source workspace'
  guide_root="$runtime/../../profile-guides"
  if [[ -n "${TRELLAGE_TRX_GUIDE_ROOT-}" ]]; then
    [[ "$TRELLAGE_TRX_GUIDE_ROOT" == /* ]] \
      || die "TRELLAGE_TRX_GUIDE_ROOT must be absolute: $TRELLAGE_TRX_GUIDE_ROOT"
    [[ -d "$TRELLAGE_TRX_GUIDE_ROOT" && ! -L "$TRELLAGE_TRX_GUIDE_ROOT" ]] \
      || die "unsafe TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
    guide_root="$(canonical_directory "$TRELLAGE_TRX_GUIDE_ROOT")" \
      || die "cannot resolve TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
  fi
else
  [[ "$runtime" == "$canonical_home/.local/share/trellage/trx" ]] \
    || die "trx is not running from its owned runtime: $runtime"
  [[ -f "$runtime/.managed-by-trellage-router" && ! -L "$runtime/.managed-by-trellage-router" ]] \
    || die 'missing trx ownership marker'
  [[ "$(<"$runtime/.managed-by-trellage-router")" == "$ownership_value" ]] \
    || die 'invalid trx ownership marker'
  guide_root="$runtime/share/profile-guides"
fi
require_source_runtime() {
  [[ -f "$source_workspace/scripts/bun-runtime.sh" && ! -L "$source_workspace/scripts/bun-runtime.sh" ]] \
    || die "source runtime is missing or unsafe; reinstall trx: $source_workspace"
  . "$source_workspace/scripts/bun-runtime.sh"
  if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
    trellage_bun_runtime "$source_workspace" || die 'source Bun runtime is unavailable'
    TRELLAGE_READINESS_MEMO=1 "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/workspace-cli.ts" ensure "$source_workspace" \
      || die 'automatic source runtime preparation failed'
    return
  fi
  trellage_require_source_runtime "$source_workspace" \
    || die 'source runtime is not ready; reinstall trx or prepare worktree dependencies explicitly'
}
skip_optional_jev_key() {
  printf 'trx: Jev decisions stay off: %s\n' "$1" >&2
}

# Load the optional TYPESAFE_API_KEY from the Trellage Varlock environment.
# An existing process value wins. The key goes to the launcher under a private
# name, which the launcher removes from its environment, so agents launched from
# the guide do not inherit it. A missing key is a silent no-op. A resolver or
# Varlock failure never loads the key and never stops the guide.
load_optional_jev_api_key() {
  local resolver="$source_workspace/scripts/native-environment.ts"
  local metadata environment_path dependency_directory varlock key
  unset _TRELLAGE_JEV_API_KEY
  [[ -z "${TYPESAFE_API_KEY-}" ]] || return 0
  [[ -f "$resolver" && ! -L "$resolver" ]] || {
    skip_optional_jev_key "environment resolver is missing or unsafe: $resolver"
    return 0
  }
  metadata="$("${trellage_bun[@]}" "$resolver")" || {
    skip_optional_jev_key 'environment resolution failed'
    return 0
  }
  jq -e '
    type == "object"
    and (.enabled | type == "boolean")
    and (.source_present | type == "boolean")
    and (.path | type == "string" and length > 0)
  ' <<<"$metadata" >/dev/null 2>&1 || {
    skip_optional_jev_key 'environment resolver returned invalid metadata'
    return 0
  }
  [[ "$(jq -r '.enabled and .source_present' <<<"$metadata")" == true ]] || return 0
  environment_path="$(jq -r '.path' <<<"$metadata")"
  dependency_directory="$("${trellage_bun[@]}" \
    "$source_workspace/packages/trellage-runtime/src/workspace-cli.ts" \
    dependency "$source_workspace" varlock)" || {
    skip_optional_jev_key 'Varlock dependency is not ready'
    return 0
  }
  varlock="$dependency_directory/bin/cli.js"
  [[ -f "$varlock" && ! -L "$varlock" && -r "$varlock" ]] || {
    skip_optional_jev_key "Varlock CLI is missing or unsafe: $varlock"
    return 0
  }
  command -v node >/dev/null 2>&1 || {
    skip_optional_jev_key 'required command not found: node'
    return 0
  }
  # Varlock cannot wrap the guide: it does not pass fd 3 and it redacts piped
  # output. Resolve only this key in a short child, then hand it over.
  key="$(
    unset TYPESAFE_API_KEY
    node "$varlock" run --no-redact-stdout --path "$environment_path" --inject vars \
      --filter TYPESAFE_API_KEY -- /bin/sh -c 'printf %s "${TYPESAFE_API_KEY-}"' 2>/dev/null
  )" || {
    skip_optional_jev_key "Varlock could not load $environment_path; run varlock load --path $environment_path"
    return 0
  }
  [[ -n "$key" ]] || return 0
  _TRELLAGE_JEV_API_KEY="$key"
  export _TRELLAGE_JEV_API_KEY
}

picker_path="$source_workspace/packages/trellage-launcher/src/cli.tsx"
floating_skills_manager="$source_workspace/scripts/floating-skills.ts"
floating_skills_catalog="$source_workspace/config.toml"
router_command_path="$runtime/bin/trx"
[[ "$script_path" == "$router_command_path" && -f "$router_command_path" \
    && -x "$router_command_path" && ! -L "$router_command_path" ]] \
  || die 'current router command is missing or unsafe'
if [[ "$mode" == lifecycle ]]; then
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/native-run/lifecycle-cli.ts" "${lifecycle_args[@]}"
fi
if [[ "$mode" == list ]]; then
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-launcher/src/run-list-cli.ts" ${list_args[@]+"${list_args[@]}"}
fi
if [[ "$mode" == compose-select ]]; then
  require_source_runtime
  if [[ "$trx_transcript_api_key_is_set" == true ]]; then
    export TRANSCRIPT_API_KEY="$trx_transcript_api_key"
  fi
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-launcher/src/run-select-cli.tsx" ${compose_args[@]+"${compose_args[@]}"}
fi
if [[ "$mode" == compose ]]; then
  if [[ "${compose_args[0]-}" == codex && "${compose_args[1]-}" == youtube ]]; then restore_transcript_api_key codex youtube; fi
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/native-run/cli.ts" ${compose_args[@]+"${compose_args[@]}"}
fi
if [[ "$mode" == skills ]]; then
  require_source_runtime
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
  if [[ "$skills_action" == check ]]; then
    exec "${trellage_bun[@]}" "$floating_skills_manager" check-shared --catalog "$floating_skills_catalog"
  fi
  if [[ "$skills_action" == update ]]; then
    exec "${trellage_bun[@]}" "$source_workspace/scripts/skills-update.ts" ${skills_update_args[@]+"${skills_update_args[@]}"}
  fi
  exec "${trellage_bun[@]}" "$floating_skills_manager" "$skills_action" \
    --catalog "$floating_skills_catalog" \
    --bundle native-common
fi

if [[ "$mode" == guide && "$review_seen" == true ]]; then
  require_source_runtime
  [[ -f "$picker_path" && ! -L "$picker_path" ]] || die 'Ink launcher is missing or unsafe'
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die 'floating-skills manager is missing or unsafe'
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die 'floating-skills catalog is missing or unsafe'
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    TRELLAGE_REVIEW_PROFILE_COMMAND="$script_path" \
    TRELLAGE_GUIDE_SKILLS_MANAGER="$floating_skills_manager" \
    TRELLAGE_GUIDE_SKILLS_CATALOG="$floating_skills_catalog" \
    TRELLAGE_GUIDE_NATIVE_SKILLS_CACHE="$native_common_root/skills" \
    exec "${trellage_launcher[@]}" "$picker_path" guide "$guide_root" "" "${guide_args[@]}"
fi

if [[ "$mode" == guide && "$ritual_seen" == true ]]; then
  # Saved prompts read no catalog and call no model.
  require_source_runtime
  ritual_headless=false
  ritual_value_expected=false
  for guide_arg in "${guide_args[@]}"; do
    if [[ "$ritual_value_expected" == true ]]; then
      ritual_value_expected=false
      continue
    fi
    case "$guide_arg" in
      --print|--print=*|--copy|--copy=*|--help)
        ritual_headless=true
        ;;
      --intent|--base|--profile|--ui-variant)
        ritual_headless=true
        ritual_value_expected=true
        ;;
      --intent=*|--base=*|--profile=*|--ui-variant=*|--json|--json=*|--optimize|--intent-stdin|--stdin|--preview|--preview=*|--forks|--forks=*)
        ritual_headless=true
        ;;
      --model|--effort|--*-model|--*-effort)
        ritual_value_expected=true
        ;;
    esac
  done
  if [[ "$ritual_headless" == false ]]; then
    [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
  fi
  [[ -f "$picker_path" && ! -L "$picker_path" ]] \
    || die 'Ink launcher is missing or unsafe'
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    exec "${trellage_launcher[@]}" "$picker_path" guide "$guide_root" "" "${guide_args[@]}"
fi

if [[ "$mode" == guide ]] && ((${#guide_args[@]} > 0)); then
  for guide_arg in "${guide_args[@]}"; do
    if [[ "$guide_arg" == --preview || "$guide_arg" == --preview=* \
      || "$guide_arg" == --forks || "$guide_arg" == --forks=* ]]; then
      # Fixture-only previews: they read no catalog, so short-circuit
      # before launcher discovery, the catalog reads,
      # and the floating-skills fetch below. None of them apply to fixtures.
      require_source_runtime
      [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
      [[ -f "$picker_path" && ! -L "$picker_path" ]] \
        || die 'Ink launcher is missing or unsafe'
      if [[ "$guide_arg" == --forks* ]]; then
        exec "${trellage_launcher[@]}" "$picker_path" guide-forks "${guide_args[@]}"
      fi
      exec "${trellage_launcher[@]}" "$picker_path" guide-preview "${guide_args[@]}"
    fi
  done
fi



if [[ "$mode" == upgrade ]]; then
  require_source_runtime
  [[ -f "$picker_path" && ! -L "$picker_path" ]] || die 'harness update CLI is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] || die 'profile guide registry is missing or unsafe'
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    exec "${trellage_launcher[@]}" "$picker_path" upgrade "${upgrade_args[@]}"
fi

if [[ "$mode" == guide ]]; then
  require_source_runtime
  load_optional_jev_api_key
  [[ -f "$picker_path" && ! -L "$picker_path" ]] || die 'Ink launcher is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] || die 'profile guide registry is missing or unsafe'

  guide_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx-guide.XXXXXX")" || die 'cannot create guide workspace'
  cleanup_guide_tmp() { rm -rf -- "$guide_tmp"; }
  trap cleanup_guide_tmp EXIT HUP INT TERM

  if [[ "$engagement_seen" == false ]]; then
    [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
    [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
    "${trellage_bun[@]}" "$floating_skills_manager" ensure \
      --catalog "$floating_skills_catalog" \
      --bundle guide-prompt-master \
      --cache "$canonical_home/.local/share/trellage/common/guide-prompt-master-skills" \
      --target "$guide_tmp/skills" \
      || die 'failed to prepare the guide Prompt Master skill'
    [[ -f "$guide_tmp/skills/prompt-master/SKILL.md" && ! -L "$guide_tmp/skills/prompt-master/SKILL.md" ]] \
      || die 'guide Prompt Master skill is missing or unsafe'
  fi

  guide_command=("${trellage_launcher[@]}" "$picker_path" guide "$guide_root" "$guide_tmp/skills/prompt-master")
  ((${#guide_args[@]} == 0)) || guide_command+=("${guide_args[@]}")
  guide_status=0
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    TRELLAGE_GUIDE_SKILLS_MANAGER="$floating_skills_manager" \
    TRELLAGE_GUIDE_SKILLS_CATALOG="$floating_skills_catalog" \
    TRELLAGE_GUIDE_NATIVE_SKILLS_CACHE="$native_common_root/skills" \
    TRELLAGE_GUIDE_OPTIMIZE_SKILLS_CACHE="$canonical_home/.local/share/trellage/common/guide-optimize-architecture-skills" \
    "${guide_command[@]}" || guide_status=$?
  cleanup_guide_tmp
  trap - EXIT HUP INT TERM
  exit "$guide_status"
fi

if [[ "$mode" == admin ]]; then
  require_source_runtime
  [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
  load_optional_jev_api_key
  [[ -f "$picker_path" && ! -L "$picker_path" ]] || die 'Ink launcher is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] || die 'profile guide registry is missing or unsafe'
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    exec "${trellage_launcher[@]}" "$picker_path" admin "$guide_root"
fi
