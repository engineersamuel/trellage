}

restore_transcript_api_key() {
  if [[ "$1" == cdx && "$2" == youtube && "$trx_transcript_api_key_is_set" == true ]]; then
    export TRANSCRIPT_API_KEY="$trx_transcript_api_key"
  fi
}

usage() {
  cat <<'EOF'
Usage:
  trx
  trx list [--json]
  trx run HARNESS PROFILE [-- ARGS...]
  trx guide [INTENT] [--json] [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --next-steps [--model MODEL] [--effort LEVEL]
  trx guide --engagement [--intent QUESTION] [--model MODEL] [--effort LEVEL]
  trx guide --optimize [--base REF] [--intent INTENT] [--model MODEL] [--effort LEVEL]
  trx guide --review
  trx guide --preview
  trx guide --forks [VARIANT]
  trx inventory LAUNCHER PROFILE --json
  trx admin
  trx upgrade all [--yes | --dry-run]
  trx skills status
  trx skills check --json
  trx skills update

Select an installed native harness/profile interactively, or list available
profiles. Bare trx opens the launcher. `trx run` composes selected profiles
and launches their canonical harness. For example:
`trx run copilot tufte-vdqi`. The picker shows this exact command for each row.
`trx guide`
recommends a profile and builds prompt candidates; its JSON mode is
non-interactive and has no launch or Herdr side effects. `trx inventory`
reports the live readiness (`healthy`, `unhealthy`, `not-setup`, or `busy`) of
a single profile by delegating to that launcher's own `inventory` command. It
is not called during `list` or interactive selection, so those stay fast.
`trx admin` opens a read-mostly command center listing every native and
Sandbox profile with health, install state, and diagnostics; it requires an
interactive terminal and never launches a profile without an explicit,
separately confirmed terminal-launch action.
`trx upgrade all` previews Native and Container harness version AND skill updates and
requires explicit terminal confirmation. Use --yes to authorize a
non-interactive update, or --dry-run to preview without updates. It does not
install or upgrade Trellage itself.
EOF
}

upgrade_usage() {
  cat <<'EOF'
Usage:
  trx upgrade all [--yes | --dry-run]

Update harness versions AND skills for every Native and Container catalog profile.
The preview includes profiles hidden by Admin filters. One queue runs:
1. Native harness updates: shared runtimes once, Firstmate per profile.
2. Shared Native skill-cache refresh: one trx skills update.
3. Native profile skill copies and verification, including Agency.
4. Container harness builds, including current configured skills.
Native skill copies are final; harness updates cannot overwrite them afterward.
Admin U remains the selected harness-only action.

Without a flag, preview the scope and require you to type yes at a terminal.
--yes authorizes updates without an interactive terminal.
--dry-run previews the scope without running updates or version checks.

Existing profile version and source pins are preserved. Unsupported profiles,
fallbacks, failures, and unreadable installed versions are reported.
Independent updates continue after failures. Cancellation stops later updates.
Exit status is nonzero for incomplete discovery, unsupported profiles, failed
harness or skill updates, failed installed-version reads, and profiles not run.
A failed skill cache refresh skips Native copies, not independent harness updates.
Cancellation exits 130.

This does not install or upgrade Trellage itself.
trellage upgrade all remains Container-only.
EOF
}

guide_usage() {
  cat <<'EOF'
Usage:
  trx guide [INTENT]
  trx guide --intent INTENT [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --next-steps [--model MODEL] [--effort LEVEL]
  trx guide --engagement [--intent QUESTION] [--model MODEL] [--effort LEVEL]
  trx guide --optimize [--base REF] [--intent INTENT] [--model MODEL] [--effort LEVEL]
  trx guide --review
  trx guide --json [--intent INTENT] [--profile PROFILE_REF] [--model MODEL] [--effort LEVEL]
  trx guide --preview
  trx guide --forks [tabs|inline]

PROFILE_REF is native:<launcher>/<profile> or sandbox:<profile>. JSON mode
uses schemaVersion 1, has no launch or Herdr side effects, and accepts a JSON
request on stdin when --intent is omitted.
INTENT can contain line breaks and accepts up to 60,000 characters.
--engagement reads selected repository documents to recommend the next
customer-engagement action. Its question is limited to 8,000 characters.
It opens a local source view first; model use, saving, and interactive
current-terminal launch require separate confirmation. No folder migration.
--review opens Review changes with no checks selected; --optimize opens the same
view with First principles and Behavior preservation selected. Both offer all six checks.
Approve findings before one fresh Native agent can edit this worktree.
The current worktree and branch are used automatically. Use --base REF to
override the detected comparison base. Uncommitted-only review is an explicit
alternative. No conversation capture or model calls during setup.
Press p during matching or recommendations to view the prompt as Markdown.
Press e in the prompt viewer to edit; Enter rematches a changed prompt.
Interactive prompt viewers: pager, split, focus, bookends, dashboard.
--preview renders the staged prompt basket composer overlay from fixture data.
--forks renders two ways to fork the guide into parallel subflows.
It reads no profile catalog, calls no model, and launches nothing.
--review accepts --base, --intent, --intent-stdin, --model and --effort.
It needs Copilot and selected review skills, not every Native launcher or Sandbox.
EOF
}

canonical_directory() {
  (CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P)
}

resolve_file() {
  local path="$1"
  local directory
  local target
  local links=0

  [[ "$path" == /* ]] || {
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    path="$directory/$(basename "$path")"
  }

  while [[ -L "$path" ]]; do
    ((links += 1))
    ((links <= 40)) || return 1
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    target="$(readlink "$path")" || return 1
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$directory/$target"
    fi
  done

  directory="$(canonical_directory "$(dirname "$path")")" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

require_safe_directory() {
  local path="$1"
  local expected="$2"
  local description="$3"
  local resolved

  [[ -d "$path" && ! -L "$path" ]] || die "unsafe $description: $path"
  resolved="$(canonical_directory "$path")" || die "cannot resolve $description: $path"
  [[ "$resolved" == "$expected" ]] || die "redirected $description: $path"
}

discover_launcher() {
  local launcher="$1"
  local marker_name="$2"
  local marker_value="$3"
  local legacy_marker_value="${4-}"
  local package_dir="${5-}"
  local discovered
  local installed_marker_value
  local resolved
  local dev_candidate
  local dev_source
  # Captured before the launcher-scoped `runtime` below shadows the trx
  # router's own resolved runtime directory (set once, globally, near the
  # top-level TRELLAGE_TRX_SOURCE_ROOT handling).
  local trx_root="$runtime"
  local runtime="$canonical_home/.local/share/trellage/$launcher"
  local expected="$runtime/bin/$launcher"
  local catalog="$runtime/catalog.json"
  local marker="$runtime/$marker_name"

  if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" && -n "${TRELLAGE_TRX_NATIVE_SOURCE-}" \
    && -n "$package_dir" ]]; then
    # Explicit, opt-in extension of TRELLAGE_TRX_SOURCE_ROOT: a developer who
    # also sets TRELLAGE_TRX_NATIVE_SOURCE gets every native launcher resolved
    # from this worktree's own sibling prototypes/trellage-*-profiles package
    # instead of the shared, installed runtime, so worktree development and
    # the installed launcher never collide. This is intentionally a second,
    # separate switch: TRELLAGE_TRX_SOURCE_ROOT alone only affects trx's own
    # bundled router assets (picker/guide), so router-only dev/test flows that
    # still want deterministic, installed (or fixture) native launchers keep
    # working unchanged.
    dev_source="$trx_root/../$package_dir/bin/$launcher"
    [[ -f "$dev_source" && ! -L "$dev_source" ]] \
      || die "unsafe development launcher: $launcher ($dev_source)"
    dev_candidate="$(resolve_file "$dev_source")" \
      || die "cannot resolve development launcher: $launcher ($package_dir)"
    [[ -f "$dev_candidate" && -x "$dev_candidate" ]] \
      || die "development launcher is not an executable regular file: $launcher ($dev_candidate)"
    printf '%s\n' "$dev_candidate"
    return 0
  fi

  # Backends are private installed assets; public aliases are never discovered on PATH.
  if [[ ! -f "$expected" ]]; then
    dev_source="$source_workspace/prototypes/$package_dir/bin/$launcher"
    [[ -f "$dev_source" && -x "$dev_source" && ! -L "$dev_source" ]] \
      || die "native backend unavailable: $launcher; reinstall trx"
    printf '%s\n' "$dev_source"
    return 0
  fi

  require_safe_directory "$runtime" "$runtime" "$launcher runtime"
  require_safe_directory "$runtime/bin" "$runtime/bin" "$launcher runtime bin"
  [[ -f "$expected" && -x "$expected" && ! -L "$expected" ]] \
    || die "unsafe owned launcher: $expected"
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "unsafe owned catalog: $catalog"
  [[ -f "$marker" && -r "$marker" && ! -L "$marker" ]] \
    || die "missing ownership marker for $launcher"
  installed_marker_value="$(<"$marker")"
  if [[ "$installed_marker_value" != "$marker_value" ]] \
    && { [[ -z "$legacy_marker_value" ]] || [[ "$installed_marker_value" != "$legacy_marker_value" ]]; }; then
    die "invalid ownership marker for $launcher"
  fi

  printf '%s\n' "$expected"
}

read_catalog() {
  local launcher="$1"
  local harness="$2"
  local executable="$3"
  local output

  local catalog_path="$(dirname "$(dirname "$executable")")/catalog.json"
  [[ -f "$catalog_path" && ! -L "$catalog_path" ]] || die "missing private catalog: $launcher"
  output="$(jq --arg launcher "$launcher" --arg harness "$harness" '
    {schemaVersion: 1, launcher: $launcher, harness: $harness, sandbox: false,
     profiles: [.profiles | (if type == "array" then .[] else to_entries[] | .value + {name: .key} end)
       | .plugin //= null | .source //= null | .standaloneMcps //= []
       | if .kind == "plugin" or .kind == "skills" then . else del(.kind) end
       | .marketplace = (if (.marketplace | type) == "string" then {repository: .marketplace} else .marketplace end)]}
  ' "$catalog_path")" || die "invalid catalog from $launcher"

  jq -e --arg launcher "$launcher" --arg harness "$harness" '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    def validOrchestration:
      type == "object"
      and ((keys - ["preparation", "instances"]) == [
        "dispatchRules", "kind", "schemaVersion", "sourceRevision", "submission",
        "taskIdPrefix", "workerEfforts", "workerHarness", "workerPolicy"
      ])
      and ((has("preparation") | not) or
        (.preparation | type == "object" and keys == ["schemaVersion"] and .schemaVersion == 1))
      and ((has("instances") | not) or
        (.instances | type == "object" and keys == ["schemaVersion"] and .schemaVersion == 1))
      and .schemaVersion == 1
      and .kind == "firstmate"
      and (.sourceRevision | type == "string" and test("^[a-f0-9]{40}$"))
      and (.taskIdPrefix
        | type == "string" and length <= 128 and test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.workerPolicy == null or
        (.workerPolicy
          | type == "object"
          and keys == ["digest", "name"]
          and (.name | type == "string" and length <= 128 and test("^[a-z0-9]+(-[a-z0-9]+)*$"))
          and (.digest | type == "string" and test("^[a-f0-9]{64}$"))))
      and .workerHarness == "claude"
      and (.workerEfforts
        | type == "array"
        and length > 0 and length <= 5 and length == (unique | length)
        and all(.[]; . == "low" or . == "medium" or . == "high" or . == "xhigh" or . == "max"))
      and .dispatchRules == "claude-single"
      and (.submission
        | type == "object"
        and keys == ["maxRequestBytes", "schemaVersion"]
        and .schemaVersion == 1
        and (.maxRequestBytes
          | type == "number" and . == floor and . >= 1024 and . <= 524288));
    type == "object"
    and keys == ["harness", "launcher", "profiles", "sandbox", "schemaVersion"]
    and .schemaVersion == 1
    and .launcher == $launcher
    and .harness == $harness
    and (.sandbox | type == "boolean")
    and (.profiles | type == "array" and length > 0)
    and all(.profiles[];
      type == "object"
      and (.name | type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.description
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not))
      and (.headless | validHeadless)
      and ((has("orchestration") | not) or
        ($launcher == "fmx" and $harness == "firstmate"
          and .headless.prompt == false and (.orchestration | validOrchestration)))
      and (.plugin == null or
        (.plugin
          | type == "string"
          and length > 0
          and (test("[\u0000-\u001f\u007f-\u009f]") | not)))
      and ((has("kind") | not) or (.kind == "plugin" or .kind == "skills"))
      and (.source == null or (.source | type == "string" and length > 0))
      and ((has("skillBundles") | not) or
        (.skillBundles
          | type == "array"
          and length > 0
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$"))))
      and ((has("managedSkills") | not) or
        (.managedSkills
          | type == "array"
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))))
      and ((has("requiredEnvironment") | not) or
        (.requiredEnvironment
          | type == "array"
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[A-Z][A-Z0-9_]*$"))))
      and (.marketplace == null or (.marketplace | type == "object"))
      and (.standaloneMcps | type == "array")
      and all(.standaloneMcps[];
        (
          if type == "string" then .
          elif type == "object" then .name
          else null
          end
        )
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not)))
    and ([.profiles[].name] | length == (unique | length))
  ' <<<"$output" >/dev/null || die "invalid catalog from $launcher"

  printf '%s\n' "$output"
}

build_choices() {
  jq -cn \
    --argjson cpxCatalog "$1" \
    --argjson cdxCatalog "$2" \
    --argjson cldxCatalog "$3" \
    --argjson jcxCatalog "$4" \
    --argjson ompCatalog "$5" \
    --argjson picxCatalog "$6" \
    --argjson prxCatalog "$7" \
    --argjson fmxCatalog "$8" \
    --argjson agxCatalog "$9" \
    --arg cpxPath "${10}" \
    --arg cdxPath "${11}" \
    --arg cldxPath "${12}" \
    --arg jcxPath "${13}" \
    --arg ompPath "${14}" \
    --arg picxPath "${15}" \
    --arg prxPath "${16}" \
    --arg fmxPath "${17}" \
    --arg agxPath "${18}" \
    --arg trxPath "$router_command_path" \
    --argjson passthroughArgs "${19}" '
    def models($catalog; $profile):
      if $catalog.launcher == "cpx" or $catalog.launcher == "cdx" then
        {defaultModel:"gpt-6-astra",models:["gpt-6-astra","gpt-5.6-sol","gpt-5.6-terra"],modelOverrideSupported:true}
      elif $catalog.launcher == "cldx" then
        {defaultModel:"claude-opus-5",models:["claude-opus-5","claude-sonnet-5","claude-haiku-4.5"],modelOverrideSupported:true}
      elif $catalog.launcher == "omp" and $profile.name == "copilot" then
        {defaultModel:"github-copilot/gpt-5.6-sol:medium",models:["github-copilot/gpt-5.6-sol:medium","github-copilot/gpt-5.6-terra:medium"],modelOverrideSupported:true}
      elif $catalog.launcher == "picx" then
        {defaultModel:"copilot-proxy-rs/gpt-6-astra:medium",models:["copilot-proxy-rs/gpt-6-astra:medium"],modelOverrideSupported:false}
      elif $catalog.launcher == "omp" then
        {defaultModel:"copilot-proxy-rs/qwen3.6-35b-a3b-local",models:["copilot-proxy-rs/qwen3.6-35b-a3b-local"],modelOverrideSupported:false}
      elif $catalog.launcher == "jcx" then
        {defaultModel:"gpt-5.6-sol",models:["gpt-5.6-sol"],modelOverrideSupported:true}
      elif $catalog.launcher == "prx" then
        {defaultModel:"claude-opus-5",models:["claude-opus-5"],modelOverrideSupported:true}
      else {models:[],modelOverrideSupported:false}
      end;
    def display_harness($catalog):
      if $catalog.launcher == "omp" or $catalog.launcher == "picx" then "pi" else $catalog.harness end;
    def display_profile($catalog; $profile):
      if $catalog.launcher == "omp" and $profile.name == "copilot" then "oh-my-pi" else $profile.name end;
    def binary_path($catalog):
      if $catalog.launcher == "cpx" then $cpxPath
      elif $catalog.launcher == "cdx" then $cdxPath
      elif $catalog.launcher == "cldx" then $cldxPath
      elif $catalog.launcher == "fmx" then $fmxPath
      elif $catalog.launcher == "jcx" then $jcxPath
      elif $catalog.launcher == "omp" then $ompPath
      elif $catalog.launcher == "picx" then $picxPath
      elif $catalog.launcher == "prx" then $prxPath
      elif $catalog.launcher == "agx" then $agxPath
      else error("unknown launcher path") end;
    def pair($catalog):
      $catalog.profiles[] as $profile
      | (display_harness($catalog)) as $harness
      | (display_profile($catalog; $profile)) as $displayProfile
      | ({
        id: ($catalog.launcher + ":" + $profile.name),
        label: ($harness + " / " + $displayProfile),
        harness: $harness,
        profile: $displayProfile,
        commandAlias: $catalog.launcher,
        commandPath: $trxPath,
        profileArgument: $profile.name,
        passthroughArgs: $passthroughArgs,
        description: $profile.description,
        plugins: ([$profile.plugin] | map(select(type == "string" and length > 0)) | unique),
        skills: ($profile.managedSkills // []),
        mcps: ([$profile.standaloneMcps[]? | if type == "string" then . else .name end] | map(select(type == "string" and length > 0)) | unique),
        sandbox: $catalog.sandbox,
        details: "The selected launcher checks readiness before starting."
      } + models($catalog; $profile));
    {
      prompt: "Select a Trellage harness/profile",
      description: "Direct launch: trx run LAUNCHER PROFILE. The selected row shows its exact command below. Trellage Native runs coding-agent launchers and Firstmate fleet orchestration directly on the host with isolated state. Codex (cdx) uses Full Access without a native sandbox; other legacy native profiles are not security boundaries.",
      choices: [
        pair($cpxCatalog),
        pair($cdxCatalog),
        pair($cldxCatalog),
        pair($fmxCatalog),
        pair($jcxCatalog),
        pair($ompCatalog),
        pair($picxCatalog),
        pair($prxCatalog)
        ,pair($agxCatalog)
      ]
    }
  '
}

build_profile_list() {
  jq -cn \
    --argjson cpxCatalog "$1" \
    --argjson cdxCatalog "$2" \
    --argjson cldxCatalog "$3" \
    --argjson jcxCatalog "$4" \
    --argjson ompCatalog "$5" \
    --argjson picxCatalog "$6" \
    --argjson prxCatalog "$7" \
    --argjson fmxCatalog "$8" \
    --argjson agxCatalog "$9" \
    --argjson herdrLedger "$trx_herdr_ledger" '
    def herdrCompatibility($launcher; $name):
      ([$herdrLedger[] | select(.launcher == $launcher and .profile == $name)] | .[0]) as $entry
      | if $entry == null then { status: "untested" }
        else ($entry | del(.launcher, .profile))
        end;
    def profiles($catalog):
      $catalog.profiles[] | {
        launcher: (if $catalog.launcher == "omp" then "omp" else $catalog.harness end),
        harness: (if $catalog.launcher == "omp" then "omp" else $catalog.harness end),
        name: (if $catalog.launcher == "agx" then "azure" elif $catalog.launcher == "omp" and .name == "copilot" then "default" else .name end),
        description,
        headless,
        sandbox: $catalog.sandbox,
        herdrCompatibility: herdrCompatibility($catalog.launcher; .name)
      } + (if has("orchestration") then {orchestration} else {} end);
    {
      schemaVersion: 1,
      profiles: [
        profiles($cpxCatalog),
        profiles($cdxCatalog),
        profiles($cldxCatalog),
        profiles($fmxCatalog),
        profiles($jcxCatalog),
        profiles($ompCatalog),
        profiles($picxCatalog),
        profiles($prxCatalog)
        ,profiles($agxCatalog)
      ]
    }
  '
}

# Builds the profile-guide catalog shared by `guide`
# `admin`, and `upgrade all`, writing it to "$1/combined.json". Requires guide_root,
# runtime, source_workspace, picker_path, cpx/cdx/cldx/jcx/omp/picx/prx (validated launcher
# paths), and the per-launcher *_catalog variables to already be in scope.
build_combined_guide_catalog() {
  local out_dir="$1"
  local native_only="${2:-false}"
  local profile_list
  profile_list="$(build_profile_list \
    "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" \
    "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog" "$agx_catalog")" \
    || die 'could not build native profile list'

  local sandbox_cli
  if [[ "$native_only" == true ]]; then
    # The shared schema still needs a command path, but Optimize never invokes it.
    sandbox_cli="$source_workspace/prototypes/trellage/trellage"
  elif [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
    sandbox_cli="$runtime/../trellage/trellage"
  else
    sandbox_cli="$(command -v trellage || true)"
  fi
  [[ -n "$sandbox_cli" && -x "$sandbox_cli" ]] \
    || die 'trellage command not found; this mode requires the Sandbox catalog'
  sandbox_cli="$(resolve_file "$sandbox_cli")" \
    || die "cannot resolve trellage command: $sandbox_cli"
  [[ -f "$sandbox_cli" && -x "$sandbox_cli" ]] \
    || die "trellage command is not an executable regular file: $sandbox_cli"

  printf '%s\n' "$profile_list" \
    | "${trellage_launcher[@]}" "$picker_path" enrich-native-list "$guide_root" \
      >"$out_dir/native-public.json" \
    || die 'could not enrich native profile list with guides'
  jq --arg trxPath "$router_command_path" '.profiles |= map(. + {commandPath: $trxPath})' \
    "$out_dir/native-public.json" >"$out_dir/native.json" \
    || die 'could not add router command path to the guide catalog'
  if [[ "$native_only" == true ]]; then
    printf '{"schemaVersion":2,"profiles":[]}\n' >"$out_dir/sandbox.json"
  else
    "$sandbox_cli" list --json-full >"$out_dir/sandbox.json" \
      || die 'could not load the Sandbox profile guide catalog'
  fi
  jq -n \
    --arg sandboxCommandPath "$sandbox_cli" \
    --slurpfile native "$out_dir/native.json" \
    --slurpfile sandbox "$out_dir/sandbox.json" \
    '{
      schemaVersion: 1,
      sandboxCommandPath: $sandboxCommandPath,
      native: $native[0].profiles,
      sandbox: $sandbox[0].profiles
    }' >"$out_dir/combined.json" \
    || die 'could not combine profile guide catalogs'
}

mode=''
review_seen=false
optimize_seen=false
list_json=0
inventory_launcher=''
inventory_profile_arg=''
run_launcher=''
run_profile=''
run_args=()
skills_action=''
guide_args=()
upgrade_args=()
case "${1-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  list)
    mode='list'
    shift
    if [[ "$#" -eq 0 ]]; then
      :
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_json=1
    elif [[ "$#" -ge 1 && "$#" -le 2 && "$1" != -* ]]; then
      mode='backend'
      backend_args=(list "$@")
    else
      die 'list accepts only --json'
    fi
    ;;
  guide)
    mode='guide'
    shift
    if [[ "$#" -eq 1 && ("$1" == -h || "$1" == --help || "$1" == help) ]]; then
      guide_usage
      exit 0
    fi
    guide_args=("$@")
    next_steps_seen=false
    engagement_seen=false
    optimize_seen=false
    review_seen=false
    guide_value_expected=false
    for guide_arg in "$@"; do
      if [[ "$guide_value_expected" == true ]]; then
        guide_value_expected=false
        continue
      fi
      case "$guide_arg" in
        --intent|--base|--model|--effort|--ui-variant|--profile|--*-model|--*-effort)
          guide_value_expected=true
          ;;
        --next-steps)
          [[ "$next_steps_seen" == false ]] || die '--next-steps may be specified only once'
          next_steps_seen=true
          ;;
        --next-steps=*) die '--next-steps does not accept a value' ;;
        --engagement)
          [[ "$engagement_seen" == false ]] || die '--engagement may be specified only once'
          engagement_seen=true
          ;;
        --engagement=*) die '--engagement does not accept a value' ;;
        --optimize)
          [[ "$optimize_seen" == false ]] || die '--optimize may be specified only once'
          optimize_seen=true
          ;;
        --optimize=*) die '--optimize does not accept a value' ;;
        --review)
          [[ "$review_seen" == false ]] || die '--review may be specified only once'
          review_seen=true
          ;;
        --review=*) die '--review does not accept a value' ;;
      esac
    done
    [[ "$review_seen" != true || "$optimize_seen" != true ]] || die '--review and --optimize cannot be combined'
    if [[ "$optimize_seen" == true || "$review_seen" == true ]]; then
      [[ "$next_steps_seen" == false ]] || die '--optimize and --next-steps cannot be combined'
      [[ "$engagement_seen" == false ]] || die '--optimize and --engagement cannot be combined'
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --json|--json=*|--preview|--preview=*|--forks|--forks=*)
            die '--optimize cannot be combined with JSON or preview modes'
            ;;
          --intent|--base|--model|--effort|--ui-variant|--profile|--*-model|--*-effort)
            guide_value_expected=true
            ;;
        esac
      done
    fi
    if [[ "$next_steps_seen" == true ]]; then
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --engagement|--json|--json=*|--intent|--intent=*|--stdin|--preview|--preview=*|--forks|--forks=*|--optimize)
            die '--next-steps cannot be combined with ordinary intent, JSON, stdin, or preview modes'
            ;;
          --model|--effort|--ui-variant|--profile|--*-model|--*-effort)
            guide_value_expected=true
            ;;
        esac
      done
    fi
    if [[ "$engagement_seen" == true ]]; then
      guide_value_expected=false
      for guide_arg in "$@"; do
        if [[ "$guide_value_expected" == true ]]; then
          guide_value_expected=false
          continue
        fi
        case "$guide_arg" in
          --json|--json=*|--profile|--profile=*|--ui-variant|--ui-variant=*|--preview|--preview=*|--forks|--forks=*)
            die '--engagement cannot be combined with JSON, profile selection, or preview modes'
            ;;
          --intent|--model|--effort) guide_value_expected=true ;;
        esac
      done
    fi
    ;;
  models|setup|doctor|repair|workflow-check|harness-version|instances|prepare|submit|receipt|shutdown|skill|skills-update|skills-check|harness-update)
    mode='backend'
    backend_args=("$@")
    ;;
  inventory)
    mode='inventory'
    shift
    [[ "$#" -ge 3 && ( "$3" == --json || "$3" == --goal-features ) ]] \
      || die 'inventory requires LAUNCHER PROFILE --json'
    inventory_launcher="$1"
    inventory_profile_arg="$2"
    case "$1" in agency|codex|claude|copilot|firstmate|jcode|omp|pi|prime) mode='backend'; backend_args=(inventory "$@") ;; esac
    ;;
  run)
    shift
    case "${1-}" in
      '')
        mode='compose-select'
        compose_args=()
        ;;
      --dry-run|--no-always|--allow-unproven-isolation|--require-proven-isolation)
        mode='compose-select'
        compose_args=("$@")
        ;;
      pi|copilot|claude|codex|grok|agency|firstmate|jcode|omp|prime|-h|--help|help)
        mode='compose'
        compose_args=("$@")
        [[ "${1-}" == pi || "${1-}" == copilot || "${1-}" == claude || "${1-}" == codex || "${1-}" == grok || "${1-}" == agency || "${1-}" == firstmate || "${1-}" == jcode || "${1-}" == omp || "${1-}" == prime ]] \
          || compose_args=(--help)
        ;;
      *) die "unknown harness: $1; use: trx run copilot|codex|claude|agency|firstmate|jcode|omp|pi|prime|grok PROFILE" ;;
    esac
    ;;
  --profile|--profile=*)
    die '--profile aliases are retired; use: trx run agency azure [-- ARGS...]'
    ;;
  admin)
    mode='admin'
    shift
    [[ "$#" -eq 0 ]] || die 'admin accepts no arguments'
    ;;
  upgrade)
    mode='upgrade'
    shift
    if [[ "$#" -eq 1 && ("$1" == -h || "$1" == --help || "$1" == help) ]]; then
      upgrade_usage
      exit 0
    fi
    if [[ "${1-}" != all ]]; then
      case "${1-}" in agency|codex|claude|copilot|firstmate|jcode|omp|pi|prime) ;; *) die 'upgrade requires all [--yes | --dry-run] or HARNESS [PROFILE]' ;; esac
      mode='backend'
      backend_args=(upgrade "$@")
    else
    [[ "${1-}" == all && "$#" -le 2 ]] \
      || die 'upgrade requires all [--yes | --dry-run]; use trx upgrade --help'
    if [[ "$#" -eq 2 ]]; then
      case "$2" in
        -h|--help|help) upgrade_usage; exit 0 ;;
        --yes|--dry-run) ;;
        *) die 'upgrade requires all [--yes | --dry-run]; use trx upgrade --help' ;;
      esac
    fi
    upgrade_args=("$@")
    fi
    ;;
  skills)
    mode='skills'
    shift
    skills_action="${1-}"
    skills_update_args=()
    if [[ "$skills_action" == update ]]; then
      shift
      [[ "$#" -le 1 && ( "$#" -eq 0 || "$1" == --check || "$1" == --upgrade-pins ) ]] || die 'skills update accepts --check or --upgrade-pins'
      skills_update_args=("$@")
    else
      [[ ( "$#" -eq 1 && "$1" == status ) || ( "$#" -eq 2 && "$1" == check && "$2" == --json ) ]] || die 'skills requires status, update, or check --json'
    fi
    ;;
  -i|--interactive|--interactive=*)
    die '-i and --interactive have been removed; run trx with no arguments'
    ;;
  '')
    mode='interactive'
    ;;
  *)
    mode='interactive'
    ;;
esac

command -v jq >/dev/null 2>&1 || die 'required command not found: jq'

case "$HOME" in
  /*) ;;
  *) die "HOME must be an absolute path: $HOME" ;;
esac
[[ -d "$HOME" && ! -L "$HOME" ]] || die "unsafe HOME: $HOME"
canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
[[ "$canonical_home" != / ]] || die 'HOME must not be /'
native_common_root="${XDG_DATA_HOME:-$canonical_home/.local/share}/trellage/common"

script_path="$(resolve_file "${BASH_SOURCE[0]}")" || die 'cannot resolve trx runtime'
script_dir="$(canonical_directory "$(dirname "$script_path")")" || die 'cannot resolve trx runtime'
runtime="$(canonical_directory "$script_dir/..")" || die 'cannot resolve trx runtime'
source_workspace="$runtime/source"
if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
  [[ "$TRELLAGE_TRX_SOURCE_ROOT" == /* ]] \
    || die "TRELLAGE_TRX_SOURCE_ROOT must be absolute: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ -d "$TRELLAGE_TRX_SOURCE_ROOT" && ! -L "$TRELLAGE_TRX_SOURCE_ROOT" ]] \
    || die "unsafe TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  source_root="$(canonical_directory "$TRELLAGE_TRX_SOURCE_ROOT")" \
    || die "cannot resolve TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ "$runtime" == "$source_root" ]] \
    || die "trx source runtime differs from TRELLAGE_TRX_SOURCE_ROOT: $runtime"
  source_workspace="$(canonical_directory "$runtime/../..")" || die 'cannot resolve source workspace'
  guide_root="$runtime/../../profile-guides"
  if [[ -n "${TRELLAGE_TRX_GUIDE_ROOT-}" ]]; then
    [[ "$TRELLAGE_TRX_GUIDE_ROOT" == /* ]] \
      || die "TRELLAGE_TRX_GUIDE_ROOT must be absolute: $TRELLAGE_TRX_GUIDE_ROOT"
    [[ -d "$TRELLAGE_TRX_GUIDE_ROOT" && ! -L "$TRELLAGE_TRX_GUIDE_ROOT" ]] \
      || die "unsafe TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
    guide_root="$(canonical_directory "$TRELLAGE_TRX_GUIDE_ROOT")" \
      || die "cannot resolve TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
  fi
else
  [[ "$runtime" == "$canonical_home/.local/share/trellage/trx" ]] \
    || die "trx is not running from its owned runtime: $runtime"
  [[ -f "$runtime/.managed-by-trellage-router" && ! -L "$runtime/.managed-by-trellage-router" ]] \
    || die 'missing trx ownership marker'
  [[ "$(<"$runtime/.managed-by-trellage-router")" == "$ownership_value" ]] \
    || die 'invalid trx ownership marker'
  guide_root="$runtime/share/profile-guides"
fi
require_source_runtime() {
  [[ -f "$source_workspace/scripts/bun-runtime.sh" && ! -L "$source_workspace/scripts/bun-runtime.sh" ]] \
    || die "source runtime is missing or unsafe; reinstall trx: $source_workspace"
  . "$source_workspace/scripts/bun-runtime.sh"
  if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
    trellage_bun_runtime "$source_workspace" || die 'source Bun runtime is unavailable'
    TRELLAGE_READINESS_MEMO=1 "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/workspace-cli.ts" ensure "$source_workspace" \
      || die 'automatic source runtime preparation failed'
    return
  fi
  trellage_require_source_runtime "$source_workspace" \
    || die 'source runtime is not ready; reinstall trx or prepare worktree dependencies explicitly'
}
skip_optional_jev_key() {
  printf 'trx: Jev decisions stay off: %s\n' "$1" >&2
}

# Load the optional TYPESAFE_API_KEY from the Trellage Varlock environment.
# An existing process value wins. The key goes to the launcher under a private
# name, which the launcher removes from its environment, so agents launched from
# the guide do not inherit it. A missing key is a silent no-op. A resolver or
# Varlock failure never loads the key and never stops the guide.
load_optional_jev_api_key() {
  local resolver="$source_workspace/scripts/native-environment.ts"
  local metadata environment_path dependency_directory varlock key
  unset _TRELLAGE_JEV_API_KEY
  [[ -z "${TYPESAFE_API_KEY-}" ]] || return 0
  [[ -f "$resolver" && ! -L "$resolver" ]] || {
    skip_optional_jev_key "environment resolver is missing or unsafe: $resolver"
    return 0
  }
  metadata="$("${trellage_bun[@]}" "$resolver")" || {
    skip_optional_jev_key 'environment resolution failed'
    return 0
  }
  jq -e '
    type == "object"
    and (.enabled | type == "boolean")
    and (.source_present | type == "boolean")
    and (.path | type == "string" and length > 0)
  ' <<<"$metadata" >/dev/null 2>&1 || {
    skip_optional_jev_key 'environment resolver returned invalid metadata'
    return 0
  }
  [[ "$(jq -r '.enabled and .source_present' <<<"$metadata")" == true ]] || return 0
  environment_path="$(jq -r '.path' <<<"$metadata")"
  dependency_directory="$("${trellage_bun[@]}" \
    "$source_workspace/packages/trellage-runtime/src/workspace-cli.ts" \
    dependency "$source_workspace" varlock)" || {
    skip_optional_jev_key 'Varlock dependency is not ready'
    return 0
  }
  varlock="$dependency_directory/bin/cli.js"
  [[ -f "$varlock" && ! -L "$varlock" && -r "$varlock" ]] || {
    skip_optional_jev_key "Varlock CLI is missing or unsafe: $varlock"
    return 0
  }
  command -v node >/dev/null 2>&1 || {
    skip_optional_jev_key 'required command not found: node'
    return 0
  }
  # Varlock cannot wrap the guide: it does not pass fd 3 and it redacts piped
  # output. Resolve only this key in a short child, then hand it over.
  key="$(
    unset TYPESAFE_API_KEY
    node "$varlock" run --no-redact-stdout --path "$environment_path" --inject vars \
      --filter TYPESAFE_API_KEY -- /bin/sh -c 'printf %s "${TYPESAFE_API_KEY-}"' 2>/dev/null
  )" || {
    skip_optional_jev_key "Varlock could not load $environment_path; run varlock load --path $environment_path"
    return 0
  }
  [[ -n "$key" ]] || return 0
  _TRELLAGE_JEV_API_KEY="$key"
  export _TRELLAGE_JEV_API_KEY
}

picker_path="$source_workspace/packages/trellage-launcher/src/cli.tsx"
floating_skills_manager="$source_workspace/scripts/floating-skills.ts"
floating_skills_catalog="$source_workspace/config.toml"
router_command_path="$runtime/bin/trx"
[[ "$script_path" == "$router_command_path" && -f "$router_command_path" \
    && -x "$router_command_path" && ! -L "$router_command_path" ]] \
  || die 'current router command is missing or unsafe'
if [[ "$mode" == backend ]]; then
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/native-run/backend-cli.ts" "${backend_args[@]}"
fi
if [[ "$mode" == compose-select ]]; then
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-launcher/src/run-select-cli.tsx" ${compose_args[@]+"${compose_args[@]}"}
fi
if [[ "$mode" == compose ]]; then
  if [[ "${compose_args[0]-}" == codex && "${compose_args[1]-}" == youtube ]]; then restore_transcript_api_key cdx youtube; fi
  require_source_runtime
  exec "${trellage_bun[@]}" "$source_workspace/packages/trellage-runtime/src/native-run/cli.ts" ${compose_args[@]+"${compose_args[@]}"}
fi
if [[ "$mode" == skills ]]; then
  require_source_runtime
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
  if [[ "$skills_action" == check ]]; then
    exec "${trellage_bun[@]}" "$floating_skills_manager" check-shared --catalog "$floating_skills_catalog"
  fi
  if [[ "$skills_action" == update ]]; then
    exec "${trellage_bun[@]}" "$source_workspace/scripts/skills-update.ts" ${skills_update_args[@]+"${skills_update_args[@]}"}
  fi
  exec "${trellage_bun[@]}" "$floating_skills_manager" "$skills_action" \
    --catalog "$floating_skills_catalog" \
    --bundle native-common
fi

if [[ "$mode" == guide && ( "$review_seen" == true || "$optimize_seen" == true ) ]]; then
  require_source_runtime
  [[ -f "$picker_path" && ! -L "$picker_path" ]] || die 'Ink launcher is missing or unsafe'
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die 'floating-skills manager is missing or unsafe'
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die 'floating-skills catalog is missing or unsafe'
  if [[ "${TRELLAGE_REVIEW_PROFILES_ONLY:-}" != 1 ]]; then
    review_catalog="$(jq -cn --arg sandbox "$source_workspace/prototypes/trellage/trellage" \
      '{schemaVersion:1,sandboxCommandPath:$sandbox,sandbox:[],native:[]}')"
    TRELLAGE_REVIEW_PROFILE_COMMAND="$script_path" \
      TRELLAGE_GUIDE_SKILLS_MANAGER="$floating_skills_manager" \
      TRELLAGE_GUIDE_SKILLS_CATALOG="$floating_skills_catalog" \
      TRELLAGE_GUIDE_NATIVE_SKILLS_CACHE="$native_common_root/skills" \
      TRELLAGE_GUIDE_OPTIMIZE_SKILLS_CACHE="$canonical_home/.local/share/trellage/common/guide-optimize-architecture-skills" \
      exec "${trellage_launcher[@]}" "$picker_path" guide "$guide_root" "" "${guide_args[@]}" 3< <(printf '%s\n' "$review_catalog")
  fi
  review_profiles='[]'
  for review_launcher in cpx cdx cldx; do
    case "$review_launcher" in
      cpx) review_command="$(discover_launcher cpx .managed-by-trellage-profiles trellage-profiles-v1 '' trellage-copilot-profiles 2>/dev/null)" || continue ;;
      cdx) review_command="$(discover_launcher cdx .managed-by-trellage-codex-profiles trellage-codex-profiles-v2 trellage-codex-profiles-v1 trellage-codex-profiles 2>/dev/null)" || continue ;;
      cldx) review_command="$(discover_launcher cldx .managed-by-trellage-claude-profiles trellage-claude-profiles-v1 '' trellage-claude-profiles 2>/dev/null)" || continue ;;
    esac
    [[ -n "$review_command" && -f "$review_command" && -x "$review_command" ]] || continue
    if review_inventory="$("$review_command" list --json --cached-capabilities 2>/dev/null)"; then
      review_profiles="$(jq -cn --argjson previous "$review_profiles" --argjson inventory "$review_inventory" \
        --arg launcher "$review_launcher" --arg commandPath "$review_command" '
        $previous + [$inventory.profiles[] | {
          launcher: $launcher, commandPath: $commandPath, harness: $inventory.harness,
          name, description, headless, sandbox: $inventory.sandbox,
          herdrCompatibility: {status: "untested"}
        } + (if has("orchestration") then {orchestration} else {} end)]')" \
        || die 'invalid optional Native profile inventory'
    fi
  done
  review_native="$(jq -cn --argjson profiles "$review_profiles" '{schemaVersion:1, profiles:$profiles}' \
    | "${trellage_launcher[@]}" "$picker_path" enrich-native-list "$guide_root")" \
    || die 'cannot read optional Native profiles'
  review_catalog="$(jq -cn --argjson native "$review_native" --argjson profiles "$review_profiles" \
    --arg sandbox "$source_workspace/prototypes/trellage/trellage" '{
      schemaVersion:1, sandboxCommandPath:$sandbox, sandbox:[],
      native: [$native.profiles[] as $entry | $entry + {
        commandPath: ([$profiles[] | select(.launcher == $entry.launcher and .name == $entry.name)][0].commandPath)
      }]
    }')"
  printf '%s\n' "$review_catalog"
  exit 0
fi

if [[ "$mode" == guide ]] && ((${#guide_args[@]} > 0)); then
  for guide_arg in "${guide_args[@]}"; do
    if [[ "$guide_arg" == --preview || "$guide_arg" == --preview=* \
      || "$guide_arg" == --forks || "$guide_arg" == --forks=* ]]; then
      # Fixture-only previews: they read no catalog, so short-circuit
      # before launcher discovery, the ten catalog reads, the Sandbox list,
      # and the floating-skills fetch below. None of them apply to fixtures.
      require_source_runtime
      [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
      [[ -f "$picker_path" && ! -L "$picker_path" ]] \
        || die 'Ink launcher is missing or unsafe'
      if [[ "$guide_arg" == --forks* ]]; then
        exec "${trellage_launcher[@]}" "$picker_path" guide-forks "${guide_args[@]}"
      fi
      exec "${trellage_launcher[@]}" "$picker_path" guide-preview "${guide_args[@]}"
    fi
  done
fi



cpx="$(discover_launcher cpx .managed-by-trellage-profiles trellage-profiles-v1 '' trellage-copilot-profiles)"
cdx="$(discover_launcher cdx .managed-by-trellage-codex-profiles trellage-codex-profiles-v2 trellage-codex-profiles-v1 trellage-codex-profiles)"
cldx="$(discover_launcher cldx .managed-by-trellage-claude-profiles trellage-claude-profiles-v1 '' trellage-claude-profiles)"
fmx="$(discover_launcher fmx .managed-by-trellage-firstmate-profiles trellage-firstmate-profiles-v1 '' trellage-firstmate-profiles)"
jcx="$(discover_launcher jcx .managed-by-trellage-jcode-profiles trellage-jcode-profiles-v1 '' trellage-jcode-profiles)"
omp="$(discover_launcher omp .managed-by-trellage-omp-profiles trellage-omp-profiles-v2 '' trellage-omp-profiles)"
picx="$(discover_launcher picx .managed-by-trellage-picx-profiles trellage-picx-profiles-v1 '' trellage-picx-profiles)"
prx="$(discover_launcher prx .managed-by-trellage-prime-profiles trellage-prime-profiles-v1 '' trellage-prime-profiles)"
agx="$(discover_launcher agx .managed-by-trellage-agency-profiles trellage-agency-profiles-v1 '' trellage-agency-profiles)"

if [[ "$mode" == inventory ]]; then
  case "$inventory_launcher" in
    cpx) inventory_executable="$cpx" ;;
    cdx) inventory_executable="$cdx" ;;
    cldx) inventory_executable="$cldx" ;;
    fmx) inventory_executable="$fmx" ;;
    jcx) inventory_executable="$jcx" ;;
    omp) inventory_executable="$omp" ;;
    picx) inventory_executable="$picx" ;;
    prx) inventory_executable="$prx" ;;
    agx) inventory_executable="$agx" ;;
    *) die "unknown launcher: $inventory_launcher" ;;
  esac
  output="$("$inventory_executable" inventory "$inventory_profile_arg" --json)" \
    || die "$inventory_launcher inventory failed for $inventory_profile_arg"
  jq -e '
    type == "object"
    and (.readiness | type == "string" and test("^(healthy|unhealthy|not-setup|busy)$"))
  ' <<<"$output" >/dev/null || die "invalid inventory output from $inventory_launcher"
  printf '%s\n' "$output"
  exit 0
fi

catalog_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx.XXXXXX")" \
  || die 'cannot create catalog workspace'
cleanup_catalog_tmp() {
  rm -rf -- "$catalog_tmp"
}
trap cleanup_catalog_tmp EXIT HUP INT TERM

read_catalog cpx copilot "$cpx" >"$catalog_tmp/cpx" 2>"$catalog_tmp/cpx.err" &
cpx_catalog_pid=$!
read_catalog cdx codex "$cdx" >"$catalog_tmp/cdx" 2>"$catalog_tmp/cdx.err" &
cdx_catalog_pid=$!
read_catalog cldx claude "$cldx" >"$catalog_tmp/cldx" 2>"$catalog_tmp/cldx.err" &
cldx_catalog_pid=$!
read_catalog fmx firstmate "$fmx" >"$catalog_tmp/fmx" 2>"$catalog_tmp/fmx.err" &
fmx_catalog_pid=$!
read_catalog jcx jcode "$jcx" >"$catalog_tmp/jcx" 2>"$catalog_tmp/jcx.err" &
jcx_catalog_pid=$!
read_catalog omp oh-my-pi "$omp" >"$catalog_tmp/omp" 2>"$catalog_tmp/omp.err" &
omp_catalog_pid=$!
read_catalog picx pi "$picx" >"$catalog_tmp/picx" 2>"$catalog_tmp/picx.err" &
picx_catalog_pid=$!
read_catalog prx prime "$prx" >"$catalog_tmp/prx" 2>"$catalog_tmp/prx.err" &
prx_catalog_pid=$!
read_catalog agx agency "$agx" >"$catalog_tmp/agx" 2>"$catalog_tmp/agx.err" &
agx_catalog_pid=$!

catalog_status=0
for catalog_pid in \
  "$cpx_catalog_pid" "$cdx_catalog_pid" "$cldx_catalog_pid" \
  "$fmx_catalog_pid" "$jcx_catalog_pid" "$omp_catalog_pid" "$picx_catalog_pid" \
  "$prx_catalog_pid" "$agx_catalog_pid"; do
  wait "$catalog_pid" || catalog_status=1
done
if ((catalog_status != 0)); then
  for launcher in cpx cdx cldx fmx jcx omp picx prx agx; do
    while IFS= read -r diagnostic; do
      printf '%s\n' "$diagnostic" >&2
    done <"$catalog_tmp/$launcher.err"
  done
  die 'catalog discovery failed'
fi

cpx_catalog="$(<"$catalog_tmp/cpx")"
cdx_catalog="$(<"$catalog_tmp/cdx")"
cldx_catalog="$(<"$catalog_tmp/cldx")"
fmx_catalog="$(<"$catalog_tmp/fmx")"
jcx_catalog="$(<"$catalog_tmp/jcx")"
omp_catalog="$(<"$catalog_tmp/omp")"
picx_catalog="$(<"$catalog_tmp/picx")"
prx_catalog="$(<"$catalog_tmp/prx")"
agx_catalog="$(<"$catalog_tmp/agx")"
if [[ "$mode" == upgrade ]]; then
  require_source_runtime
  [[ -f "$picker_path" && ! -L "$picker_path" ]] \
    || die 'harness update CLI is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] \
    || die 'profile guide registry is missing or unsafe'
  build_combined_guide_catalog "$catalog_tmp"
  jq -e -s 'length == 1 and .[0].schemaVersion == 2 and (.[0].profiles | type == "array" and length > 0)' \
    "$catalog_tmp/sandbox.json" >/dev/null \
    || die 'incomplete or invalid Sandbox catalog; no harness updates were started'
  upgrade_cancelled=0
  upgrade_pid=''
  upgrade_wait_interrupted=0
  cancel_harness_upgrade() {
    upgrade_wait_interrupted=1
    upgrade_cancelled=1
    if [[ -n "$upgrade_pid" ]]; then
      kill -TERM "$upgrade_pid" 2>/dev/null || true
    fi
  }
  # Forward signals while the Bun child owns the queue, then wait for its cleanup.
  trap cancel_harness_upgrade HUP INT TERM
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    "${trellage_launcher[@]}" "$picker_path" upgrade "${upgrade_args[@]}" <"$catalog_tmp/combined.json" &
  upgrade_pid=$!
  [[ "$upgrade_cancelled" == 0 ]] || cancel_harness_upgrade
  while :; do
    upgrade_wait_interrupted=0
    upgrade_status=0
    wait "$upgrade_pid" || upgrade_status=$?
    [[ "$upgrade_wait_interrupted" == 1 ]] || break
  done
  upgrade_pid=''
  [[ "$upgrade_cancelled" == 0 ]] || upgrade_status=130
  cleanup_catalog_tmp
  trap - EXIT HUP INT TERM
  exit "$upgrade_status"
fi
cleanup_catalog_tmp
trap - EXIT HUP INT TERM



if [[ "$mode" == list ]]; then
  profile_list="$(build_profile_list \
    "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" \
    "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog" "$agx_catalog")" \
    || die 'could not build profile list'
  if ((list_json)); then
    require_source_runtime
    [[ -f "$picker_path" && ! -L "$picker_path" ]] \
      || die 'Ink launcher is missing or unsafe'
    [[ -d "$guide_root" && ! -L "$guide_root" ]] \
      || die 'profile guide registry is missing or unsafe'
    printf '%s\n' "$profile_list" \
      | "${trellage_launcher[@]}" "$picker_path" enrich-native-list "$guide_root" \
      || die 'could not enrich profile list with guides'
  else
    jq -r '.profiles[] | [(.launcher + "/" + .name), .description] | @tsv' \
      <<<"$profile_list" || die 'could not format profile list'
  fi
  exit 0
fi

if [[ "$mode" == guide ]]; then
  require_source_runtime
  load_optional_jev_api_key
  [[ -f "$picker_path" && ! -L "$picker_path" ]] \
    || die 'Ink launcher is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] \
    || die 'profile guide registry is missing or unsafe'

  guide_catalog_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx-guide.XXXXXX")" \
    || die 'cannot create guide catalog workspace'
  cleanup_guide_catalog_tmp() {
    rm -rf -- "$guide_catalog_tmp"
  }
  trap cleanup_guide_catalog_tmp EXIT HUP INT TERM

  if [[ "$engagement_seen" == false && "$optimize_seen" == false ]]; then
    [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
      || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
    [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
      || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
    "${trellage_bun[@]}" "$floating_skills_manager" ensure \
      --catalog "$floating_skills_catalog" \
      --bundle guide-prompt-master \
      --cache "$canonical_home/.local/share/trellage/common/guide-prompt-master-skills" \
      --target "$guide_catalog_tmp/skills" \
      || die 'failed to prepare the guide Prompt Master skill'
    [[ -f "$guide_catalog_tmp/skills/prompt-master/SKILL.md" \
        && ! -L "$guide_catalog_tmp/skills/prompt-master/SKILL.md" ]] \
      || die 'guide Prompt Master skill is missing or unsafe'
  fi

  build_combined_guide_catalog "$guide_catalog_tmp" "$optimize_seen"

  guide_command=("${trellage_launcher[@]}" "$picker_path" guide "$guide_root" "$guide_catalog_tmp/skills/prompt-master")
  if ((${#guide_args[@]} > 0)); then
    guide_command+=("${guide_args[@]}")
  fi
  guide_status=0
  TRELLAGE_GUIDE_SKILLS_MANAGER="$floating_skills_manager" \
    TRELLAGE_GUIDE_SKILLS_CATALOG="$floating_skills_catalog" \
    TRELLAGE_GUIDE_OPTIMIZE_SKILLS_CACHE="$canonical_home/.local/share/trellage/common/guide-optimize-architecture-skills" \
    TRELLAGE_GUIDE_NATIVE_SKILLS_CACHE="$native_common_root/skills" \
    "${guide_command[@]}" 3<"$guide_catalog_tmp/combined.json" || guide_status=$?
  cleanup_guide_catalog_tmp
  trap - EXIT HUP INT TERM
  exit "$guide_status"
fi

if [[ "$mode" == admin ]]; then
  require_source_runtime
  [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
  load_optional_jev_api_key
  [[ -f "$picker_path" && ! -L "$picker_path" ]] \
    || die 'Ink launcher is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] \
    || die 'profile guide registry is missing or unsafe'

  admin_catalog_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx-admin.XXXXXX")" \
    || die 'cannot create admin catalog workspace'
  cleanup_admin_catalog_tmp() {
    rm -rf -- "$admin_catalog_tmp"
  }
  trap cleanup_admin_catalog_tmp EXIT HUP INT TERM

  build_combined_guide_catalog "$admin_catalog_tmp"

  admin_status=0
  TRELLAGE_TRX_COMMAND_PATH="$router_command_path" \
    "${trellage_launcher[@]}" "$picker_path" admin "$guide_root" 3<"$admin_catalog_tmp/combined.json" \
    || admin_status=$?
  cleanup_admin_catalog_tmp
  trap - EXIT HUP INT TERM
  exit "$admin_status"
fi

require_source_runtime
[[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
[[ -f "$picker_path" && ! -L "$picker_path" ]] \
  || die 'Ink launcher is missing or unsafe'

passthrough_args="$(jq -cn '$ARGS.positional' --args -- "$@")" \
  || die 'could not encode launcher arguments'
choices="$(build_choices \
  "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog" "$agx_catalog" \
  "$cpx" "$cdx" "$cldx" "$jcx" "$omp" "$picx" "$prx" "$fmx" "$agx" "$passthrough_args")" \
  || die 'could not build profile choices'

choice_file="$(mktemp "${TMPDIR:-/tmp}/trellage-trx-choices.XXXXXX")" \
  || die 'cannot create launcher catalog file'
result_file="$(mktemp "${TMPDIR:-/tmp}/trellage-trx-result.XXXXXX")" \
  || { rm -f -- "$choice_file"; die 'cannot create launcher result file'; }
printf '%s\n' "$choices" >"$choice_file"
picker_status=0
"${trellage_launcher[@]}" "$picker_path" "$choice_file" "$result_file" || picker_status=$?
launch_intent="$(<"$result_file")"
rm -f -- "$choice_file" "$result_file"
if ((picker_status != 0)); then
  exit "$picker_status"
fi

selection="$(jq -er '.id | select(type == "string")' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid selection'
launch_target="$(jq -er '.target | select(. == "current" or . == "herdr")' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid target'
selected_model="$(jq -r '.model // empty' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid model'
launcher="${selection%%:*}"
profile="${selection#*:}"
case "$launcher" in
  cpx)
    selected_launcher="$cpx"
    selected_catalog="$cpx_catalog"
    ;;
  cdx)
    selected_launcher="$cdx"
    selected_catalog="$cdx_catalog"
    ;;
  cldx)
    selected_launcher="$cldx"
    selected_catalog="$cldx_catalog"
    ;;
  fmx)
    selected_launcher="$fmx"
    selected_catalog="$fmx_catalog"
    ;;
  jcx)
    selected_launcher="$jcx"
    selected_catalog="$jcx_catalog"
    ;;
  omp)
    selected_launcher="$omp"
    selected_catalog="$omp_catalog"
    ;;
  picx)
    selected_launcher="$picx"
    selected_catalog="$picx_catalog"
    ;;
  prx)
    selected_launcher="$prx"
    selected_catalog="$prx_catalog"
    ;;
  agx)
    selected_launcher="$agx"
    selected_catalog="$agx_catalog"
    ;;
  *) die 'terminal picker returned an invalid launcher' ;;
esac
[[ "$profile" != "$selection" && "$profile" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] \
  || die 'terminal picker returned an invalid profile'
jq -e --arg profile "$profile" '.profiles | map(.name) | index($profile) != null' \
  <<<"$selected_catalog" >/dev/null \
  || die 'Ink launcher returned an unknown profile'
launch_arguments=("$selected_launcher" "$profile")
[[ -z "$selected_model" ]] || launch_arguments+=(--model "$selected_model")
launch_arguments+=("$@")
if [[ "$launch_target" == herdr ]]; then
  if [[ "$launcher" == cdx && "$profile" == youtube \
      && "$trx_transcript_api_key_is_set" == true ]]; then
    die 'explicit TRANSCRIPT_API_KEY cannot be forwarded securely to Herdr; use the Trellage Varlock source or launch in the current pane'
  fi
  [[ "${HERDR_ENV:-}" == 1 && -n "${HERDR_PANE_ID:-}" ]] \
    || die 'Herdr launch requested outside a Herdr pane'
  command -v herdr >/dev/null 2>&1 || die 'Herdr command is unavailable'
  worktree="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
    || die 'Herdr launch requires a Git worktree'
  split="$(herdr pane split --current --direction right --cwd "$worktree" --focus)" \
    || die 'could not create a Herdr pane'
  pane="$(jq -er '.result.pane.pane_id' <<<"$split")" \
    || die 'Herdr did not return a pane ID'
  command_line="$(printf '%q ' "${launch_arguments[@]}")"
  herdr pane run "$pane" "$command_line" || die 'could not start the selected profile in Herdr'
  exit 0
fi
restore_transcript_api_key "$launcher" "$profile"
exec "${launch_arguments[@]}"
