#!/usr/bin/env bash
set +x
set +a
set -euo pipefail

unset trx_transcript_api_key trx_transcript_api_key_is_set
trx_transcript_api_key_is_set=false
trx_transcript_api_key=""
if [[ "${TRANSCRIPT_API_KEY+x}" == x ]]; then
  trx_transcript_api_key_is_set=true
  trx_transcript_api_key="$TRANSCRIPT_API_KEY"
fi
unset TRANSCRIPT_API_KEY

# Reuse V8's compiled bytecode across invocations. The launcher bundle and the
# skills manager are re-compiled on every `node` call otherwise; a warm cache
# measured 47-55ms against 68ms cold for the launcher. Node 22 ships this
# natively, and an unwritable or stale cache directory degrades to a normal
# cold start rather than failing.
export NODE_COMPILE_CACHE="${NODE_COMPILE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/trellage/node-compile-cache}"

readonly ownership_value='trellage-router-v2'

# Hand-maintained Herdr-compatibility ledger for native launcher/profile pairs,
# merged into `trx list --json` as each profile's `herdrCompatibility` field.
# This is a curated signal (not live-probed): trx cannot detect Herdr-side
# bugs (agent detection, consent-dialog handling, etc.) automatically, and
# embedding it here (rather than reading a file at runtime) keeps `trx list`
# fast and self-contained for the installed launcher, which has no access to
# this repository's working tree. KEEP THIS IN SYNC with the native entries in
# docs/herdr-compatibility.json.
readonly trx_herdr_ledger='[
  { "launcher": "cldx", "profile": "default", "status": "verified" },
  { "launcher": "fmx", "profile": "default", "status": "verified", "notes": "Verified in a real Herdr captain-and-scout round trip: consent-managed prerequisites installed, the scout used an isolated Treehouse worktree and worker home, all locked tools resolved, and teardown completed." },
  { "launcher": "fmx", "profile": "pstack-workers", "status": "untested", "notes": "The shared Firstmate runtime passed the fmx/default Herdr fleet round trip, and static worker-policy contracts pass. Awaiting a profile-specific pstack-workers fleet round trip." },
  { "launcher": "omp", "profile": "copilot", "status": "verified" },
  { "launcher": "picx", "profile": "default", "status": "untested", "notes": "Static launcher, catalog, inventory, and headless contracts pass; awaiting an end-to-end Herdr round trip." },
  { "launcher": "cdx", "profile": "pstack", "status": "untested", "notes": "Static profile, plugin inventory, and native sandbox contracts pass; awaiting an end-to-end Herdr round trip." },
  { "launcher": "cdx", "profile": "youtube", "status": "verified", "notes": "Verified end-to-end with Herdr v0.8.2: a fresh cdx youtube session loaded youtube-full and completed one free TranscriptAPI channel/resolve request for @GitHub with the expected channel ID and canonical URL, using standard-input curl configuration without putting the key in process arguments." },
  { "launcher": "cpx", "profile": "hve", "status": "untested", "notes": "Was unhealthy (missing hve-core-all plugin); repaired locally via cpx repair hve (now reports healthy). Awaiting a fresh end-to-end Herdr verification run to confirm the full round trip." },
  { "launcher": "cpx", "profile": "compound-engineering", "status": "untested", "notes": "Static catalog, plugin inventory, and profile-guide contracts pass; an end-to-end Herdr round trip has not yet been recorded." },
  { "launcher": "cpx", "profile": "awesome", "status": "known-issue", "issue": "F", "notes": "Repo-context role confusion when delegated within the orchestrator\u0027s own repo/worktree; never finished." },
  { "launcher": "cpx", "profile": "superpowers", "status": "known-issue", "issue": "C", "notes": "Correct answer produced but stuck in a repeated approval loop; outcome=turn_limit." },
  { "launcher": "cdx", "profile": "superpowers", "status": "known-issue", "issue": "A", "notes": "Agent-detection timeout (300s); no pane ever detected." },
  { "launcher": "grx", "profile": "superpowers", "status": "known-issue", "issue": "B", "notes": "Stuck on an unrecognized Grok first-run data-retention consent screen." },
  { "launcher": "jcx", "profile": "default", "status": "known-issue", "issue": "A", "notes": "Agent-detection timeout (300s); no pane ever detected." },
  { "launcher": "omp", "profile": "local", "status": "known-issue", "issue": "G", "notes": "No local Qwen inference backend is registered with the running copilot-proxy-rs instance; out-of-repo infrastructure provisioning, not a Trellage code defect. driveLoop also masked the real error as an empty submind-answerer response." },
  { "launcher": "prx", "profile": "default", "status": "known-issue", "issue": "E", "notes": "\"agent_not_ready: not an active named agent\"; pane never reached a ready state." }
]'

die() {
  printf 'trx: %s\n' "$1" >&2
  exit 1
}

restore_transcript_api_key() {
  if [[ "$1" == cdx && "$2" == youtube && "$trx_transcript_api_key_is_set" == true ]]; then
    export TRANSCRIPT_API_KEY="$trx_transcript_api_key"
  fi
}

usage() {
  cat <<'EOF'
Usage:
  trx
  trx list [--json]
  trx run LAUNCHER PROFILE [-- ARGS...]
  trx guide [INTENT] [--json] [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --preview
  trx guide --forks [VARIANT]
  trx inventory LAUNCHER PROFILE --json
  trx skills status
  trx skills update

Select an installed native harness/profile interactively, or list available
profiles. Bare trx opens the launcher. `trx run` validates an exact installed
launcher/profile pair and executes it without the picker. `trx guide`
recommends a profile and builds prompt candidates; its JSON mode is
non-interactive and has no launch or Herdr side effects. `trx inventory`
reports the live readiness (`healthy`, `unhealthy`, `not-setup`, or `busy`) of
a single profile by delegating to that launcher's own `inventory` command. It
is not called during `list` or interactive selection, so those stay fast.
EOF
}

guide_usage() {
  cat <<'EOF'
Usage:
  trx guide [INTENT]
  trx guide --intent INTENT [--model MODEL] [--effort LEVEL] [--ui-variant NAME]
  trx guide --json [--intent INTENT] [--profile PROFILE_REF] [--model MODEL] [--effort LEVEL]
  trx guide --preview
  trx guide --forks [tabs|inline]

PROFILE_REF is native:<launcher>/<profile> or sandbox:<profile>. JSON mode
uses schemaVersion 1, has no launch or Herdr side effects, and accepts a JSON
request on stdin when --intent is omitted.
INTENT can contain line breaks and accepts up to 60,000 characters.
Press p during matching or recommendations to view the prompt as Markdown.
Press e in the prompt viewer to edit; Enter rematches a changed prompt.
Interactive prompt viewers: pager, split, focus, bookends, dashboard.
--preview renders the staged prompt basket composer overlay from fixture data.
--forks renders two ways to fork the guide into parallel subflows.
It reads no profile catalog, calls no model, and launches nothing.
EOF
}

canonical_directory() {
  (CDPATH= cd -P -- "$1" >/dev/null 2>&1 && pwd -P)
}

resolve_file() {
  local path="$1"
  local directory
  local target
  local links=0

  [[ "$path" == /* ]] || {
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    path="$directory/$(basename "$path")"
  }

  while [[ -L "$path" ]]; do
    ((links += 1))
    ((links <= 40)) || return 1
    directory="$(canonical_directory "$(dirname "$path")")" || return 1
    target="$(readlink "$path")" || return 1
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$directory/$target"
    fi
  done

  directory="$(canonical_directory "$(dirname "$path")")" || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

require_safe_directory() {
  local path="$1"
  local expected="$2"
  local description="$3"
  local resolved

  [[ -d "$path" && ! -L "$path" ]] || die "unsafe $description: $path"
  resolved="$(canonical_directory "$path")" || die "cannot resolve $description: $path"
  [[ "$resolved" == "$expected" ]] || die "redirected $description: $path"
}

discover_launcher() {
  local launcher="$1"
  local marker_name="$2"
  local marker_value="$3"
  local legacy_marker_value="${4-}"
  local discovered
  local installed_marker_value
  local resolved
  local runtime="$canonical_home/.local/share/trellage/$launcher"
  local expected="$runtime/bin/$launcher"
  local catalog="$runtime/catalog.json"
  local marker="$runtime/$marker_name"

  discovered="$(command -v "$launcher" 2>/dev/null)" \
    || die "required launcher not found on PATH: $launcher"
  [[ "$discovered" == */* ]] || die "unsafe launcher discovered on PATH: $launcher"
  resolved="$(resolve_file "$discovered")" || die "cannot resolve launcher: $launcher"
  [[ "$resolved" == "$expected" ]] \
    || die "launcher is not the owned Trellage runtime: $launcher ($resolved)"

  require_safe_directory "$runtime" "$runtime" "$launcher runtime"
  require_safe_directory "$runtime/bin" "$runtime/bin" "$launcher runtime bin"
  [[ -f "$expected" && -x "$expected" && ! -L "$expected" ]] \
    || die "unsafe owned launcher: $expected"
  [[ -f "$catalog" && -r "$catalog" && ! -L "$catalog" ]] \
    || die "unsafe owned catalog: $catalog"
  [[ -f "$marker" && -r "$marker" && ! -L "$marker" ]] \
    || die "missing ownership marker for $launcher"
  installed_marker_value="$(<"$marker")"
  if [[ "$installed_marker_value" != "$marker_value" ]] \
    && { [[ -z "$legacy_marker_value" ]] || [[ "$installed_marker_value" != "$legacy_marker_value" ]]; }; then
    die "invalid ownership marker for $launcher"
  fi

  printf '%s\n' "$expected"
}

read_catalog() {
  local launcher="$1"
  local harness="$2"
  local executable="$3"
  local output

  if ! output="$("$executable" list --json)"; then
    die "$launcher catalog interface failed"
  fi

  jq -e --arg launcher "$launcher" --arg harness "$harness" '
    def validHeadless:
      type == "object"
      and keys == [
        "changedFiles",
        "cost",
        "effortOverride",
        "eventContract",
        "modelOverride",
        "outputFormats",
        "prompt",
        "questionToolControl",
        "resume",
        "resumeWithPrompt",
        "schemaVersion",
        "sessionId",
        "testedHarnessVersion",
        "trellageEventContract",
        "usage"
      ]
      and .schemaVersion == 1
      and (.prompt | type == "boolean")
      and (.outputFormats
        | type == "array"
        and length == (unique | length)
        and all(.[]; . == "text" or . == "json" or . == "jsonl"))
      and (.eventContract == null
        or (.eventContract | type == "string" and length > 0))
      and (.trellageEventContract == null
        or .trellageEventContract == "trellage-headless-v1")
      and (.sessionId == "native"
        or .sessionId == "trellage"
        or .sessionId == "none")
      and (.resume | type == "boolean")
      and (.resumeWithPrompt | type == "boolean")
      and (.questionToolControl == "hard-deny"
        or .questionToolControl == "prompt-only"
        or .questionToolControl == "none")
      and (.changedFiles == "native"
        or .changedFiles == "git-diff"
        or .changedFiles == "none")
      and (.usage | type == "boolean")
      and (.cost | type == "boolean")
      and (.modelOverride | type == "boolean")
      and (.effortOverride | type == "boolean")
      and (.testedHarnessVersion == null
        or (.testedHarnessVersion | type == "string" and length > 0));
    type == "object"
    and keys == ["harness", "launcher", "profiles", "sandbox", "schemaVersion"]
    and .schemaVersion == 1
    and .launcher == $launcher
    and .harness == $harness
    and (.sandbox | type == "boolean")
    and (.profiles | type == "array" and length > 0)
    and all(.profiles[];
      type == "object"
      and (.name | type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$"))
      and (.description
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not))
      and (.headless | validHeadless)
      and (.plugin == null or
        (.plugin
          | type == "string"
          and length > 0
          and (test("[\u0000-\u001f\u007f-\u009f]") | not)))
      and ((has("kind") | not) or (.kind == "plugin" or .kind == "skills"))
      and (.source == null or (.source | type == "string" and length > 0))
      and ((has("skillBundles") | not) or
        (.skillBundles
          | type == "array"
          and length > 0
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[a-z0-9]+(-[a-z0-9]+)*$"))))
      and ((has("managedSkills") | not) or
        (.managedSkills
          | type == "array"
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))))
      and ((has("requiredEnvironment") | not) or
        (.requiredEnvironment
          | type == "array"
          and length == (unique | length)
          and all(.[]; type == "string" and test("^[A-Z][A-Z0-9_]*$"))))
      and (.marketplace == null or (.marketplace | type == "object"))
      and (.standaloneMcps | type == "array")
      and all(.standaloneMcps[];
        (
          if type == "string" then .
          elif type == "object" then .name
          else null
          end
        )
        | type == "string"
        and length > 0
        and (test("[\u0000-\u001f\u007f-\u009f]") | not)))
    and ([.profiles[].name] | length == (unique | length))
  ' <<<"$output" >/dev/null || die "invalid catalog from $launcher"

  printf '%s\n' "$output"
}

build_choices() {
  jq -cn \
    --argjson cpxCatalog "$1" \
    --argjson cdxCatalog "$2" \
    --argjson cldxCatalog "$3" \
    --argjson grxCatalog "$4" \
    --argjson jcxCatalog "$5" \
    --argjson ompCatalog "$6" \
    --argjson picxCatalog "$7" \
    --argjson prxCatalog "$8" \
    --argjson fmxCatalog "$9" \
    --arg cpxPath "${10}" \
    --arg cdxPath "${11}" \
    --arg cldxPath "${12}" \
    --arg grxPath "${13}" \
    --arg jcxPath "${14}" \
    --arg ompPath "${15}" \
    --arg picxPath "${16}" \
    --arg prxPath "${17}" \
    --arg fmxPath "${18}" \
    --argjson passthroughArgs "${19}" '
    def models($catalog; $profile):
      if $catalog.launcher == "cpx" or $catalog.launcher == "cdx" then
        {defaultModel:"gpt-5.6-sol",models:["gpt-5.6-sol","gpt-5.6-terra"],modelOverrideSupported:true}
      elif $catalog.launcher == "cldx" then
        {defaultModel:"claude-opus-5",models:["claude-opus-5","claude-sonnet-5","claude-haiku-4.5"],modelOverrideSupported:true}
      elif $catalog.launcher == "omp" and $profile.name == "copilot" then
        {defaultModel:"github-copilot/gpt-5.6-sol:medium",models:["github-copilot/gpt-5.6-sol:medium","github-copilot/gpt-5.6-terra:medium"],modelOverrideSupported:true}
      elif $catalog.launcher == "picx" then
        {defaultModel:"copilot-proxy-rs/gpt-5.6-sol:medium",models:["copilot-proxy-rs/gpt-5.6-sol:medium"],modelOverrideSupported:false}
      elif $catalog.launcher == "omp" then
        {defaultModel:"copilot-proxy-rs/qwen3.6-35b-a3b-local",models:["copilot-proxy-rs/qwen3.6-35b-a3b-local"],modelOverrideSupported:false}
      elif $catalog.launcher == "grx" then
        {defaultModel:"grok-4.6",models:["grok-4.6"],modelOverrideSupported:true}
      elif $catalog.launcher == "jcx" then
        {defaultModel:"gpt-5.6-sol",models:["gpt-5.6-sol"],modelOverrideSupported:true}
      elif $catalog.launcher == "prx" then
        {defaultModel:"claude-opus-5",models:["claude-opus-5"],modelOverrideSupported:true}
      else {models:[],modelOverrideSupported:false}
      end;
    def display_harness($catalog):
      if $catalog.launcher == "omp" or $catalog.launcher == "picx" then "pi" else $catalog.harness end;
    def display_profile($catalog; $profile):
      if $catalog.launcher == "omp" and $profile.name == "copilot" then "oh-my-pi" else $profile.name end;
    def binary_path($catalog):
      if $catalog.launcher == "cpx" then $cpxPath
      elif $catalog.launcher == "cdx" then $cdxPath
      elif $catalog.launcher == "cldx" then $cldxPath
      elif $catalog.launcher == "fmx" then $fmxPath
      elif $catalog.launcher == "grx" then $grxPath
      elif $catalog.launcher == "jcx" then $jcxPath
      elif $catalog.launcher == "omp" then $ompPath
      elif $catalog.launcher == "picx" then $picxPath
      elif $catalog.launcher == "prx" then $prxPath
      else error("unknown launcher path") end;
    def pair($catalog):
      $catalog.profiles[] as $profile
      | (display_harness($catalog)) as $harness
      | (display_profile($catalog; $profile)) as $displayProfile
      | ({
        id: ($catalog.launcher + ":" + $profile.name),
        label: ($harness + " / " + $displayProfile),
        harness: $harness,
        profile: $displayProfile,
        commandAlias: $catalog.launcher,
        commandPath: binary_path($catalog),
        profileArgument: $profile.name,
        passthroughArgs: $passthroughArgs,
        description: $profile.description,
        plugins: ([$profile.plugin] | map(select(type == "string" and length > 0)) | unique),
        skills: ($profile.managedSkills // []),
        mcps: ([$profile.standaloneMcps[]? | if type == "string" then . else .name end] | map(select(type == "string" and length > 0)) | unique),
        sandbox: $catalog.sandbox,
        details: "The selected launcher checks readiness before starting."
      } + models($catalog; $profile));
    {
      prompt: "Select a Trellage harness/profile",
      description: "Trellage Native runs coding-agent launchers and Firstmate fleet orchestration directly on the host with isolated state. Codex (cdx) and Grok (grx) enable the native sandbox for each harness; other native profiles are not security boundaries.",
      choices: [
        pair($cpxCatalog),
        pair($cdxCatalog),
        pair($cldxCatalog),
        pair($fmxCatalog),
        pair($grxCatalog),
        pair($jcxCatalog),
        pair($ompCatalog),
        pair($picxCatalog),
        pair($prxCatalog)
      ]
    }
  '
}

build_profile_list() {
  jq -cn \
    --argjson cpxCatalog "$1" \
    --argjson cdxCatalog "$2" \
    --argjson cldxCatalog "$3" \
    --argjson grxCatalog "$4" \
    --argjson jcxCatalog "$5" \
    --argjson ompCatalog "$6" \
    --argjson picxCatalog "$7" \
    --argjson prxCatalog "$8" \
    --argjson fmxCatalog "$9" \
    --argjson herdrLedger "$trx_herdr_ledger" '
    def herdrCompatibility($launcher; $name):
      ([$herdrLedger[] | select(.launcher == $launcher and .profile == $name)] | .[0]) as $entry
      | if $entry == null then { status: "untested" }
        else ($entry | del(.launcher, .profile))
        end;
    def profiles($catalog):
      $catalog.profiles[] | {
        launcher: $catalog.launcher,
        harness: $catalog.harness,
        name,
        description,
        headless,
        sandbox: $catalog.sandbox,
        herdrCompatibility: herdrCompatibility($catalog.launcher; .name)
      };
    {
      schemaVersion: 1,
      profiles: [
        profiles($cpxCatalog),
        profiles($cdxCatalog),
        profiles($cldxCatalog),
        profiles($fmxCatalog),
        profiles($grxCatalog),
        profiles($jcxCatalog),
        profiles($ompCatalog),
        profiles($picxCatalog),
        profiles($prxCatalog)
      ]
    }
  '
}

mode=''
list_json=0
inventory_launcher=''
inventory_profile_arg=''
run_launcher=''
run_profile=''
run_args=()
skills_action=''
guide_args=()
case "${1-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  list)
    mode='list'
    shift
    if [[ "$#" -eq 0 ]]; then
      :
    elif [[ "$#" -eq 1 && "$1" == --json ]]; then
      list_json=1
    else
      die 'list accepts only --json'
    fi
    ;;
  guide)
    mode='guide'
    shift
    if [[ "$#" -eq 1 && ("$1" == -h || "$1" == --help || "$1" == help) ]]; then
      guide_usage
      exit 0
    fi
    guide_args=("$@")
    ;;
  inventory)
    mode='inventory'
    shift
    [[ "$#" -eq 3 && "$3" == --json ]] \
      || die 'inventory requires LAUNCHER PROFILE --json'
    inventory_launcher="$1"
    inventory_profile_arg="$2"
    ;;
  run)
    mode='run'
    shift
    [[ "$#" -ge 2 ]] || die 'run requires LAUNCHER PROFILE [-- ARGS...]'
    run_launcher="$1"
    run_profile="$2"
    shift 2
    if [[ "$#" -gt 0 ]]; then
      [[ "$1" == -- ]] || die 'run arguments must follow --'
      shift
    fi
    [[ "$run_launcher" =~ ^[a-z0-9]+$ ]] || die "invalid launcher: $run_launcher"
    [[ "$run_profile" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid profile: $run_profile"
    run_args=("$@")
    ;;
  skills)
    mode='skills'
    shift
    [[ "$#" -eq 1 && ("$1" == status || "$1" == update) ]] \
      || die 'skills requires status or update'
    skills_action="$1"
    ;;
  -i|--interactive|--interactive=*)
    die '-i and --interactive have been removed; run trx with no arguments'
    ;;
  '')
    mode='interactive'
    ;;
  *)
    mode='interactive'
    ;;
esac

command -v jq >/dev/null 2>&1 || die 'required command not found: jq'

case "$HOME" in
  /*) ;;
  *) die "HOME must be an absolute path: $HOME" ;;
esac
[[ -d "$HOME" && ! -L "$HOME" ]] || die "unsafe HOME: $HOME"
canonical_home="$(canonical_directory "$HOME")" || die "cannot resolve HOME: $HOME"
[[ "$canonical_home" != / ]] || die 'HOME must not be /'
native_common_root="${XDG_DATA_HOME:-$canonical_home/.local/share}/trellage/common"

script_path="$(resolve_file "${BASH_SOURCE[0]}")" || die 'cannot resolve trx runtime'
script_dir="$(canonical_directory "$(dirname "$script_path")")" || die 'cannot resolve trx runtime'
runtime="$(canonical_directory "$script_dir/..")" || die 'cannot resolve trx runtime'
picker_path="$runtime/lib/launcher.mjs"
if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
  [[ "$TRELLAGE_TRX_SOURCE_ROOT" == /* ]] \
    || die "TRELLAGE_TRX_SOURCE_ROOT must be absolute: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ -d "$TRELLAGE_TRX_SOURCE_ROOT" && ! -L "$TRELLAGE_TRX_SOURCE_ROOT" ]] \
    || die "unsafe TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  source_root="$(canonical_directory "$TRELLAGE_TRX_SOURCE_ROOT")" \
    || die "cannot resolve TRELLAGE_TRX_SOURCE_ROOT: $TRELLAGE_TRX_SOURCE_ROOT"
  [[ "$runtime" == "$source_root" ]] \
    || die "trx source runtime differs from TRELLAGE_TRX_SOURCE_ROOT: $runtime"
  picker_path="$runtime/../../packages/trellage-launcher/dist/launcher.mjs"
  guide_root="$runtime/../../profile-guides"
  if [[ -n "${TRELLAGE_TRX_GUIDE_ROOT-}" ]]; then
    [[ "$TRELLAGE_TRX_GUIDE_ROOT" == /* ]] \
      || die "TRELLAGE_TRX_GUIDE_ROOT must be absolute: $TRELLAGE_TRX_GUIDE_ROOT"
    [[ -d "$TRELLAGE_TRX_GUIDE_ROOT" && ! -L "$TRELLAGE_TRX_GUIDE_ROOT" ]] \
      || die "unsafe TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
    guide_root="$(canonical_directory "$TRELLAGE_TRX_GUIDE_ROOT")" \
      || die "cannot resolve TRELLAGE_TRX_GUIDE_ROOT: $TRELLAGE_TRX_GUIDE_ROOT"
  fi
  dependency_bootstrap="$runtime/../../scripts/bootstrap-development-dependencies.sh"
  floating_skills_manager="$runtime/../../scripts/floating-skills.mjs"
  floating_skills_catalog="$runtime/../../skills.json"
else
  [[ "$runtime" == "$canonical_home/.local/share/trellage/trx" ]] \
    || die "trx is not running from its owned runtime: $runtime"
  [[ -f "$runtime/.managed-by-trellage-router" && ! -L "$runtime/.managed-by-trellage-router" ]] \
    || die 'missing trx ownership marker'
  [[ "$(<"$runtime/.managed-by-trellage-router")" == "$ownership_value" ]] \
    || die 'invalid trx ownership marker'
  dependency_bootstrap="$runtime/lib/bootstrap-development-dependencies.sh"
  guide_root="$runtime/share/profile-guides"
  floating_skills_manager="$canonical_home/.local/share/trellage/common/floating-skills-runtime/floating-skills.mjs"
  floating_skills_catalog="$canonical_home/.local/share/trellage/common/floating-skills-runtime/skills.json"
fi
[[ ! -x "$dependency_bootstrap" ]] || "$dependency_bootstrap" --background

if [[ "$mode" == skills ]]; then
  command -v node >/dev/null 2>&1 || die 'required command not found: node'
  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
  if [[ "$skills_action" == update ]]; then
    node "$floating_skills_manager" update \
      --catalog "$floating_skills_catalog" \
      --bundle native-common \
      || die 'failed to update native skills'
    node "$floating_skills_manager" update \
      --catalog "$floating_skills_catalog" \
      --bundle native-common \
      --bundle youtube \
      --cache "$native_common_root/cdx-youtube-skills" \
      || die 'failed to update native YouTube skills'
    node "$floating_skills_manager" update \
      --catalog "$floating_skills_catalog" \
      --bundle omp-community \
      --cache "$canonical_home/.local/share/trellage/common/omp-community-skills" \
      || die 'failed to update OMP community skills'
    node "$floating_skills_manager" update \
      --catalog "$floating_skills_catalog" \
      --bundle guide-prompt-master \
      --cache "$canonical_home/.local/share/trellage/common/guide-prompt-master-skills" \
      || die 'failed to update guide Prompt Master skill'
    exit 0
  fi
  exec node "$floating_skills_manager" "$skills_action" \
    --catalog "$floating_skills_catalog" \
    --bundle native-common
fi

if [[ "$mode" == guide ]] && ((${#guide_args[@]} > 0)); then
  for guide_arg in "${guide_args[@]}"; do
    if [[ "$guide_arg" == --preview || "$guide_arg" == --preview=* \
      || "$guide_arg" == --forks || "$guide_arg" == --forks=* ]]; then
      # Fixture-only previews: they read no catalog, so short-circuit
      # before launcher discovery, the eight catalog reads, the Sandbox list,
      # and the floating-skills fetch below. None of them apply to fixtures.
      command -v node >/dev/null 2>&1 || die 'required command not found: node'
      [[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
      [[ -f "$picker_path" && ! -L "$picker_path" ]] \
        || die 'Ink launcher is missing or unsafe'
      if [[ "$guide_arg" == --forks* ]]; then
        exec node "$picker_path" guide-forks "${guide_args[@]}"
      fi
      exec node "$picker_path" guide-preview "${guide_args[@]}"
    fi
  done
fi

cpx="$(discover_launcher cpx .managed-by-trellage-profiles trellage-profiles-v1)"
cdx="$(discover_launcher cdx .managed-by-trellage-codex-profiles trellage-codex-profiles-v2 trellage-codex-profiles-v1)"
cldx="$(discover_launcher cldx .managed-by-trellage-claude-profiles trellage-claude-profiles-v1)"
fmx="$(discover_launcher fmx .managed-by-trellage-firstmate-profiles trellage-firstmate-profiles-v1)"
grx="$(discover_launcher grx .managed-by-trellage-grok-profiles trellage-grok-profiles-v1)"
jcx="$(discover_launcher jcx .managed-by-trellage-jcode-profiles trellage-jcode-profiles-v1)"
omp="$(discover_launcher omp .managed-by-trellage-omp-profiles trellage-omp-profiles-v2)"
picx="$(discover_launcher picx .managed-by-trellage-picx-profiles trellage-picx-profiles-v1)"
prx="$(discover_launcher prx .managed-by-trellage-prime-profiles trellage-prime-profiles-v1)"

if [[ "$mode" == inventory ]]; then
  case "$inventory_launcher" in
    cpx) inventory_executable="$cpx" ;;
    cdx) inventory_executable="$cdx" ;;
    cldx) inventory_executable="$cldx" ;;
    fmx) inventory_executable="$fmx" ;;
    grx) inventory_executable="$grx" ;;
    jcx) inventory_executable="$jcx" ;;
    omp) inventory_executable="$omp" ;;
    picx) inventory_executable="$picx" ;;
    prx) inventory_executable="$prx" ;;
    *) die "unknown launcher: $inventory_launcher" ;;
  esac
  output="$("$inventory_executable" inventory "$inventory_profile_arg" --json)" \
    || die "$inventory_launcher inventory failed for $inventory_profile_arg"
  jq -e '
    type == "object"
    and (.readiness | type == "string" and test("^(healthy|unhealthy|not-setup|busy)$"))
  ' <<<"$output" >/dev/null || die "invalid inventory output from $inventory_launcher"
  printf '%s\n' "$output"
  exit 0
fi

catalog_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx.XXXXXX")" \
  || die 'cannot create catalog workspace'
cleanup_catalog_tmp() {
  rm -rf -- "$catalog_tmp"
}
trap cleanup_catalog_tmp EXIT HUP INT TERM

read_catalog cpx copilot "$cpx" >"$catalog_tmp/cpx" 2>"$catalog_tmp/cpx.err" &
cpx_catalog_pid=$!
read_catalog cdx codex "$cdx" >"$catalog_tmp/cdx" 2>"$catalog_tmp/cdx.err" &
cdx_catalog_pid=$!
read_catalog cldx claude "$cldx" >"$catalog_tmp/cldx" 2>"$catalog_tmp/cldx.err" &
cldx_catalog_pid=$!
read_catalog fmx firstmate "$fmx" >"$catalog_tmp/fmx" 2>"$catalog_tmp/fmx.err" &
fmx_catalog_pid=$!
read_catalog grx grok "$grx" >"$catalog_tmp/grx" 2>"$catalog_tmp/grx.err" &
grx_catalog_pid=$!
read_catalog jcx jcode "$jcx" >"$catalog_tmp/jcx" 2>"$catalog_tmp/jcx.err" &
jcx_catalog_pid=$!
read_catalog omp oh-my-pi "$omp" >"$catalog_tmp/omp" 2>"$catalog_tmp/omp.err" &
omp_catalog_pid=$!
read_catalog picx pi "$picx" >"$catalog_tmp/picx" 2>"$catalog_tmp/picx.err" &
picx_catalog_pid=$!
read_catalog prx prime "$prx" >"$catalog_tmp/prx" 2>"$catalog_tmp/prx.err" &
prx_catalog_pid=$!

catalog_status=0
for catalog_pid in \
  "$cpx_catalog_pid" "$cdx_catalog_pid" "$cldx_catalog_pid" "$grx_catalog_pid" \
  "$fmx_catalog_pid" "$jcx_catalog_pid" "$omp_catalog_pid" "$picx_catalog_pid" "$prx_catalog_pid"; do
  wait "$catalog_pid" || catalog_status=1
done
if ((catalog_status != 0)); then
  for launcher in cpx cdx cldx fmx grx jcx omp picx prx; do
    while IFS= read -r diagnostic; do
      printf '%s\n' "$diagnostic" >&2
    done <"$catalog_tmp/$launcher.err"
  done
  die 'catalog discovery failed'
fi

cpx_catalog="$(<"$catalog_tmp/cpx")"
cdx_catalog="$(<"$catalog_tmp/cdx")"
cldx_catalog="$(<"$catalog_tmp/cldx")"
fmx_catalog="$(<"$catalog_tmp/fmx")"
grx_catalog="$(<"$catalog_tmp/grx")"
jcx_catalog="$(<"$catalog_tmp/jcx")"
omp_catalog="$(<"$catalog_tmp/omp")"
picx_catalog="$(<"$catalog_tmp/picx")"
prx_catalog="$(<"$catalog_tmp/prx")"
cleanup_catalog_tmp
trap - EXIT HUP INT TERM

if [[ "$mode" == run ]]; then
  case "$run_launcher" in
    cpx) run_executable="$cpx"; run_catalog="$cpx_catalog" ;;
    cdx) run_executable="$cdx"; run_catalog="$cdx_catalog" ;;
    cldx) run_executable="$cldx"; run_catalog="$cldx_catalog" ;;
    fmx) run_executable="$fmx"; run_catalog="$fmx_catalog" ;;
    grx) run_executable="$grx"; run_catalog="$grx_catalog" ;;
    jcx) run_executable="$jcx"; run_catalog="$jcx_catalog" ;;
    omp) run_executable="$omp"; run_catalog="$omp_catalog" ;;
    picx) run_executable="$picx"; run_catalog="$picx_catalog" ;;
    prx) run_executable="$prx"; run_catalog="$prx_catalog" ;;
    *) die "unknown launcher: $run_launcher" ;;
  esac
  jq -e --arg profile "$run_profile" \
    '.profiles | map(.name) | index($profile) != null' \
    <<<"$run_catalog" >/dev/null \
    || die "unknown profile for $run_launcher: $run_profile"
  restore_transcript_api_key "$run_launcher" "$run_profile"
  if (( ${#run_args[@]} > 0 )); then
    exec "$run_executable" "$run_profile" "${run_args[@]}"
  fi
  exec "$run_executable" "$run_profile"
fi

if [[ "$mode" == list ]]; then
  profile_list="$(build_profile_list \
    "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" "$grx_catalog" \
    "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog")" \
    || die 'could not build profile list'
  if ((list_json)); then
    command -v node >/dev/null 2>&1 || die 'required command not found: node'
    [[ -f "$picker_path" && ! -L "$picker_path" ]] \
      || die 'Ink launcher is missing or unsafe'
    [[ -d "$guide_root" && ! -L "$guide_root" ]] \
      || die 'profile guide registry is missing or unsafe'
    printf '%s\n' "$profile_list" \
      | node "$picker_path" enrich-native-list "$guide_root" \
      || die 'could not enrich profile list with guides'
  else
    jq -r '.profiles[] | [(.launcher + "/" + .name), .description] | @tsv' \
      <<<"$profile_list" || die 'could not format profile list'
  fi
  exit 0
fi

if [[ "$mode" == guide ]]; then
  command -v node >/dev/null 2>&1 || die 'required command not found: node'
  [[ -f "$picker_path" && ! -L "$picker_path" ]] \
    || die 'Ink launcher is missing or unsafe'
  [[ -d "$guide_root" && ! -L "$guide_root" ]] \
    || die 'profile guide registry is missing or unsafe'

  profile_list="$(build_profile_list \
    "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" "$grx_catalog" \
    "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog")" \
    || die 'could not build native profile list'

  if [[ -n "${TRELLAGE_TRX_SOURCE_ROOT-}" ]]; then
    sandbox_cli="$runtime/../trellage/trellage"
  else
    sandbox_cli="$(command -v trellage || true)"
  fi
  [[ -n "$sandbox_cli" && -x "$sandbox_cli" ]] \
    || die 'trellage command not found; guide mode requires the Sandbox catalog'
  sandbox_cli="$(resolve_file "$sandbox_cli")" \
    || die "cannot resolve trellage command: $sandbox_cli"
  [[ -f "$sandbox_cli" && -x "$sandbox_cli" ]] \
    || die "trellage command is not an executable regular file: $sandbox_cli"

  guide_catalog_tmp="$(mktemp -d "${TMPDIR:-/tmp}/trellage-trx-guide.XXXXXX")" \
    || die 'cannot create guide catalog workspace'
  cleanup_guide_catalog_tmp() {
    rm -rf -- "$guide_catalog_tmp"
  }
  trap cleanup_guide_catalog_tmp EXIT HUP INT TERM

  [[ -f "$floating_skills_manager" && ! -L "$floating_skills_manager" ]] \
    || die "floating-skills manager is missing or unsafe: $floating_skills_manager"
  [[ -f "$floating_skills_catalog" && ! -L "$floating_skills_catalog" ]] \
    || die "floating-skills catalog is missing or unsafe: $floating_skills_catalog"
  node "$floating_skills_manager" ensure \
    --catalog "$floating_skills_catalog" \
    --bundle guide-prompt-master \
    --cache "$canonical_home/.local/share/trellage/common/guide-prompt-master-skills" \
    --target "$guide_catalog_tmp/skills" \
    || die 'failed to prepare the guide Prompt Master skill'
  [[ -f "$guide_catalog_tmp/skills/prompt-master/SKILL.md" \
      && ! -L "$guide_catalog_tmp/skills/prompt-master/SKILL.md" ]] \
    || die 'guide Prompt Master skill is missing or unsafe'

  printf '%s\n' "$profile_list" \
    | node "$picker_path" enrich-native-list "$guide_root" \
      >"$guide_catalog_tmp/native-public.json" \
    || die 'could not enrich native profile list with guides'
  jq \
    --arg cpxPath "$cpx" \
    --arg cdxPath "$cdx" \
    --arg cldxPath "$cldx" \
    --arg fmxPath "$fmx" \
    --arg grxPath "$grx" \
    --arg jcxPath "$jcx" \
    --arg ompPath "$omp" \
    --arg picxPath "$picx" \
    --arg prxPath "$prx" '
      .profiles |= map(
        . + {
          commandPath:
            (if .launcher == "cpx" then $cpxPath
             elif .launcher == "cdx" then $cdxPath
             elif .launcher == "cldx" then $cldxPath
             elif .launcher == "fmx" then $fmxPath
             elif .launcher == "grx" then $grxPath
             elif .launcher == "jcx" then $jcxPath
             elif .launcher == "omp" then $ompPath
             elif .launcher == "picx" then $picxPath
             elif .launcher == "prx" then $prxPath
             else error("unknown native launcher")
             end)
        }
      )
    ' "$guide_catalog_tmp/native-public.json" >"$guide_catalog_tmp/native.json" \
    || die 'could not add validated native launcher paths to the guide catalog'
  "$sandbox_cli" list --json-full >"$guide_catalog_tmp/sandbox.json" \
    || die 'could not load the Sandbox profile guide catalog'
  jq -n \
    --arg sandboxCommandPath "$sandbox_cli" \
    --slurpfile native "$guide_catalog_tmp/native.json" \
    --slurpfile sandbox "$guide_catalog_tmp/sandbox.json" \
    '{
      schemaVersion: 1,
      sandboxCommandPath: $sandboxCommandPath,
      native: $native[0].profiles,
      sandbox: $sandbox[0].profiles
    }' >"$guide_catalog_tmp/combined.json" \
    || die 'could not combine profile guide catalogs'

  guide_command=(node "$picker_path" guide "$guide_root" "$guide_catalog_tmp/skills/prompt-master")
  if ((${#guide_args[@]} > 0)); then
    guide_command+=("${guide_args[@]}")
  fi
  guide_status=0
  "${guide_command[@]}" 3<"$guide_catalog_tmp/combined.json" || guide_status=$?
  cleanup_guide_catalog_tmp
  trap - EXIT HUP INT TERM
  exit "$guide_status"
fi

command -v node >/dev/null 2>&1 || die 'required command not found: node'
[[ -t 0 && -t 2 ]] || die 'an interactive terminal is required'
[[ -f "$picker_path" && ! -L "$picker_path" ]] \
  || die 'Ink launcher is missing or unsafe'

passthrough_args="$(jq -cn '$ARGS.positional' --args -- "$@")" \
  || die 'could not encode launcher arguments'
choices="$(build_choices \
  "$cpx_catalog" "$cdx_catalog" "$cldx_catalog" "$grx_catalog" "$jcx_catalog" "$omp_catalog" "$picx_catalog" "$prx_catalog" "$fmx_catalog" \
  "$cpx" "$cdx" "$cldx" "$grx" "$jcx" "$omp" "$picx" "$prx" "$fmx" "$passthrough_args")" \
  || die 'could not build profile choices'

choice_file="$(mktemp "${TMPDIR:-/tmp}/trellage-trx-choices.XXXXXX")" \
  || die 'cannot create launcher catalog file'
result_file="$(mktemp "${TMPDIR:-/tmp}/trellage-trx-result.XXXXXX")" \
  || { rm -f -- "$choice_file"; die 'cannot create launcher result file'; }
printf '%s\n' "$choices" >"$choice_file"
picker_status=0
node "$picker_path" "$choice_file" "$result_file" || picker_status=$?
launch_intent="$(<"$result_file")"
rm -f -- "$choice_file" "$result_file"
if ((picker_status != 0)); then
  exit "$picker_status"
fi

selection="$(jq -er '.id | select(type == "string")' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid selection'
launch_target="$(jq -er '.target | select(. == "current" or . == "herdr")' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid target'
selected_model="$(jq -r '.model // empty' <<<"$launch_intent")" \
  || die 'Ink launcher returned an invalid model'
launcher="${selection%%:*}"
profile="${selection#*:}"
case "$launcher" in
  cpx)
    selected_launcher="$cpx"
    selected_catalog="$cpx_catalog"
    ;;
  cdx)
    selected_launcher="$cdx"
    selected_catalog="$cdx_catalog"
    ;;
  cldx)
    selected_launcher="$cldx"
    selected_catalog="$cldx_catalog"
    ;;
  fmx)
    selected_launcher="$fmx"
    selected_catalog="$fmx_catalog"
    ;;
  grx)
    selected_launcher="$grx"
    selected_catalog="$grx_catalog"
    ;;
  jcx)
    selected_launcher="$jcx"
    selected_catalog="$jcx_catalog"
    ;;
  omp)
    selected_launcher="$omp"
    selected_catalog="$omp_catalog"
    ;;
  picx)
    selected_launcher="$picx"
    selected_catalog="$picx_catalog"
    ;;
  prx)
    selected_launcher="$prx"
    selected_catalog="$prx_catalog"
    ;;
  *) die 'terminal picker returned an invalid launcher' ;;
esac
[[ "$profile" != "$selection" && "$profile" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] \
  || die 'terminal picker returned an invalid profile'
jq -e --arg profile "$profile" '.profiles | map(.name) | index($profile) != null' \
  <<<"$selected_catalog" >/dev/null \
  || die 'Ink launcher returned an unknown profile'
launch_arguments=("$selected_launcher" "$profile")
[[ -z "$selected_model" ]] || launch_arguments+=(--model "$selected_model")
launch_arguments+=("$@")
if [[ "$launch_target" == herdr ]]; then
  if [[ "$launcher" == cdx && "$profile" == youtube \
      && "$trx_transcript_api_key_is_set" == true ]]; then
    die 'explicit TRANSCRIPT_API_KEY cannot be forwarded securely to Herdr; use the Trellage Varlock source or launch in the current pane'
  fi
  [[ "${HERDR_ENV:-}" == 1 && -n "${HERDR_PANE_ID:-}" ]] \
    || die 'Herdr launch requested outside a Herdr pane'
  command -v herdr >/dev/null 2>&1 || die 'Herdr command is unavailable'
  worktree="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
    || die 'Herdr launch requires a Git worktree'
  split="$(herdr pane split --current --direction right --cwd "$worktree" --focus)" \
    || die 'could not create a Herdr pane'
  pane="$(jq -er '.result.pane.pane_id' <<<"$split")" \
    || die 'Herdr did not return a pane ID'
  command_line="$(printf '%q ' "${launch_arguments[@]}")"
  herdr pane run "$pane" "$command_line" || die 'could not start the selected profile in Herdr'
  exit 0
fi
restore_transcript_api_key "$launcher" "$profile"
exec "${launch_arguments[@]}"
