#!/usr/bin/env bash
set +x
set +a
set -euo pipefail

unset trx_transcript_api_key trx_transcript_api_key_is_set
trx_transcript_api_key_is_set=false
trx_transcript_api_key=""
if [[ "${TRANSCRIPT_API_KEY+x}" == x ]]; then
  trx_transcript_api_key_is_set=true
  trx_transcript_api_key="$TRANSCRIPT_API_KEY"
fi
unset TRANSCRIPT_API_KEY

readonly ownership_value='trellage-router-v3'

