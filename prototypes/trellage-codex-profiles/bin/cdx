#!/usr/bin/env bash
set -u

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}" source_dir link_target

  while [[ -L "$source_path" ]]; do
    source_dir="$(CDPATH= cd -P -- "$(dirname "$source_path")" && pwd)"
    link_target="$(readlink "$source_path")"
    if [[ "$link_target" == /* ]]; then
      source_path="$link_target"
    else
      source_path="$source_dir/$link_target"
    fi
  done
  CDPATH= cd -P -- "$(dirname "$source_path")" && pwd
}

script_dir="$(resolve_script_dir)" || {
  printf 'cdx: could not resolve launcher directory\n' >&2
  exit 1
}
runtime_root="$(CDPATH= cd -P -- "$script_dir/.." && pwd)" || {
  printf 'cdx: could not resolve runtime root\n' >&2
  exit 1
}
common_launcher="$runtime_root/lib/native-codex"
if [[ ! -f "$common_launcher" ]]; then
  common_launcher="$runtime_root/../trellage-codex-common/native-codex"
fi
[[ -f "$common_launcher" && ! -L "$common_launcher" && -x "$common_launcher" ]] || {
  printf 'cdx: shared native Codex launcher is missing or unsafe: %s\n' "$common_launcher" >&2
  exit 1
}

export TRELLAGE_CODEX_LAUNCHER_NAME=cdx
export TRELLAGE_CODEX_RUNTIME_ROOT="$runtime_root"
export TRELLAGE_CODEX_PROFILE_STORAGE_KEY=
# Source the implementation so the public launcher remains $0 for signal and
# process-boundary behavior.
. "$common_launcher"
