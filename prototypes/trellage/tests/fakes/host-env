#!/usr/bin/env bash
set -euo pipefail

write_fixture_config() {
  local directory="$1"
  local destination="$directory/.trellage-fixture-env.$$.$RANDOM"
  local temporary="$destination.tmp"
  : >"$temporary"
  while IFS= read -r name; do
    printf 'export %q=%q\n' "$name" "${!name}" >>"$temporary"
  done < <(compgen -A variable FAKE_)
  mv -f "$temporary" "$destination"
  fixture_config="$destination"
}

fixture_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
fixture_config=
write_fixture_config "$fixture_directory"
export TRELLAGE_TEST_FIXTURE_CONFIG="$fixture_config"

case "${1:-}" in
  -i|--ignore-environment)
    clean_option="$1"
    shift
    exec /usr/bin/env "$clean_option" \
      "TRELLAGE_TEST_FIXTURE_CONFIG=$fixture_config" "$@"
    ;;
  *) exec /usr/bin/env "$@" ;;
esac
