#!/usr/bin/env bash
set -euo pipefail
fixture_config="${TRELLAGE_TEST_FIXTURE_CONFIG:-$(dirname "$0")/.trellage-fixture-env}"
[[ ! -f "$fixture_config" ]] || source "$fixture_config"

log="${FAKE_DOCKER_LOG:?}"
if [[ ! -s "$log" || ! -f "$log.generation" ]]; then
  printf '%s:%s\n' "$$" "$RANDOM" >"$log.generation"
  printf '0\n' >"$log.container-label-inspect-count"
fi
IFS= read -r current_generation <"$log.generation"
printf 'CALL\n' >>"$log"
printf 'ENV\tHERDR_AGENT=%s\n' "${HERDR_AGENT:-}" >>"$log"
printf 'ENV\tDOCS_TOKEN=%s\n' "${DOCS_TOKEN:+present}" >>"$log"
copilot_token_state=
if [[ -n "${COPILOT_GITHUB_TOKEN:-}" ]]; then
  copilot_token_state=present
  if [[ -n "${FAKE_DOCKER_EXPECT_COPILOT_TOKEN_SHA256:-}" ]]; then
    if command -v sha256sum >/dev/null 2>&1; then
      copilot_token_hash="$(printf '%s' "$COPILOT_GITHUB_TOKEN" | sha256sum | awk '{print $1}')"
    else
      copilot_token_hash="$(printf '%s' "$COPILOT_GITHUB_TOKEN" | shasum -a 256 | awk '{print $1}')"
    fi
    [[ "$copilot_token_hash" != "$FAKE_DOCKER_EXPECT_COPILOT_TOKEN_SHA256" ]] \
      || copilot_token_state=matched
  fi
fi
printf 'ENV\tCOPILOT_GITHUB_TOKEN=%s\n' "$copilot_token_state" >>"$log"
printf 'ENV\tGH_TOKEN=%s\n' "${GH_TOKEN:+present}" >>"$log"
printf 'ENV\tGITHUB_TOKEN=%s\n' "${GITHUB_TOKEN:+present}" >>"$log"
printf 'ENV\tPLAYWRIGHT_MCP_EXTENSION_TOKEN=%s\n' "${PLAYWRIGHT_MCP_EXTENSION_TOKEN:+present}" >>"$log"
claude_routing_state=
if [[ -n "${FAKE_DOCKER_EXPECT_CLAUDE_GATEWAY:-}" ]]; then
  claude_routing_state=present
  if [[ "${TRELLAGE_CLAUDE_MODE:-}" == "${FAKE_DOCKER_EXPECT_CLAUDE_MODE:-}" \
    && "${ANTHROPIC_BASE_URL:-}" == "$FAKE_DOCKER_EXPECT_CLAUDE_GATEWAY" \
    && "${ANTHROPIC_DEFAULT_OPUS_MODEL:-}" == "${FAKE_DOCKER_EXPECT_CLAUDE_OPUS_MODEL:-}" \
    && "${ANTHROPIC_DEFAULT_SONNET_MODEL:-}" == "${FAKE_DOCKER_EXPECT_CLAUDE_SONNET_MODEL:-}" \
    && "${ANTHROPIC_DEFAULT_HAIKU_MODEL:-}" == "${FAKE_DOCKER_EXPECT_CLAUDE_HAIKU_MODEL:-}" ]]; then
    claude_routing_state=matched
  fi
fi
printf 'ENV\tCLAUDE_PROXY_ROUTING=%s\n' "$claude_routing_state" >>"$log"
for internal_name in \
  ambient_copilot_github_token ambient_gh_token ambient_github_token \
  copilot_token secret_value secret_source_values; do
  [[ -z "${!internal_name:-}" ]] || internal_state=present
  printf 'ENV\t%s=%s\n' "$internal_name" "${internal_state:-}" >>"$log"
  internal_state=
done
printf 'ARG\t%s\n' "$@" >>"$log"

emit_agent_streams() {
  if [[ -n "${FAKE_DOCKER_AGENT_STDOUT_FILE:-}" ]]; then
    [[ -f "$FAKE_DOCKER_AGENT_STDOUT_FILE" && ! -L "$FAKE_DOCKER_AGENT_STDOUT_FILE" ]] \
      || exit 64
    cat -- "$FAKE_DOCKER_AGENT_STDOUT_FILE"
  fi
  if [[ -n "${FAKE_DOCKER_AGENT_STDERR_FILE:-}" ]]; then
    [[ -f "$FAKE_DOCKER_AGENT_STDERR_FILE" && ! -L "$FAKE_DOCKER_AGENT_STDERR_FILE" ]] \
      || exit 64
    cat -- "$FAKE_DOCKER_AGENT_STDERR_FILE" >&2
  fi
}

assert_prepared_agent_tty() {
  local tty_settings
  [[ "${FAKE_DOCKER_REQUIRE_PREPARED_TTY:-0}" == 1 ]] || return 0
  [[ -t 0 && -t 1 && -t 2 ]] || exit 91
  tty_settings="$(stty -a 2>/dev/null </dev/tty)" || exit 92
  [[ "$tty_settings" =~ (^|[[:space:];])-icanon([[:space:];]|$) ]] || exit 93
  [[ "$tty_settings" =~ (^|[[:space:];])-echo([[:space:];]|$) ]] || exit 94
  [[ "$tty_settings" =~ (^|[[:space:];])isig([[:space:];]|$) ]] || exit 95
  printf 'AGENT_TTY\tprepared\n' >>"$log"
}

if [[ "${1:-}" == --host ]]; then
  [[ $# -ge 3 ]] || exit 64
  shift 2
fi
case "${1:-} ${2:-}" in
  'context show')
    printf '%s\n' fake-context
    exit 0
    ;;
  'context inspect')
    printf '%s\n' unix:///tmp/trellage-fake-docker.sock
    exit 0
    ;;
  'info --format')
    server_info_count_file="$log.server-info-count"
    server_info_count=0
    info_platform="${FAKE_DOCKER_INFO_PLATFORM:-linux/arm64}"
    [[ ! -f "$server_info_count_file" ]] || server_info_count="$(head -n 1 "$server_info_count_file")"
    server_info_count="$((server_info_count + 1))"
    printf '%s\n' "$server_info_count" >"$server_info_count_file"
    if [[ "${FAKE_DOCKER_CLEANUP_SERVER_CHANGE:-0}" == 1 && -f "$log.agent-exec-finished" ]]; then
      if [[ "${3:-}" == $'{{.ID}}\n{{.OSType}}/{{.Architecture}}' ]]; then
        printf '%s\n%s\n' changed-server-id linux/amd64
      else
        printf '%s\n' changed-server-id
      fi
    elif [[ "$server_info_count" -eq "${FAKE_DOCKER_SERVER_CHANGE_ON_INFO_CALL:-0}" ]]; then
      if [[ "${3:-}" == $'{{.ID}}\n{{.OSType}}/{{.Architecture}}' ]]; then
        printf '%s\n%s\n' changed-server-id linux/amd64
      else
        printf '%s\n' linux/amd64
      fi
    elif [[ "${3:-}" == $'{{.ID}}\n{{.OSType}}/{{.Architecture}}' ]]; then
      printf '%s\n%s\n' fake-server-id "$info_platform"
    elif [[ "${3:-}" == '{{.ID}}' ]]; then
      printf '%s\n' fake-server-id
    else
      printf '%s\n' "$info_platform"
    fi
    exit 0
    ;;
esac

default_profile_hash() {
  if [[ -n "${FAKE_HARNESS_METADATA:-}" && -f "$FAKE_HARNESS_METADATA" ]]; then
    jq -er '.profile_hash | strings | select(test("^sha256:[0-9a-f]{64}$"))' "$FAKE_HARNESS_METADATA" 2>/dev/null \
      && return
  fi
  printf '%s\n' "${FAKE_DOCKER_DEFAULT_PROFILE_HASH:-sha256:62404b7266dfa833082abd9f7cd40d694fe755dfed126c323b57b542e77b9124}"
}

read_fake_state() {
  local fallback="$1"
  local state_file="$2"
  if [[ -n "$state_file" ]]; then
    head -n 1 "$state_file"
    return
  fi
  printf '%s\n' "$fallback"
}

created_state_is_current() {
  local resource="$1"
  local generation_file="$log.$resource-generation"
  local generation
  [[ -f "$generation_file" ]] || return 1
  IFS= read -r generation <"$generation_file"
  [[ -n "$generation" && "$generation" == "$current_generation" ]]
}

persist_create_labels() {
  local resource="$1"
  shift
  local labels_file="$log.$resource-labels"
  local argument label key value
  : >"$labels_file"
  while (( $# > 0 )); do
    argument="$1"
    case "$argument" in
      --label)
        [[ $# -ge 2 ]] || exit 64
        label="$2"
        shift 2
        ;;
      --label=*)
        label="${argument#--label=}"
        shift
        ;;
      *)
        shift
        continue
        ;;
    esac
    [[ "$label" == *=* ]] || exit 64
    key="${label%%=*}"
    value="${label#*=}"
    printf '%s\t%s\n' "$key" "$value" >>"$labels_file"
  done
  printf '%s\n' "$current_generation" >"$log.$resource-generation"
}

created_label() {
  local resource="$1"
  local key="$2"
  local labels_file="$log.$resource-labels"
  awk -F '\t' -v expected="$key" '
    $1 == expected {
      print substr($0, length($1) + 2)
      found = 1
      exit
    }
    END { if (!found) print "" }
  ' "$labels_file"
}

container_state="$(read_fake_state \
  "${FAKE_DOCKER_CONTAINER_STATE:-absent}" \
  "${FAKE_DOCKER_CONTAINER_STATE_FILE:-}")"
volume_state="$(read_fake_state \
  "${FAKE_DOCKER_VOLUME_STATE:-absent}" \
  "${FAKE_DOCKER_VOLUME_STATE_FILE:-}")"
if created_state_is_current container; then
  container_state=created
fi
if [[ "$volume_state" == absent ]] && created_state_is_current volume; then
  volume_state=created
fi

case "${1:-} ${2:-}" in
  'container ls')
    list_state="${FAKE_DOCKER_CONTAINER_LIST_STATE:-auto}"
    if [[ "$list_state" == auto ]]; then
      case "$container_state" in
        absent) list_state=absent ;;
        *) list_state=present ;;
      esac
    fi
    case "$list_state" in
      absent) ;;
      error) exit "${FAKE_DOCKER_CONTAINER_LIST_ERROR_CODE:-72}" ;;
      unexpected) printf 'unexpected-container\n' ;;
      present)
        filter=''
        while [[ "$#" -gt 0 ]]; do
          if [[ "$1" == --filter ]]; then
            filter="${2:-}"
            break
          fi
          shift
        done
        listed_name="${filter#name=^/}"
        listed_name="${listed_name%\$}"
        printf '%s\n' "$listed_name"
        ;;
      *) exit 65 ;;
    esac
    ;;
  'volume ls')
    list_state="${FAKE_DOCKER_VOLUME_LIST_STATE:-auto}"
    if [[ "$list_state" == auto ]]; then
      case "$volume_state" in
        absent) list_state=absent ;;
        *) list_state=present ;;
      esac
    fi
    case "$list_state" in
      absent) ;;
      error) exit "${FAKE_DOCKER_VOLUME_LIST_ERROR_CODE:-73}" ;;
      unexpected) printf 'unexpected-volume\n' ;;
      present)
        filter=''
        while [[ "$#" -gt 0 ]]; do
          if [[ "$1" == --filter ]]; then
            filter="${2:-}"
            break
          fi
          shift
        done
        listed_name="${filter#name=^}"
        listed_name="${listed_name%\$}"
        printf '%s\n' "$listed_name"
        ;;
      *) exit 65 ;;
    esac
    ;;
  'image ls')
    list_state="${FAKE_DOCKER_IMAGE_LIST_STATE:-auto}"
    if [[ "$list_state" == auto ]]; then
      if [[ "${FAKE_DOCKER_IMAGE_EXISTS:-1}" == 1 ]]; then
        list_state=present
      else
        list_state=absent
      fi
    fi
    case "$list_state" in
      absent) ;;
      error) exit "${FAKE_DOCKER_IMAGE_LIST_ERROR_CODE:-74}" ;;
      unexpected) printf 'unexpected/image:tag\n' ;;
      present)
        filter=''
        while [[ "$#" -gt 0 ]]; do
          if [[ "$1" == --filter ]]; then
            filter="${2:-}"
            break
          fi
          shift
        done
        printf '%s\n' "${filter#reference=}"
        ;;
      *) exit 65 ;;
    esac
    ;;
  'network ls')
    list_state="${FAKE_DOCKER_NETWORK_LIST_STATE:-auto}"
    if [[ "$list_state" == auto ]]; then
      if [[ "${FAKE_DOCKER_NETWORK_EXISTS:-1}" == 1 ]]; then
        list_state=present
      else
        list_state=absent
      fi
    fi
    case "$list_state" in
      absent) ;;
      error) exit "${FAKE_DOCKER_NETWORK_LIST_ERROR_CODE:-75}" ;;
      unexpected) printf 'unexpected-network\n' ;;
      present)
        filter=''
        while [[ "$#" -gt 0 ]]; do
          if [[ "$1" == --filter ]]; then
            filter="${2:-}"
            break
          fi
          shift
        done
        listed_name="${filter#name=^}"
        listed_name="${listed_name%\$}"
        printf '%s\n' "$listed_name"
        ;;
      *) exit 65 ;;
    esac
    ;;
  'image inspect')
    image_was_built=false
    if [[ "${FAKE_PROFILE_BUILD_SUCCEEDS:-0}" == 1 && -f "$log.image-built" ]]; then
      image_was_built=true
    fi
    [[ "$image_was_built" == true || "${FAKE_DOCKER_IMAGE_EXISTS:-1}" == 1 ]] || exit 1
    if [[ "${3:-}" == --format ]]; then
      case "${4:-}" in
        *'.Id'*)
          if [[ "$image_was_built" == true ]]; then
            printf '%s\n' fake-built-image-id
          else
            printf '%s\n' "${FAKE_DOCKER_IMAGE_ID:-fake-image-id}"
          fi
          ;;
        *dev.trellage.profile.hash*)
          [[ "${FAKE_DOCKER_IMAGE_LABEL_INSPECT_ERROR:-0}" != 1 ]] \
            || exit "${FAKE_DOCKER_IMAGE_LABEL_ERROR_CODE:-77}"
          if [[ "$image_was_built" == true ]]; then
            cat "$log.image-profile-hash"
            exit 0
          fi
          if [[ "${FAKE_DOCKER_RETAG_RACE:-0}" == 1 && "${5:-}" != "${FAKE_DOCKER_IMAGE_ID:-fake-image-id}" ]]; then
            printf 'sha256:%064d\n' 0
            exit 0
          fi
          printf '%s\n' "${FAKE_DOCKER_IMAGE_PROFILE_HASH-$(default_profile_hash)}"
          ;;
        *dev.trellage.runtime.hash*)
          [[ "${FAKE_DOCKER_IMAGE_LABEL_INSPECT_ERROR:-0}" != 1 ]] \
            || exit "${FAKE_DOCKER_IMAGE_LABEL_ERROR_CODE:-77}"
          if [[ "$image_was_built" == true ]]; then
            cat "$log.image-runtime-hash"
            exit 0
          fi
          if [[ "${FAKE_DOCKER_RETAG_RACE:-0}" == 1 && "${5:-}" != "${FAKE_DOCKER_IMAGE_ID:-fake-image-id}" ]]; then
            printf 'sha256:%064d\n' 0
            exit 0
          fi
          printf '%s\n' "${FAKE_DOCKER_IMAGE_RUNTIME_HASH:-}"
          ;;
        *dev.trellage.platform*) printf '%s\n' "${FAKE_DOCKER_PLATFORM:-linux/arm64}" ;;
      esac
    fi
    ;;
  'network inspect')
    [[ "${FAKE_DOCKER_NETWORK_EXISTS:-1}" == 1 ]]
    ;;
  'volume inspect')
    if [[ "${FAKE_DOCKER_CLEANUP_VOLUME_MISMATCH:-0}" == 1 && -f "$log.agent-exec-finished" ]]; then
      volume_state=unrelated
    fi
    case "$volume_state" in
      absent) exit 1 ;;
      error) exit "${FAKE_DOCKER_VOLUME_ERROR_CODE:-71}" ;;
      created)
        prototype="$(created_label volume dev.trellage.prototype)"
        worktree="$(created_label volume dev.trellage.worktree)"
        profile="$(created_label volume dev.trellage.profile)"
        platform="$(created_label volume dev.trellage.platform)"
        ;;
      matching)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        platform="${FAKE_DOCKER_PLATFORM:-linux/arm64}"
        ;;
      matching-legacy-platform)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        platform=
        ;;
      matching-missing-profile)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-copilot}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile=
        platform="${FAKE_DOCKER_PLATFORM:-linux/arm64}"
        ;;
      unrelated)
        prototype='some-other-tool'
        worktree='/tmp/not-this-worktree'
        profile='unrelated'
        platform='linux/arm64'
        ;;
      *) exit 65 ;;
    esac
    case "${4:-}" in
      *dev.trellage.prototype*dev.trellage.worktree*dev.trellage.profile*dev.trellage.platform*)
        printf '%s\t%s\t%s\t%s\n' "$prototype" "$worktree" "$profile" "$platform"
        ;;
      *dev.trellage.prototype*dev.trellage.worktree*)
        printf '%s\t%s\n' "$prototype" "$worktree"
        ;;
      *dev.trellage.prototype*) printf '%s\n' "$prototype" ;;
      *dev.trellage.worktree*) printf '%s\n' "$worktree" ;;
      *dev.trellage.profile*) printf '%s\n' "$profile" ;;
      *) exit 66 ;;
    esac
    ;;
  'container inspect')
    if [[ "${FAKE_DOCKER_CLEANUP_OWNERSHIP_MISMATCH:-0}" == 1 && -f "$log.agent-exec-finished" ]]; then
      container_state=unrelated
    elif [[ "${FAKE_DOCKER_CLEANUP_MOUNT_MISMATCH:-0}" == 1 && -f "$log.agent-exec-finished" ]]; then
      container_state=matching-wrong-mount
    fi
    case "$container_state" in
      absent) exit 1 ;;
      error) exit "${FAKE_DOCKER_CONTAINER_ERROR_CODE:-70}" ;;
      created)
        prototype="$(created_label container dev.trellage.prototype)"
        worktree="$(created_label container dev.trellage.worktree)"
        profile="$(created_label container dev.trellage.profile)"
        profile_hash="$(created_label container dev.trellage.profile.hash)"
        platform="$(created_label container dev.trellage.platform)"
        runtime_hash="$(created_label container dev.trellage.runtime.hash)"
        container_image="$(head -n 1 "$log.container-image")"
        running="$(head -n 1 "$log.container-running")"
        ;;
      matching-running)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        profile_hash="${FAKE_DOCKER_CONTAINER_PROFILE_HASH:-$(default_profile_hash)}"
        runtime_hash="${FAKE_DOCKER_CONTAINER_RUNTIME_HASH:-}"
        platform="${FAKE_DOCKER_PLATFORM:-linux/arm64}"
        running='true'
        ;;
      matching-stopped)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        profile_hash="${FAKE_DOCKER_CONTAINER_PROFILE_HASH:-$(default_profile_hash)}"
        runtime_hash="${FAKE_DOCKER_CONTAINER_RUNTIME_HASH:-}"
        platform="${FAKE_DOCKER_PLATFORM:-linux/arm64}"
        running='false'
        ;;
      matching-stopped-legacy-platform)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        profile_hash="${FAKE_DOCKER_CONTAINER_PROFILE_HASH:-$(default_profile_hash)}"
        runtime_hash="${FAKE_DOCKER_CONTAINER_RUNTIME_HASH:-}"
        platform=
        running='false'
        ;;
      matching-running-missing-profile)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-copilot}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile=
        running='true'
        ;;
      matching-worktree-prefix)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}|other"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        running='true'
        ;;
      matching-wrong-mount)
        prototype="${FAKE_DOCKER_PROTOTYPE:-trellage-codex}"
        worktree="${FAKE_GIT_ROOT:?}"
        profile="${FAKE_DOCKER_PROFILE:-codex-superpowers}"
        profile_hash="${FAKE_DOCKER_CONTAINER_PROFILE_HASH:-$(default_profile_hash)}"
        runtime_hash="${FAKE_DOCKER_CONTAINER_RUNTIME_HASH:-}"
        platform="${FAKE_DOCKER_PLATFORM:-linux/arm64}"
        running='true'
        ;;
      unrelated)
        prototype='some-other-tool'
        worktree='/tmp/not-this-worktree'
        profile='unrelated'
        running='true'
        ;;
      *) exit 65 ;;
    esac
    case "${4:-}" in
      *dev.trellage.profile.hash*|*dev.trellage.runtime.hash*)
        label_count_file="$log.container-label-inspect-count"
        label_count=0
        [[ ! -f "$label_count_file" ]] || label_count="$(head -n 1 "$label_count_file")"
        label_count="$((label_count + 1))"
        printf '%s\n' "$label_count" >"$label_count_file"
        [[ "${FAKE_DOCKER_CONTAINER_LABEL_INSPECT_ERROR:-0}" != 1 ]] \
          || exit "${FAKE_DOCKER_CONTAINER_LABEL_ERROR_CODE:-76}"
        [[ -z "${FAKE_DOCKER_CONTAINER_LABEL_INSPECT_FAIL_ON:-}" \
          || "$label_count" -ne "$FAKE_DOCKER_CONTAINER_LABEL_INSPECT_FAIL_ON" ]] \
          || exit "${FAKE_DOCKER_CONTAINER_LABEL_ERROR_CODE:-76}"
        case "${4:-}" in
          *dev.trellage.profile.hash*) printf '%s\n' "${profile_hash:-}" ;;
          *) printf '%s\n' "${runtime_hash:-}" ;;
        esac
        ;;
      *dev.trellage.prototype*) printf '%s\n' "$prototype" ;;
      *dev.trellage.worktree*) printf '%s\n' "$worktree" ;;
      *dev.trellage.platform*) printf '%s\n' "${platform:-}" ;;
      *dev.trellage.profile*) printf '%s\n' "$profile" ;;
      *'.Id'*)
        if [[ "${FAKE_DOCKER_CLEANUP_ID_MISMATCH:-0}" == 1 && -f "$log.agent-exec-finished" ]]; then
          printf '%064d\n' 2
        else
          printf '%064d\n' 1
        fi
        ;;
      *'.Image'*)
        if [[ "$container_state" == created ]]; then
          printf '%s\n' "$container_image"
        else
          printf '%s\n' "${FAKE_DOCKER_CONTAINER_IMAGE_ID:-fake-image-id}"
        fi
        ;;
      *State.Running*) printf '%s\n' "$running" ;;
      *State.Pid*) printf '100\n' ;;
      *HostConfig.Init*)
        if [[ "${FAKE_DOCKER_RUNTIME_STATE:-matching}" == absent \
          || "${FAKE_DOCKER_RUNTIME_STATE:-matching}" == missing-init ]]; then
          printf '<nil>\n'
        else
          printf 'true\n'
        fi
        ;;
      *HostConfig.Tmpfs*)
        if [[ "${FAKE_DOCKER_RUNTIME_STATE:-matching}" == absent ]]; then
          printf '\n'
        else
          printf 'rw,noexec,nosuid,nodev,size=1m,mode=700,uid=10001,gid=10001\n'
        fi
        ;;
      *'.Config.Env'*)
        if [[ "${FAKE_DOCKER_RUNTIME_STATE:-matching}" != absent ]]; then
          printf 'XDG_RUNTIME_DIR=/run/user/10001\n'
        fi
        ;;
      *'.Mounts'*)
        fake_state_volume="${FAKE_DOCKER_STATE_VOLUME:-}"
        if [[ -z "$fake_state_volume" && -f "$log.created-volume-name" ]]; then
          IFS= read -r fake_state_volume <"$log.created-volume-name"
        fi
        [[ -n "$fake_state_volume" ]] || exit 67
        if [[ "$container_state" == matching-wrong-mount ]]; then
          printf 'bind\t\t%s\t%s\ttrue\n' "$worktree" "/mounts/$(basename "$worktree")"
          printf 'volume\twrong-state-volume\t/var/lib/docker/volumes/wrong/_data\t/home/agent\ttrue\n'
        else
          printf 'bind\t\t%s\t%s\ttrue\n' "$worktree" "/mounts/$(basename "$worktree")"
          printf 'bind\t\t%s\t%s\ttrue\n' "$worktree/.git" "$worktree/.git"
          printf 'volume\t%s\t/var/lib/docker/volumes/%s/_data\t/home/agent\ttrue\n' \
            "$fake_state_volume" "$fake_state_volume"
          case "${FAKE_DOCKER_MODELS_MOUNT_STATE:-matching}" in
            absent) ;;
            matching)
              printf 'bind\t\t%s\t/home/agent/.copilot-models.json\tfalse\n' "$HOME/.copilot/models.json"
              ;;
            writable)
              printf 'bind\t\t%s\t/home/agent/.copilot-models.json\ttrue\n' "$HOME/.copilot/models.json"
              ;;
            wrong-source)
              printf 'bind\t\t%s\t/home/agent/.copilot-models.json\tfalse\n' "$HOME/.copilot/wrong-models.json"
              ;;
            *) exit 79 ;;
          esac
        fi
        ;;
      *) exit 66 ;;
    esac
    ;;
  'volume create')
    persist_create_labels volume "$@"
    printf '%s\n' "${@: -1}" >"$log.created-volume-name"
    printf '%s\n' "${@: -1}"
    ;;
  'container create')
    if [[ "${FAKE_DOCKER_RETAG_RACE:-0}" == 1 ]]; then
      for argument in "$@"; do
        [[ "$argument" != "${FAKE_DOCKER_RACE_TAG:-}" ]] || exit 88
      done
    fi
    persist_create_labels container "$@"
    printf '%s\n' "${@: -3:1}" >"$log.container-image"
    printf 'false\n' >"$log.container-running"
    printf '%064d\n' 1
    ;;
  'container start')
    if [[ "$container_state" == created ]]; then
      printf 'true\n' >"$log.container-running"
    fi
    printf '%s\n' "${@: -1}"
    ;;
  'container stop')
    [[ "${FAKE_DOCKER_STOP_EXIT:-0}" == 0 ]] || exit "$FAKE_DOCKER_STOP_EXIT"
    if [[ -n "${FAKE_DOCKER_STOP_READY_FILE:-}" ]]; then
      : >"$FAKE_DOCKER_STOP_READY_FILE"
      while [[ ! -f "${FAKE_DOCKER_STOP_RELEASE_FILE:?}" ]]; do sleep 0.05; done
    fi
    if [[ "$container_state" == created ]]; then
      printf 'false\n' >"$log.container-running"
    fi
    printf '%s\n' "${@: -1}"
    ;;
  'container top')
    if [[ "${FAKE_DOCKER_INIT_WRAPPER:-0}" == 1 ]]; then
      printf 'PID PPID COMMAND COMMAND\n'
      printf '100 0 docker-init /sbin/docker-init -- sleep infinity\n'
      printf '101 100 sleep sleep infinity\n'
      if [[ "${FAKE_DOCKER_ACTIVE_SESSION:-0}" == 1 ]]; then
        printf '102 0 claude claude\n'
      fi
    else
      printf 'PID PPID COMMAND\n'
      printf '100 0 sleep\n'
      if [[ "${FAKE_DOCKER_ACTIVE_SESSION:-0}" == 1 ]]; then
        printf '101 100 claude\n'
      fi
    fi
    ;;
  'container rm') printf '%s\n' "${@: -1}" ;;
  'volume rm') printf '%s\n' "${@: -1}" ;;
  'container exec')
    if [[ -n "${FAKE_DOCKER_GH_AUTH_MARKER:-}" ]]; then
      for argument in "$@"; do
        if [[ "$argument" == *'gh auth login'* ]]; then
          printf '%s\n' "$FAKE_DOCKER_GH_AUTH_MARKER"
          printf '%s-stderr\n' "$FAKE_DOCKER_GH_AUTH_MARKER" >&2
          break
        fi
      done
    fi
    if [[ "${FAKE_DOCKER_BLOCK_ANY_EXEC:-0}" == 1 && -n "${FAKE_DOCKER_EXEC_READY_FILE:-}" ]]; then
      : >"$FAKE_DOCKER_EXEC_READY_FILE"
      while [[ ! -f "${FAKE_DOCKER_EXEC_RELEASE_FILE:?}" ]]; do sleep 0.05; done
    fi
    if [[ -n "${FAKE_DOCKER_AGENT_EXEC_EXIT:-}" ]]; then
      for argument in "$@"; do
        if [[ "$argument" == *trellage-*-entry* \
          || "$argument" == /usr/local/bin/trellage-session-bridge ]]; then
          assert_prepared_agent_tty
          emit_agent_streams
          : >"$log.agent-exec-finished"
          exit "$FAKE_DOCKER_AGENT_EXEC_EXIT"
        fi
      done
    fi
    for argument in "$@"; do
      if [[ "$argument" == *trellage-*-entry* \
        || "$argument" == /usr/local/bin/trellage-session-bridge ]]; then
        assert_prepared_agent_tty
        if [[ "${FAKE_DOCKER_PTY_PROBE:-0}" == 1 ]]; then
          [[ -t 0 && -t 1 && -t 2 ]] || exit 91
          trap 'printf "PTY:interrupt\n"; exit 130' INT
          printf 'PTY:tty\n'
          printf '\033[32mPTY:color\033[0m\n'
          printf 'PTY:ready\n'
          IFS= read -r probe_input
          printf 'PTY:input:%s\n' "$probe_input"
          IFS= read -r probe_command
          printf 'PTY:slash:%s\n' "$probe_command"
          while :; do sleep 1; done
        fi
        if [[ -n "${FAKE_DOCKER_EXEC_READY_FILE:-}" ]]; then
          : >"$FAKE_DOCKER_EXEC_READY_FILE"
          while [[ ! -f "${FAKE_DOCKER_EXEC_RELEASE_FILE:?}" ]]; do sleep 0.05; done
        fi
        emit_agent_streams
        : >"$log.agent-exec-finished"
        break
      fi
    done
    exit "${FAKE_DOCKER_EXEC_EXIT:-0}"
    ;;
  *) exit 64 ;;
esac
