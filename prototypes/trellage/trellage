    claude_auth_args+=(--env PLAYWRIGHT_MCP_EXTENSION_TOKEN)
  fi
  if [[ -n "$ambient_apify_api_token" ]]; then
    APIFY_API_TOKEN="$ambient_apify_api_token"
    export APIFY_API_TOKEN
    claude_auth_args+=(--env APIFY_API_TOKEN)
  fi
  if [[ -n "$ambient_google_ai_api_key" ]]; then
    GOOGLE_AI_API_KEY="$ambient_google_ai_api_key"
    export GOOGLE_AI_API_KEY
    claude_auth_args+=(--env GOOGLE_AI_API_KEY)
  fi
