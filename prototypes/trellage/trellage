# Host package-feed overrides for agent sessions inside the sandbox.
# Only forwards when the host has HTTPS index/registry values (corporate CFS,
# private mirrors, etc.). Empty on machines that use public registries.
# Images stay universal; feeds are launch-time host policy, not baked digests.
package_feed_args=()
is_https_package_feed_url() {
  local value="$1"
  [[ -n "$value" ]] || return 1
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* && "$value" != *$'\0'* ]] || return 1
  case "$value" in
    https://*/*) return 0 ;;
    https://*) return 0 ;;
    *) return 1 ;;
  esac
}
prepare_package_feed_args() {
  package_feed_args=()
  local name value npm_registry
  # Prefer explicit host env (fish/MDM). Fill gaps from host npm config the same
  # way the profile compiler discovers npm_config_registry for image builds.
  if [[ -z "${npm_config_registry:-}" ]] && command -v npm >/dev/null 2>&1; then
    npm_registry="$(npm config get registry 2>/dev/null | tr -d '\r\n')" || npm_registry=
    if is_https_package_feed_url "$npm_registry"; then
      npm_config_registry="$npm_registry"
      export npm_config_registry
    fi
  fi
  if [[ -z "${UV_DEFAULT_INDEX:-}" && -n "${PIP_INDEX_URL:-}" ]] \
    && is_https_package_feed_url "${PIP_INDEX_URL}"; then
    UV_DEFAULT_INDEX="$PIP_INDEX_URL"
    export UV_DEFAULT_INDEX
  fi
  if [[ -z "${UV_DEFAULT_INDEX:-}" && -n "${npm_config_registry:-}" ]]; then
    case "$npm_config_registry" in
      https://packagefeedproxy.microsoft.io/npm|https://packagefeedproxy.microsoft.io/npm/)
        UV_DEFAULT_INDEX=https://packagefeedproxy.microsoft.io/pypi/simple/
        export UV_DEFAULT_INDEX
        if [[ -z "${PIP_INDEX_URL:-}" ]]; then
          PIP_INDEX_URL=$UV_DEFAULT_INDEX
          export PIP_INDEX_URL
        fi
        ;;
    esac
  fi
  for name in UV_DEFAULT_INDEX PIP_INDEX_URL UV_INDEX_URL UV_EXTRA_INDEX_URL \
    npm_config_registry NPM_CONFIG_REGISTRY; do
    value="$(printenv "$name" 2>/dev/null || true)"
    is_https_package_feed_url "$value" || continue
    package_feed_args+=(--env "$name")
  done
}
prepare_package_feed_args

