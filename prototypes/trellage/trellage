#!/usr/bin/env bash
set +x
set -euo pipefail
ulimit -c 0 2>/dev/null || true

resolve_script_path() {
  local candidate="$1"
  local candidate_dir link_target
  while [[ -L "$candidate" ]]; do
    candidate_dir="$(cd -P "$(dirname "$candidate")" && pwd)" || return 1
    link_target="$(readlink "$candidate")" || return 1
    if [[ "$link_target" == /* ]]; then
      candidate="$link_target"
    else
      candidate="$candidate_dir/$link_target"
    fi
  done
  candidate_dir="$(cd -P "$(dirname "$candidate")" && pwd)" || return 1
  printf '%s/%s\n' "$candidate_dir" "${candidate##*/}"
}

canonical_git_common_dir() {
  local checkout="$1"
  local common_dir
  common_dir="$(git -C "$checkout" rev-parse --git-common-dir 2>/dev/null)" || return 1
  if [[ "$common_dir" != /* ]]; then
    common_dir="$checkout/$common_dir"
  fi
  [[ -d "$common_dir" ]] || return 1
  cd -P "$common_dir" && pwd
}

dispatch_to_current_trellage_worktree() {
  local invoked_path="$1"
  local installed_path="$2"
  shift 2
  [[ -L "$invoked_path" ]] || return 0
  command -v git >/dev/null 2>&1 || return 0

  local current_root installed_root candidate
  local current_common_dir installed_common_dir
  current_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" || return 0
  current_root="$(cd -P "$current_root" && pwd)" || return 0
  candidate="$current_root/prototypes/trellage/trellage"
  [[ -f "$candidate" && -x "$candidate" && ! -L "$candidate" ]] || return 0
  candidate="$(resolve_script_path "$candidate")" || return 0
  [[ "$candidate" != "$installed_path" ]] || return 0

  installed_root="$(git -C "$(dirname "$installed_path")" rev-parse --show-toplevel 2>/dev/null)" \
    || return 0
  installed_root="$(cd -P "$installed_root" && pwd)" || return 0
  current_common_dir="$(canonical_git_common_dir "$current_root")" || return 0
  installed_common_dir="$(canonical_git_common_dir "$installed_root")" || return 0
  [[ "$current_common_dir" == "$installed_common_dir" ]] || return 0

  printf 'trellage: using current worktree command: %s\n' "$candidate" >&2
  [[ -z "${ambient_copilot_github_token-}" ]] || export COPILOT_GITHUB_TOKEN="$ambient_copilot_github_token"
  [[ -z "${ambient_gh_token-}" ]] || export GH_TOKEN="$ambient_gh_token"
  [[ -z "${ambient_github_token-}" ]] || export GITHUB_TOKEN="$ambient_github_token"
  [[ -z "${ambient_claude_code_oauth_token-}" ]] || export CLAUDE_CODE_OAUTH_TOKEN="$ambient_claude_code_oauth_token"
  [[ -z "${ambient_anthropic_api_key-}" ]] || export ANTHROPIC_API_KEY="$ambient_anthropic_api_key"
  [[ -z "${ambient_playwright_mcp_extension_token-}" ]] || export PLAYWRIGHT_MCP_EXTENSION_TOKEN="$ambient_playwright_mcp_extension_token"
  [[ -z "${ambient_apify_api_token-}" ]] || export APIFY_API_TOKEN="$ambient_apify_api_token"
  [[ -z "${ambient_google_ai_api_key-}" ]] || export GOOGLE_AI_API_KEY="$ambient_google_ai_api_key"
  exec "$candidate" "$@"
}


unset \
  ambient_copilot_github_token ambient_gh_token ambient_github_token \
  ambient_claude_code_oauth_token ambient_anthropic_api_key \
  ambient_playwright_mcp_extension_token ambient_apify_api_token ambient_google_ai_api_key \
  copilot_token secret_value secret_source_values
ambient_copilot_github_token="${COPILOT_GITHUB_TOKEN-}"
ambient_gh_token="${GH_TOKEN-}"
ambient_github_token="${GITHUB_TOKEN-}"
ambient_claude_code_oauth_token="${CLAUDE_CODE_OAUTH_TOKEN-}"
ambient_anthropic_api_key="${ANTHROPIC_API_KEY-}"
ambient_playwright_mcp_extension_token="${PLAYWRIGHT_MCP_EXTENSION_TOKEN-}"
ambient_apify_api_token="${APIFY_API_TOKEN-}"
ambient_google_ai_api_key="${GOOGLE_AI_API_KEY-}"
unset COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY \
  PLAYWRIGHT_MCP_EXTENSION_TOKEN APIFY_API_TOKEN GOOGLE_AI_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
  ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL \
  TRELLAGE_RESUME_PROFILE TRELLAGE_RESUME_SESSION_ID \
  CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY \
  AWS_SESSION_TOKEN AWS_PROFILE GOOGLE_APPLICATION_CREDENTIALS ANTHROPIC_VERTEX_PROJECT_ID \
  CLOUD_ML_REGION AZURE_CLIENT_ID AZURE_CLIENT_SECRET AZURE_TENANT_ID
unset HERDR_AGENT
invoked_path="${BASH_SOURCE[0]}"
source_path="$(resolve_script_path "$invoked_path")"
dispatch_to_current_trellage_worktree "$invoked_path" "$source_path" "$@"

trellage_arguments=("$@")

fail() {
  printf 'trellage: %s\n' "$1" >&2
  exit 1
}

discard_ambient_github_auth() {
  ambient_copilot_github_token=
  ambient_gh_token=
  ambient_github_token=
}

discard_ambient_claude_auth() {
  ambient_claude_code_oauth_token=
  ambient_anthropic_api_key=
  ambient_playwright_mcp_extension_token=
  ambient_apify_api_token=
  ambient_google_ai_api_key=
}

mode=new
compiler_mode=false
case "${1:-}" in
  validate|lock|build|upgrade)
    mode=compiler
    compiler_mode=true
    ;;
esac
if [[ "$compiler_mode" == true ]]; then
  for compiler_argument in "$@"; do
    case "$compiler_argument" in
      -p|--prompt|--prompt=*) fail '--prompt is not supported for compiler commands' ;;
      -i|--interactive|--interactive=*) fail '--interactive is not supported for compiler commands' ;;
    esac
  done
fi

profile_argument=
auth_mode_argument=
prompt_argument=
prompt_argument_set=false
interactive=false
resume_session_id=
if [[ "$compiler_mode" == false ]]; then
  parsed_arguments=()
  while (( $# > 0 )); do
    case "$1" in
      --profile)
        [[ -z "$profile_argument" ]] || fail '--profile may be specified only once'
        [[ $# -ge 2 && -n "$2" ]] || fail '--profile requires a value'
        profile_argument="$2"
        shift 2
        ;;
      --profile=*)
        [[ -z "$profile_argument" ]] || fail '--profile may be specified only once'
        profile_argument="${1#--profile=}"
        [[ -n "$profile_argument" ]] || fail '--profile requires a value'
        shift
        ;;
      --auth-mode)
        [[ -z "$auth_mode_argument" ]] || fail '--auth-mode may be specified only once'
        [[ $# -ge 2 && -n "$2" ]] || fail '--auth-mode requires a value'
        auth_mode_argument="$2"
        shift 2
        ;;
      --auth-mode=*)
        [[ -z "$auth_mode_argument" ]] || fail '--auth-mode may be specified only once'
        auth_mode_argument="${1#--auth-mode=}"
        [[ -n "$auth_mode_argument" ]] || fail '--auth-mode requires a value'
        shift
        ;;
      -p|--prompt)
        [[ "$prompt_argument_set" == false ]] || fail '--prompt may be specified only once'
        [[ $# -ge 2 && -n "$2" ]] || fail '--prompt requires a non-empty value'
        prompt_argument="$2"
        prompt_argument_set=true
        shift 2
        ;;
      --prompt=*)
        [[ "$prompt_argument_set" == false ]] || fail '--prompt may be specified only once'
        prompt_argument="${1#--prompt=}"
        [[ -n "$prompt_argument" ]] || fail '--prompt requires a non-empty value'
        prompt_argument_set=true
        shift
        ;;
      -i|--interactive)
        [[ "$interactive" == false ]] || fail '--interactive may be specified only once'
        interactive=true
        shift
        ;;
      --interactive=*)
        fail '--interactive does not accept a value'
        ;;
      *)
        parsed_arguments+=("$1")
        shift
        ;;
    esac
  done
  if [[ "${#parsed_arguments[@]}" -eq 0 ]]; then
    set --
  else
    set -- "${parsed_arguments[@]}"
  fi
  if [[ "$prompt_argument_set" == true ]]; then
    [[ "$#" -eq 0 ]] || fail '--prompt cannot be combined with positional arguments'
    mode=prompt
  elif [[ "$#" -ge 1 ]]; then
    case "$1" in
      resume|shell|stop|doctor|destroy)
        if [[ "$1" == resume ]]; then
          [[ "$#" -le 2 ]] || fail 'resume accepts at most one session ID'
          if [[ "$#" -eq 2 ]]; then
            resume_session_id="$2"
            [[ "$resume_session_id" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
              || fail 'resume session ID must be a UUID'
          fi
        else
          [[ "$#" -eq 1 ]] || fail "$1 does not accept a prompt"
        fi
        mode="$1"
        ;;
    esac
  fi
  if [[ "$interactive" == true ]]; then
    [[ -z "$profile_argument" ]] || fail '--profile cannot be combined with --interactive'
    case "$mode" in
      new|prompt) ;;
      *) fail "--interactive is not supported for $mode" ;;
    esac
  fi
fi

case "$auth_mode_argument" in
  ''|proxy|native|api-key) ;;
  *) fail "unsupported --auth-mode: $auth_mode_argument" ;;
esac

case "$mode" in
  new|prompt|resume|doctor) ;;
  *) discard_ambient_github_auth; discard_ambient_claude_auth ;;
esac

prototype_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
compiler_package_dir="$(cd "$prototype_dir/../../packages/trellage-cli" && pwd -P)"
compiler="$compiler_package_dir/dist/cli.js"
compiler_fingerprint="$prototype_dir/../../scripts/profile-compiler-fingerprint.sh"
compiler_stamp="$compiler_package_dir/dist/.source-hash"
varlock="$prototype_dir/../../packages/trellage-cli/node_modules/.bin/varlock"
picker="$prototype_dir/../shared/terminal-picker.mjs"

profile_compiler_is_fresh() {
  local actual_fingerprint expected_fingerprint
  [[ -f "$compiler" && -x "$compiler_fingerprint" ]] || return 1
  expected_fingerprint="$($compiler_fingerprint)" || return 1
  actual_fingerprint="$(head -n 1 "$compiler_stamp" 2>/dev/null || true)"
  [[ "$actual_fingerprint" == "$expected_fingerprint" ]]
}

ensure_profile_compiler() {
  profile_compiler_is_fresh && return 0
  [[ -x "$compiler_fingerprint" ]] \
    || fail "profile compiler fingerprint is unavailable: $compiler_fingerprint"
  command -v npm >/dev/null 2>&1 \
    || fail 'profile compiler bootstrap requires npm'

  if [[ ! -x "$compiler_package_dir/node_modules/.bin/tsc" ]]; then
    printf 'trellage: installing profile compiler dependencies\n' >&2
    (cd "$compiler_package_dir" && npm ci) \
      || fail "profile compiler dependency installation failed in $compiler_package_dir"
  fi

  printf 'trellage: building profile compiler\n' >&2
  (cd "$compiler_package_dir" && npm run build) \
    || fail "profile compiler build failed in $compiler_package_dir"
  [[ -f "$compiler" ]] || fail 'profile compiler build did not produce dist/cli.js'
  profile_compiler_is_fresh || fail 'profile compiler remains stale after build'
}

clean_child_environment=(env -i "PATH=$PATH")
# Keep proxy/TLS and UV package-index overrides so profile image builds can reach
# alternate PyPI simple indexes when files.pythonhosted.org is blocked.
for environment_name in HOME USER LOGNAME SHELL TMPDIR XDG_CONFIG_HOME XDG_CACHE_HOME DOCKER_CONFIG \
  TRELLAGE_ENVIRONMENT TRELLAGE_PROFILE \
  HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy \
  SSL_CERT_FILE SSL_CERT_DIR \
  UV_DEFAULT_INDEX UV_INDEX UV_INDEX_URL UV_EXTRA_INDEX_URL PIP_INDEX_URL; do
  [[ -z "${!environment_name-}" ]] || clean_child_environment+=("$environment_name=${!environment_name}")
done

ensure_profile_compiler
environment_metadata=
environment_enabled=
environment_source_present=
environment_path=
if [[ "$mode" == new || "$mode" == prompt || "$mode" == resume || "$mode" == doctor ]]; then
  environment_metadata="$("${clean_child_environment[@]}" node "$compiler" environment)" \
    || fail 'environment configuration resolution failed'
  environment_enabled="$(jq -r '.enabled' <<<"$environment_metadata")" \
    || fail 'environment metadata has no enabled state'
  environment_source_present="$(jq -r '.source_present' <<<"$environment_metadata")" \
    || fail 'environment metadata has no source state'
  environment_path="$(jq -er '.path' <<<"$environment_metadata")" \
    || fail 'environment metadata has no path'
  [[ "$environment_enabled" == true || "$environment_enabled" == false ]] \
    || fail 'environment metadata has an invalid enabled state'
  [[ "$environment_source_present" == true || "$environment_source_present" == false ]] \
    || fail 'environment metadata has an invalid source state'
  if [[ ( "$mode" == new || "$mode" == prompt || "$mode" == resume ) \
    && "$environment_enabled" == true && "$environment_source_present" == true \
    && "${_TRELLAGE_VARLOCK_BOOTSTRAPPED:-}" != 1 ]]; then
    [[ -x "$varlock" ]] \
      || fail "Varlock is unavailable; run: cd $prototype_dir/../../packages/trellage-cli && npm install"
    [[ -z "$ambient_copilot_github_token" ]] || export COPILOT_GITHUB_TOKEN="$ambient_copilot_github_token"
    [[ -z "$ambient_gh_token" ]] || export GH_TOKEN="$ambient_gh_token"
    [[ -z "$ambient_github_token" ]] || export GITHUB_TOKEN="$ambient_github_token"
    [[ -z "$ambient_claude_code_oauth_token" ]] \
      || export CLAUDE_CODE_OAUTH_TOKEN="$ambient_claude_code_oauth_token"
    [[ -z "$ambient_anthropic_api_key" ]] || export ANTHROPIC_API_KEY="$ambient_anthropic_api_key"
    [[ -z "$ambient_playwright_mcp_extension_token" ]] \
      || export PLAYWRIGHT_MCP_EXTENSION_TOKEN="$ambient_playwright_mcp_extension_token"
    [[ -z "$ambient_apify_api_token" ]] || export APIFY_API_TOKEN="$ambient_apify_api_token"
    [[ -z "$ambient_google_ai_api_key" ]] || export GOOGLE_AI_API_KEY="$ambient_google_ai_api_key"
    export _TRELLAGE_VARLOCK_BOOTSTRAPPED=1
    exec "$varlock" run --inject vars --path "$environment_path" -- "$source_path" "${trellage_arguments[@]}"
  fi
fi

case "${1:-}" in
  validate|lock|build|upgrade)
    discard_ambient_github_auth
    exec "${clean_child_environment[@]}" node "$compiler" "$@"
    ;;
esac

if [[ "$interactive" == true ]]; then
  [[ -t 0 && -t 1 ]] || fail 'interactive profile selection requires an interactive terminal'
  [[ -f "$picker" ]] || fail "terminal picker is unavailable: $picker"
  profile_choices="$("${clean_child_environment[@]}" node "$compiler" choices)" \
    || fail 'profile choices resolution failed'
  picker_input="$(jq -ce '
    def counted($label; $items):
      ($items | length) as $count
      | $label + " " + ($count | tostring)
        + (if $count == 0 then "" else ": " + ($items | join(", ")) end);
    {
      prompt: "Select a Trellage profile",
      choices: to_entries | map({
        id: (.key | tostring),
        label: ((.value.name + " / " + .value.harness.kind) | .[:500]),
        description: (.value.description | gsub("[[:cntrl:]]"; " ") | .[:4000]),
        details: (
          (
            "Declared profile — harness " + .value.harness.kind
            + " " + .value.harness.version
            + (if .value.harness.model then ", model " + .value.harness.model else "" end)
            + "; " + counted("plugins"; [.value.plugins[].select[]])
            + "; " + counted("skill selections"; [.value.skills[].select[]])
            + "; " + counted("MCPs"; [.value.mcps[].name])
          )
          | gsub("[[:cntrl:]]"; " ")
          | .[:8000]
        )
      })
    }
  ' <<<"$profile_choices")" || fail 'profile choices are invalid'
  picker_status=0
  selected_choice="$(node "$picker" <<<"$picker_input")" || picker_status=$?
  if [[ "$picker_status" -ne 0 ]]; then
    exit "$picker_status"
  fi
  profile_argument="$(jq -er --arg choice "$selected_choice" \
    '.[$choice | tonumber].value' <<<"$profile_choices")" \
    || fail 'terminal picker returned an invalid profile selection'
  [[ -n "$profile_argument" ]] || fail 'terminal picker returned an empty profile path'
fi

metadata_args=(metadata)
[[ -z "$profile_argument" ]] || metadata_args+=("$profile_argument")
docker_discovery() {
  local docker_environment=("${clean_child_environment[@]}")
  [[ -z "${DOCKER_HOST-}" ]] || docker_environment+=("DOCKER_HOST=$DOCKER_HOST")
  [[ -z "${DOCKER_CONTEXT-}" ]] || docker_environment+=("DOCKER_CONTEXT=$DOCKER_CONTEXT")
  "${docker_environment[@]}" docker "$@"
}
if [[ -n "${DOCKER_HOST-}" ]]; then
  docker_endpoint="$DOCKER_HOST"
else
  docker_context="$(docker_discovery context show 2>/dev/null)" || fail 'cannot capture Docker context'
  docker_endpoint="$(docker_discovery context inspect "$docker_context" --format '{{ (index .Endpoints "docker").Host }}' 2>/dev/null)" \
    || fail 'cannot capture Docker endpoint'
fi
[[ "$docker_endpoint" == unix://* ]] || fail "Docker endpoint must be Unix: ${docker_endpoint:-missing}"
export DOCKER_HOST="$docker_endpoint"
unset DOCKER_CONTEXT
docker() {
  if [[ "${1:-}" == --host ]]; then
    shift 2
  fi
  command docker --host "$docker_endpoint" "$@"
}
normalize_docker_platform() {
  # Prefer case over ${var/pat/repl}: bash treats \/ in the replacement as a
  # literal backslash, which corrupted linux/aarch64 into linux\/arm64.
  case "$1" in
    linux/aarch64) printf '%s\n' linux/arm64 ;;
    linux/x86_64) printf '%s\n' linux/amd64 ;;
    *) printf '%s\n' "$1" ;;
  esac
}
docker_platform="$(docker_discovery --host "$docker_endpoint" info --format '{{.OSType}}/{{.Architecture}}' 2>/dev/null)" \
  || fail 'cannot inspect Docker server platform'
docker_platform="$(normalize_docker_platform "$docker_platform")"
case "$docker_platform" in
  linux/arm64|linux/amd64) ;;
  *) fail "unsupported Docker server platform: ${docker_platform:-unknown}" ;;
esac
docker_server_id="$(docker_discovery --host "$docker_endpoint" info --format '{{.ID}}' 2>/dev/null)" \
  || fail 'cannot capture Docker server identity'
[[ -n "$docker_server_id" ]] || fail 'Docker server identity is empty'
verify_docker_server() {
  local current_platform current_server_id
  current_platform="$(docker info --format '{{.OSType}}/{{.Architecture}}' 2>/dev/null)" \
    || fail 'Docker server changed during operation'
  current_platform="$(normalize_docker_platform "$current_platform")"
  current_server_id="$(docker info --format '{{.ID}}' 2>/dev/null)" \
    || fail 'Docker server changed during operation'
  [[ "$current_platform" == "$docker_platform" && "$current_server_id" == "$docker_server_id" ]] \
    || fail 'Docker server changed during operation'
}
profile_metadata="$("${clean_child_environment[@]}" "DOCKER_HOST=$docker_endpoint" \
  node "$compiler" "${metadata_args[@]}")" || fail 'profile metadata resolution failed'
harness_kind="$(jq -er '.harness_kind' <<<"$profile_metadata")" || fail 'profile metadata has no harness kind'
if [[ "$harness_kind" != claude ]]; then
  [[ -z "$auth_mode_argument" ]] || fail '--auth-mode is supported only for Claude profiles'
  discard_ambient_claude_auth
fi
claude_auth_mode="${auth_mode_argument:-proxy}"
profile_name="$(jq -er '.profile_name' <<<"$profile_metadata")" || fail 'profile metadata has no name'
profile_hash="$(jq -er '.profile_hash' <<<"$profile_metadata")" || fail 'profile metadata has no hash'
runtime_hash="$(jq -er '.runtime_hash' <<<"$profile_metadata")" || fail 'profile metadata has no runtime hash'
[[ "$profile_hash" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'profile metadata has an invalid profile hash'
[[ "$runtime_hash" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'profile metadata has an invalid runtime hash'
profile_path="$(jq -er '.profile_path' <<<"$profile_metadata")" || fail 'profile metadata has no path'
profile_locked="$(jq -r '.locked' <<<"$profile_metadata")" || fail 'profile metadata has no lock state'
profile_image="$(jq -er '.image' <<<"$profile_metadata")" || fail 'profile metadata has no image'
metadata_platform="$(jq -er '.platform' <<<"$profile_metadata")" || fail 'profile metadata has no platform'
[[ "$metadata_platform" == "$docker_platform" ]] || fail 'profile metadata selected a different Docker platform'
build_command="$(jq -er '.build_command' <<<"$profile_metadata")" || fail 'profile metadata has no build command'
secrets_provider="$(jq -er '.secrets_provider' <<<"$profile_metadata")" || fail 'profile metadata has no secrets provider'
resolved_varlock_path="$(jq -r '.resolved_varlock_path // empty' <<<"$profile_metadata")"
has_initial_prompt="$(jq -r '.has_initial_prompt' <<<"$profile_metadata")" || fail 'profile metadata has no prompt state'
harness_executable="$(jq -er '.harness_executable' <<<"$profile_metadata")" || fail 'profile metadata has no executable'
runtime_entry="$(jq -er '.runtime_entry' <<<"$profile_metadata")" || fail 'profile metadata has no runtime entry'
default_network="$(jq -er '.default_network' <<<"$profile_metadata")" || fail 'profile metadata has no default network'
auth_policy="$(jq -er '.auth_policy' <<<"$profile_metadata")" || fail 'profile metadata has no auth policy'
resolved_version="$(jq -r '.resolved_version // empty' <<<"$profile_metadata")"
tmpfs_size="$(jq -r 'if has("tmpfs_size") then .tmpfs_size else "256m" end' <<<"$profile_metadata")" \
  || fail 'profile metadata has no tmpfs size'
[[ "$tmpfs_size" =~ ^[1-9][0-9]*(k|m|g)$ ]] \
  || fail 'profile metadata has an invalid tmpfs size'
claude_mode=
claude_gateway=
claude_opus_model=
claude_sonnet_model=
claude_haiku_model=
prime_provider=
prime_model=
prime_base_url=
if [[ "$harness_kind" == claude ]]; then
  claude_mode="$(jq -er '.claude_mode' <<<"$profile_metadata")" || fail 'profile metadata has no Claude mode'
  claude_gateway="$(jq -er '.claude_gateway' <<<"$profile_metadata")" || fail 'profile metadata has no Claude gateway'
  claude_opus_model="$(jq -er '.claude_opus_model | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Claude Opus route'
  claude_sonnet_model="$(jq -er '.claude_sonnet_model | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Claude Sonnet route'
  claude_haiku_model="$(jq -er '.claude_haiku_model | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Claude Haiku route'
  case "$claude_mode" in
    core|hyperresearch) ;;
    *) fail 'profile metadata has an unsupported Claude mode' ;;
  esac
  [[ "$claude_gateway" =~ ^https?://[^[:space:]]+$ ]] || fail 'profile metadata has an invalid Claude gateway'
fi
if [[ "$harness_kind" == prime ]]; then
  prime_provider="$(jq -er '.prime_provider | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Prime provider'
  prime_model="$(jq -er '.prime_model | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Prime model'
  prime_base_url="$(jq -er '.prime_base_url | select(type == "string" and length > 0)' <<<"$profile_metadata")" \
    || fail 'profile metadata has no Prime base URL'
  [[ "$prime_provider" == copilot-proxy-rs ]] || fail 'profile metadata has an unsupported Prime provider'
  [[ "$prime_model" == claude-opus-5 ]] || fail 'profile metadata has an unsupported Prime model'
  [[ "$prime_base_url" == http://copilot-proxy-rs:8080 ]] || fail 'profile metadata has an unsupported Prime base URL'
  [[ "$auth_policy" == proxy ]] || fail 'profile metadata has an unsupported Prime auth policy'
  [[ "$harness_executable" == prime-agent ]] || fail 'profile metadata has an unsupported Prime executable'
  [[ "$runtime_entry" == trellage-prime-entry ]] || fail 'profile metadata has an unsupported Prime runtime entry'
  [[ "$default_network" == copilot-proxy-rs_default ]] || fail 'profile metadata has an unsupported Prime network'
fi
case "$harness_kind" in
  claude|codex|copilot|pi|prime) ;;
  *) fail 'profile metadata has an unsupported harness kind' ;;
esac
[[ "$harness_executable" =~ ^[A-Za-z0-9._-]+$ ]] \
  || fail 'profile metadata has an unsafe harness executable'
[[ "$runtime_entry" =~ ^[A-Za-z0-9._-]+$ ]] \
