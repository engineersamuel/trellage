  volume_ownership="$(docker volume inspect \
    --format "$volume_ownership_format" "$state_volume" 2>/dev/null)" \
    || fail "cannot inspect Docker volume ownership: $state_volume"
  expected_ownership="$prototype_owner"$'\t'"$worktree"$'\t'"$profile_name"$'\t'"$docker_platform"
  [[ "$volume_ownership" == "$expected_ownership" ]] && return
  legacy_arm64_ownership="$prototype_owner"$'\t'"$worktree"$'\t'"$profile_name"$'\t'
  [[ "$docker_platform" == linux/arm64 && "$volume_ownership" == "$legacy_arm64_ownership" ]] \
