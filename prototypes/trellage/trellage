}

if [[ "$mode" == doctor ]]; then
  image_state=error
  if probe_image_presence; then
    resolved_image_id="$(docker image inspect --format '{{ .Id }}' "$image" 2>/dev/null)" \
      || resolved_image_id=
    if [[ -n "$resolved_image_id" ]]; then
      image_state=available
      image_profile_inspection=error
      image_runtime_inspection=error
      if inspected_profile_hash="$(docker image inspect \
        --format '{{ index .Config.Labels "dev.trellage.profile.hash" }}' "$resolved_image_id" 2>/dev/null)"; then
        image_profile_inspection=ok
      fi
      if inspected_runtime_hash="$(docker image inspect \
        --format '{{ index .Config.Labels "dev.trellage.runtime.hash" }}' "$resolved_image_id" 2>/dev/null)"; then
        image_runtime_inspection=ok
      fi
      if [[ "$image_profile_inspection" != ok || "$image_runtime_inspection" != ok ]]; then
        image_state=error
      elif [[ "$inspected_profile_hash" != "$profile_hash" \
        || "$inspected_runtime_hash" != "$runtime_hash" ]]; then
        image_state=stale
      fi
    fi
  else
    probe_status="$?"
    if [[ "$probe_status" -eq 1 ]]; then
      image_state=absent
    fi
  fi
  network_state=error
  if probe_network_presence; then
    network_state=available
  else
    probe_status="$?"
    if [[ "$probe_status" -eq 1 ]]; then
      network_state=absent
    fi
  fi

  container_probe=error
  if probe_container_presence; then
    container_probe=present
  else
    probe_status="$?"
    if [[ "$probe_status" -eq 1 ]]; then
      container_probe=absent
    fi
  fi
  volume_probe=error
  if probe_volume_presence; then
    volume_probe=present
  else
    probe_status="$?"
    if [[ "$probe_status" -eq 1 ]]; then
      volume_probe=absent
    fi
  fi

  resource_state=absent
  if [[ "$container_probe" == error || "$volume_probe" == error ]]; then
    resource_state=error
  elif [[ "$container_probe" == present && "$volume_probe" == present ]]; then
    resource_state=error
    if (inspect_container && validate_container_mounts && validate_state_volume) >/dev/null 2>&1; then
      container_label_state=error
      if container_labels_are_current; then
        container_label_state=current
      else
        container_label_status="$?"
        [[ "$container_label_status" -ne 1 ]] || container_label_state=stale
      fi
      if [[ "$container_label_state" == stale ]]; then
        resource_state=stale
      elif [[ "$container_label_state" == current ]]; then
        running="$(docker container inspect \
          --format '{{ .State.Running }}' "$container_name" 2>/dev/null)" \
          || running=error
        case "$running" in
          true) resource_state=running ;;
          false) resource_state=stopped ;;
        esac
      fi
    fi
  elif [[ "$container_probe" == present || "$volume_probe" == present ]]; then
    resource_state=error
  fi

  printf 'profile: %s (%s)\n' "$profile_name" "$profile_path"
  printf 'harness kind: %s\n' "$harness_kind"
  if [[ "$environment_enabled" != true ]]; then
    printf 'environment: disabled\n'
  elif [[ "$environment_source_present" == true ]]; then
    printf 'environment: varlock (ready)\n'
  else
    printf 'environment: varlock (no source)\n'
  fi
  printf 'environment path: %s\n' "$environment_path"
  printf 'resolved version: %s\n' "${resolved_version:-unresolved}"
  case "$github_cli_auth_source" in
    GH_TOKEN|GITHUB_TOKEN|COPILOT_GITHUB_TOKEN) printf 'GitHub CLI auth: environment\n' ;;
    gh) printf 'GitHub CLI auth: gh\n' ;;
    *) printf 'GitHub CLI auth: login required\n' ;;
  esac
  if [[ "$auth_policy" == host-or-login ]]; then
    case "$copilot_auth_source" in
      COPILOT_GITHUB_TOKEN|GH_TOKEN|GITHUB_TOKEN) printf 'host auth: environment\n' ;;
      gh) printf 'host auth: gh\n' ;;
      *) printf 'host auth: login required\n' ;;
    esac
  fi
  if [[ "$harness_kind" == claude ]]; then
    printf 'auth mode: %s\n' "$claude_auth_mode"
    case "$claude_auth_source" in
      CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY) printf 'host auth: environment\n' ;;
      login) printf 'host auth: login required\n' ;;
      *) printf 'host auth: local proxy\n' ;;
    esac
  fi
  printf 'profile lock: %s\n' "$profile_locked"
  printf 'worktree: %s\n' "$worktree"
  printf 'mount: %s\n' "$mount_path"
  printf 'image: %s (%s)\n' "$image" "$image_state"
  printf 'network: %s (%s)\n' "$network" "$network_state"
  printf 'container: %s\n' "$container_name"
  printf 'state volume: %s\n' "$state_volume"
  if [[ "$resource_state" == absent ]]; then
    printf 'state: absent (created on first launch)\n'
  else
    printf 'state: %s\n' "$resource_state"
  fi
  if [[ "$profile_locked" != true || "$image_state" != available ]]; then
    printf 'build required: %s\n' "$build_command"
  fi
  exit 0
fi

codex_exec_prefix=(docker container exec)
if [[ "$secrets_provider" == varlock \
  && ( "$mode" == new || "$mode" == prompt || "$mode" == resume ) ]]; then
  secret_filter="$(jq -r '.required_secrets | sort | join(",")' <<<"$profile_metadata")"
  codex_exec_prefix=(
    "$varlock" run
    --path "$resolved_varlock_path"
    --inject vars
    --filter "$secret_filter"
    -- docker container exec
  )
fi

if [[ "$mode" == stop ]]; then
  if ! container_is_present; then
    exit 0
  fi
  inspect_container
  volume_is_present || fail "Docker state volume is missing: $state_volume"
  validate_state_volume
  validate_container_mounts
  running="$(docker container inspect \
    --format '{{ .State.Running }}' "$container_id" 2>/dev/null)" \
    || fail "cannot inspect Docker container state: $container_name"
  [[ "$running" == 'true' || "$running" == 'false' ]] \
    || fail "Docker container has an invalid running state: $container_name"
  if [[ "$running" == true ]]; then
    verify_docker_server
    docker container stop "$container_id" >/dev/null
  fi
  exit 0
fi

if [[ "$mode" == destroy ]]; then
  printf 'container: %s\n' "$container_name"
  printf 'state volume: %s\n' "$state_volume"
  confirmation="destroy $container_name $state_volume"
  printf 'type "%s" to confirm: ' "$confirmation"
  if ! IFS= read -r reply; then
    printf 'cancelled\n'
    exit 0
  fi
  if [[ "$reply" != "$confirmation" ]]; then
    printf 'cancelled\n'
    exit 0
  fi

  container_present=false
  volume_present=false
  if container_is_present; then
    container_present=true
  fi
  if volume_is_present; then
    volume_present=true
  fi
  if [[ "$container_present" == true ]]; then
    inspect_container
    validate_container_mounts
  fi
  if [[ "$volume_present" == true ]]; then
    validate_state_volume
  fi

  if [[ "$container_present" == true ]]; then
    verify_docker_server
    docker container rm --force "$container_id" >/dev/null
  fi
  if [[ "$volume_present" == true ]]; then
    validate_state_volume
    verify_docker_server
    docker volume rm "$state_volume" >/dev/null
  fi
  exit 0
fi

inspect_profile_image() {
  resolved_image_id="$(docker image inspect --format '{{ .Id }}' "$image" 2>/dev/null)" \
    || resolved_image_id=
  [[ -n "$resolved_image_id" ]] || return 1
  image_profile_hash="$(docker image inspect \
    --format '{{ index .Config.Labels "dev.trellage.profile.hash" }}' "$resolved_image_id" 2>/dev/null)" \
    || fail "cannot inspect Docker image profile hash: $image"
  [[ "$image_profile_hash" == "$profile_hash" ]] || return 1
  image_runtime_hash="$(docker image inspect \
    --format '{{ index .Config.Labels "dev.trellage.runtime.hash" }}' "$resolved_image_id" 2>/dev/null)" \
    || fail "cannot inspect Docker image runtime hash: $image"
  [[ "$image_runtime_hash" == "$runtime_hash" ]] || return 1
  image_platform="$(docker image inspect \
    --format '{{ index .Config.Labels "dev.trellage.platform" }}' "$resolved_image_id" 2>/dev/null)" \
    || fail "cannot inspect Docker image platform: $image"
  [[ "$image_platform" == "$docker_platform" ]]
}

[[ "$profile_locked" == true ]] \
  || fail "profile image is missing or stale; run: $build_command"
if ! inspect_profile_image; then
  if [[ -n "${TRELLAGE_IMAGE:-}" ]]; then
    resolved_image_id="$(docker image inspect --format '{{ .Id }}' "$image" 2>/dev/null)" \
      || resolved_image_id=
    [[ -n "$resolved_image_id" ]] \
      || fail "Docker image is unavailable: $image"
    fail "profile image is missing or stale; run: $build_command"
  fi
  verify_docker_server
  printf 'trellage: profile image is missing or stale; building automatically\n' >&2
  "${clean_child_environment[@]}" "DOCKER_HOST=$docker_endpoint" \
    node "$compiler" build --locked "$profile_path" \
    || fail "automatic profile image build failed: $build_command"
  inspect_profile_image \
    || fail "profile image remains missing or stale after automatic build: $image"
fi
docker network inspect "$network" >/dev/null 2>&1 \
  || fail "Docker network is unavailable: $network"
expected_image_id="$resolved_image_id"
[[ -n "$expected_image_id" ]] || fail "Docker image has an empty ID: $image"

reuse_container=false
if container_is_present; then
  inspect_container
  volume_is_present || fail "Docker state volume is missing: $state_volume"
  validate_state_volume
  validate_container_mounts
  mount_state="$(container_mount_state)" \
    || fail "refusing Docker container with unexpected mounts: $container_name"
  if [[ "$mount_state" == legacy ]] || ! container_is_current; then
    remove_stale_container
    container_id=
  else
    container_image_id="$(docker container inspect \
      --format '{{ .Image }}' "$container_id" 2>/dev/null)" \
      || fail "cannot inspect Docker container image: $container_name"
    if [[ "$container_image_id" != "$expected_image_id" ]]; then
      remove_stale_container
    else
      reuse_container=true
      running="$(docker container inspect \
        --format '{{ .State.Running }}' "$container_id" 2>/dev/null)" \
        || fail "cannot inspect Docker container state: $container_name"
      [[ "$running" == 'true' || "$running" == 'false' ]] \
        || fail "Docker container has an invalid running state: $container_name"
      if [[ "$running" != true ]]; then
        verify_docker_server
        docker container start "$container_id" >/dev/null
      fi
    fi
  fi
fi
if [[ "$reuse_container" != true ]]; then
  if volume_is_present; then
    validate_state_volume
  else
    verify_docker_server
    created_volume="$(docker volume create \
      "${resource_label_args[@]}" \
      "$state_volume")"
    [[ "$created_volume" == "$state_volume" ]] \
      || fail "Docker created an unexpected state volume: $created_volume"
    validate_state_volume \
      || fail "Docker state volume could not be verified after creation: $state_volume"
  fi
  verify_docker_server
  container_id="$(docker container create \
    --name "$container_name" \
    "${resource_label_args[@]}" \
    "${container_integrity_label_args[@]}" \
    --user '10001:10001' \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 256 \
    --memory 2g \
    --cpus 2 \
    --tmpfs "/tmp:rw,noexec,nosuid,nodev,size=${tmpfs_size},uid=10001,gid=10001" \
    --mount "type=bind,src=$worktree,dst=$mount_path" \
    --mount "type=bind,src=$git_common_dir,dst=$git_common_dir" \
    --mount "type=volume,src=$state_volume,dst=/home/agent" \
    --network "$network" \
    --workdir "$mount_path" \
    "$expected_image_id" sleep infinity)"
  [[ -n "$container_id" ]] || fail "Docker create returned an empty container ID: $container_name"
  created_container_image_id="$(docker container inspect \
    --format '{{ .Image }}' "$container_id" 2>/dev/null)" \
    || fail "cannot inspect created Docker container image: $container_name"
  if [[ "$created_container_image_id" != "$expected_image_id" ]]; then
    docker container rm --force "$container_id" >/dev/null
    fail "Docker created container from an unexpected image: $container_name"
  fi
  verify_docker_server
  docker container start "$container_id" >/dev/null
fi
