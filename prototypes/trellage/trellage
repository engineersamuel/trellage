}

container_mount_state() {
  local mounts expected_worktree expected_git count
  mounts="$(docker container inspect \
    --format "$mounts_format" "$container_id" 2>/dev/null)" || return 2
  count="$(printf '%s\n' "$mounts" | awk 'NF { count++ } END { print count + 0 }')"
  [[ "$count" == 2 || "$count" == 3 ]] || return 1
  expected_worktree=$'bind\t\t'"$worktree"$'\t'"$mount_path"$'\ttrue'
  grep -Fqx "$expected_worktree" <<<"$mounts" || return 1
  awk -F '\t' -v volume="$state_volume" '
    $1 == "volume" && $2 == volume && $3 != "" && $4 == "/home/agent" && $5 == "true" { found++ }
    END { exit(found == 1 ? 0 : 1) }
  ' <<<"$mounts" || return 1
  if [[ "$count" == 2 ]]; then
    printf 'legacy\n'
    return
  fi
  expected_git=$'bind\t\t'"$git_common_dir"$'\t'"$git_common_dir"$'\ttrue'
  grep -Fqx "$expected_git" <<<"$mounts" || return 1
  printf 'current\n'
}

validate_container_mounts() {
  local state
  state="$(container_mount_state)" \
    || fail "refusing Docker container with unexpected mounts: $container_name"
  [[ "$state" == current || "$state" == legacy ]] \
    || fail "refusing Docker container with unexpected mounts: $container_name"
}

