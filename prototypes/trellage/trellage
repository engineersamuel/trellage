inspect_container() {
  container_prototype="$(docker container inspect \
    --format "$prototype_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container ownership: $container_name"
  [[ "$container_prototype" == "$prototype_owner" ]] \
    || fail "refusing unrelated Docker container name collision: $container_name"
  container_worktree="$(docker container inspect \
    --format "$worktree_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container worktree label: $container_name"
  [[ "$container_worktree" == "$worktree" ]] \
    || fail "refusing unrelated Docker container name collision: $container_name"
  container_profile="$(docker container inspect \
    --format "$profile_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container profile label: $container_name"
  [[ "$container_profile" == "$profile_name" ]] \
    || fail "refusing Docker container profile collision: $container_name"
  container_profile_hash="$(docker container inspect \
    --format "$profile_hash_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container profile hash: $container_name"
  container_platform="$(docker container inspect \
    --format "$platform_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container platform: $container_name"
  container_platform_is_legacy=false
  if [[ -z "$container_platform" && "$docker_platform" == linux/arm64 ]]; then
    container_platform_is_legacy=true
  else
    [[ "$container_platform" == "$docker_platform" ]] \
      || fail "refusing Docker container platform collision: $container_name"
  fi
  container_runtime_hash="$(docker container inspect \
    --format "$runtime_hash_format" "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container runtime hash: $container_name"
  container_id="$(docker container inspect \
    --format '{{ .Id }}' "$container_name" 2>/dev/null)" \
    || fail "cannot inspect Docker container ID: $container_name"
  [[ -n "$container_id" ]] || fail "Docker container has an empty ID: $container_name"
}

container_is_current() {
  [[ "$container_platform_is_legacy" == false \
    && "$container_profile_hash" == "$profile_hash" \
    && "$container_runtime_hash" == "$runtime_hash" ]]
}

remove_stale_container() {
  local running main_pid processes
  running="$(docker container inspect --format '{{ .State.Running }}' "$container_id" 2>/dev/null)" \
    || fail "cannot inspect Docker container state: $container_name"
  [[ "$running" == true || "$running" == false ]] \
    || fail "Docker container has an invalid running state: $container_name"
  if [[ "$running" == true ]]; then
    main_pid="$(docker container inspect --format '{{ .State.Pid }}' "$container_id" 2>/dev/null)" \
      || fail "cannot inspect Docker container PID: $container_name"
    [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] || fail "Docker container has an invalid PID: $container_name"
    processes="$(docker container top "$container_id" -eo pid,ppid,comm 2>/dev/null)" \
      || fail "cannot inspect Docker container processes: $container_name"
    if awk -v main_pid="$main_pid" 'NR > 1 && $1 != main_pid { found = 1 } END { exit(found ? 0 : 1) }' \
      <<<"$processes"; then
      fail "profile container is stale but has an active session; exit it and retry: $container_name"
    fi
  fi
  verify_docker_server
  docker container rm --force "$container_id" >/dev/null
  container_id=
}

container_labels_are_current() {
